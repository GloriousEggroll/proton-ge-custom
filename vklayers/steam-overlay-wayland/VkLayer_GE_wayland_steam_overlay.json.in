{
    "file_format_version": "1.0.0",
    "layer": {
        "name": "VK_LAYER_GE_wayland_steam_overlay",
        "type": "GLOBAL",
        "library_path": "libVkLayer_GE_Wayland_SteamOverlay.so",
        "api_version": "1.3.0",
        "implementation_version": "1",
        "description": "Steam overlay input compatibility bridge for Wine Wayland",
        "functions": {
            "vkGetInstanceProcAddr": "GEOverlay_GetInstanceProcAddr",
            "vkGetDeviceProcAddr": "GEOverlay_GetDeviceProcAddr",
            "vkNegotiateLoaderLayerInterfaceVersion": "GEOverlay_NegotiateLoaderLayerInterfaceVersion"
        },
        "enable_environment": {
            "WINE_WAYLAND_STEAM_OVERLAY_LAYER": "1"
        },
        "disable_environment": {
            "DISABLE_WINE_WAYLAND_STEAM_OVERLAY_LAYER": "1"
        }
    }
}
