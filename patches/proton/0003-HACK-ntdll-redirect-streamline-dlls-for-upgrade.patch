From: GloriousEggroll <gloriouseggroll@gmail.com>
Subject: [PATCH] HACK: ntdll: redirect NVIDIA Streamline dlls for the Streamline
 upgrade

When WINE_UPSCALER_REPLACE contains "streamline", load sl.*.dll from
c:\windows\system32\umu\streamline\ when the upgraded copy has that file.
Doing this in load_dll() also covers games that import sl.interposer.dll
statically, which the kernelbase LoadLibraryExW upscaler hack can't see.

https://github.com/GloriousEggroll/proton-ge-custom/issues/875
---
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -3851,6 +3851,48 @@
 
 
 /***********************************************************************
+ *	load_dll_streamline_hack
+ *
+ * Redirect NVIDIA Streamline modules (sl.*.dll) to the upgraded copy that
+ * protonfixes installs when WINE_UPSCALER_REPLACE contains "streamline".
+ * This also covers static imports of sl.interposer.dll, and only applies to
+ * files that exist in the upgraded copy.
+ */
+static BOOL load_dll_streamline_hack( const WCHAR *name, WCHAR *override, DWORD size )
+{
+    static const WCHAR dirW[] = L"\\??\\c:\\windows\\system32\\umu\\streamline\\";
+    static INT enabled = -1;
+    FILE_BASIC_INFORMATION info;
+    UNICODE_STRING overrideW;
+    OBJECT_ATTRIBUTES attr;
+    const WCHAR *base, *p;
+    WCHAR envW[64];
+    size_t len;
+
+    if (enabled == -1)
+        enabled = get_env( L"WINE_UPSCALER_REPLACE", envW, sizeof(envW) ) && wcsstr( envW, L"streamline" );
+    if (!enabled) return FALSE;
+
+    base = name;
+    if ((p = wcsrchr( base, '\\' ))) base = p + 1;
+    if ((p = wcsrchr( base, '/' ))) base = p + 1;
+    len = wcslen( base );
+    if (len < 8 || wcsnicmp( base, L"sl.", 3 ) || wcsicmp( base + len - 4, L".dll" )) return FALSE;
+    if (ARRAY_SIZE(dirW) + len > size) return FALSE;
+
+    swprintf( override, size, L"%s%s", dirW, base );
+    RtlInitUnicodeString( &overrideW, override );
+    InitializeObjectAttributes( &attr, &overrideW, OBJ_CASE_INSENSITIVE, 0, NULL );
+    if (NtQueryAttributesFile( &attr, &info ))
+    {
+        override[0] = 0;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+
+/***********************************************************************
  *	load_dll  (internal)
  *
  * Load a PE style module according to the load order.
@@ -3875,7 +3917,8 @@
 
     if (nts)
     {
-        if ( (do_override = load_dll_optiscaler_hack(libname, override, ARRAY_SIZE(override))) )
+        if ( (do_override = load_dll_optiscaler_hack(libname, override, ARRAY_SIZE(override))) ||
+             (do_override = load_dll_streamline_hack(libname, override, ARRAY_SIZE(override))) )
             FIXME ( "HACK: redirecting %s to %s\n", debugstr_w(libname), debugstr_w(override) );
         nts = find_dll_file( load_path, do_override ? override : libname, &nt_name, pwm, &mapping, &image_info, &id,
                              &redirected, FALSE );
