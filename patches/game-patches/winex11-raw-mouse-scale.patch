From: GloriousEggroll <gloriouseggroll@gmail.com>
Subject: [PATCH] winex11.drv: Add optional WINE_RAW_MOUSE_SCALE for raw mouse deltas

Some games (e.g. Stronghold Crusader HD) move their own cursor from raw
mouse deltas. These are neither accelerated nor scaled, so the cursor is
much faster than the desktop pointer (cnc-ddraw works around this with its
"sensitivity"/"adjmouse" options).

WINE_RAW_MOUSE_SCALE accepts either:
- a number (0 < value <= 16) that multiplies the raw deltas, carrying the
  sub-pixel remainder between events;
- "accel", which sends the same accelerated motion the desktop pointer
  uses, so the game follows the user's own pointer speed and display scale.

Unset (or 1.0) keeps the old behaviour.
---
diff --git a/dlls/winex11.drv/mouse.c b/dlls/winex11.drv/mouse.c
index c4ee7a7..7629f04 100644
--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -26,6 +26,7 @@
 #include "config.h"
 
 #include <math.h>
+#include <stdlib.h>
 #include <dlfcn.h>
 #include <X11/Xlib.h>
 #include <X11/cursorfont.h>
@@ -1726,6 +1727,34 @@ static BOOL X11DRV_DeviceChanged( XGenericEventCookie *xev )
     return TRUE;
 }
 
+/* Optional per-app handling of raw mouse deltas, set through WINE_RAW_MOUSE_SCALE.
+ * Some games (e.g. Stronghold Crusader HD) move their own cursor from raw deltas,
+ * which are neither accelerated nor scaled and so feel too fast.
+ *
+ * - a number (0 < value <= 16) multiplies the raw deltas;
+ * - "accel" sends the same accelerated motion the desktop pointer uses, so the game
+ *   follows the user's own pointer speed and display scale. */
+static double get_raw_mouse_scale(BOOL *use_pointer_motion)
+{
+    static double scale = -1;
+    static BOOL accel;
+    const char *env;
+    char *end;
+
+    if (scale < 0)
+    {
+        scale = 1.0;
+        if ((env = getenv( "WINE_RAW_MOUSE_SCALE" )))
+        {
+            double value = strtod( env, &end );
+            if (!strcmp( env, "accel" )) accel = TRUE;
+            else if (end != env && value > 0.0 && value <= 16.0) scale = value;
+        }
+    }
+    *use_pointer_motion = accel;
+    return scale;
+}
+
 static BOOL map_raw_event_coords( XIRawEvent *event, INPUT *input, BOOL send_raw )
 {
     struct x11drv_thread_data *thread_data = x11drv_thread_data();
@@ -1798,8 +1827,33 @@ static BOOL map_raw_event_coords( XIRawEvent *event, INPUT *input, BOOL send_raw
     }
     else if (send_raw)
     {
-        input->mi.dx = round( x_raw );
-        input->mi.dy = round( y_raw );
+        BOOL use_pointer_motion;
+        double raw_scale = get_raw_mouse_scale( &use_pointer_motion );
+        static double raw_x_remainder, raw_y_remainder;
+
+        if (use_pointer_motion)
+        {
+            /* same accelerated motion as the desktop pointer, keeping the sub-pixel remainder */
+            input->mi.dx = round( x->value );
+            input->mi.dy = round( y->value );
+            x->value -= input->mi.dx;
+            y->value -= input->mi.dy;
+        }
+        else if (raw_scale != 1.0)
+        {
+            /* keep the sub-pixel remainder so small moves are not lost */
+            raw_x_remainder += x_raw * raw_scale;
+            raw_y_remainder += y_raw * raw_scale;
+            input->mi.dx = round( raw_x_remainder );
+            input->mi.dy = round( raw_y_remainder );
+            raw_x_remainder -= input->mi.dx;
+            raw_y_remainder -= input->mi.dy;
+        }
+        else
+        {
+            input->mi.dx = round( x_raw );
+            input->mi.dy = round( y_raw );
+        }
         TRACE( "event %f,%f raw value %f,%f, raw input %d,%d\n", x_value, y_value, x_raw, y_raw,
                (int)input->mi.dx, (int)input->mi.dy );
 
