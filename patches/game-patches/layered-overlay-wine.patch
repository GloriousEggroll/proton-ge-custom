+    BOOL overlay = layered_overlay_shape_enabled() || layered_overlay_alpha_enabled();
     char const *sgi;
 
     if (!data->whole_window) return;
 
     /* HACK for bug 27151 - TBH: Task Bar Hero (3678970) does not take input
