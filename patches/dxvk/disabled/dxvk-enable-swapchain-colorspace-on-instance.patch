From: GloriousEggroll <gloriouseggroll@gmail.com>
Subject: [PATCH] dxvk: Enable swapchain colorspace as an instance extension.

Disabled: superseded by upstream DXVK commit
3c40ca1b ([dxvk] Move EXT_swapchain_colorspace to instance extensions).

VK_EXT_swapchain_colorspace is an instance extension. Querying it through
vkEnumerateDeviceExtensionProperties leaves it disabled and omits it from
vkCreateInstance. The Warframe DX11 log shows extSwapchainColorSpace = 0
and no VK_EXT_swapchain_colorspace in the enabled instance extensions,
despite PROTON_ENABLE_HDR=1. Its DX12 path works with that option.

Move the extension to DxvkInstanceExtensionInfo and getExtensionList so
the existing instance-support query enables it only when available.
Remove the unused device capability and device-extension request. The
existing import path also limits this to extensions enabled by the caller.

This corrects capability discovery, without changing dxgi.enableHDR or
pretending that the surface supports HDR. Warframe's flip-model and
anti-aliasing requirements still apply and need to be checked separately.

Original HDR extension support: Joshua Ashton <joshua@froggi.es>,
commit 4335eccae9f233fbf8180395845258a27cb2f180.
Specification: https://docs.vulkan.org/refpages/latest/refpages/source/VK_EXT_swapchain_colorspace.html

Manual validation after rebuilding (not yet performed):
- Warframe DX11 with PROTON_ENABLE_HDR=1: verify the extension appears in
  the enabled instance extensions and test the HDR output option.
- Check DX12 HDR remains working and ordinary SDR presentation is unchanged.
---
 src/dxvk/dxvk_device_info.cpp | 4 ----
 src/dxvk/dxvk_device_info.h   | 2 --
 src/dxvk/dxvk_instance.cpp    | 1 +
 src/dxvk/dxvk_instance.h      | 1 +
 4 files changed, 2 insertions(+), 6 deletions(-)

diff --git a/src/dxvk/dxvk_device_info.cpp b/src/dxvk/dxvk_device_info.cpp
--- a/src/dxvk/dxvk_device_info.cpp
+++ b/src/dxvk/dxvk_device_info.cpp
@@ -40,7 +40,6 @@ namespace dxvk {
     HANDLE_EXT(extSampleLocations);                \
     HANDLE_EXT(extShaderModuleIdentifier);         \
     HANDLE_EXT(extShaderStencilExport);            \
-    HANDLE_EXT(extSwapchainColorSpace);            \
     HANDLE_EXT(extSwapchainMaintenance1);          \
     HANDLE_EXT(extTransformFeedback);              \
     HANDLE_EXT(extVertexAttributeDivisor);         \
@@ -998,9 +997,6 @@ namespace dxvk {
       /* Stencil export, used both internally and in client APIs */
       ENABLE_EXT(extShaderStencilExport, false),
 
-      /* HDR color space support */
-      ENABLE_EXT(extSwapchainColorSpace, false),
-
       /* Swapchain maintenance, used to implement proper synchronization
        * and dynamic present modes to avoid swapchain recreation */
       ENABLE_EXT_FEATURE(extSwapchainMaintenance1, swapchainMaintenance1, false),
diff --git a/src/dxvk/dxvk_device_info.h b/src/dxvk/dxvk_device_info.h
--- a/src/dxvk/dxvk_device_info.h
+++ b/src/dxvk/dxvk_device_info.h
@@ -83,7 +83,6 @@ namespace dxvk {
     VkBool32                                                  extSampleLocations              = VK_FALSE;
     VkPhysicalDeviceShaderModuleIdentifierFeaturesEXT         extShaderModuleIdentifier       = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_MODULE_IDENTIFIER_FEATURES_EXT };
     VkBool32                                                  extShaderStencilExport          = VK_FALSE;
-    VkBool32                                                  extSwapchainColorSpace          = VK_FALSE;
     VkPhysicalDeviceSwapchainMaintenance1FeaturesEXT          extSwapchainMaintenance1        = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SWAPCHAIN_MAINTENANCE_1_FEATURES_EXT };
     VkPhysicalDeviceTransformFeedbackFeaturesEXT              extTransformFeedback            = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TRANSFORM_FEEDBACK_FEATURES_EXT };
     VkPhysicalDeviceVertexAttributeDivisorFeaturesEXT         extVertexAttributeDivisor       = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VERTEX_ATTRIBUTE_DIVISOR_FEATURES };
@@ -159,7 +158,6 @@ namespace dxvk {
     VkExtensionProperties extSampleLocations                = vk::makeExtension(VK_EXT_SAMPLE_LOCATIONS_EXTENSION_NAME);
     VkExtensionProperties extShaderModuleIdentifier         = vk::makeExtension(VK_EXT_SHADER_MODULE_IDENTIFIER_EXTENSION_NAME);
     VkExtensionProperties extShaderStencilExport            = vk::makeExtension(VK_EXT_SHADER_STENCIL_EXPORT_EXTENSION_NAME);
-    VkExtensionProperties extSwapchainColorSpace            = vk::makeExtension(VK_EXT_SWAPCHAIN_COLOR_SPACE_EXTENSION_NAME);
     VkExtensionProperties extSwapchainMaintenance1          = vk::makeExtension(VK_EXT_SWAPCHAIN_MAINTENANCE_1_EXTENSION_NAME);
     VkExtensionProperties extTransformFeedback              = vk::makeExtension(VK_EXT_TRANSFORM_FEEDBACK_EXTENSION_NAME);
     VkExtensionProperties extVertexAttributeDivisor         = vk::makeExtension(VK_EXT_VERTEX_ATTRIBUTE_DIVISOR_EXTENSION_NAME);
diff --git a/src/dxvk/dxvk_instance.cpp b/src/dxvk/dxvk_instance.cpp
--- a/src/dxvk/dxvk_instance.cpp
+++ b/src/dxvk/dxvk_instance.cpp
@@ -372,6 +372,7 @@ namespace dxvk {
     return {{
       &extensions.extDebugUtils,
       &extensions.extSurfaceMaintenance1,
+      &extensions.extSwapchainColorSpace,
       &extensions.khrGetSurfaceCapabilities2,
       &extensions.khrSurface,
       &extensions.khrSurfaceMaintenance1,
diff --git a/src/dxvk/dxvk_instance.h b/src/dxvk/dxvk_instance.h
--- a/src/dxvk/dxvk_instance.h
+++ b/src/dxvk/dxvk_instance.h
@@ -28,6 +28,7 @@ namespace dxvk {
   struct DxvkInstanceExtensionInfo {
     VkExtensionProperties extDebugUtils               = vk::makeExtension(VK_EXT_DEBUG_UTILS_EXTENSION_NAME);
     VkExtensionProperties extSurfaceMaintenance1      = vk::makeExtension(VK_EXT_SURFACE_MAINTENANCE_1_EXTENSION_NAME);
+    VkExtensionProperties extSwapchainColorSpace      = vk::makeExtension(VK_EXT_SWAPCHAIN_COLOR_SPACE_EXTENSION_NAME);
     VkExtensionProperties khrGetSurfaceCapabilities2  = vk::makeExtension(VK_KHR_GET_SURFACE_CAPABILITIES_2_EXTENSION_NAME);
     VkExtensionProperties khrSurface                  = vk::makeExtension(VK_KHR_SURFACE_EXTENSION_NAME);
     VkExtensionProperties khrSurfaceMaintenance1      = vk::makeExtension(VK_KHR_SURFACE_MAINTENANCE_1_EXTENSION_NAME);
