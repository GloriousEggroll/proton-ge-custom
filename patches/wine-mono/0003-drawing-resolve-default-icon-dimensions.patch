+		[DllImport ("user32.dll")]
+		private static extern int GetSystemMetrics (int index);
+
+		private static Size DefaultIconSize ()
+		{
+			Size size = new Size (GetSystemMetrics (11), GetSystemMetrics (12));
+			if (size.Width <= 0 || size.Height <= 0 || size.Width >= 240 || size.Height >= 240)
+				Assert.Ignore ("The icon fixture requires dimensions below 240 pixels.");
+			return size;
+		}
+
+		private static byte [] MultiSizeIcon (Size size, bool invalidLargeImage)
+		{
+			Size [] sizes = { size, new Size (size.Width + 16, size.Height + 16) };
+			using (MemoryStream stream = new MemoryStream ()) {
+				using (BinaryWriter writer = new BinaryWriter (stream)) {
+					writer.Write ((ushort) 0);
+					writer.Write ((ushort) 1);
+					writer.Write ((ushort) sizes.Length);
+					int offset = 6 + 16 * sizes.Length;
+					foreach (Size frame in sizes) {
+						int maskSize = ((frame.Width + 31) / 32) * 4 * frame.Height;
+						int length = 40 + frame.Width * frame.Height * 4 + maskSize;
+						writer.Write ((byte) frame.Width);
+						writer.Write ((byte) frame.Height);
+						writer.Write ((byte) 0);
+						writer.Write ((byte) 0);
+						writer.Write ((ushort) 1);
+						writer.Write ((ushort) 32);
+						writer.Write (length);
+						writer.Write (offset);
+						offset += length;
+					}
+					for (int i = 0; i < sizes.Length; i++) {
+						Size frame = sizes [i];
+						if (i == 1 && invalidLargeImage) {
+							writer.Write (new byte [40]);
+						} else {
+							writer.Write (40);
+							writer.Write (frame.Width);
+							writer.Write (frame.Height * 2);
+							writer.Write ((ushort) 1);
+							writer.Write ((ushort) 32);
+							writer.Write (new byte [24]);
+						}
+						for (int pixel = 0; pixel < frame.Width * frame.Height; pixel++)
+							writer.Write (Color.Red.ToArgb ());
+						writer.Write (new byte [((frame.Width + 31) / 32) * 4 * frame.Height]);
+					}
+					return stream.ToArray ();
+				}
+			}
+		}
+
+		private static void CheckDefaultIcon (Icon result, Size expected)
+		{
+			Assert.AreEqual (expected, result.Size, "Size");
+			Assert.AreNotEqual (IntPtr.Zero, result.Handle, "Handle");
+			using (Bitmap bitmap = result.ToBitmap ()) {
+				Assert.AreEqual (expected, bitmap.Size, "Bitmap size");
+				Assert.AreEqual (Color.Red.ToArgb (), bitmap.GetPixel (0, 0).ToArgb (), "Pixel");
+			}
+		}
+
+		[TestCase (true, true)]
+		[TestCase (true, false)]
+		[TestCase (false, true)]
+		[Platform ("Win")]
+		public void Constructor_Stream_ZeroDimensions (bool zeroWidth, bool zeroHeight)
+		{
+			Size size = DefaultIconSize ();
+			using (MemoryStream stream = new MemoryStream (MultiSizeIcon (size, false)))
+			using (Icon result = new Icon (stream, zeroWidth ? 0 : size.Width, zeroHeight ? 0 : size.Height))
+				CheckDefaultIcon (result, size);
+		}
+
+		[Test]
+		[Platform ("Win")]
+		public void Constructor_Icon_ZeroDimensions ()
+		{
+			Size size = DefaultIconSize ();
+			using (MemoryStream stream = new MemoryStream (MultiSizeIcon (size, false)))
+			using (Icon original = new Icon (stream, size))
+			using (Icon result = new Icon (original, Size.Empty))
+				CheckDefaultIcon (result, size);
+		}
+
+		[TestCase (true, false)]
+		[TestCase (false, false)]
+		[TestCase (true, true)]
+		[TestCase (false, true)]
+		[Platform ("Win")]
+		public void Deserialize_DefaultSize (bool includeSize, bool invalidLargeImage)
+		{
+			Size size = DefaultIconSize ();
+			SerializationInfo info = new SerializationInfo (typeof (Icon), new FormatterConverter ());
+			info.AddValue ("IconData", MultiSizeIcon (size, invalidLargeImage), typeof (byte []));
+			if (includeSize)
+				info.AddValue ("IconSize", Size.Empty, typeof (Size));
+			ConstructorInfo constructor = typeof (Icon).GetConstructor (BindingFlags.Instance | BindingFlags.NonPublic,
+				null, new Type [] { typeof (SerializationInfo), typeof (StreamingContext) }, null);
+			using (Icon result = (Icon) constructor.Invoke (new object [] { info, new StreamingContext () }))
+				CheckDefaultIcon (result, size);
+		}
+
+		[Test]
+		[Platform ("Win")]
+		public void Constructor_Stream_ExplicitLargeSize ()
+		{
+			Size size = DefaultIconSize ();
+			Size large = new Size (size.Width + 16, size.Height + 16);
+			using (MemoryStream stream = new MemoryStream (MultiSizeIcon (size, false)))
+			using (Icon result = new Icon (stream, large))
+				CheckDefaultIcon (result, large);
+		}
+
