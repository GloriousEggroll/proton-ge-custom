From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gustavo Belo <gustavo@example.invalid>
Date: Tue, 1 Sep 2026 00:00:00 -0300
Subject: [PATCH] upscalers: add PROTON_FSR2_UPGRADE (FSR2-to-FSR4)

Wires the `fsr2` compat_config flag (PROTON_FSR2_UPGRADE=1) into the
existing FSR4 driver download (amdxcffx64, same as PROTON_FSR4_UPGRADE)
and, once that driver is present, overrides ffx_fsr2_api_x64 to wine's
new builtin translation dll (see the accompanying wine-wayland patch
that adds dlls/ffx_fsr2_api_x64).

Since the driver download is shared with PROTON_FSR4_UPGRADE, the FSR4
version can also be selected through PROTON_FSR2_UPGRADE itself
(PROTON_FSR2_UPGRADE="4.1.1"), matching how the other upscaler options
take a version instead of 1. An explicit PROTON_FSR4_UPGRADE version
still takes precedence.
---
 upscalers.py | 15 +++++++++++++--
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/upscalers.py b/upscalers.py
index 4820a9f..1111111 100644
--- a/upscalers.py
+++ b/upscalers.py
@@ -626,6 +626,11 @@
     xess_version = get_version(env, 'PROTON_XESS_UPGRADE', 'default')
 
     fsr4_version = get_version(env, 'PROTON_FSR4_UPGRADE', 'default')
+    # PROTON_FSR2_UPGRADE reuses the same amdxcffx64 download, so let it pick
+    # the driver version too (PROTON_FSR2_UPGRADE="4.1.1"). An explicit
+    # PROTON_FSR4_UPGRADE version still wins.
+    if fsr4_version == 'default':
+        fsr4_version = get_version(env, 'PROTON_FSR2_UPGRADE', 'default')
 
     ffx3_version = get_version(env, 'PROTON_FFX3_UPGRADE', '1.0.1.41314')
     ffx4_version = get_version(env, 'PROTON_FFX4_UPGRADE', 'default')
@@ -640,7 +645,7 @@
         ('dlss', dlss_version, 'dlss' in compat_config or 'optiscaler' in compat_config),
         ('xess', xess_version, 'xess' in compat_config or 'optiscaler' in compat_config),
         # amdxcffx64 4.1.1
-        ('fsr4', fsr4_version, 'fsr4' in compat_config),
+        ('fsr4', fsr4_version, 'fsr4' in compat_config or 'fsr2' in compat_config),
         # fidelityfx sdk
         ('ffx3', ffx3_version, 'ffx3' in compat_config or 'optiscaler' in compat_config),
         ('ffx4', ffx4_version, 'ffx4' in compat_config),
@@ -665,6 +670,14 @@
     if 'fsr4' in upscaler_replace:
         pass
 
+    if 'fsr2' in compat_config and 'fsr4' in upscaler_replace:
+        # ffx_fsr2_api_x64 is a wine builtin (dlls/ffx_fsr2_api_x64) that
+        # translates the FSR2 context API to FSR4 via amdxcffx64; force it
+        # over the game's own frontend dll.
+        existing = env.get('WINEDLLOVERRIDES', '')
+        override = 'ffx_fsr2_api_x64=b'
+        env['WINEDLLOVERRIDES'] = f'{existing};{override}' if existing else override
+
     if 'dlss' in upscaler_replace:
         env.setdefault(
             'DXVK_NVAPI_DRS_SETTINGS',
