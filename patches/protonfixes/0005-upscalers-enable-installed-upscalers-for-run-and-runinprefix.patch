-    else:
+    elif check_conditions():
         upscalers.setup_upscalers(compat_config, env, compat_dir, prefix_dir)
+    elif check_run_conditions():
+        # run/runinprefix (e.g. a second game in a prefix that is already running): don't
+        # download or replace anything, but enable what a previous launch already installed.
+        log.info('Using installed upscaler files only (no downloads).')
+        upscalers.setup_upscalers(compat_config, env, compat_dir, prefix_dir, install=False)
+    else:
+        log.warn('Skipping upscaler setup. Execution conditions are not satisfied.')
 
 
