+def check_installed(name: str, compat_dir: str, prefix_dir: str) -> bool:
+    """Check that the files a previous setup installed are still in place.
+
+    Only reads the tracking file and the prefix: no manifest download, and
+    nothing is removed or replaced.
+    """
+    sections = {
+        'dlss': __dlss_section,
+        'xess': __xess_section,
+        'fsr4': __fsr4_section,
+        'ffx3': __ffx3_section,
+        'ffx4': __ffx4_section,
+        'optiscaler': __opti_section,
+        'streamline': __nvsl_section,
+    }
+    if name not in sections:
+        return False
+    return __check_installed_section(compat_dir, prefix_dir, sections[name])
+
+
+def __check_installed_section(compat_dir: str, prefix_dir: str, section: str) -> bool:
+    try:
+        tracked_items = __get_tracked_items(compat_dir, section)
+    except Exception:
+        return False
+    if not tracked_items:
+        return False
+
+    for dst, tracked in tracked_items.items():
+        target = os.path.join(prefix_dir, dst)
+        if not os.path.isfile(target) or os.path.islink(target):
+            log.warn(f'Missing file from prefix "{dst}"')
+            return False
+        tracked_md5 = tracked.get('md5_hash')
+        if tracked_md5:
+            with open(target, 'rb') as dst_fd:
+                if hashlib.md5(dst_fd.read()).hexdigest().lower() != tracked_md5.lower():
+                    log.warn(f'MD5 checksum mismatch between tracking file and prefix "{dst}"')
+                    return False
+    return True
+
+
