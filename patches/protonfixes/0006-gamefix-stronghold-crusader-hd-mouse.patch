From: GloriousEggroll <gloriouseggroll@gmail.com>
Subject: [PATCH] gamefix: Stronghold Crusader HD: fix the cursor speed and size

The game moves its cursor from raw mouse deltas, which are not accelerated, so
it is much faster than the desktop pointer without cnc-ddraw. Send the same
accelerated motion as the desktop pointer (WINE_RAW_MOUSE_SCALE=accel).

The 32x32 cursors only look tiny on large panels, so WINE_CURSOR_SCALE=2.0 is
set only when the connected display is at least 1440 pixels tall. Both values
are left alone if the user already set them.
---
diff --git a/gamefixes-steam/40970.py b/gamefixes-steam/40970.py
index 6bd49bb..12b24e5 100755
--- a/gamefixes-steam/40970.py
+++ b/gamefixes-steam/40970.py
@@ -1,10 +1,49 @@
 """Game fix for Stronghold Crusader HD
-Fixes Multiplayer
+Fixes Multiplayer, the too fast mouse cursor and the tiny cursor on large displays
 """
 
+import os
+import re
+
 from protonfixes import util
 
+# Cursors are 32x32 pixels. They only look tiny on large, high-resolution panels,
+# so the cursor is enlarged only when the display is at least this tall.
+CURSOR_SCALE_MIN_HEIGHT = 1440
+CURSOR_SCALE = '2.0'
+
+
+def get_display_height(drm_path: str = '/sys/class/drm') -> int:
+    """Height in pixels of the preferred mode of the first connected display, 0 if unknown"""
+    try:
+        for card in sorted(os.listdir(drm_path)):
+            status = os.path.join(drm_path, card, 'status')
+            modes = os.path.join(drm_path, card, 'modes')
+            if not (os.path.isfile(status) and os.path.isfile(modes)):
+                continue
+            with open(status, encoding='utf-8') as file:
+                if file.read().strip() != 'connected':
+                    continue
+            with open(modes, encoding='utf-8') as file:
+                match = re.match(r'(\d+)x(\d+)', file.readline().strip())
+            if match:
+                return int(match.group(2))
+    except OSError:
+        pass
+    return 0
+
 
 def main() -> None:
-    """Installs directplay"""
+    """Installs directplay and fixes the cursor"""
     util.protontricks('directplay')
+
+    # The game moves its cursor from raw mouse deltas, which are not accelerated, so it is
+    # too fast. Send the same motion as the desktop pointer (needs the winex11
+    # WINE_RAW_MOUSE_SCALE patch). Set the same variable in the launch options to override.
+    if 'WINE_RAW_MOUSE_SCALE' not in os.environ:
+        util.set_environment('WINE_RAW_MOUSE_SCALE', 'accel')
+
+    # Enlarge the cursor on large displays only (needs the winex11 WINE_CURSOR_SCALE patch).
+    # Set the same variable in the launch options to override.
+    if 'WINE_CURSOR_SCALE' not in os.environ and get_display_height() >= CURSOR_SCALE_MIN_HEIGHT:
+        util.set_environment('WINE_CURSOR_SCALE', CURSOR_SCALE)
