     return params._ret;
 }
 
@@ -2457,9 +2471,15 @@ int8_t __thiscall winISteamInput_SteamInput007_Init(struct w_iface *_this, int8_
         .u_iface = _this->u_iface,
         .bExplicitlyCallRunFrame = bExplicitlyCallRunFrame,
