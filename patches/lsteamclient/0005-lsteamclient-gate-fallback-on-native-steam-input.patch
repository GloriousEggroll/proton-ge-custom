 }
 
@@ -3006,6 +3026,7 @@ uint16_t __thiscall winISteamInput_SteamInput007_GetSessionInputConfigurationSet
     };
     TRACE("%p\n", _this);
     STEAMCLIENT_CALL( ISteamInput_SteamInput007_GetSessionInputConfigurationSettings, &params );
