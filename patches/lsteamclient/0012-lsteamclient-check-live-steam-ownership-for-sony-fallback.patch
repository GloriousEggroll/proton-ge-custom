From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Subject: [PATCH] lsteamclient: Use live Steam ownership for Sony fallback.

Match XInput's automatic discovery policy. Steam can export its virtual
gamepad info path and SDL allow hint while per-game Steam Input is disabled.
Those hints must not disable the synthetic Sony identity before probing
for real controllers. Live Steam virtual devices and native Steam API
controllers still take priority; explicit emulation stays unchanged.

This does not enable game-specific action aliases or change Steam settings.
---
diff --git a/lsteamclient/steam_input_manual.c b/lsteamclient/steam_input_manual.c
--- a/lsteamclient/steam_input_manual.c
+++ b/lsteamclient/steam_input_manual.c
@@ -201,21 +201,14 @@ static BOOL steaminput_xinput_explicit_fallback(void)
 
 int steaminput_xinput_fallback_configured(void)
 {
-    static const char * const steam_vars[] =
-    {
-        "SteamVirtualGamepadInfo", "SteamVirtualGamepadInfo_Proton",
-        "SDL_GAMECONTROLLER_ALLOW_STEAM_VIRTUAL_GAMEPAD",
-    };
-    unsigned int i;
     const char *value;
 
     if (steaminput_xinput_explicit_fallback()) return TRUE;
     if (!env_enabled("PROTON_SONY_AUTO_XINPUT")) return FALSE;
     if ((value = getenv("PROTON_EMULATE_STEAMINPUT")) && atoi(value)) return FALSE;
-    if ((value = getenv("PROTON_NO_STEAMINPUT")) && atoi(value)) return TRUE;
-    for (i = 0; i < ARRAY_SIZE(steam_vars); ++i)
-        if ((value = getenv(steam_vars[i])) && *value && strcmp(value, "0")) return FALSE;
+    /* Steam's discovery hints do not establish ownership. refresh_mode() and
+     * native controller enumeration retain priority over synthetic handles. */
     return TRUE;
 }
 
 static BOOL CALLBACK init_native_steam_input_event(INIT_ONCE *once, void *param, void **context)
