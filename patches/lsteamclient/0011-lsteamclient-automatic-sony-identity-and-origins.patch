         return FALSE;
 
-    *index = xinput_index;
+    steaminput006_xinput_get_input_type(&type, input_handle);
+    *index = type ? xinput_index : -1;
+    return TRUE;
+}
+
+int steaminput_xinput_get_action_origin(uint32_t *origin, uint64_t input_handle, uint32_t xbox_origin)
+{
+    /* EInputActionOrigin values from the Steamworks SDK, indexed by EXboxOrigin.
+     * X/Y map to Square/Triangle, not the declaration order Triangle/Square. */
+    static const uint16_t ps4[] =
+    {
+        50, 51, 53, 52, 54, 55, 56, 57, 79, 80, 81, 82, 83, 84,
+        85, 86, 87, 88, 89, 90, 91, 92, 93, 94, 95, 96, 97, 98,
+    };
+    static const uint16_t ps5[] =
+    {
+        258, 259, 261, 260, 262, 263, 264, 265, 288, 289, 290, 291, 292, 293,
+        294, 295, 296, 297, 298, 299, 300, 301, 302, 303, 304, 305, 306, 307,
+    };
+    uint32_t type;
+
+    if (!steaminput006_xinput_get_input_type(&type, input_handle)) return FALSE;
+    *origin = 0;
+    if (xbox_origin >= ARRAY_SIZE(ps4)) return TRUE;
+    if (type == STEAM_INPUT_TYPE_PS4) *origin = ps4[xbox_origin];
+    else if (type == STEAM_INPUT_TYPE_PS5) *origin = ps5[xbox_origin];
+    else if (type == STEAM_INPUT_TYPE_XBOX_ONE) *origin = 114 + xbox_origin;
+    return TRUE;
+}
+
+int steamcontroller_xinput_get_action_origin(uint32_t *origin, uint64_t input_handle, uint32_t xbox_origin)
+{
+    /* The legacy ISteamController enum has a different numbering scheme. */
+    if (!steaminput_xinput_get_action_origin(origin, input_handle, xbox_origin)) return FALSE;
+    if (*origin >= 50 && *origin <= 98) *origin -= 11;
+    else if (*origin >= 114 && *origin <= 141) *origin -= 22;
+    else if (*origin >= 258 && *origin <= 303) *origin -= 13;
+    else if (*origin >= 304 && *origin <= 307) *origin -= 12;
     return TRUE;
 }
 
