-int steaminput_xinput_fallback_configured(void)
+static BOOL steaminput_xinput_explicit_fallback(void)
 {
     return env_enabled("PROTON_STEAMINPUT_FALLBACK") ||
             env_enabled("PROTON_STEAMINPUT_XINPUT_FALLBACK");
+}
+
+int steaminput_xinput_fallback_configured(void)
+{
+    static const char * const steam_vars[] =
+    {
+        "SteamVirtualGamepadInfo", "SteamVirtualGamepadInfo_Proton",
+        "SDL_GAMECONTROLLER_ALLOW_STEAM_VIRTUAL_GAMEPAD",
+    };
+    unsigned int i;
+    const char *value;
+
+    if (steaminput_xinput_explicit_fallback()) return TRUE;
+    if (!env_enabled("PROTON_SONY_AUTO_XINPUT")) return FALSE;
+    if ((value = getenv("PROTON_EMULATE_STEAMINPUT")) && atoi(value)) return FALSE;
+    if ((value = getenv("PROTON_NO_STEAMINPUT")) && atoi(value)) return TRUE;
+    for (i = 0; i < ARRAY_SIZE(steam_vars); ++i)
+        if ((value = getenv(steam_vars[i])) && *value && strcmp(value, "0")) return FALSE;
+    return TRUE;
+}
+
+static BOOL CALLBACK init_native_steam_input_event(INIT_ONCE *once, void *param, void **context)
+{
+    WCHAR name[64];
+
+    swprintf(name, ARRAY_SIZE(name), L"Local\\__wine_xinput_steam_input_%08lx", GetCurrentProcessId());
+    *context = CreateEventW(NULL, TRUE, FALSE, name);
+    return !!*context;
+}
+
+static void steaminput_xinput_native_detected(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    void *event;
+
+    InterlockedExchange(&steaminput_native_session_seen, TRUE);
+    /* Shared by all XInput DLL versions in this process, not other processes. */
+    if (InitOnceExecuteOnce(&once, init_native_steam_input_event, NULL, &event)) SetEvent(event);
 }
 
