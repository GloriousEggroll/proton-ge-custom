 int steaminput006_xinput_get_gamepad_index_for_controller(int32_t *index, uint64_t input_handle)
 {
     int xinput_index;
-
-    if (!steaminput_xinput_fallback_active() ||
-        (xinput_index = xinput_index_from_steam_handle(input_handle)) < 0)
+    uint32_t type;
