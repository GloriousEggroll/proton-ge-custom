From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Subject: [PATCH] lsteamclient: Add Armored Core VI Steam Input actions.

Armored Core VI: Fires of Rubicon (1888160) reads controllers only through
ISteamInput006 and never polls XInput itself. Under PROTON_ENABLE_WAYLAND=1
native Steam Input is unavailable, so the game saw no controller at all.
With PROTON_STEAMINPUT_FALLBACK=1 the fallback enumerated the pad, but none
of the game's action names were known, so every handle stayed unmapped.

Add the game's single action set and its actions from the Xbox One layout
shipped in its steam_input_manifest.vdf / steam_input_for_xboxone_controller.vdf.
Every action is a one-to-one physical binding, so no remapping is involved.
---
diff --git a/lsteamclient/steam_input_manual.c b/lsteamclient/steam_input_manual.c
--- a/lsteamclient/steam_input_manual.c
+++ b/lsteamclient/steam_input_manual.c
@@ -148,6 +148,22 @@
     DIGITAL_BUTTON("MenuLeft", XINPUT_GAMEPAD_DPAD_LEFT),
     DIGITAL_BUTTON("MenuCharacter", XINPUT_GAMEPAD_BACK),
     DIGITAL_BUTTON("MenuExit", XINPUT_GAMEPAD_START),
+
+    /* Armored Core VI: Fires of Rubicon. */
+    DIGITAL_BUTTON("pad_l_up", XINPUT_GAMEPAD_DPAD_UP),
+    DIGITAL_BUTTON("pad_l_down", XINPUT_GAMEPAD_DPAD_DOWN),
+    DIGITAL_BUTTON("pad_l_left", XINPUT_GAMEPAD_DPAD_LEFT),
+    DIGITAL_BUTTON("pad_l_right", XINPUT_GAMEPAD_DPAD_RIGHT),
+    DIGITAL_BUTTON("pad_r_up", XINPUT_GAMEPAD_Y),
+    DIGITAL_BUTTON("pad_r_down", XINPUT_GAMEPAD_A),
+    DIGITAL_BUTTON("pad_r_left", XINPUT_GAMEPAD_X),
+    DIGITAL_BUTTON("pad_r_right", XINPUT_GAMEPAD_B),
+    DIGITAL_BUTTON("pad_c_left", XINPUT_GAMEPAD_BACK),
+    DIGITAL_BUTTON("pad_c_right", XINPUT_GAMEPAD_START),
+    DIGITAL_BUTTON("pad_l_shoulder", XINPUT_GAMEPAD_LEFT_SHOULDER),
+    DIGITAL_BUTTON("pad_r_shoulder", XINPUT_GAMEPAD_RIGHT_SHOULDER),
+    DIGITAL_BUTTON("pad_l_thumb", XINPUT_GAMEPAD_LEFT_THUMB),
+    DIGITAL_BUTTON("pad_r_thumb", XINPUT_GAMEPAD_RIGHT_THUMB),
 };
 
 static struct xinput_analog_action xinput_analog_actions[] =
@@ -163,6 +179,11 @@
     {"right_stick",   0, XINPUT_ANALOG_RIGHT_STICK},
     {"Move",          0, XINPUT_ANALOG_LEFT_STICK},
     {"Camera",         0, XINPUT_ANALOG_RIGHT_STICK},
+    /* Armored Core VI: Fires of Rubicon. */
+    {"left_analog_controls",  0, XINPUT_ANALOG_LEFT_STICK},
+    {"right_analog_controls", 0, XINPUT_ANALOG_RIGHT_STICK},
+    {"pad_l_trigger",         0, XINPUT_ANALOG_LEFT_TRIGGER},
+    {"pad_r_trigger",         0, XINPUT_ANALOG_RIGHT_TRIGGER},
 };
 
 static struct
@@ -174,6 +195,7 @@
     {"GamepadSetting", 0},
     {"GameControls", 0},
     {"MenuControls", 0},
+    {"fnr_controls", 0},
 };
 
 static BOOL env_enabled(const char *name)
