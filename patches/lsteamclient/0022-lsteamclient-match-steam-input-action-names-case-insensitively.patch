From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Tue, 24 Nov 2026 14:00:00 -0500
Subject: [PATCH] lsteamclient: Match Steam Input action names case-insensitively.

Steam resolves action and action set names case-insensitively. God of War
Ragnarok asks for its stick actions as "move" and "camera", while its
manifest and the XInput fallback table use "Move" and "Camera". Steam
returned handles for them, but the fallback's strcmp found no entry, so
GetAnalogActionData never matched a handle and both sticks read zero
while buttons worked.

https://github.com/GloriousEggroll/proton-ge-custom/issues/1004
---
--- a/lsteamclient/steam_input_manual.c
+++ b/lsteamclient/steam_input_manual.c
@@ -78,7 +78,9 @@
 #define DIGITAL_TRIGGER(name, trigger) {name, 0, trigger, 0}
 #define DIGITAL_UNAVAILABLE(name) {name, 0, XINPUT_DIGITAL_UNAVAILABLE, 0}
 
-/* Action aliases used by the supported Steam Input manifests. */
+/* Action aliases used by the supported Steam Input manifests. Steam matches
+ * action and action set names case-insensitively: God of War Ragnarok asks for
+ * "move" and "camera" although its manifest declares "Move" and "Camera". */
 static struct xinput_digital_action xinput_digital_actions[] =
 {
     /* Monster Hunter Wilds. */
@@ -518,7 +520,7 @@
 
     for (i = 0; i < ARRAY_SIZE(xinput_action_sets); ++i)
     {
-        if (strcmp(name, xinput_action_sets[i].name)) continue;
+        if (_stricmp(name, xinput_action_sets[i].name)) continue;
         if (native_handle) xinput_action_sets[i].handle = native_handle;
         if (!steaminput_xinput_fallback_active()) return native_handle;
         if (!xinput_action_sets[i].handle)
@@ -537,7 +539,7 @@
 
     for (i = 0; i < ARRAY_SIZE(xinput_digital_actions); ++i)
     {
-        if (strcmp(name, xinput_digital_actions[i].name)) continue;
+        if (_stricmp(name, xinput_digital_actions[i].name)) continue;
         if (native_handle) xinput_digital_actions[i].handle = native_handle;
         if (!steaminput_xinput_fallback_active()) return native_handle;
         if (!xinput_digital_actions[i].handle)
@@ -606,7 +608,7 @@
 
     for (i = 0; i < ARRAY_SIZE(xinput_analog_actions); ++i)
     {
-        if (strcmp(name, xinput_analog_actions[i].name)) continue;
+        if (_stricmp(name, xinput_analog_actions[i].name)) continue;
         if (native_handle) xinput_analog_actions[i].handle = native_handle;
         if (!steaminput_xinput_fallback_active()) return native_handle;
         if (!xinput_analog_actions[i].handle)
--
