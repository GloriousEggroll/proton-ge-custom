From: GloriousEggroll <gloriouseggroll@gmail.com>
Subject: [PATCH] lsteamclient: Optionally report Steam Deck and Steam Controller as
 Xbox One controllers.

Some games only have prompts for the gamepad types they know. Rune Factory 5
uses ISteamInput002, asks GetInputTypeForHandle() for the device type and
shows keyboard prompts on a Steam Deck or with a Steam Controller.

With PROTON_STEAM_INPUT_XBOX_PROMPTS=1, report native Steam Controller and
Steam Deck handles as k_ESteamInputType_XBoxOneController, and translate
SteamController/SteamDeck action origins returned by Get*ActionOrigins() to
Xbox One origins through the interface's own TranslateActionOrigin(), so
glyph and string lookups return Xbox prompts. Synthetic XInput fallback
handles keep their existing handling.

Update the wrapper generator and checked-in wrappers together.

https://github.com/GloriousEggroll/proton-ge-custom/issues/841
---
--- a/lsteamclient/gen_wrapper.py
+++ b/lsteamclient/gen_wrapper.py
@@ -1185,6 +1185,11 @@
         "ISteamController_SteamController007") else "FALSE"
     session_config_method = None
     connected_controllers_method = None
+    translate_origin_method = None
+
+    if is_steaminput and method.name in ("GetDigitalActionOrigins", "GetAnalogActionOrigins"):
+        translate_origin_method = next((candidate for candidate in klass.methods
+                if candidate.name == "TranslateActionOrigin"), None)
 
     if (is_steaminput or is_legacy_steaminput) and method.name == "Init":
         session_config_method = next((candidate for candidate in klass.methods
@@ -1295,6 +1300,26 @@
             out(u'    params._ret = steaminput006_xinput_register_digital_action( params._ret, pszActionName );\n')
         elif is_steaminput and method.name == "GetAnalogActionHandle":
             out(u'    params._ret = steaminput006_xinput_register_analog_action( params._ret, pszActionName );\n')
+        elif is_steaminput and method.name == "GetInputTypeForHandle":
+            out(u'    params._ret = steaminput_native_input_type( params._ret );\n')
+        elif is_steaminput and method.name in ("GetDigitalActionOrigins", "GetAnalogActionOrigins") and translate_origin_method:
+            out(u'    if (steaminput_report_xbox_identity())\n')
+            out(u'    {\n')
+            out(f'        struct {translate_origin_method.full_name}_params translate_params =\n')
+            out(u'        {\n')
+            out(u'            .u_iface = _this->u_iface,\n')
+            out(u'            .eDestinationInputType = 3, /* k_ESteamInputType_XBoxOneController */\n')
+            out(u'        };\n')
+            out(u'        int32_t i;\n')
+            out(u'\n')
+            out(u'        for (i = 0; i < params._ret; i++)\n')
+            out(u'        {\n')
+            out(u'            if (!steaminput_origin_needs_xbox( originsOut[i] )) continue;\n')
+            out(u'            translate_params.eSourceOrigin = originsOut[i];\n')
+            out(f'            STEAMCLIENT_CALL( {translate_origin_method.full_name}, &translate_params );\n')
+            out(u'            if (translate_params._ret) originsOut[i] = translate_params._ret;\n')
+            out(u'        }\n')
+            out(u'    }\n')
     if method.name in OUTSTR_PARAMS and OUTSTR_PARAMS[method.name] in names:
         out(f'    if ({OUTSTR_PARAMS[method.name]}) *{OUTSTR_PARAMS[method.name]} = get_unix_buffer( params._str );\n')
 
