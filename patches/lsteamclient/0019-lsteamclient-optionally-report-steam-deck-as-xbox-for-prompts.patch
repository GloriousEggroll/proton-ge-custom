+/* Some games only have gamepad prompts for the controller types they know and
+ * fall back to keyboard prompts for a Steam Deck or Steam Controller. With
+ * PROTON_STEAM_INPUT_XBOX_PROMPTS=1, report those native devices as Xbox One
+ * controllers and let Steam translate their action origins to Xbox ones. */
+int steaminput_report_xbox_identity(void)
+{
+    static LONG enabled = -1;
+
+    if (ReadAcquire(&enabled) == -1)
+        InterlockedExchange(&enabled, env_enabled("PROTON_STEAM_INPUT_XBOX_PROMPTS"));
+    return ReadAcquire(&enabled);
+}
+
+uint32_t steaminput_native_input_type(uint32_t type)
+{
+    if (!steaminput_report_xbox_identity()) return type;
+    if (type == STEAM_INPUT_TYPE_STEAM_CONTROLLER || type == STEAM_INPUT_TYPE_STEAM_DECK)
+        return STEAM_INPUT_TYPE_XBOX_ONE;
+    return type;
+}
+
+int steaminput_origin_needs_xbox(uint32_t origin)
+{
+    /* k_EInputActionOrigin_SteamController_* and k_EInputActionOrigin_SteamDeck_* */
+    return (origin >= 1 && origin <= 49) || (origin >= 333 && origin <= 405);
+}
+
 int steamcontroller_xinput_get_action_origin(uint32_t *origin, uint64_t input_handle, uint32_t xbox_origin,
         BOOL legacy_sony)
 {
