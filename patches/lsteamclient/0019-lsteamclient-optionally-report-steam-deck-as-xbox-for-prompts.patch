@@ -31,9 +31,11 @@
 
 enum steam_input_type
 {
+    STEAM_INPUT_TYPE_STEAM_CONTROLLER = 1,
     STEAM_INPUT_TYPE_XBOX_ONE = 3,
     STEAM_INPUT_TYPE_PS4 = 5,
     STEAM_INPUT_TYPE_PS5 = 13,
+    STEAM_INPUT_TYPE_STEAM_DECK = 14,
