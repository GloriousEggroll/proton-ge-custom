From: Mike Lothian <mike@fireburn.co.uk>
Subject: [PATCH] lsteamclient: build with clang and libc++.

Include <wchar.h> before the Wine headers in the Unix-side sources and
parenthesise std::max so a max macro cannot replace it.

From #835; GE moved the wchar.h include from a global -include in
EXTRADEFS to the files that need it.
---
diff --git a/lsteamclient/unix_private.h b/lsteamclient/unix_private.h
index 78e128b..038f988 100644
--- a/lsteamclient/unix_private.h
+++ b/lsteamclient/unix_private.h
@@ -3,6 +3,8 @@
 
 #include <stdarg.h>
 #include <stddef.h>
+/* libc++ needs the C wide-character declarations before the Wine headers. */
+#include <wchar.h>
 
 #include <windef.h>
 #include <winbase.h>
diff --git a/lsteamclient/unixlib.cpp b/lsteamclient/unixlib.cpp
index fb76b27..76f9b5e 100644
--- a/lsteamclient/unixlib.cpp
+++ b/lsteamclient/unixlib.cpp
@@ -1,3 +1,5 @@
+/* libc++ needs the C wide-character declarations before the Wine headers. */
+#include <wchar.h>
 #include "ntstatus.h"
 #define WIN32_NO_STATUS
 #include "unix_private.h"
@@ -875,7 +877,7 @@ static void collapse_path( WCHAR *path, UINT mark )
     for (p = path; *p; p++) if (*p == '/') *p = '\\';
 
     /* collapse duplicate backslashes */
-    next = path + std::max( 1u, mark );
+    next = path + (std::max)( 1u, mark );
     for (p = next; *p; p++) if (*p != '\\' || next[-1] != '\\') *next++ = *p;
     *next = 0;
 
