From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Subject: [PATCH] lsteamclient: Project Sony fallback metadata for older interfaces.

SteamInput001 and SteamController006/007 predate the PS5 input type added
in SDK 151. Grandia's type switch accepts values 1-12; a synthetic PS5
type 13 selects its generic controller icons instead of PlayStation icons.

Project synthetic DualSense/Edge types and Xbox-to-action origins to PS4
metadata only on those old interfaces. Keep PS5 metadata for newer APIs.
Do not rewrite physical IDs or synthetic handles: availability checks must
still reject stale handles on native takeover and controller replacement.
Real Steam handles retain the host Steam implementation.

Update the wrapper generator and checked-in wrappers together.
---
diff --git a/lsteamclient/gen_wrapper.py b/lsteamclient/gen_wrapper.py
index 6e1c520a..876851ae 100755
--- a/lsteamclient/gen_wrapper.py
+++ b/lsteamclient/gen_wrapper.py
@@ -1180,6 +1180,9 @@ def handle_method_c(klass, method, winclassname, out):
     is_legacy_steaminput = klass.full_name in (
         "ISteamController_SteamController006", "ISteamController_SteamController007",
         "ISteamController_SteamController008")
+    legacy_sony = "TRUE" if klass.full_name in (
+        "ISteamInput_SteamInput001", "ISteamController_SteamController006",
+        "ISteamController_SteamController007") else "FALSE"
     session_config_method = None
     connected_controllers_method = None
 
@@ -1249,13 +1252,13 @@ def handle_method_c(klass, method, winclassname, out):
             "    if (steaminput006_xinput_trigger_vibration_extended( inputHandle, usLeftSpeed, usRightSpeed,\n"
             "            usLeftTriggerSpeed, usRightTriggerSpeed )) return;\n",
         "GetInputTypeForHandle":
-            "    if (steaminput006_xinput_get_input_type( &params._ret, inputHandle )) return params._ret;\n",
+            f"    if (steaminput006_xinput_get_input_type( &params._ret, inputHandle, {legacy_sony} )) return params._ret;\n",
         "GetGamepadIndexForController":
             "    if (steaminput006_xinput_get_gamepad_index_for_controller( &params._ret, ulinputHandle )) return params._ret;\n",
         "GetControllerForGamepadIndex":
             "    if (steaminput006_xinput_get_controller_for_gamepad_index( &params._ret, nIndex )) return params._ret;\n",
         "GetActionOriginFromXboxOrigin":
-            "    if (steaminput_xinput_get_action_origin( &params._ret, inputHandle, eOrigin )) return params._ret;\n",
+            f"    if (steaminput_xinput_get_action_origin( &params._ret, inputHandle, eOrigin, {legacy_sony} )) return params._ret;\n",
     }
     if is_steaminput and method.name in steaminput_hooks:
         out(steaminput_hooks[method.name])
diff --git a/lsteamclient/steam_input_manual.c b/lsteamclient/steam_input_manual.c
index 6f0ef881..f7395f64 100644
--- a/lsteamclient/steam_input_manual.c
+++ b/lsteamclient/steam_input_manual.c
@@ -654,7 +654,7 @@ int steaminput006_xinput_trigger_vibration_extended(uint64_t input_handle, uint1
     return steaminput006_xinput_trigger_vibration(input_handle, left, right);
 }
 
-int steaminput006_xinput_get_input_type(uint32_t *type, uint64_t input_handle)
+int steaminput006_xinput_get_input_type(uint32_t *type, uint64_t input_handle, BOOL legacy_sony)
 {
     int index;
     uint32_t handle_type;
@@ -666,6 +666,9 @@ int steaminput006_xinput_get_input_type(uint32_t *type, uint64_t input_handle)
     *type = 0;
     if (steaminput_xinput_controller_available(index, &state) &&
             handle_type == steaminput_xinput_fallback_type(index)) *type = handle_type;
+    /* SteamInput001 and SteamController006/007 predate PS5 types and origins.
+     * Keep the handle's physical identity for ownership and hotplug checks. */
+    if (legacy_sony && *type == STEAM_INPUT_TYPE_PS5) *type = STEAM_INPUT_TYPE_PS4;
     return TRUE;
 }
 
@@ -689,12 +692,13 @@ int steaminput006_xinput_get_gamepad_index_for_controller(int32_t *index, uint64
     if ((xinput_index = xinput_index_from_steam_handle(input_handle)) < 0)
         return FALSE;
 
-    steaminput006_xinput_get_input_type(&type, input_handle);
+    steaminput006_xinput_get_input_type(&type, input_handle, FALSE);
     *index = type ? xinput_index : -1;
     return TRUE;
 }
 
-int steaminput_xinput_get_action_origin(uint32_t *origin, uint64_t input_handle, uint32_t xbox_origin)
+int steaminput_xinput_get_action_origin(uint32_t *origin, uint64_t input_handle, uint32_t xbox_origin,
+        BOOL legacy_sony)
 {
     /* EInputActionOrigin values from the Steamworks SDK, indexed by EXboxOrigin.
      * X/Y map to Square/Triangle, not the declaration order Triangle/Square. */
@@ -710,7 +714,7 @@ int steaminput_xinput_get_action_origin(uint32_t *origin, uint64_t input_handle,
     };
     uint32_t type;
 
-    if (!steaminput006_xinput_get_input_type(&type, input_handle)) return FALSE;
+    if (!steaminput006_xinput_get_input_type(&type, input_handle, legacy_sony)) return FALSE;
     *origin = 0;
     if (xbox_origin >= ARRAY_SIZE(ps4)) return TRUE;
     if (type == STEAM_INPUT_TYPE_PS4) *origin = ps4[xbox_origin];
@@ -719,10 +723,11 @@ int steaminput_xinput_get_action_origin(uint32_t *origin, uint64_t input_handle,
     return TRUE;
 }
 
-int steamcontroller_xinput_get_action_origin(uint32_t *origin, uint64_t input_handle, uint32_t xbox_origin)
+int steamcontroller_xinput_get_action_origin(uint32_t *origin, uint64_t input_handle, uint32_t xbox_origin,
+        BOOL legacy_sony)
 {
     /* The legacy ISteamController enum has a different numbering scheme. */
-    if (!steaminput_xinput_get_action_origin(origin, input_handle, xbox_origin)) return FALSE;
+    if (!steaminput_xinput_get_action_origin(origin, input_handle, xbox_origin, legacy_sony)) return FALSE;
     if (*origin >= 50 && *origin <= 98) *origin -= 11;
     else if (*origin >= 114 && *origin <= 141) *origin -= 22;
     else if (*origin >= 258 && *origin <= 303) *origin -= 13;
