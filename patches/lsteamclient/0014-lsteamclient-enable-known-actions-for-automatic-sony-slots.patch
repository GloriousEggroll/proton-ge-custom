From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Subject: [PATCH] lsteamclient: Supply known actions for automatic Sony fallback.

Automatic Sony slots already supply controller identity, but their known
Steam Input actions were still gated on PROTON_STEAMINPUT_FALLBACK. Ragnarok
therefore enumerated a PS5 controller but received inactive action data when
the per-game forced flags were removed.

Use the existing named action mappings for automatic Sony slots too. Keep
unknown names unmapped, real Steam handles untouched, and action data gated
by live controller availability. Reject stale handles whose physical type no
longer matches after hotplug. Explicit fallback still allows non-Sony slots.
---
diff --git a/lsteamclient/steam_input_manual.c b/lsteamclient/steam_input_manual.c
index f7395f64..267f10d1 100644
--- a/lsteamclient/steam_input_manual.c
+++ b/lsteamclient/steam_input_manual.c
@@ -467,7 +467,7 @@ uint64_t steaminput006_xinput_register_action_set(uint64_t native_handle, const
 {
     unsigned int i;
 
-    if (!steaminput_xinput_explicit_fallback() || !steaminput_xinput_fallback_active() || !name) return native_handle;
+    if (!steaminput_xinput_fallback_active() || !name) return native_handle;
 
     for (i = 0; i < ARRAY_SIZE(xinput_action_sets); ++i)
     {
@@ -485,7 +485,7 @@ uint64_t steaminput006_xinput_register_digital_action(uint64_t native_handle, co
 {
     unsigned int i;
 
-    if (!steaminput_xinput_explicit_fallback() || !steaminput_xinput_fallback_active() || !name) return native_handle;
+    if (!steaminput_xinput_fallback_active() || !name) return native_handle;
 
     for (i = 0; i < ARRAY_SIZE(xinput_digital_actions); ++i)
     {
@@ -514,8 +514,9 @@ int steaminput006_xinput_get_digital_action_data(InputDigitalActionData_t *data,
         return FALSE;
 
     memset(data, 0, sizeof(*data));
-    if (!action_handle || !steaminput_xinput_explicit_fallback()) return TRUE;
+    if (!action_handle) return TRUE;
     if (!steaminput_xinput_controller_available(index, &state)) return TRUE;
+    if (xinput_type_from_steam_handle(input_handle) != steaminput_xinput_fallback_type(index)) return TRUE;
 
     for (i = 0; i < ARRAY_SIZE(xinput_digital_actions); ++i)
     {
@@ -551,7 +552,7 @@ uint64_t steaminput006_xinput_register_analog_action(uint64_t native_handle, con
 {
     unsigned int i;
 
-    if (!steaminput_xinput_explicit_fallback() || !steaminput_xinput_fallback_active() || !name) return native_handle;
+    if (!steaminput_xinput_fallback_active() || !name) return native_handle;
 
     for (i = 0; i < ARRAY_SIZE(xinput_analog_actions); ++i)
     {
@@ -576,8 +577,9 @@ int steaminput006_xinput_get_analog_action_data(InputAnalogActionData_t *data,
         return FALSE;
 
     memset(data, 0, sizeof(*data));
-    if (!action_handle || !steaminput_xinput_explicit_fallback()) return TRUE;
+    if (!action_handle) return TRUE;
     if (!steaminput_xinput_controller_available(index, &state)) return TRUE;
+    if (xinput_type_from_steam_handle(input_handle) != steaminput_xinput_fallback_type(index)) return TRUE;
 
     for (i = 0; i < ARRAY_SIZE(xinput_analog_actions); ++i)
     {
