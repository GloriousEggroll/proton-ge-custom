From: Mike Lothian <mike@fireburn.co.uk>
Subject: [PATCH] vrclient: build with clang and libc++.

Include <wchar.h> before the Wine headers in the Unix-side sources.

From #835; GE moved the include from a global -include in EXTRADEFS to the
files that need it.
---
diff --git a/vrclient_x64/json_converter.cpp b/vrclient_x64/json_converter.cpp
index 3767da4..9e07e18 100644
--- a/vrclient_x64/json_converter.cpp
+++ b/vrclient_x64/json_converter.cpp
@@ -1,5 +1,7 @@
 #include <stdarg.h>
 #include <stddef.h>
+/* libc++ needs the C wide-character declarations before the Wine headers. */
+#include <wchar.h>
 
 #include "ntstatus.h"
 #define WIN32_NO_STATUS
diff --git a/vrclient_x64/unix_private.h b/vrclient_x64/unix_private.h
index cace710..682fc9e 100644
--- a/vrclient_x64/unix_private.h
+++ b/vrclient_x64/unix_private.h
@@ -3,6 +3,8 @@
 
 #include <stdarg.h>
 #include <stddef.h>
+/* libc++ needs the C wide-character declarations before the Wine headers. */
+#include <wchar.h>
 
 #include <windef.h>
 #include <winbase.h>
