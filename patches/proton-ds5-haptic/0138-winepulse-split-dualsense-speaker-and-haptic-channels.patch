From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Tue, 11 Aug 2026 17:55:00 -0600
Subject: [PATCH] winepulse: Preserve DualSense speaker and haptic channels

Death Stranding Director's Cut uses separate channels of a four-channel S16
client for controller audio and haptics. Channels 0 and 1 feed the controller
audio outputs, while channels 2 and 3 carry actuator data. A separately selected
Wwise controller-speaker output may also create a float client.

PipeWire handles the DualSense UCM profile as a native split device. Its hidden
four-channel parent owns the hardware PCM and feeds the public mono speaker
split. Sending Wwise's four-channel float client through that mono endpoint
loses the channel layout before it reaches the controller.

For this split-stream layout, route both four-channel clients through
PipeWire's hidden parent. PipeWire can mix the streams while channels 0 and 1
remain controller audio and channels 2 and 3 remain actuator data. Do not fall
back to direct ALSA when the PipeWire parent is unavailable, since taking the
hardware PCM would remove the speaker sink again.

Keep this alternate classification behind an internal Proton option so other
Sony audio paths retain their established routing and hotplug behavior.
---
 dlls/winepulse.drv/pulse.c | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

--- a/dlls/winepulse.drv/pulse.c
+++ b/dlls/winepulse.drv/pulse.c
@@ -594,6 +594,7 @@
 static BOOL is_dualsense_speaker_sink(const PhysDevice *dev);
 static void pulse_retarget_dualsense_mono_streams(const char *preferred);
 static BOOL use_pipewire_dualsense_haptic_target(void);
+static BOOL use_dualsense_split_audio(void);
 static void pulse_retarget_dualsense_haptic_streams(const char *target);
 static void pulse_retarget_dualsense_haptic_streams_to_alsa(const char *path);
 static char *find_dualsense_haptic_alsa_path(void);
@@ -1336,6 +1337,13 @@
             InterlockedCompareExchange(&g_sony_windows_audio_mode, 0, 0);
 }
 
+static BOOL use_dualsense_split_audio(void)
+{
+    const char *env = getenv("PROTON_DUALSENSE_SPLIT_AUDIO");
+
+    return env && env[0] == '1' && !env[1];
+}
+
 static char *make_pipewire_dualsense_haptic_path(const char *target)
 {
     static const char prefix[] = "pipewire:NODE=";
@@ -2492,7 +2500,8 @@
 {
     PhysDevice *dev;
 
-    if (stream->dataflow != eRender || stream->ss.format != PA_SAMPLE_FLOAT32LE
+    if (stream->dataflow != eRender || (stream->ss.format != PA_SAMPLE_FLOAT32LE
+            && (!use_dualsense_split_audio() || stream->ss.format != PA_SAMPLE_S16LE))
             || stream->ss.rate != 48000 || stream->ss.channels != 4 || !pulse_name || !pulse_name[0])
         return NULL;
 
@@ -3410,7 +3429,7 @@
             TRACE("Routing DualSense stream from %s through ALSA PipeWire target %s.\n",
                     params->device, haptic_alsa_path ? haptic_alsa_path : haptic_target);
         }
-        else
+        else if (!use_dualsense_split_audio())
         {
             haptic_alsa_path = get_dualsense_haptic_alsa_path(params->device, stream);
             if (!haptic_alsa_path)
@@ -3419,6 +3438,9 @@
                     params->device, haptic_alsa_path ? "raw ALSA PCM " : "Pulse device ",
                     haptic_alsa_path ? haptic_alsa_path : params->device);
         }
+        else
+            WARN("No PipeWire parent was found for the DualSense haptic stream from %s.\n",
+                    params->device);
     }
 
     stream->def_period = params->period;
-- 
