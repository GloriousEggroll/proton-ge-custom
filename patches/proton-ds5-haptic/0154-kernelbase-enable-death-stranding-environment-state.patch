From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Thu, 13 Aug 2026 18:15:00 -0600
Subject: [PATCH] kernelbase: Enable Death Stranding controller environment state

Tracing Death Stranding's sound-update graph showed that enabling its
environmental capability callback is not sufficient: the controller-speaker
selection is never submitted to Wwise. The extracted resident bank identifies
0xd517feeb as the controller-speaker state group and 0x2b6e617d as its sole
active state; the graph's 0x2ca33bdb value is Wwise's implicit None state.

Submit the active controller-speaker state after the graph makes its first
known state update, when Wwise and the resident bank are initialized. Preserve
the graph's original state call, retry on a failed Wwise result, and leave the
working BB speaker and haptic streams unchanged.

--- a/dlls/kernelbase/main.c
+++ b/dlls/kernelbase/main.c
@@ -67,6 +67,7 @@ static death_stranding_set_rtpc_value_t death_stranding_set_rtpc_value_original;
 static death_stranding_set_state_t death_stranding_set_state_original;
 static struct death_stranding_rtpc_trace_entry death_stranding_rtpc_trace_entries[256];
 static LONGLONG death_stranding_state_trace_entries[512];
+static LONG death_stranding_controller_state_initialized;
 
 static BOOL WINAPI death_stranding_environment_output_enabled(void)
 {
@@ -104,7 +105,11 @@ static ULONG WINAPI death_stranding_trace_set_rtpc_value(ULONG id, float value,
 
 static ULONG WINAPI death_stranding_trace_set_state(ULONG group, ULONG state)
 {
+    static const ULONG sound_update_graph_group = 0x7a3867ba;
+    static const ULONG controller_speaker_group = 0xd517feeb;
+    static const ULONG controller_speaker_enabled = 0x2b6e617d;
     LONGLONG pair = ((ULONGLONG)group << 32) | state;
+    ULONG controller_result, result;
     unsigned int i;
 
     for (i = 0; i < ARRAY_SIZE(death_stranding_state_trace_entries); ++i)
@@ -117,7 +122,19 @@ static ULONG WINAPI death_stranding_trace_set_state(ULONG group, ULONG state)
         WARN("Death Stranding set new Wwise state pair %#lx -> %#lx.\n", group, state);
         break;
     }
-    return death_stranding_set_state_original(group, state);
+
+    result = death_stranding_set_state_original(group, state);
+    if (group == sound_update_graph_group &&
+            !InterlockedCompareExchange(&death_stranding_controller_state_initialized, TRUE, FALSE))
+    {
+        controller_result = death_stranding_set_state_original(controller_speaker_group,
+                controller_speaker_enabled);
+        WARN("Death Stranding enabled environmental controller-speaker state %#lx -> %#lx: %#lx.\n",
+                controller_speaker_group, controller_speaker_enabled, controller_result);
+        if (controller_result != 1)
+            InterlockedExchange(&death_stranding_controller_state_initialized, FALSE);
+    }
+    return result;
 }
 
 static BYTE *death_stranding_find_registration_callback(BYTE *base, IMAGE_NT_HEADERS *nt,
-- 
