From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Fri, 14 Aug 2026 13:00:00 -0600
Subject: [PATCH] xinput: Expose live Sony product to Steam Input fallback

The standalone Steam Input fallback needs the physical controller family for
each XInput slot so it can advertise the matching Xbox, DualShock 4, or
DualSense action profile. XInputGetCapabilitiesEx deliberately hides Sony
identity from games using the Sony-to-XInput bridge, so it cannot provide that
information without undoing the compatibility behavior expected by games.

Add a private Wine-only query which returns the physical Sony product ID kept
on the live XInput controller object. The value is cleared when the controller
is destroyed and replaced when a hotplugged device is assigned to the slot,
avoiding stale SetupAPI and registry interfaces while leaving the public
XInput identity unchanged.
---
 dlls/xinput1_3/main.c        | 22 ++++++++++++++++++++++
 dlls/xinput1_3/xinput1_3.spec |  1 +
 2 files changed, 23 insertions(+)

diff --git a/dlls/xinput1_3/main.c b/dlls/xinput1_3/main.c
--- a/dlls/xinput1_3/main.c
+++ b/dlls/xinput1_3/main.c
@@ -124,6 +124,7 @@ static HANDLE steam_overlay_event;
 static SRWLOCK state_lock = SRWLOCK_INIT;
 static XINPUT_STATE current_state[XUSER_MAX_COUNT];
 
+DWORD WINAPI __wine_XInputGetSonyProductId(DWORD index, WORD *product_id);
 static USHORT sony_gamepad_product_id(const WCHAR *path);
 
 static void set_current_state(UINT index, const XINPUT_STATE *state)
@@ -1303,6 +1303,27 @@ DWORD WINAPI DECLSPEC_HOTPATCH XInputGetCapabilities(DWORD index, DWORD flags, X
     return ret;
 }
 
+DWORD WINAPI __wine_XInputGetSonyProductId(DWORD index, WORD *product_id)
+{
+    DWORD ret = ERROR_SUCCESS;
+
+    TRACE("index %lu, product_id %p.\n", index, product_id);
+
+    if (index >= XUSER_MAX_COUNT || !product_id) return ERROR_BAD_ARGUMENTS;
+
+    start_update_thread();
+
+    EnterCriticalSection(&xinput_cs);
+    if (!controllers[index].device) update_controller_list();
+    if (!controllers[index].device)
+        ret = ERROR_DEVICE_NOT_CONNECTED;
+    else
+        *product_id = controllers[index].hid.sony_product_id;
+    LeaveCriticalSection(&xinput_cs);
+
+    return ret;
+}
+
 DWORD WINAPI DECLSPEC_HOTPATCH XInputGetDSoundAudioDeviceGuids(DWORD index, GUID *render_guid, GUID *capture_guid)
 {
     DWORD ret;
diff --git a/dlls/xinput1_3/xinput1_3.spec b/dlls/xinput1_3/xinput1_3.spec
--- a/dlls/xinput1_3/xinput1_3.spec
+++ b/dlls/xinput1_3/xinput1_3.spec
@@ -7,3 +7,4 @@
 7 stdcall XInputGetBatteryInformation(long long ptr)
 8 stdcall XInputGetKeystroke(long long ptr)
 100 stdcall XInputGetStateEx(long ptr)
+@ stdcall -private __wine_XInputGetSonyProductId(long ptr)
