From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Fri, 14 Aug 2026 15:00:00 -0600
Subject: [PATCH] xinput: Expose live controller VID and PID privately

lsteamclient must distinguish Steam's 28de:11ff virtual gamepad from physical
controllers when deciding whether native Steam Input or its standalone
fallback owns the current session. Public XInput capabilities are unsuitable:
Wine intentionally rewrites some controller identities for compatibility.

Add a private Wine-only query for the VID and PID parsed from the live XInput
controller path. Like the Sony product query, it follows XInput slot lifetime
and therefore cannot return a stale registry or SetupAPI identity after
hotplugging.
---
 dlls/xinput1_3/main.c         | 29 +++++++++++++++++++++++++++++
 dlls/xinput1_3/xinput1_3.spec |  1 +
 2 files changed, 30 insertions(+)

diff --git a/dlls/xinput1_3/main.c b/dlls/xinput1_3/main.c
--- a/dlls/xinput1_3/main.c
+++ b/dlls/xinput1_3/main.c
@@ -124,6 +124,7 @@ static HANDLE steam_overlay_event;
 static SRWLOCK state_lock = SRWLOCK_INIT;
 static XINPUT_STATE current_state[XUSER_MAX_COUNT];
 
+DWORD WINAPI __wine_XInputGetDeviceVidPid(DWORD index, WORD *vendor_id, WORD *product_id);
 DWORD WINAPI __wine_XInputGetSonyProductId(DWORD index, WORD *product_id);
 static USHORT sony_gamepad_product_id(const WCHAR *path);
 
@@ -1325,6 +1326,34 @@ DWORD WINAPI __wine_XInputGetSonyProductId(DWORD index, WORD *product_id)
     return ret;
 }
 
+DWORD WINAPI __wine_XInputGetDeviceVidPid(DWORD index, WORD *vendor_id, WORD *product_id)
+{
+    UINT vid, pid;
+    DWORD ret = ERROR_SUCCESS;
+
+    TRACE("index %lu, vendor_id %p, product_id %p.\n", index, vendor_id, product_id);
+
+    if (index >= XUSER_MAX_COUNT || !vendor_id || !product_id) return ERROR_BAD_ARGUMENTS;
+
+    start_update_thread();
+
+    EnterCriticalSection(&xinput_cs);
+    if (!controllers[index].device) update_controller_list();
+    if (!controllers[index].device)
+        ret = ERROR_DEVICE_NOT_CONNECTED;
+    else if (swscanf(controllers[index].device_path, L"\\\\?\\HID#VID_%04x&PID_%04x", &vid, &pid) != 2 &&
+            swscanf(controllers[index].device_path, L"\\\\?\\hid#vid_%04x&pid_%04x", &vid, &pid) != 2)
+        ret = ERROR_INVALID_DATA;
+    else
+    {
+        *vendor_id = vid;
+        *product_id = pid;
+    }
+    LeaveCriticalSection(&xinput_cs);
+
+    return ret;
+}
+
 DWORD WINAPI DECLSPEC_HOTPATCH XInputGetDSoundAudioDeviceGuids(DWORD index, GUID *render_guid, GUID *capture_guid)
 {
     DWORD ret;
diff --git a/dlls/xinput1_3/xinput1_3.spec b/dlls/xinput1_3/xinput1_3.spec
--- a/dlls/xinput1_3/xinput1_3.spec
+++ b/dlls/xinput1_3/xinput1_3.spec
@@ -8,3 +8,4 @@
 8 stdcall XInputGetKeystroke(long long ptr)
 100 stdcall XInputGetStateEx(long ptr)
 @ stdcall -private __wine_XInputGetSonyProductId(long ptr)
+@ stdcall -private __wine_XInputGetDeviceVidPid(long ptr ptr)
