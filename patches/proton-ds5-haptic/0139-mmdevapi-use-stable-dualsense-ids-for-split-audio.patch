From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Tue, 11 Aug 2026 20:15:00 -0600
Subject: [PATCH] mmdevapi: Use stable DualSense IDs for split audio

Death Stranding saves its selected secondary Wwise output as a hash of the
MMDevice endpoint ID. The normal Sony hotplug path deliberately creates a new
random MMDevice GUID for every connection, so the saved controller-speaker
selection cannot be resolved after restarting the process.

When the title's split-audio mode is active, derive the endpoint GUID from the
backend device name and flow instead. The live MMDevice and its cache entry are
still destroyed on disconnect; a later connection creates a new object with the
same logical endpoint ID. Keep the default random-ID path for every other game.
---
 dlls/mmdevapi/devenum.c | 44 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

--- a/dlls/mmdevapi/devenum.c
+++ b/dlls/mmdevapi/devenum.c
@@ -118,6 +118,45 @@ static BOOL is_dualsense_backend_name( const char *name )
             strstr( name, "Sony_Interactive_Entertainment" ));
 }
 
+static BOOL use_stable_dualsense_device_ids(void)
+{
+    const char *env = getenv("PROTON_DUALSENSE_SPLIT_AUDIO");
+
+    return env && env[0] == '1' && !env[1];
+}
+
+static DWORD hash_dualsense_device_name(const char *name, EDataFlow flow, DWORD seed)
+{
+    const unsigned char *p = (const unsigned char *)name;
+    DWORD hash = seed;
+
+    while (*p)
+    {
+        hash ^= *p++;
+        hash *= 0x01000193;
+    }
+    hash ^= flow;
+    hash *= 0x01000193;
+    return hash;
+}
+
+static void get_stable_dualsense_device_guid(EDataFlow flow, const char *name, GUID *guid)
+{
+    DWORD hashes[4];
+
+    hashes[0] = hash_dualsense_device_name(name, flow, 0x811c9dc5);
+    hashes[1] = hash_dualsense_device_name(name, flow, 0x9e3779b9);
+    hashes[2] = hash_dualsense_device_name(name, flow, 0x85ebca6b);
+    hashes[3] = hash_dualsense_device_name(name, flow, 0xc2b2ae35);
+
+    guid->Data1 = hashes[0];
+    guid->Data2 = hashes[1];
+    guid->Data3 = (hashes[1] >> 16 & 0x0fff) | 0x5000;
+    memcpy(guid->Data4, &hashes[2], sizeof(hashes[2]));
+    memcpy(guid->Data4 + sizeof(hashes[2]), &hashes[3], sizeof(hashes[3]));
+    guid->Data4[0] = (guid->Data4[0] & 0x3f) | 0x80;
+}
+
 static BOOL device_is_published(const GUID *devguid, EDataFlow flow)
 {
     MMDevice *device;
@@ -349,5 +388,10 @@ static void get_device_guid( EDataFlow flow, const char *dev_name, BOOL create,
         if ((dev = find_device_name_in_cache( dev_name, flow )))
             *guid = dev->guid;
+        else if (use_stable_dualsense_device_ids())
+        {
+            get_stable_dualsense_device_guid( flow, dev_name, guid );
+            if (create) add_device_to_cache( guid, dev_name, flow );
+        }
         else if (create)
         {
             CoCreateGuid( guid );
