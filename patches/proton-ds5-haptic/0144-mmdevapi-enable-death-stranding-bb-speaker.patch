From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Wed, 12 Aug 2026 12:35:00 -0600
Subject: [PATCH] mmdevapi: Enable Death Stranding BB speaker capability

Death Stranding's Wwise::sGetControllerSpeakerEnable callback reports false
until the selected secondary output has finished activating. Wwise queries the
capability while initializing and can retain the false result even though the
controller mastering voice is created shortly afterward. The result is a live
four-channel controller stream whose speaker channels remain silent.

Once Proton has verified the exact executable signatures and installed the
native BB-output selector hook, make this capability callback return true from
startup. The Sony endpoint is exposed and selected for this title before Wwise
creates its engines, so the output is available when an actual BB event plays.

Do not alter Wwise::sGetFootSoundToControllerSpeaker. That PC-only false stub
guards an incomplete environmental-effects path which is unsafe to enable.
---
 dlls/mmdevapi/main.c | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

--- a/dlls/mmdevapi/main.c
+++ b/dlls/mmdevapi/main.c
@@ -291,9 +291,23 @@ static BOOL enable_death_stranding_controller_effects(void)
     FlushInstructionCache(GetCurrentProcess(), selector_call, 5);
     VirtualProtect(selector_call, 5, old_protect, &old_protect);
 
+    if (VirtualProtect(callbacks[1], 11, PAGE_EXECUTE_READWRITE, &old_protect))
+    {
+        callbacks[1][0] = 0xb0; /* mov al, 1 */
+        callbacks[1][1] = 0x01;
+        callbacks[1][2] = 0xc3; /* ret */
+        memset(callbacks[1] + 3, 0x90, 8);
+        FlushInstructionCache(GetCurrentProcess(), callbacks[1], 11);
+        VirtualProtect(callbacks[1], 11, old_protect, &old_protect);
+        TRACE("Enabled Death Stranding's native BB controller-speaker capability at %p.\n",
+                callbacks[1]);
+    }
+    else
+        WARN("Could not enable Death Stranding's native BB controller-speaker capability.\n");
+
     TRACE("Left unsupported Death Stranding environmental speaker callback %p disabled and "
-            "redirected its settings output selector call %p through %p.\n", callbacks[0],
-            selector_call, (void *)death_stranding_select_controller_output);
+            "redirected its settings output selector call %p through %p.\n",
+            callbacks[0], selector_call, (void *)death_stranding_select_controller_output);
     return TRUE;
 }
 
