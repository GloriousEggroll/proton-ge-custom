From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Subject: [PATCH] xinput: Arbitrate Sony fallback using live Steam ownership.

Steam exports its virtual-gamepad info path and SDL allow hint even when
per-game Steam Input is disabled. Sky polls XInput with a native Sony HID
device present, but these hints prevented automatic discovery from running.

Do not treat discovery hints as proof that Steam Input owns the controller.
Keep explicit emulation/compatibility overrides, live virtual-device
detection and the process-local native Steam session event authoritative.
Native HID consumption still withdraws only the matching automatic slot.
---
diff --git a/dlls/xinput1_3/main.c b/dlls/xinput1_3/main.c
--- a/dlls/xinput1_3/main.c
+++ b/dlls/xinput1_3/main.c
@@ -150,21 +150,15 @@ static BOOL automatic_sony_enabled(void)
         "PROTON_SONY_DUALSENSE_AS_DUALSHOCK4", "PROTON_SONY_DUALSHOCK4_V2_AS_V1",
         "PROTON_SONY_DUALSENSE_EDGE_AS_DUALSENSE",
     };
-    static const char * const steam_vars[] =
-    {
-        "SteamVirtualGamepadInfo", "SteamVirtualGamepadInfo_Proton",
-        "SDL_GAMECONTROLLER_ALLOW_STEAM_VIRTUAL_GAMEPAD",
-    };
     const char *value = getenv("PROTON_SONY_AUTO_XINPUT");
     unsigned int i;
 
     if (!value || strcmp(value, "1")) return FALSE;
     for (i = 0; i < ARRAY_SIZE(overrides); ++i)
         if (getenv(overrides[i])) return FALSE;
     if ((value = getenv("PROTON_EMULATE_STEAMINPUT")) && atoi(value)) return FALSE;
-    if ((value = getenv("PROTON_NO_STEAMINPUT")) && atoi(value)) return TRUE;
-    for (i = 0; i < ARRAY_SIZE(steam_vars); ++i)
-        if ((value = getenv(steam_vars[i])) && *value && strcmp(value, "0")) return FALSE;
+    /* Steam exports discovery hints even with per-game Steam Input disabled.
+     * Live virtual devices and the native-session event arbitrate ownership. */
     return TRUE;
 }
 
