From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Sun, 16 Aug 2026 02:30:00 -0600
Subject: [PATCH] ds5: Select complete Windows audio path for raw DS5 nodes

The automatic Sony selector could enter Windows audio mode from MMDevice
activation, but physical endpoint enumeration had already completed by then.
In particular, a controller starting in PipeWire's Direct profile retained a
transient wine-dualsense-hotplug identity and its original endpoint format,
while winepulse only switched the eventual stream to the raw four-channel
transport.  This was only half of the Assassin's Creed path and left native
clients such as Stellar Blade with haptics but no controller speaker output.

Select winepulse's Windows Sony mode as soon as a DualSense or DualSense Edge
raw haptic render node is discovered, before assigning its endpoint ID and
probing its mix format.  The stable wine-sony-hotplug identity and four-channel
Windows format are therefore present in the first endpoint list.  Do not apply
that format to DualShock 4: its audio function is stereo and its motors remain
HID-driven even when it replaces a DS5 in a process that already selected the
Windows Sony mode.

When MMDevAPI receives that Sony endpoint, publish the process-lifetime mode
event and select its canonical Windows endpoint policy before deriving the
GUID or creating endpoint properties.  This makes automatic discovery choose
the complete Assassin's Creed path rather than changing transport after an
application has already consumed the old endpoint.

Automatic mode may still be selected after winebus initialized the HID device.
Honor the same named event when preserving explicit speaker-control output
reports so later trigger, lightbar, or rumble updates cannot disable the USB
internal-speaker route.
---
 dlls/mmdevapi/devenum.c     | 40 ++++++++++++++++++++++++++++++++++++++--
 dlls/winebus.sys/main.c     | 25 ++++++++++++++++++++-----
 dlls/winepulse.drv/pulse.c | 12 +++++++++++-
 3 files changed, 69 insertions(+), 8 deletions(-)

diff --git a/dlls/mmdevapi/devenum.c b/dlls/mmdevapi/devenum.c
index 4ca5aa3..cd5ec73 100644
--- a/dlls/mmdevapi/devenum.c
+++ b/dlls/mmdevapi/devenum.c
@@ -1025,6 +1025,36 @@ static BOOL sony_windows_audio_mode_selected(void)
             sony_windows_audio_mode_event_enabled();
 }
 
+static void select_sony_windows_audio_mode_for_endpoint_discovery(
+        const char *name, EDataFlow flow)
+{
+    HANDLE event;
+
+    /* Only a native DS5/DS5 Edge four-channel Direct node is definitive at
+     * discovery time. Generic Sony names also cover the DS4 stereo device,
+     * whose haptics remain HID reports rather than audio channels. */
+    if (flow != eRender || !name ||
+            (!strstr(name, "Direct__Direct__sink") &&
+             !strstr(name, "#wine-sony-hotplug-0ce6054c") &&
+             !strstr(name, "#wine-sony-hotplug-0df2054c")))
+        return;
+
+    if (!sony_windows_audio_mode_selected() &&
+            !InterlockedCompareExchange(&sony_windows_audio_mode, 1, 0))
+    {
+        event = CreateEventW(NULL, TRUE, TRUE, SONY_WINDOWS_AUDIO_MODE_EVENT);
+        if (!event)
+            WARN("Failed to publish endpoint-discovered Windows Sony audio mode, error %lu.\n",
+                    GetLastError());
+        else
+            sony_windows_audio_mode_event = event;
+        TRACE("Selected Windows Sony audio mode before controller endpoint publication.\n");
+    }
+
+    if (!InterlockedExchange(&sony_windows_controller_names, 1))
+        TRACE("Selected canonical Windows Sony controller endpoint names during discovery.\n");
+}
+
 static BOOL keep_sony_audio_endpoint_visible(void)
 {
     const char *env = getenv("PROTON_KEEP_SONY_AUDIO_ENDPOINT_VISIBLE");
@@ -1784,10 +1808,11 @@ static MMDevice *MMDevice_Create(const WCHAR *name, GUID *id, EDataFlow flow, DW
 
             pv.vt = VT_LPWSTR;
 
-            if (sony_direct_public_name)
-                public_device_iname = sony_direct_public_name;
-            else if (dualsense_mono_endpoint && use_windows_sony_controller_names())
+            if ((dualsense_mono_endpoint || sony_direct_endpoint) &&
+                    use_windows_sony_controller_names())
                 public_device_iname = L"Wireless Controller";
+            else if (sony_direct_public_name)
+                public_device_iname = sony_direct_public_name;
             else
                 public_device_iname = device_iname;
             swprintf(public_friendly_name, ARRAY_SIZE(public_friendly_name), friendly_name_fmt,
@@ -1839,6 +1864,13 @@ static MMDevice *MMDevice_Create(const WCHAR *name, GUID *id, EDataFlow flow, DW
         RegCloseKey(key);
     }
 
+    if ((dualsense_mono_endpoint || sony_direct_endpoint) &&
+            use_windows_sony_controller_names())
+    {
+        device_iname = L"Wireless Controller";
+        swprintf(friendly_name, ARRAY_SIZE(friendly_name), friendly_name_fmt,
+                device_desc, device_iname);
+    }
     MMDevice_Register(guidstr, friendly_name, device_iname,
         device_path.vt == VT_LPWSTR ? device_path.pwszVal : NULL,
         container_id.vt == VT_CLSID ? container_id.puuid : &GUID_NULL,
@@ -2023,6 +2055,7 @@ static void add_endpoints_from_params(struct get_endpoint_ids_params *params, BO
         GUID guid;
         const WCHAR *name = (WCHAR *)((char *)params->endpoints + params->endpoints[i].name);
         const char *dev_name = (char *)params->endpoints + params->endpoints[i].device;
+        select_sony_windows_audio_mode_for_endpoint_discovery(dev_name, params->flow);
         get_device_guid(params->flow, dev_name, TRUE, &guid);
         promote_delayed_dualsense_profile_in_cache(&guid, dev_name, params->flow);
         already_published = device_is_published(&guid, params->flow);
diff --git a/dlls/winebus.sys/main.c b/dlls/winebus.sys/main.c
index d5bc602..3253b61 100644
--- a/dlls/winebus.sys/main.c
+++ b/dlls/winebus.sys/main.c
@@ -762,16 +762,28 @@ static void hidraw_enable_dualsense_usb_haptics(DEVICE_OBJECT *device)
         WARN("Failed to select DualSense USB internal speaker on device %p: %#lx\n", device, io.Status);
 }
 
-static void hidraw_preserve_dualsense_usb_speaker_route(struct device_extension *ext,
-        HID_XFER_PACKET *packet)
+static BOOL use_windows_sony_audio_mode(void)
 {
     const char *raw_haptics = getenv("PROTON_DUALSENSE_HAPTICS_PREFER_NON_EVENT");
     const char *death_stranding = getenv("PROTON_DEATH_STRANDING_CONTROLLER_EFFECTS");
+    HANDLE event;
+    BOOL enabled;
+
+    if ((raw_haptics && raw_haptics[0] == '1' && !raw_haptics[1]) ||
+            (death_stranding && death_stranding[0] == '1' && !death_stranding[1]))
+        return TRUE;
+    if (!(event = OpenEventW(SYNCHRONIZE, FALSE, L"__wine_sony_windows_audio_mode")))
+        return FALSE;
+    enabled = WaitForSingleObject(event, 0) == WAIT_OBJECT_0;
+    CloseHandle(event);
+    return enabled;
+}
+
+static void hidraw_preserve_dualsense_usb_speaker_route(struct device_extension *ext,
+        HID_XFER_PACKET *packet)
+{
     BYTE *report = packet->reportBuffer;
 
-    if ((!raw_haptics || raw_haptics[0] != '1' || raw_haptics[1]) &&
-            (!death_stranding || death_stranding[0] != '1' || death_stranding[1]))
-        return;
     if (!ext->desc.is_hidraw || ext->desc.bus_type == BUS_TYPE_BLUETOOTH)
         return;
     if (!is_dualsense_gamepad(ext->desc.vid, ext->desc.pid))
@@ -790,6 +802,9 @@ static void hidraw_preserve_dualsense_usb_speaker_route(struct device_extension
               DUALSENSE_OUTPUT_VALID_FLAG1_AUDIO_CONTROL2_ENABLE))
         return;
 
+    if (!use_windows_sony_audio_mode())
+        return;
+
     report[DUALSENSE_OUTPUT_VALID_FLAG0_OFFSET] |=
             DUALSENSE_OUTPUT_VALID_FLAG0_SPEAKER_VOLUME_ENABLE |
             DUALSENSE_OUTPUT_VALID_FLAG0_AUDIO_CONTROL_ENABLE;
diff --git a/dlls/winepulse.drv/pulse.c b/dlls/winepulse.drv/pulse.c
index 6a4f87e..d684056 100644
--- a/dlls/winepulse.drv/pulse.c
+++ b/dlls/winepulse.drv/pulse.c
@@ -1442,7 +1442,12 @@ static void apply_windows_sony_audio_format(PhysDevice *dev)
 {
     WAVEFORMATEX *wfx = &dev->fmt.Format;
 
-    if (!use_windows_sony_controller_names() || !is_dualsense_speaker_sink(dev))
+    /* DualShock 4 exposes a normal stereo speaker plus HID motor rumble. A
+     * process may already have selected the DualSense four-channel path before
+     * a DS4 is hotplugged, but that must not turn the DS4 endpoint into a fake
+     * quad haptic device. */
+    if (!use_windows_sony_controller_names() || !is_dualsense_speaker_sink(dev) ||
+            is_dualshock_audio_device(dev))
         return;
 
     /* Windows exposes the DualSense USB audio function as a four-channel
@@ -1632,6 +1637,10 @@ static void pulse_add_device(struct list *list, EDataFlow flow, pa_proplist *pro
         }
     }
     memcpy(dev->pulse_name, pulse_name, len + 1);
+    if (dev->flow == eRender && is_dualsense_audio_device(dev) &&
+            !is_dualshock_audio_device(dev) && dev->raw_haptic_target &&
+            !InterlockedExchange(&g_sony_windows_audio_mode, 1))
+        TRACE("Selected Windows Sony audio mode during physical endpoint discovery.\n");
     if (!pulse_set_endpoint_id(dev))
     {
         pulse_dev_free(dev);
-- 
2.55.0
