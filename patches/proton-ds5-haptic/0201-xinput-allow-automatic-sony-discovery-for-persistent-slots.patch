From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Subject: [PATCH] xinput: Allow automatic Sony discovery with persistent player one.

Castlevania's persistent-player-one workaround keeps the logical slot
connected but must not disable physical Sony discovery. Without the forced
Sony translation flag, the game polled a permanently empty placeholder.

Allow automatic discovery alongside the persistent slot. Populate its state
from the ownership-checked snapshot, not the raw cached input, and keep it
neutral when the physical slot is unavailable or the overlay owns input.
Native HID takeover and real Steam Input retain their existing priority.
---
diff --git a/dlls/xinput1_3/main.c b/dlls/xinput1_3/main.c
index 4aec4220..49facd58 100644
--- a/dlls/xinput1_3/main.c
+++ b/dlls/xinput1_3/main.c
@@ -146,7 +146,7 @@ static BOOL automatic_sony_enabled(void)
 {
     static const char * const overrides[] =
     {
-        "PROTON_SONY_HIDRAW_XINPUT", "PROTON_XINPUT_PERSISTENT_PLAYER1",
+        "PROTON_SONY_HIDRAW_XINPUT",
         "PROTON_SONY_DUALSENSE_AS_DUALSHOCK4", "PROTON_SONY_DUALSHOCK4_V2_AS_V1",
         "PROTON_SONY_DUALSENSE_EDGE_AS_DUALSENSE",
     };
@@ -224,7 +224,7 @@ static void get_persistent_state(XINPUT_STATE *state, BOOL suppress_input)
     XINPUT_GAMEPAD gamepad = {0};
 
     AcquireSRWLockExclusive(&state_lock);
-    if (!suppress_input) gamepad = current_state[0].Gamepad;
+    if (!suppress_input) gamepad = state->Gamepad;
     if (!persistent_state.dwPacketNumber || memcmp(&persistent_state.Gamepad, &gamepad, sizeof(gamepad)))
     {
         persistent_state.Gamepad = gamepad;
@@ -1224,7 +1224,8 @@ done:
     {
         /* Keep the logical state separate: a placeholder must not hide device
          * removal from discovery or reset its packet number on reconnection. */
-        get_persistent_state(state, WaitForSingleObject(steam_overlay_event, 0) == WAIT_OBJECT_0);
+        get_persistent_state(state, ret != ERROR_SUCCESS ||
+                WaitForSingleObject(steam_overlay_event, 0) == WAIT_OBJECT_0);
         return ERROR_SUCCESS;
     }
     if (ret == ERROR_SUCCESS && WaitForSingleObject(steam_overlay_event, 0) == WAIT_OBJECT_0)
