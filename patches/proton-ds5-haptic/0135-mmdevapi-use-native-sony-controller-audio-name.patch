From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Tue, 11 Aug 2026 15:20:00 -0600
Subject: [PATCH] mmdevapi: Use native Sony controller audio endpoint name

Games using Wwise and similar audio middleware can identify the controller
speaker by matching the Windows endpoint name "Wireless Controller".  Keep
the model-specific Pulse description as the internal driver name because the
Sony hotplug path uses it to distinguish DualShock, DualSense, and DualSense
Edge endpoints, but publish the native Windows name through MMDevAPI when the
Windows Sony audio path is selected.

This also avoids exposing PipeWire descriptions longer than the limits used
by some audio middleware without changing endpoint IDs, container IDs, PnP
registration, or hotplug bookkeeping.
---
 dlls/mmdevapi/devenum.c | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/dlls/mmdevapi/devenum.c b/dlls/mmdevapi/devenum.c
--- a/dlls/mmdevapi/devenum.c
+++ b/dlls/mmdevapi/devenum.c
@@ -821,6 +821,15 @@ static BOOL keep_sony_audio_endpoint_visible(void)
             sony_windows_audio_mode_event_enabled();
 }
 
+static BOOL use_windows_sony_controller_names(void)
+{
+    const char *env = getenv("PROTON_SONY_WINDOWS_DEVICE_NAMES");
+
+    return (env && env[0] == '1' && !env[1]) ||
+            InterlockedCompareExchange(&sony_windows_audio_mode, 0, 0) ||
+            sony_windows_audio_mode_event_enabled();
+}
+
 static BOOL is_dualsense_mono_endpoint_name(const WCHAR *name)
 {
     if (!name)
@@ -1540,6 +1549,8 @@ static MMDevice *MMDevice_Create(const WCHAR *name, GUID *id, EDataFlow flow, D
         if (!RegCreateKeyExW(key, L"Properties", 0, NULL, 0, KEY_WRITE|KEY_READ|KEY_WOW64_64KEY, NULL, &keyprop, NULL))
         {
             PROPVARIANT pv;
+            const WCHAR *public_device_iname;
+            WCHAR public_friendly_name[FRIENDLY_NAME_MAX];
 
             if (SUCCEEDED(set_driver_prop_value(id, flow, &devicepath_key))) {
                 if (SUCCEEDED(MMDevice_GetPropValue(id, flow, &devicepath_key, &device_path)) && device_path.vt == VT_LPWSTR) {
@@ -1552,10 +1563,15 @@ static MMDevice *MMDevice_Create(const WCHAR *name, GUID *id, EDataFlow flow, D
 
             pv.vt = VT_LPWSTR;
 
-            pv.pwszVal = friendly_name;
+            public_device_iname = dualsense_mono_endpoint && use_windows_sony_controller_names() ?
+                    L"Wireless Controller" : device_iname;
+            swprintf(public_friendly_name, ARRAY_SIZE(public_friendly_name), friendly_name_fmt,
+                    device_desc, public_device_iname);
+
+            pv.pwszVal = public_friendly_name;
             MMDevice_SetPropValue(id, flow, (const PROPERTYKEY*)&DEVPKEY_Device_FriendlyName, &pv);
 
-            pv.pwszVal = (LPWSTR)device_iname;
+            pv.pwszVal = (LPWSTR)public_device_iname;
             MMDevice_SetPropValue(id, flow, (const PROPERTYKEY*)&DEVPKEY_DeviceInterface_FriendlyName, &pv);
 
             pv.pwszVal = (LPWSTR)device_desc;
