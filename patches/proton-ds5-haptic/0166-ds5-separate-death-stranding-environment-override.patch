From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Sat, 15 Aug 2026 06:00:00 -0600
Subject: [PATCH] ds5: Separate Death Stranding environment override

Death Stranding Director's Cut needs Wine to enable and route its hidden
environmental controller-speaker path. Death Stranding 2 exposes that path as
a native in-game option and should retain the user's choice instead of having
the Director's Cut binary hooks applied implicitly by the shared controller
effects mode.

Add a dedicated opt-in for the game-side environmental capability and Wwise
routing hooks. Keep the common controller endpoint, speaker, and haptic setup
under PROTON_DEATH_STRANDING_CONTROLLER_EFFECTS so both games can use either
Sony audio profile.
---
 dlls/kernelbase/main.c |  8 ++++----
 dlls/mmdevapi/main.c   | 20 ++++++++++++++++----
 2 files changed, 20 insertions(+), 8 deletions(-)

diff --git a/dlls/kernelbase/main.c b/dlls/kernelbase/main.c
--- a/dlls/kernelbase/main.c
+++ b/dlls/kernelbase/main.c
@@ -38,9 +38,9 @@ WINE_DEFAULT_DEBUG_CHANNEL(kernelbase);
 BOOL is_wow64 = FALSE;
 
 #ifdef __x86_64__
-static BOOL death_stranding_controller_effects_enabled(void)
+static BOOL death_stranding_environment_effects_enabled(void)
 {
-    static const WCHAR nameW[] = L"PROTON_DEATH_STRANDING_CONTROLLER_EFFECTS";
+    static const WCHAR nameW[] = L"PROTON_DEATH_STRANDING_FORCE_ENVIRONMENT_EFFECTS";
     WCHAR buffer[2];
     UNICODE_STRING name, value;
 
@@ -829,7 +829,7 @@ static void trace_death_stranding_environment_audio(void)
     LONG displacement;
     unsigned int i;
 
-    if (!death_stranding_controller_effects_enabled() || !(nt = RtlImageNtHeader(module)) ||
+    if (!death_stranding_environment_effects_enabled() || !(nt = RtlImageNtHeader(module)) ||
             nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC)
         return;
 
@@ -1024,7 +1024,7 @@ static void enable_death_stranding_environment_audio(void)
     ULONG old_protect;
     NTSTATUS status;
 
-    if (!death_stranding_controller_effects_enabled() || !(nt = RtlImageNtHeader( module )) ||
+    if (!death_stranding_environment_effects_enabled() || !(nt = RtlImageNtHeader( module )) ||
             nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC)
         return;
 
diff --git a/dlls/mmdevapi/main.c b/dlls/mmdevapi/main.c
--- a/dlls/mmdevapi/main.c
+++ b/dlls/mmdevapi/main.c
@@ -67,6 +67,14 @@ static void *death_stranding_environment_original_callback;
 static LONG death_stranding_environment_callback_updated;
 static LONG death_stranding_environment_scan_in_progress;
 
+static BOOL force_death_stranding_environment_effects(void)
+{
+    WCHAR value[2];
+
+    return GetEnvironmentVariableW(L"PROTON_DEATH_STRANDING_FORCE_ENVIRONMENT_EFFECTS",
+            value, ARRAY_SIZE(value)) == 1 && value[0] == '1';
+}
+
 static BOOL WINAPI death_stranding_environment_output_enabled(void)
 {
     static LONG logged;
@@ -183,6 +191,8 @@ static BOOL death_stranding_update_environment_callback(void)
     BYTE *entry;
     unsigned int i;
 
+    if (!force_death_stranding_environment_effects())
+        return FALSE;
     if (InterlockedCompareExchange(&death_stranding_environment_callback_updated, 0, 0))
         return TRUE;
     if (!death_stranding_environment_name ||
@@ -676,7 +686,7 @@ static BOOL enable_death_stranding_controller_effects(void)
     FlushInstructionCache(GetCurrentProcess(), output_switch + 0xa0, sizeof(output_switch_new));
     VirtualProtect(output_switch + 0xa0, sizeof(output_switch_old), old_protect, &old_protect);
 
-    if (!environment_registered_early)
+    if (force_death_stranding_environment_effects() && !environment_registered_early)
     {
         relative_offset = (BYTE *)death_stranding_environment_output_enabled - (callback_loads[0] + 7);
         jump_offset = (INT32)relative_offset;
@@ -693,12 +703,14 @@ static BOOL enable_death_stranding_controller_effects(void)
         registered_callback_updated = death_stranding_update_environment_callback();
     }
 
-    TRACE("Enabled Death Stranding environmental speaker registration %p using callback %p; "
-            "early registration enabled %d, existing runtime entry updated %d, "
+    TRACE("Enabled Death Stranding controller output; environmental speaker override %d "
+            "at registration %p using callback %p; early registration enabled %d, "
+            "existing runtime entry updated %d, "
             "pre-applied output selection through %p and UI stores %p/%p, "
             "redirected its final selector call %p through %p, and corrected its Wwise "
             "output transition at %p.\n",
-            callback_loads[0], callbacks[0], environment_registered_early,
+            force_death_stranding_environment_effects(), callback_loads[0], callbacks[0],
+            environment_registered_early,
             registered_callback_updated,
             (void *)death_stranding_prepare_controller_output_thunk,
             output_stores[0], output_stores[1], selector_call,
-- 
2.55.0
