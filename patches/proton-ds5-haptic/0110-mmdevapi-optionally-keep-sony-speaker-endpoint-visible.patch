From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Wed, 5 Aug 2026 12:00:00 -0600
Subject: [PATCH] mmdevapi: Optionally keep Sony speaker endpoint visible

Some Ubisoft games probe every active render endpoint before selecting the
Sony controller speaker.  Hiding the mono endpoint as soon as the probe
activates IAudioClient removes it before the game can initialize its controller
audio and haptic streams.  The game then continuously polls the endpoint
collection waiting for the speaker to return.

Add an opt-in compatibility mode that leaves the active Sony mono endpoint in
endpoint collections after activation.  Keep the existing hide-on-activation
behavior by default for games whose endpoint scanners cannot tolerate the
one-channel controller speaker.
---
 dlls/mmdevapi/devenum.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/dlls/mmdevapi/devenum.c b/dlls/mmdevapi/devenum.c
--- a/dlls/mmdevapi/devenum.c
+++ b/dlls/mmdevapi/devenum.c
@@ -803,6 +803,13 @@ static BOOL use_windows_sony_controller_names(void)
     return env && env[0] == '1' && !env[1];
 }
 
+static BOOL keep_sony_audio_endpoint_visible(void)
+{
+    const char *env = getenv("PROTON_KEEP_SONY_AUDIO_ENDPOINT_VISIBLE");
+
+    return env && env[0] == '1' && !env[1];
+}
+
 static BOOL is_dualsense_mono_endpoint_name(const WCHAR *name)
 {
     if (!name)
@@ -2041,7 +2048,8 @@ static HRESULT WINAPI MMDevice_Activate(IMMDevice *iface, REFIID riid, DWORD cls
             IsEqualIID(riid, &IID_IAudioClient3))
     {
         hr = AudioClient_Create(&This->devguid, iface, (IAudioClient**)ppv);
-        if (SUCCEEDED(hr) && is_dualsense_mono_endpoint(This))
+        if (SUCCEEDED(hr) && is_dualsense_mono_endpoint(This) &&
+                !keep_sony_audio_endpoint_visible())
         {
             TRACE("Hiding activated DualSense mono endpoint %s from endpoint collections.\n",
                     debugstr_guid(&This->devguid));
-- 
