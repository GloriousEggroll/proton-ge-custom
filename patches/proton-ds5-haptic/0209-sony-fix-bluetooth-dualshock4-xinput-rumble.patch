From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ilyasbounoua <bounoua.ilyas@outlook.com>
Date: Sat, 17 Oct 2026 23:30:00 +0200
Subject: [PATCH] Sony: Fix Bluetooth DualShock 4 rumble through the XInput fallback

Bluetooth Sony controllers declare several output reports, so
OutputReportByteLength is the largest one (547 bytes for a DS4) instead of
the 78-byte rumble report. The fallback rejected it. Accept larger lengths
and send the 78-byte report, hidclass checks the length per report ID.

Once a valid Bluetooth output report is sent, the controller switches to its
extended input report. winebus then disabled the report fixup, so the XInput
fallback stopped reading buttons and axes. Keep the fixup when the output
report comes from the XInput fallback.

services.exe starts drivers with a clean environment, so winebus never saw
PROTON_SONY_HIDRAW_XINPUT and the other variables it reads on its PE side.
Preserve them.

GE changes (GloriousEggroll):
- Instead of keeping the fixup whenever PROTON_SONY_AUTO_XINPUT=1 (the
  default), hidclass forwards output reports from the registered XInput
  fallback as IOCTL_HID_WINE_SET_XINPUT_OUTPUT_REPORT, and only those skip
  hidraw_disable_report_fixups(). Native hidraw consumers on Bluetooth still
  switch the controller to the extended report (gyro, touchpad).
- Also preserve PROTON_DUALSENSE_HAPTICS_PREFER_NON_EVENT and
  PROTON_DEATH_STRANDING_CONTROLLER_EFFECTS, which winebus reads the same way.
---
diff --git a/dlls/hidclass.sys/device.c b/dlls/hidclass.sys/device.c
index 57c13b8..4c3e386 100644
--- a/dlls/hidclass.sys/device.c
+++ b/dlls/hidclass.sys/device.c
@@ -613,8 +613,16 @@ static NTSTATUS hid_device_xfer_report( struct phys_device *pdo, ULONG code, IRP
     case IOCTL_HID_WRITE_REPORT:
         params->padding = 1 - offset;
         /* fallthrough */
-    case IOCTL_HID_SET_FEATURE:
     case IOCTL_HID_SET_OUTPUT_REPORT:
+    {
+        struct hid_queue *queue = irp->Tail.Overlay.OriginalFileObject->FsContext;
+
+        /* let winebus know the rumble comes from the XInput fallback, which
+         * relies on Bluetooth Sony controllers staying in basic report mode */
+        if (queue && queue->takeover_event) code = IOCTL_HID_WINE_SET_XINPUT_OUTPUT_REPORT;
+    }
+        /* fallthrough */
+    case IOCTL_HID_SET_FEATURE:
         params->packet.reportBufferLen = report_len - offset;
         irp = IoBuildDeviceIoControlRequest( code, pdo->parent_fdo, NULL, sizeof(params->packet),
                                              &params->packet, 0, TRUE, NULL, NULL );
diff --git a/dlls/winebus.sys/main.c b/dlls/winebus.sys/main.c
index 46483c7..0948a74 100644
--- a/dlls/winebus.sys/main.c
+++ b/dlls/winebus.sys/main.c
@@ -39,6 +39,7 @@
 #include "wine/list.h"
 #include "wine/server.h"
 #include "wine/unixlib.h"
+#include "wine/hid.h"
 
 #include "unixlib.h"
 
@@ -2872,6 +2873,7 @@ static NTSTATUS WINAPI hid_internal_dispatch(DEVICE_OBJECT *device, IRP *irp)
         }
         case IOCTL_HID_SET_OUTPUT_REPORT:
         case IOCTL_HID_WRITE_REPORT:
+        case IOCTL_HID_WINE_SET_XINPUT_OUTPUT_REPORT:
         {
             HID_XFER_PACKET *packet = (HID_XFER_PACKET *)irp->UserBuffer;
             HID_XFER_PACKET fixed_packet;
@@ -2910,7 +2912,10 @@ static NTSTATUS WINAPI hid_internal_dispatch(DEVICE_OBJECT *device, IRP *irp)
                 packet = &fixed_packet;
             hidraw_preserve_dualsense_usb_speaker_route(ext, packet);
             unix_device_set_output_report(device, packet, &irp->IoStatus);
-            if (!irp->IoStatus.Status) hidraw_disable_report_fixups(device);
+            /* The XInput fallback reads the translated basic report, so its rumble
+             * must not switch a Bluetooth controller to the extended report. */
+            if (!irp->IoStatus.Status && code != IOCTL_HID_WINE_SET_XINPUT_OUTPUT_REPORT)
+                hidraw_disable_report_fixups(device);
             break;
         }
         case IOCTL_HID_GET_FEATURE:
diff --git a/dlls/winehid.sys/main.c b/dlls/winehid.sys/main.c
index ca549ab..5aacafd 100644
--- a/dlls/winehid.sys/main.c
+++ b/dlls/winehid.sys/main.c
@@ -28,6 +28,7 @@
 #include "winioctl.h"
 #include "ddk/wdm.h"
 #include "ddk/hidport.h"
+#include "wine/hid.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(hid);
@@ -54,6 +55,7 @@ static NTSTATUS WINAPI internal_ioctl(DEVICE_OBJECT *device, IRP *irp)
     case IOCTL_HID_WRITE_REPORT:
     case IOCTL_HID_GET_FEATURE:
     case IOCTL_HID_SET_FEATURE:
+    case IOCTL_HID_WINE_SET_XINPUT_OUTPUT_REPORT:
         /* All these are handled by the lower level driver */
         IoSkipCurrentIrpStackLocation(irp);
         return IoCallDriver(((HID_DEVICE_EXTENSION *)device->DeviceExtension)->NextDeviceObject, irp);
diff --git a/dlls/xinput1_3/main.c b/dlls/xinput1_3/main.c
index 57f239e..748d3cc 100644
--- a/dlls/xinput1_3/main.c
+++ b/dlls/xinput1_3/main.c
@@ -413,8 +413,9 @@ static DWORD sony_HID_set_state(struct xinput_controller *controller, XINPUT_VIB
             report[4] = motor_right;
             report[5] = motor_left;
         }
-        else if (report_len == SONY_DUALSHOCK4_BT_REPORT_SIZE)
+        else if (report_len >= SONY_DUALSHOCK4_BT_REPORT_SIZE)
         {
+            report_len = SONY_DUALSHOCK4_BT_REPORT_SIZE;
             report[0] = SONY_DUALSHOCK4_BT_REPORT_ID;
             report[1] = SONY_DUALSHOCK4_BT_HW_CONTROL;
             report[3] = 0x01; /* motor update valid */
@@ -439,8 +440,9 @@ static DWORD sony_HID_set_state(struct xinput_controller *controller, XINPUT_VIB
             report[4] = motor_left;
             report[39] = 0x04; /* compatible vibration v2 */
         }
-        else if (report_len == SONY_DUALSENSE_BT_REPORT_SIZE)
+        else if (report_len >= SONY_DUALSENSE_BT_REPORT_SIZE)
         {
+            report_len = SONY_DUALSENSE_BT_REPORT_SIZE;
             report[0] = SONY_DUALSENSE_BT_REPORT_ID;
             report[1] = (controller->hid.sony_output_seq++ & 0x0f) << 4;
             report[2] = SONY_DUALSENSE_BT_TAG;
diff --git a/include/wine/hid.h b/include/wine/hid.h
index 3e23d41..6cdb189 100644
--- a/include/wine/hid.h
+++ b/include/wine/hid.h
@@ -245,6 +245,8 @@ struct hid_preparsed_data
 #define IOCTL_HID_WINE_REGISTER_XINPUT_FALLBACK    HID_BUFFER_CTL_CODE(301)
 #define IOCTL_HID_WINE_NATIVE_INPUT_ACTIVITY       HID_BUFFER_CTL_CODE(302)
 #define IOCTL_HID_WINE_MARK_DINPUT_READER          HID_BUFFER_CTL_CODE(303)
+/* internal: output report sent by the registered Sony XInput fallback */
+#define IOCTL_HID_WINE_SET_XINPUT_OUTPUT_REPORT    HID_IN_CTL_CODE(304)
 
 /* Fixed-width handle for WOW64 callers. The driver duplicates the event. */
 struct hid_xinput_fallback_registration
diff --git a/programs/services/services.c b/programs/services/services.c
index 10a059d..35bdf16 100644
--- a/programs/services/services.c
+++ b/programs/services/services.c
@@ -1040,6 +1040,10 @@ found:
             L"WINEBOOTSTRAPMODE",
             L"PROTON_DISABLE_HIDRAW",
             L"PROTON_ENABLE_HIDRAW",
+            L"PROTON_SONY_AUTO_XINPUT",
+            L"PROTON_SONY_HIDRAW_XINPUT",
+            L"PROTON_DUALSENSE_HAPTICS_PREFER_NON_EVENT",
+            L"PROTON_DEATH_STRANDING_CONTROLLER_EFFECTS",
             L"FEX_APP_DATA_LOCATION",
             L"FEX_APP_CONFIG_LOCATION",
             L"FEX_APP_CONFIG",
