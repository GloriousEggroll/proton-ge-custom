From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Sun, 16 Aug 2026 16:35:00 -0600
Subject: [PATCH] mmdevapi: Preserve native Sony speaker identity on discovery

Early discovery of a DualSense Direct node is enough to select the raw
four-channel transport, but it does not prove that the application uses the
canonical Windows endpoint naming convention.  Conflating those decisions
renamed native controller-speaker endpoints to "Wireless Controller" before
the application enumerated them.

Native Sony clients use the model-specific audio endpoint identity to enable
their controller-speaker mix.  Stellar Blade consequently opened a valid DS4
speaker endpoint but submitted only silence, and on DS5 opened only its
four-channel haptic stream with silent speaker channels.

Keep selecting and publishing Windows Sony transport mode during physical
endpoint discovery, while leaving endpoint naming to an explicit option,
Death Stranding mode, or the existing complete capability-sweep detector.
Restore model-specific public names for Direct endpoints and avoid replacing
their PnP identity solely because the transport was selected.  This does not
change DS4 motor reports or DS5 haptic-channel routing.
---
 dlls/mmdevapi/devenum.c | 21 ++++++---------------
 1 file changed, 6 insertions(+), 15 deletions(-)

diff --git a/dlls/mmdevapi/devenum.c b/dlls/mmdevapi/devenum.c
--- a/dlls/mmdevapi/devenum.c
+++ b/dlls/mmdevapi/devenum.c
@@ -1050,9 +1050,9 @@ static void select_sony_windows_audio_mode_for_endpoint_discovery(
             sony_windows_audio_mode_event = event;
         TRACE("Selected Windows Sony audio mode before controller endpoint publication.\n");
     }
-
-    if (!InterlockedExchange(&sony_windows_controller_names, 1))
-        TRACE("Selected canonical Windows Sony controller endpoint names during discovery.\n");
+
+    /* Transport discovery alone does not identify the endpoint naming policy.
+     * Keep model-specific names unless the client performs a complete sweep. */
 }
 
 static BOOL keep_sony_audio_endpoint_visible(void)
@@ -1814,11 +1814,10 @@ static MMDevice *MMDevice_Create(const WCHAR *name, GUID *id, EDataFlow flow, DW
 
             pv.vt = VT_LPWSTR;
 
-            if ((dualsense_mono_endpoint || sony_direct_endpoint) &&
-                    use_windows_sony_controller_names())
-                public_device_iname = L"Wireless Controller";
-            else if (sony_direct_public_name)
+            if (sony_direct_public_name)
                 public_device_iname = sony_direct_public_name;
+            else if (dualsense_mono_endpoint && use_windows_sony_controller_names())
+                public_device_iname = L"Wireless Controller";
             else
                 public_device_iname = device_iname;
             swprintf(public_friendly_name, ARRAY_SIZE(public_friendly_name), friendly_name_fmt,
@@ -1870,13 +1870,6 @@ static MMDevice *MMDevice_Create(const WCHAR *name, GUID *id, EDataFlow flow, DW
         RegCloseKey(key);
     }
 
-    if ((dualsense_mono_endpoint || sony_direct_endpoint) &&
-            use_windows_sony_controller_names())
-    {
-        device_iname = L"Wireless Controller";
-        swprintf(friendly_name, ARRAY_SIZE(friendly_name), friendly_name_fmt,
-                device_desc, device_iname);
-    }
     MMDevice_Register(guidstr, friendly_name, device_iname,
         device_path.vt == VT_LPWSTR ? device_path.pwszVal : NULL,
         container_id.vt == VT_CLSID ? container_id.puuid : &GUID_NULL,
