From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Thu, 6 Aug 2026 18:35:00 -0600
Subject: [PATCH] winepulse: Request AUX channels for PipeWire DualSense PCM

The hidden PipeWire parent for a DualSense output exposes AUX0 through AUX3,
not a conventional quadraphonic layout. Mark only the local ALSA configuration
used by the dedicated haptic stream so the bundled PipeWire plugin negotiates
the matching channel positions.
---
 dlls/winepulse.drv/pulse.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/dlls/winepulse.drv/pulse.c b/dlls/winepulse.drv/pulse.c
index 378c1a4..4ef4c29 100644
--- a/dlls/winepulse.drv/pulse.c
+++ b/dlls/winepulse.drv/pulse.c
@@ -2829,6 +2829,18 @@ static int alsa_config_add_string(snd_config_t *parent, const char *name, const
     return err;
 }
 
+static int alsa_config_add_integer(snd_config_t *parent, const char *name, long value)
+{
+    snd_config_t *node;
+    int err;
+
+    if ((err = snd_config_imake_integer(&node, name, value)) < 0)
+        return err;
+    if ((err = snd_config_add(parent, node)) < 0)
+        snd_config_delete(node);
+    return err;
+}
+
 static int open_dualsense_haptic_pcm(snd_pcm_t **pcm, const char *alsa_path)
 {
     static const char pipewire_prefix[] = "pipewire:NODE=";
@@ -2851,6 +2863,7 @@ static int open_dualsense_haptic_pcm(snd_pcm_t **pcm, const char *alsa_path)
             (err = alsa_config_add_compound(pcms, "ge_dualsense", &dualsense)) < 0 ||
             (err = alsa_config_add_string(dualsense, "type", "pipewire")) < 0 ||
-            (err = alsa_config_add_string(dualsense, "playback_node", node)) < 0)
+            (err = alsa_config_add_string(dualsense, "playback_node", node)) < 0 ||
+            (err = alsa_config_add_integer(dualsense, "aux_channels", 1)) < 0)
         goto done;
 
     err = snd_pcm_open_lconf(pcm, "ge_dualsense", SND_PCM_STREAM_PLAYBACK,
-- 
2.50.1
