From 0f868516ecea98527b846ef2984fba0e0016b879 Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Tue, 4 Aug 2026 15:00:00 -0600
Subject: [PATCH] mmdevapi/setupapi: Scope fake KS audio interfaces to
 Monster Hunter Wilds

The fake MEDIA device and KSCATEGORY_AUDIO interfaces were added for Monster
Hunter Wilds, but were exposed to every process and persisted in the prefix.
PortAudio's WDM-KS backend consequently discovers devices which do not have a
real kernel-streaming filter. This breaks Black Desert Online's audio-device
enumeration and startup.

Only create and enumerate these fake interfaces when the Monster Hunter Wilds
compatibility environment variable is enabled. Filtering in setupapi as well
as mmdevapi also hides entries left in existing prefixes by older builds.
---
 dlls/mmdevapi/devenum.c | 9 ++++++++-
 dlls/setupapi/devinst.c | 10 ++++++++++
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/dlls/mmdevapi/devenum.c b/dlls/mmdevapi/devenum.c
--- a/dlls/mmdevapi/devenum.c
+++ b/dlls/mmdevapi/devenum.c
@@ -785,6 +785,13 @@ static BOOL is_dualsense_device_path(const WCHAR *device_path)
             wcsstr(device_path, L"VID_054C&PID_0DF2"));
 }
 
+static BOOL enable_mhwilds_usb_audio(void)
+{
+    const char *env = getenv("PROTON_ENABLE_MHWILDS_USB_AUDIO");
+
+    return env && env[0] == '1' && !env[1];
+}
+
 static BOOL is_dualsense_mono_endpoint_name(const WCHAR *name)
 {
     if (!name)
@@ -1249,7 +1256,7 @@ static void MMDevEnum_RegisterEndpoint(struct MMDevEnumImpl *This, EDataFlow flo
             remove_dualsense_media_devices();
 
         // HACK on top of hack, create entries that MHWilds expects.
-        if (device_path && !is_dualsense_device_path(device_path)) {
+        if (enable_mhwilds_usb_audio() && device_path && !is_dualsense_device_path(device_path)) {
             device_path = wcsstr(device_path, L"USB\\VID_");
             if (device_path) {
                 memset(&device_info_data, 0, sizeof(device_info_data));
diff --git a/dlls/setupapi/devinst.c b/dlls/setupapi/devinst.c
--- a/dlls/setupapi/devinst.c
+++ b/dlls/setupapi/devinst.c
@@ -2056,6 +2056,13 @@ DEFINE_GUID(DEVINTERFACE_AUDIO_RENDER, 0xe6327cad,0xdcec,0x4949,0xae,0x8a,0x99,
 DEFINE_GUID(DEVINTERFACE_AUDIO_CAPTURE, 0x2eef81be,0x33fa,0x4800,0x96,0x70,0x1c,0xd4,0x74,0x97,0x2c,0x3f);
 DEFINE_GUID(AM_KSCATEGORY_AUDIO, 0x6994ad04,0x93ef,0x11d0,0xa3,0xcc,0x00,0xa0,0xc9,0x22,0x31,0x96);
 
+static BOOL enable_mhwilds_usb_audio(void)
+{
+    const char *env = getenv("PROTON_ENABLE_MHWILDS_USB_AUDIO");
+
+    return env && env[0] == '1' && !env[1];
+}
+
 static void SETUPDI_AddDeviceInterfaces(struct device *device, HKEY key,
     const GUID *guid, DWORD flags)
 {
@@ -2068,6 +2075,9 @@ static void SETUPDI_AddDeviceInterfaces(struct device *device, HKEY key,
     const GUID *SKIP_PRESENT_CHECK[] = {&DEVINTERFACE_AUDIO_RENDER, &DEVINTERFACE_AUDIO_CAPTURE, &AM_KSCATEGORY_AUDIO, NULL};
     bool skip_present_check = false;
 
+    if (IsEqualGUID(guid, &AM_KSCATEGORY_AUDIO) && !enable_mhwilds_usb_audio())
+        return;
+
     for (i = 0; SKIP_PRESENT_CHECK[i] ; i++)
         if (IsEqualGUID(SKIP_PRESENT_CHECK[i], guid))
         {
-- 
