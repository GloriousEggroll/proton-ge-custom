From 436bd384697bd1fedec51ddc52572b2a1477c31d Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Thu, 6 Aug 2026 19:34:00 -0600
Subject: [PATCH] winepulse: Retarget all Sony effect streams on hotplug

DualShock 4 does not publish the hidden PipeWire split node used by the
DualSense USB audio path. Its four-channel controller effect stream can
therefore use either direct ALSA or the Pulse fallback. Such streams were not
registered for hotplug retargeting, because the registry only accepted paths
which already started with pipewire:NODE=.

Keep every successfully-created Sony four-channel effect stream in the live
registry. If the stream currently uses Pulse, disconnect that backend before
converting the existing Windows stream to a newly-published DualSense
PipeWire target. This allows a DS4-to-DualSense or DS4-to-DualSense Edge swap
to retain controller effect audio without requiring another replug.
---
 dlls/winepulse.drv/pulse.c | 12 +++++-------
 1 file changed, 5 insertions(+), 7 deletions(-)

diff --git a/dlls/winepulse.drv/pulse.c b/dlls/winepulse.drv/pulse.c
index 170701ea7af..813856b425d 100644
--- a/dlls/winepulse.drv/pulse.c
+++ b/dlls/winepulse.drv/pulse.c
@@ -1325,13 +1325,6 @@ static char *make_pipewire_dualsense_haptic_path(const char *target)
     return path;
 }
 
-static BOOL is_pipewire_dualsense_haptic_path(const char *path)
-{
-    static const char prefix[] = "pipewire:NODE=";
-
-    return path && !strncmp(path, prefix, sizeof(prefix) - 1);
-}
-
 static void apply_windows_sony_audio_format(PhysDevice *dev)
 {
     WAVEFORMATEX *wfx = &dev->fmt.Format;
@@ -3039,6 +3032,11 @@ static HRESULT pulse_retarget_dualsense_haptic_stream(struct pulse_stream *stre
 
     TRACE("Retargeting Sony controller haptic stream %p from %s to %s.\n",
             stream, debugstr_a(stream->haptic_alsa_path), debugstr_a(path));
+    /* DS4 does not expose the hidden PipeWire split node used by DualSense,
+     * so its effects stream may currently be routed through Pulse. Drop that
+     * backend before converting the live Windows stream to the new device's
+     * raw PipeWire target. */
+    pulse_stream_disconnect(stream);
     if (stream->haptic_pcm)
     {
         snd_pcm_drop(stream->haptic_pcm);
@@ -3423,7 +3422,7 @@ static NTSTATUS pulse_create_stream(void *args)
             list_add_tail(&dualsense_mono_streams, &stream->dualsense_mono_entry);
             stream->dualsense_mono_registered = TRUE;
         }
-        if (SUCCEEDED(hr) && is_pipewire_dualsense_haptic_path(stream->haptic_alsa_path))
+        if (SUCCEEDED(hr) && haptic_candidate)
         {
             list_add_tail(&dualsense_haptic_streams, &stream->dualsense_haptic_entry);
             stream->dualsense_haptic_registered = TRUE;
-- 
