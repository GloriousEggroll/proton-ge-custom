From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Sun, 9 Aug 2026 09:08:00 -0600
Subject: [PATCH] winepulse: Keep default Sony endpoint discovery fresh

The container-stable endpoint IDs added for the opt-in Windows Sony audio
layout also changed the default controller-audio path.  On a controller swap,
applications could recognize the replacement controller's auxiliary audio
interfaces as endpoints they had already seen and consequently never reopen
the newly published controller speaker.

Preserve stable IDs when the Windows Sony compatibility layout is explicitly
enabled.  Otherwise restore the original generation-based identity for Sony
capture and raw-haptic endpoints so every physical discovery cycle produces
the complete fresh endpoint set expected by the default hotplug path.
---
 dlls/winepulse.drv/pulse.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/dlls/winepulse.drv/pulse.c b/dlls/winepulse.drv/pulse.c
--- a/dlls/winepulse.drv/pulse.c
+++ b/dlls/winepulse.drv/pulse.c
@@ -181,6 +181,7 @@ static pa_mainloop *pulse_ml;
 static pthread_mutex_t g_phys_mutex;
 static pthread_cond_t g_phys_cond = PTHREAD_COND_INITIALIZER;
 static unsigned int g_haptic_hotplug_generation;
+static unsigned int g_dualsense_endpoint_generation;
 static unsigned int g_dualsense_mono_speaker_add_generation;
 static char *g_dualsense_mono_preferred_sink;
 static unsigned int g_phys_event_mask;
@@ -1436,6 +1437,7 @@ static BOOL pulse_stream_dualsense_mono_format(const struct pulse_stream *stream
 
 static BOOL pulse_set_endpoint_id(PhysDevice *dev)
 {
+    unsigned int generation;
     size_t len;
 
     if (is_dualsense_edge_speaker_sink(dev))
@@ -1451,6 +1453,18 @@ static BOOL pulse_set_endpoint_id(PhysDevice *dev)
             && strstr(dev->pulse_name, "Speaker__sink")))
         return !!(dev->endpoint_id = strdup(dev->pulse_name));
 
+    if (!use_windows_sony_controller_names())
+    {
+        generation = ++g_dualsense_endpoint_generation;
+        len = strlen(dev->pulse_name) + sizeof("#wine-dualsense-hotplug-") + 10;
+        if (!(dev->endpoint_id = malloc(len)))
+            return FALSE;
+
+        snprintf(dev->endpoint_id, len, "%s#wine-dualsense-hotplug-%u",
+                dev->pulse_name, generation);
+        return TRUE;
+    }
+
     len = strlen(dev->pulse_name) + sizeof("#wine-sony-hotplug-") + 36;
     if (!(dev->endpoint_id = malloc(len)))
         return FALSE;
