From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Wed, 5 Aug 2026 05:10:00 -0600
Subject: [PATCH] mmdevapi: Keep the live Sony speaker collection count
 consistent.

MMDevCol_Item() always projects the current Sony controller speaker at index
zero and skips that object when walking the collection snapshot.  Therefore,
MMDevCol_GetCount() must always count the projected endpoint exactly once,
including when the same object was already present in the snapshot.

Conditioning the count on snapshot membership made GetCount() return one less
than the index range exposed by Item().  WinMM could consequently construct an
output-device map containing a NULL slot and later crash in
waveOutGetDevCapsW() while querying that slot.

---
 dlls/mmdevapi/devenum.c | 18 +-----------------
 1 file changed, 1 insertion(+), 17 deletions(-)

diff --git a/dlls/mmdevapi/devenum.c b/dlls/mmdevapi/devenum.c
index c712de28..4619391e 100644
--- a/dlls/mmdevapi/devenum.c
+++ b/dlls/mmdevapi/devenum.c
@@ -2350,22 +2350,6 @@ static MMDevice *MMDevCol_current_dualsense_mono_endpoint(MMDevColImpl *This)
     return found;
 }
 
-static BOOL MMDevCol_contains_device(MMDevColImpl *This, MMDevice *target)
-{
-    UINT i;
-
-    if (!target)
-        return FALSE;
-
-    for (i = 0; i < This->devices_count; ++i)
-    {
-        if (impl_from_IMMDevice(This->devices[i]) == target)
-            return TRUE;
-    }
-
-    return FALSE;
-}
-
 static HRESULT WINAPI MMDevCol_GetCount(IMMDeviceCollection *iface, UINT *numdevs)
 {
     MMDevColImpl *This = impl_from_IMMDeviceCollection(iface);
@@ -2378,7 +2362,7 @@ static HRESULT WINAPI MMDevCol_GetCount(IMMDeviceCollection *iface, UINT *numdev
 
     *numdevs = 0;
     dualsense_mono = MMDevCol_current_dualsense_mono_endpoint(This);
-    if (dualsense_mono && !MMDevCol_contains_device(This, dualsense_mono))
+    if (dualsense_mono)
         (*numdevs)++;
 
     for (i = 0; i < This->devices_count; ++i)
-- 
2.50.1

