index d2ffaf29..eb7ec111 100644
--- a/dlls/xinput1_3/Makefile.in
+++ b/dlls/xinput1_3/Makefile.in
@@ -1,7 +1,7 @@
 EXTRADEFS = -DXINPUT_VER=3
 MODULE    = xinput1_3.dll
 IMPORTLIB = xinput
-IMPORTS   = hid setupapi advapi32 user32 ntdll
+IMPORTS   = hid cfgmgr32 advapi32 user32 ntdll
 
