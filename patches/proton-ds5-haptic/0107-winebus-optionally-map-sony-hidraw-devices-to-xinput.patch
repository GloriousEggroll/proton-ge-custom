From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Wed, 5 Aug 2026 07:30:00 -0600
Subject: [PATCH] winebus: Optionally map Sony hidraw devices to XInput

Some games, including Black Desert Online, only enumerate XInput even when a
native PlayStation controller is connected. The preferred hidraw path leaves
the Wine bus descriptor's is_gamepad member clear, so Wine installs only the
native HID stack and no WINEXINPUT interface is available to those games.

Add an opt-in compatibility switch which classifies DualShock 4, DualSense,
and DualSense Edge hidraw devices as Wine XInput gamepads. Keep this opt-in so
games which consume native PlayStation HID reports retain the existing native
device and haptics behavior.
---
 dlls/winebus.sys/bus_udev.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/dlls/winebus.sys/bus_udev.c b/dlls/winebus.sys/bus_udev.c
--- a/dlls/winebus.sys/bus_udev.c
+++ b/dlls/winebus.sys/bus_udev.c
@@ -1507,6 +1507,13 @@ static void get_device_subsystem_info(struct udev_device *dev, const char *subsy
     }
 }
 
+static BOOL enable_sony_hidraw_xinput(void)
+{
+    const char *env = getenv("PROTON_SONY_HIDRAW_XINPUT");
+
+    return env && env[0] == '1' && !env[1];
+}
+
 static NTSTATUS hidraw_device_create(struct udev_device *dev, int fd, const char *devnode, struct device_desc desc)
 {
 #ifdef HAVE_LINUX_HIDRAW_H
@@ -1516,6 +1523,13 @@ static NTSTATUS hidraw_device_create(struct udev_device *dev, int fd, const char
     char buffer[MAX_PATH];
 
     desc.is_hidraw = TRUE;
+    if (enable_sony_hidraw_xinput() &&
+            (is_dualshock4_gamepad(desc.vid, desc.pid) || is_dualsense_gamepad(desc.vid, desc.pid)))
+    {
+        desc.is_gamepad = TRUE;
+        TRACE("mapping Sony hidraw controller %04x:%04x to XInput.\n", desc.vid, desc.pid);
+    }
+
     if (!desc.product[0] && ioctl(fd, HIDIOCGRAWNAME(sizeof(buffer) - 1), buffer) >= 0)
         ntdll_umbstowcs(buffer, strlen(buffer) + 1, desc.product, ARRAY_SIZE(desc.product));
 
-- 
