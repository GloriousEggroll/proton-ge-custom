From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Thu, 13 Aug 2026 18:45:00 -0600
Subject: [PATCH] kernelbase: Enable Death Stranding controller environment RTPC

The accepted controller-speaker Wwise state alone does not make Death
Stranding submit environmental audio. Its sound-update graph keeps two
independent changed-value slots for "Sd Controller Speaker Setting": an
integer state value and a Boolean value. The four-channel source confirms the
state-only path remains silent in channels zero and one while haptic channels
continue working.

Submit the matching global Boolean RTPC after Wwise initialization alongside
the state. Use the same global-object and interpolation arguments as the
game's SetGlobalRTPC export, preserve all original graph calls, and retry the
pair if either Wwise operation fails.

--- a/dlls/kernelbase/main.c
+++ b/dlls/kernelbase/main.c
@@ -110,7 +110,7 @@ static ULONG WINAPI death_stranding_trace_set_state(ULONG group, ULONG state)
     static const ULONG controller_speaker_group = 0xd517feeb;
     static const ULONG controller_speaker_enabled = 0x2b6e617d;
     LONGLONG pair = ((ULONGLONG)group << 32) | state;
-    ULONG controller_result, result;
+    ULONG controller_rtpc_result, controller_state_result, result;
     unsigned int i;
 
     for (i = 0; i < ARRAY_SIZE(death_stranding_state_trace_entries); ++i)
@@ -127,10 +127,14 @@ static ULONG WINAPI death_stranding_trace_set_state(ULONG group, ULONG state)
             !InterlockedCompareExchange(&death_stranding_controller_state_initialized, TRUE, FALSE))
     {
-        controller_result = death_stranding_set_state_original(controller_speaker_group,
+        controller_state_result = death_stranding_set_state_original(controller_speaker_group,
                 controller_speaker_enabled);
-        WARN("Death Stranding enabled environmental controller-speaker state %#lx -> %#lx: %#lx.\n",
-                controller_speaker_group, controller_speaker_enabled, controller_result);
-        if (controller_result != 1)
+        controller_rtpc_result = death_stranding_set_rtpc_value_original(controller_speaker_group,
+                1.0f, ~(ULONGLONG)0, 0, 4, FALSE, 0);
+        WARN("Death Stranding enabled environmental controller-speaker state %#lx -> %#lx: "
+                "%#lx; RTPC %#lx -> 1: %#lx.\n", controller_speaker_group,
+                controller_speaker_enabled, controller_state_result,
+                controller_speaker_group, controller_rtpc_result);
+        if (controller_state_result != 1 || controller_rtpc_result != 1)
             InterlockedExchange(&death_stranding_controller_state_initialized, FALSE);
     }
     return result;
-- 
