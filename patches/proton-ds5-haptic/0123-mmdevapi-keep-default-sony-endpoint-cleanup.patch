From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Sun, 9 Aug 2026 09:20:00 -0600
Subject: [PATCH] mmdevapi: Keep default Sony endpoint cleanup behavior

Container-aware Sony endpoint retirement is needed by the opt-in persistent
Windows-style audio layout, but applying it to the default path removes every
capture interface alongside the disconnected speaker.  Applications which
pair controller and audio arrivals can retain those capture interfaces while
waiting for the replacement speaker and then fail to restart their speaker
stream after a later controller swap.

Use the broad Sony-name and container matching only when persistent Sony audio
endpoints are explicitly requested.  Preserve the original speaker-name-only
cleanup for the default controller audio path.
---
 dlls/mmdevapi/devenum.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/dlls/mmdevapi/devenum.c b/dlls/mmdevapi/devenum.c
--- a/dlls/mmdevapi/devenum.c
+++ b/dlls/mmdevapi/devenum.c
@@ -1084,11 +1084,14 @@ static BOOL is_dualsense_audioendpoint_name(const WCHAR *name)
 {
-    return is_dualsense_mono_endpoint_name(name) ||
-            (name && (wcsstr(name, L"DualSense") ||
-            wcsstr(name, L"DualShock") ||
-            wcsstr(name, L"Wireless Controller Speaker") ||
-            wcsstr(name, L"DualShock 4 Wireless Controller Speaker") ||
-            wcsstr(name, L"DualSense Wireless Controller Speaker") ||
-            wcsstr(name, L"DualSense Edge Wireless Controller Speaker")));
+    if (!name)
+        return FALSE;
+
+    return is_dualsense_mono_endpoint_name(name) ||
+            wcsstr(name, L"Wireless Controller Speaker") ||
+            wcsstr(name, L"DualShock 4 Wireless Controller Speaker") ||
+            wcsstr(name, L"DualSense Wireless Controller Speaker") ||
+            wcsstr(name, L"DualSense Edge Wireless Controller Speaker") ||
+            (keep_sony_audio_endpoint_visible() &&
+            (wcsstr(name, L"DualSense") || wcsstr(name, L"DualShock")));
 }
 
 static BOOL is_dualsense_audioendpoint_container(const GUID *container_id)
@@ -1131,7 +1133,8 @@ static void remove_dualsense_audioendpoint_devices(const GUID *keep_container_i
         SetupDiGetDeviceInstanceIdW(device_set, &device_info_data, instance_id,
                 ARRAY_SIZE(instance_id), NULL);
 
-        if (SetupDiGetDeviceRegistryPropertyW(device_set, &device_info_data, SPDRP_BASE_CONTAINERID,
+        if (keep_sony_audio_endpoint_visible() &&
+                SetupDiGetDeviceRegistryPropertyW(device_set, &device_info_data, SPDRP_BASE_CONTAINERID,
                 NULL, (BYTE *)container_id_string, sizeof(container_id_string), NULL) &&
                 SUCCEEDED(CLSIDFromString(container_id_string, &container_id)) &&
                 is_dualsense_audioendpoint_container(&container_id))
