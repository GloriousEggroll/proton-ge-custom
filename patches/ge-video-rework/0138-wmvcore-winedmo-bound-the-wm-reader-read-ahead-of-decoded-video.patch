From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: measlesbagel <49631653+measlesbagel@users.noreply.github.com>
Date: Wed, 25 Nov 2026 19:59:50 -0600
Subject: [PATCH 1/2] wmvcore, winedmo: Bound the WM reader's read-ahead of
 decoded video.

With 0120 and 0121, qasf delivers each output on its own thread as soon as
a sample is read, and renderers pace delivery by blocking in Receive().
Video uses the reader's own buffers, so nothing paces the reads: a
renderer slower than the stream lets the async reader queue samples for
its delivery thread without limit, and the demux thread decodes up to 256
frames ahead. Ys VIII's 1080p WMV opening grows the game by about 700 MB/s.

Stop reading a stream while three samples wait for its delivery thread,
and stop decoding ahead once 128 MB of a stream are queued (at least four
samples). Keep demuxing past that limit while another selected stream's
reader waits for a packet, so a full queue can't starve the other streams
and hang the reader on close.
---
 dlls/winedmo/wm_reader.c    | 35 ++++++++++++++++++++++++++++++++++-
 dlls/wmvcore/async_reader.c | 10 ++++++++++
 2 files changed, 44 insertions(+), 1 deletion(-)

diff --git a/dlls/winedmo/wm_reader.c b/dlls/winedmo/wm_reader.c
index 99c6437..487e6ce 100644
--- a/dlls/winedmo/wm_reader.c
+++ b/dlls/winedmo/wm_reader.c
@@ -56,6 +56,8 @@ struct wm_stream
     CRITICAL_SECTION queue_cs;
     CONDITION_VARIABLE queue_cv;
     UINT queued_packets;
+    SIZE_T queued_bytes;
+    LONG waiting_reads; /* readers blocked on an empty queue */
     bool queue_eos;
     bool queue_flushing;
 
@@ -1014,6 +1016,7 @@ static void wm_flush_stream_queue(struct wm_stream *stream)
         free(pkt);
     }
     stream->queued_packets = 0;
+    stream->queued_bytes = 0;
     stream->queue_eos = false;
     LeaveCriticalSection(&stream->queue_cs);
     WakeAllConditionVariable(&stream->queue_cv);
@@ -1027,6 +1030,27 @@ static void wm_flush_stream_queue(struct wm_stream *stream)
     LeaveCriticalSection(&stream->read_cs);
 }
 
+static BOOL wm_stream_queue_full(struct wm_stream *stream)
+{
+    return stream->queued_packets >= 256
+            || (stream->queued_packets >= 4 && stream->queued_bytes >= (128 << 20));
+}
+
+/* One demux thread feeds every stream: don't let a full queue starve another one. */
+static BOOL wm_reader_other_stream_starved(struct wm_reader *reader, struct wm_stream *stream)
+{
+    WORD i;
+
+    for (i = 0; i < reader->stream_count; ++i)
+    {
+        struct wm_stream *other = &reader->streams[i];
+        if (other != stream && other->selection != WMT_OFF
+                && ReadNoFence(&other->waiting_reads))
+            return TRUE;
+    }
+    return FALSE;
+}
+
 static BOOL wm_stream_wait_queue_space(struct wm_reader *reader, struct wm_stream *stream)
 {
     if (!IsEqualGUID(&stream->major_type, &MFMediaType_Video))
@@ -1038,7 +1062,8 @@ static BOOL wm_stream_wait_queue_space(struct wm_reader *reader, struct wm_strea
      * unbounded. */
     EnterCriticalSection(&stream->queue_cs);
     while (!reader->demux_shutdown && !stream->queue_flushing
-            && stream->selection != WMT_OFF && stream->queued_packets >= 256)
+            && stream->selection != WMT_OFF && wm_stream_queue_full(stream)
+            && !wm_reader_other_stream_starved(reader, stream))
         SleepConditionVariableCS(&stream->queue_cv, &stream->queue_cs, 10);
 
     if (reader->demux_shutdown || stream->queue_flushing || stream->selection == WMT_OFF)
@@ -1186,6 +1211,7 @@ static DWORD CALLBACK wm_demux_thread(void *arg)
                             {
                                 list_add_tail(&s->packet_queue, &pkt->entry);
                                 ++s->queued_packets;
+                                s->queued_bytes += pkt->size;
                                 LeaveCriticalSection(&s->queue_cs);
                                 WakeConditionVariable(&s->queue_cv);
                             }
@@ -1348,6 +1374,7 @@ static DWORD CALLBACK wm_demux_thread(void *arg)
                     {
                         list_add_tail(&s->packet_queue, &pkt->entry);
                         ++s->queued_packets;
+                        s->queued_bytes += pkt->size;
                         LeaveCriticalSection(&s->queue_cs);
                         WakeConditionVariable(&s->queue_cv);
                     }
@@ -1390,6 +1417,7 @@ static DWORD CALLBACK wm_demux_thread(void *arg)
             {
                 list_add_tail(&s->packet_queue, &pkt->entry);
                 ++s->queued_packets;
+                s->queued_bytes += pkt->size;
                 LeaveCriticalSection(&s->queue_cs);
                 WakeConditionVariable(&s->queue_cv);
             }
@@ -2459,7 +2487,11 @@ static HRESULT wm_stream_dequeue_sample(struct wm_stream *stream, BYTE **data, U
 
     EnterCriticalSection(&stream->queue_cs);
     while (list_empty(&stream->packet_queue) && !stream->queue_eos && !stream->queue_flushing)
+    {
+        InterlockedIncrement(&stream->waiting_reads);
         SleepConditionVariableCS(&stream->queue_cv, &stream->queue_cs, INFINITE);
+        InterlockedDecrement(&stream->waiting_reads);
+    }
 
     if (stream->queue_flushing)
     {
@@ -2477,6 +2509,7 @@ static HRESULT wm_stream_dequeue_sample(struct wm_stream *stream, BYTE **data, U
     list_remove(&pkt->entry);
     if (stream->queued_packets)
         --stream->queued_packets;
+    stream->queued_bytes -= min(stream->queued_bytes, pkt->size);
     WakeConditionVariable(&stream->queue_cv);
     LeaveCriticalSection(&stream->queue_cs);
 
diff --git a/dlls/wmvcore/async_reader.c b/dlls/wmvcore/async_reader.c
index 4cdda29..75f57cd 100644
--- a/dlls/wmvcore/async_reader.c
+++ b/dlls/wmvcore/async_reader.c
@@ -58,6 +58,10 @@ struct async_op
     struct list entry;
 };
 
+/* Renderers pace qasf's samples by blocking in Receive(), which only blocks a
+ * dedicated delivery thread: stop reading a stream while this many wait for it. */
+#define MAX_PENDING_DELIVERIES 3
+
 struct sample
 {
     struct list entry;
@@ -355,6 +359,9 @@ static void async_reader_deliver_sample(struct async_reader *reader, struct samp
     list_remove(&sample->entry);
     INSSBuffer_Release(sample->buffer);
     free(sample);
+
+    if (stream->dedicated_delivery_thread)
+        WakeConditionVariable(&reader->callback_cv);
 }
 
 static void stream_request_read(struct stream *stream)
@@ -626,6 +633,9 @@ static HRESULT async_reader_get_next_sample(struct async_reader *reader,
         if (FAILED(IWMSyncReader2_GetStreamSelected(reader->reader, i + 1, &selection))
                 || selection == WMT_OFF)
             continue;
+        if (stream->dedicated_delivery_thread
+                && list_count(&stream->deliver_samples) >= MAX_PENDING_DELIVERIES)
+            continue;
         if (!(entry = list_head(&stream->read_samples)))
         {
             if (stream->read_result == E_PENDING)
