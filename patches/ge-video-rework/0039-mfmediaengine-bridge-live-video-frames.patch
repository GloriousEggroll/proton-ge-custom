From 2e2f4ddc48bd2b5f81fd77948202fb6cae66fbd7 Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Thu, 20 Aug 2026 04:00:00 -0600
Subject: [PATCH] mfmediaengine: Prefer the render path for live video frames

Some frame-server clients use shared destination textures for live playback.
CopySubresourceRegion has no return value, so a failed shared-resource copy can
silently report success while leaving the destination unchanged. This is
visible with Twitch HLS streams in VRChat: demuxing, decoding, audio, the media
clock, and TransferVideoFrame all continue while the displayed video remains
blank.

Unknown-duration live sources can be identified by their infinite Media Engine
duration. Prefer Media Engine's render-target transfer for those sources. That
path performs the complete shader transfer on the destination device instead
of relying on a silent resource copy. If the render path is unavailable, fall
back to the direct transfer, including its cross-device CPU bridge. Keep finite
media on the existing path.
---
 dlls/mfmediaengine/main.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/dlls/mfmediaengine/main.c b/dlls/mfmediaengine/main.c
index 6caa31f9b84..bf4a3f32834 100644
--- a/dlls/mfmediaengine/main.c
+++ b/dlls/mfmediaengine/main.c
@@ -3447,7 +3447,14 @@ static HRESULT WINAPI media_engine_TransferVideoFrame(IMFMediaEngineEx *iface, I
 
     if (SUCCEEDED(IUnknown_QueryInterface(surface, &IID_ID3D11Texture2D, (void **)&texture)))
     {
-        if (!engine->device_manager
+        if (isinf(engine->duration))
+        {
+            TRACE("Using the render-target transfer path for a live video frame.\n");
+            hr = media_engine_transfer_to_d3d11_texture(engine, texture, src_rect, dst_rect, color);
+            if (FAILED(hr))
+                hr = media_engine_transfer_d3d11(engine, texture, src_rect, dst_rect, color);
+        }
+        else if (!engine->device_manager
                 || engine->video_frame.format_mismatch
                 || FAILED(hr = media_engine_transfer_d3d11(engine, texture, src_rect, dst_rect, color)))
             hr = media_engine_transfer_to_d3d11_texture(engine, texture, src_rect, dst_rect, color);
