From: GloriousEggroll <gloriouseggroll@gmail.com>
Subject: [PATCH] winedmo: Enable bounded H.264 decoder threading.

The RE4 intro recordings in #775 still show slower frame delivery after
removing the packed NV12 round-trip copies. In a moving one-second
section of the 60 Hz recordings, GE advances through about 19 images
while Experimental advances through 30. Matching the image content also
shows GE falling progressively behind, rather than just starting late.

The earlier Experimental trace configures avdec_h264 with max-threads=12.
Our libavcodec context retains the default thread_count=1. Restore
bounded H.264 decoding parallelism using the available CPU count, with
the same 16-thread / 4-thread caps used by winegstreamer. This addresses
a concrete performance difference; playback still needs runtime
comparison on the reporter's system.

Forward MF_LOW_LATENCY through the internal transform creation call.
Allow frame and slice threading for normal MF playback, but only slice
threading for low-latency callers. Preserve the exported creation API
and its existing no-frame-threading latency for other callers. WMV and
audio threading are unchanged.

Drain the short H.264 alignment fixture before requiring output, since
frame threading may buffer all its pictures until end-of-stream. The
existing low-latency H.264 tests exercise the slice-threaded path.

Leave the output-buffer fast path and current-type negotiation fixes
from 0074/0075 unchanged.

Reference: https://github.com/GloriousEggroll/proton-ge-custom/issues/775#issuecomment-6011041199
---
diff --git a/dlls/winedmo/main.c b/dlls/winedmo/main.c
--- a/dlls/winedmo/main.c
+++ b/dlls/winedmo/main.c
@@ -620,10 +620,10 @@
  * winedmo_transform_* functions (from winedmo/main.c)
  * ------------------------------------------------------------------------- */
 
-NTSTATUS CDECL winedmo_transform_create( GUID major_type,
-                                         const union winedmo_format *input_format,  UINT32 input_format_size,
-                                         const union winedmo_format *output_format, UINT32 output_format_size,
-                                         struct winedmo_transform *transform )
+NTSTATUS winedmo_transform_create_with_latency( GUID major_type,
+        const union winedmo_format *input_format, UINT32 input_format_size,
+        const union winedmo_format *output_format, UINT32 output_format_size,
+        BOOL low_latency, struct winedmo_transform *transform )
 {
     struct transform_create_params params =
     {
@@ -632,6 +632,7 @@
         .input_format_size  = input_format_size,
         .output_format      = (UINT_PTR)output_format,
         .output_format_size = output_format_size,
+        .low_latency        = low_latency,
     };
     NTSTATUS status;
 
@@ -650,6 +651,16 @@
     return STATUS_SUCCESS;
 }
 
+NTSTATUS CDECL winedmo_transform_create( GUID major_type,
+        const union winedmo_format *input_format, UINT32 input_format_size,
+        const union winedmo_format *output_format, UINT32 output_format_size,
+        struct winedmo_transform *transform )
+{
+    /* Keep the existing latency of callers which do not supply MF attributes. */
+    return winedmo_transform_create_with_latency( major_type, input_format, input_format_size,
+            output_format, output_format_size, TRUE, transform );
+}
+
 NTSTATUS CDECL winedmo_transform_destroy( struct winedmo_transform transform )
 {
     struct transform_destroy_params params = {.transform = transform};
diff --git a/dlls/winedmo/unix_transform.c b/dlls/winedmo/unix_transform.c
--- a/dlls/winedmo/unix_transform.c
+++ b/dlls/winedmo/unix_transform.c
@@ -31,6 +31,7 @@
 
 #include <stdbool.h>
 #include <inttypes.h>
+#include <libavutil/cpu.h>
 #include <libavutil/imgutils.h>
 #include <libavutil/samplefmt.h>
 #include <libswscale/swscale.h>
@@ -920,7 +921,16 @@
             t->avctx->framerate.den = t->input_fps_den;
         }
 
-        if (is_wmv_video_codec( codec_id ))
+        if (codec_id == AV_CODEC_ID_H264)
+        {
+            int thread_count = av_cpu_count();
+
+            /* libavcodec defaults to one thread. Bound the worker count like
+             * winegstreamer, without adding frame latency to low-latency callers. */
+            t->avctx->thread_count = max( 1, min( thread_count, sizeof(void *) == 4 ? 4 : 16 ) );
+            t->avctx->thread_type = params->low_latency ? FF_THREAD_SLICE : FF_THREAD_SLICE | FF_THREAD_FRAME;
+        }
+        else if (is_wmv_video_codec( codec_id ))
         {
             t->avctx->thread_count = 1;
             t->avctx->thread_type = 0;
@@ -947,6 +957,9 @@
         return STATUS_NOT_SUPPORTED;
     }
 
+    TRACE( "opened %s decoder, threads %d, active thread type %#x, low latency %u\n",
+           codec->name, t->avctx->thread_count, t->avctx->active_thread_type, params->low_latency );
+
     /* MF H.264 elementary streams may split one Annex-B access unit across
      * multiple input samples.  Preserve those fragments until complete. */
     if (!t->is_audio && (codec_id == AV_CODEC_ID_MPEG1VIDEO || codec_id == AV_CODEC_ID_MPEG2VIDEO
