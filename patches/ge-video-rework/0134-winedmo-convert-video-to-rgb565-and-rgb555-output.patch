From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Sun, 22 Nov 2026 00:00:00 -0500
Subject: [PATCH] winedmo: Convert video to RGB565 and RGB555 output.

MFVideoFormat_RGB565 and MFVideoFormat_RGB555 use the D3DFMT codes
D3DFMT_R5G6B5 (0x17) and D3DFMT_X1R5G5B5 (0x18), which
pix_fmt_from_mf_fourcc() did not map.  The output format became
AV_PIX_FMT_NONE, so the decoder's native yuv420p frame was copied
unconverted into the RGB buffer.

Daemonica's video renderer only accepts RGB565 from the WMV decoder DMO,
so its intro video showed tiled, repeated garbage: 460800 bytes of
yuv420p in each 614400 byte RGB565 sample.

Map both codes, and treat them as packed RGB so bottom-up output is
flipped like the 24 and 32 bit formats.

https://github.com/GloriousEggroll/proton-ge-custom/issues/994

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
--- a/dlls/winedmo/unix_transform.c
+++ b/dlls/winedmo/unix_transform.c
@@ -259,6 +259,8 @@
     case 0x00000015:                  return AV_PIX_FMT_BGRA;   /* D3DFMT_A8R8G8B8 */
     case 0x00000016:                  return AV_PIX_FMT_BGR0;   /* D3DFMT_X8R8G8B8 */
     case 0x00000014:                  return AV_PIX_FMT_BGR24;  /* D3DFMT_R8G8B8 */
+    case 0x00000017:                  return AV_PIX_FMT_RGB565LE; /* D3DFMT_R5G6B5, MFVideoFormat_RGB565 */
+    case 0x00000018:                  return AV_PIX_FMT_RGB555LE; /* D3DFMT_X1R5G5B5, MFVideoFormat_RGB555 */
     case 0x00000020:                  return AV_PIX_FMT_RGBA;   /* D3DFMT_A8B8G8R8 */
     default:                          return AV_PIX_FMT_NONE;
     }
@@ -277,6 +279,8 @@
     case AV_PIX_FMT_BGR0:    return 0x00000016;
     case AV_PIX_FMT_BGR24:   return 0x00000014;
     case AV_PIX_FMT_RGBA:    return 0x00000020;
+    case AV_PIX_FMT_RGB565LE: return 0x00000017;
+    case AV_PIX_FMT_RGB555LE: return 0x00000018;
     default:                 return 0;
     }
 }
@@ -623,6 +627,8 @@
     case AV_PIX_FMT_BGR0:
     case AV_PIX_FMT_BGR24:
     case AV_PIX_FMT_RGBA:
+    case AV_PIX_FMT_RGB565LE:
+    case AV_PIX_FMT_RGB555LE:
         return true;
     default:
         return false;
