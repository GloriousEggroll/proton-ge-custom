-            This->media->duration = (DOUBLE)duration / 10000000.0f;
     } else {
         update_state(This, DISPID_WMPCOREEVENT_PLAYSTATECHANGE, wmppsUndefined);
     }
@@ -1596,9 +1699,27 @@ static HRESULT WINAPI WMPControls_stop(IWMPControls *iface)
 
 static HRESULT WINAPI WMPControls_pause(IWMPControls *iface)
 {
+    HRESULT hres = S_OK;
     WindowsMediaPlayer *This = impl_from_IWMPControls(iface);
-    FIXME("(%p)\n", This);
-    return E_NOTIMPL;
+
+    TRACE("(%p)\n", This);
+
+    if (!This->media)
+        return NS_S_WMPCORE_COMMAND_NOT_AVAILABLE;
+
+    if (!This->filter_graph)
+        hres = open_graph(This);
+
+    if (SUCCEEDED(hres))
+        hres = IMediaControl_Pause(This->media_control);
+
+    if (hres == S_FALSE)
+        hres = S_OK; /* the graph is transitioning */
+
+    if (SUCCEEDED(hres))
+        update_state(This, DISPID_WMPCOREEVENT_PLAYSTATECHANGE, wmppsPaused);
+
+    return hres;
 }
 
 static HRESULT WINAPI WMPControls_fastForward(IWMPControls *iface)
@@ -1633,16 +1754,19 @@ static HRESULT WINAPI WMPControls_get_currentPosition(IWMPControls *iface, DOUBL
 
 static HRESULT WINAPI WMPControls_put_currentPosition(IWMPControls *iface, DOUBLE dCurrentPosition)
 {
-    LONGLONG Current;
+    LONGLONG Current, old = 0;
     HRESULT hres;
     WindowsMediaPlayer *This = impl_from_IWMPControls(iface);
     TRACE("(%p)->(%f)\n", This, dCurrentPosition);
     if (!This->media_seeking)
         return S_FALSE;
 
+    IMediaSeeking_GetCurrentPosition(This->media_seeking, &old);
     Current = 10000000 * dCurrentPosition;
     hres = IMediaSeeking_SetPositions(This->media_seeking, &Current,
             AM_SEEKING_AbsolutePositioning, NULL, AM_SEEKING_NoPositioning);
+    if (SUCCEEDED(hres))
+        position_changed(This, (DOUBLE)old / 10000000.0, dCurrentPosition);
 
     return hres;
 }
@@ -2274,6 +2398,7 @@ BOOL init_player(WindowsMediaPlayer *wmp)
     wmp->invoke_urls = VARIANT_TRUE;
