+/* The host's IWMPGraphCreation, from its client site: it adds its own filters (e.g. its video
+ * renderer) to the graph before it is rendered. */
+static IWMPGraphCreation *get_graph_creation(WindowsMediaPlayer *This)
+{
+    IWMPGraphCreation *graph_creation = NULL;
+    IServiceProvider *provider;
+
+    if (!This->client_site)
+        return NULL;
+    if (SUCCEEDED(IOleClientSite_QueryInterface(This->client_site, &IID_IServiceProvider, (void **)&provider))) {
+        if (FAILED(IServiceProvider_QueryService(provider, &IID_IWMPGraphCreation, &IID_IWMPGraphCreation,
+                (void **)&graph_creation)))
+            graph_creation = NULL;
+        IServiceProvider_Release(provider);
+    }
+    return graph_creation;
+}
+
+static HRESULT open_graph(WindowsMediaPlayer *This)
+{
+    IWMPGraphCreation *graph_creation;
+    HRESULT hres;
+
+    hres = CoCreateInstance(&CLSID_FilterGraph,
+            NULL,
+            CLSCTX_INPROC_SERVER,
+            &IID_IGraphBuilder,
+            (void **)&This->filter_graph);
+    update_state(This, DISPID_WMPCOREEVENT_OPENSTATECHANGE, wmposOpeningUnknownURL);
+
+    graph_creation = SUCCEEDED(hres) ? get_graph_creation(This) : NULL;
+    if (graph_creation) {
+        hres = IWMPGraphCreation_GraphCreationPreRender(graph_creation, (IUnknown *)This->filter_graph, NULL);
+        TRACE("GraphCreationPreRender returned %#lx\n", hres);
+    }
+    if (SUCCEEDED(hres))
+        hres = IGraphBuilder_RenderFile(This->filter_graph, This->media->url, NULL);
+    if (SUCCEEDED(hres) && graph_creation)
+        IWMPGraphCreation_GraphCreationPostRender(graph_creation, (IUnknown *)This->filter_graph);
+    if (graph_creation)
+        IWMPGraphCreation_Release(graph_creation);
+    if (SUCCEEDED(hres))
+        update_state(This, DISPID_WMPCOREEVENT_OPENSTATECHANGE, wmposMediaOpen);
+    if (SUCCEEDED(hres))
+        hres = IGraphBuilder_QueryInterface(This->filter_graph, &IID_IMediaControl,
+                (void**)&This->media_control);
+    if (SUCCEEDED(hres))
+        hres = IGraphBuilder_QueryInterface(This->filter_graph, &IID_IMediaSeeking,
+                (void**)&This->media_seeking);
+    if (SUCCEEDED(hres))
+        hres = IMediaSeeking_SetTimeFormat(This->media_seeking, &TIME_FORMAT_MEDIA_TIME);
+    if (SUCCEEDED(hres))
+        hres = IGraphBuilder_QueryInterface(This->filter_graph, &IID_IMediaEvent,
+                (void**)&This->media_event);
+    if (SUCCEEDED(hres))
+    {
+        IMediaEventEx *media_event_ex = NULL;
+        hres = IGraphBuilder_QueryInterface(This->filter_graph, &IID_IMediaEventEx,
+                (void**)&media_event_ex);
+        if (SUCCEEDED(hres)) {
+            hres = IMediaEventEx_SetNotifyWindow(media_event_ex, (OAHWND)This->msg_window,
+                    WM_WMPEVENT, (LONG_PTR)This);
+            IMediaEventEx_Release(media_event_ex);
+        }
+    }
+    if (SUCCEEDED(hres))
+        hres = IGraphBuilder_QueryInterface(This->filter_graph, &IID_IBasicAudio, (void**)&This->basic_audio);
+    if (SUCCEEDED(hres))
+        hres = IWMPSettings_put_volume(&This->IWMPSettings_iface, This->volume);
+    if (SUCCEEDED(hres) && This->balance)
+        IBasicAudio_put_Balance(This->basic_audio, This->balance * 100);
+    if (SUCCEEDED(hres) && This->rate != 1.0)
+        IMediaSeeking_SetRate(This->media_seeking, This->rate);
+    if (SUCCEEDED(hres)) {
+        LONGLONG duration;
+        if (SUCCEEDED(IMediaSeeking_GetDuration(This->media_seeking, &duration)))
+            This->media->duration = (DOUBLE)duration / 10000000.0f;
+    }
+
+    if (FAILED(hres))
+    {
+        if (This->filter_graph)
+        {
+            IGraphBuilder_Release(This->filter_graph);
+            This->filter_graph = NULL;
+        }
+        if (This->media_control)
+        {
+            IMediaControl_Release(This->media_control);
+            This->media_control = NULL;
+        }
+        if (This->media_seeking)
+        {
+            IMediaSeeking_Release(This->media_seeking);
+            This->media_seeking = NULL;
+        }
+        if (This->media_event)
+        {
+            IMediaEvent_Release(This->media_event);
+            This->media_event = NULL;
+        }
+        if (This->basic_audio)
+        {
+            IBasicAudio_Release(This->basic_audio);
+            This->basic_audio = NULL;
+        }
+    }
+
+    return hres;
+}
+
