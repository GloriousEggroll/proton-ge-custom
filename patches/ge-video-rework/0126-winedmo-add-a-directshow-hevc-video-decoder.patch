From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alexandre Derumier <aderumier@gmail.com>
Date: Wed, 18 Nov 2026 22:45:00 +0100
Subject: [PATCH] winedmo: Add a DirectShow HEVC video decoder.

The winedmo splitters output HEVC video (MEDIASUBTYPE_HEVC, a
VIDEOINFOHEADER followed by the track's hvcC parameter sets), but no
DirectShow filter accepted it: rendering an HEVC MP4 failed with
VFW_E_CANNOT_RENDER.

Game impacted: Veggie Blast (UNIS, its .NET host) plays its intro movie,
a 10-bit HEVC MP4, through a WPF MediaElement (Windows Media Player and
quartz): the graph could not be built and the intro was skipped.

Register a "winedmo HEVC decoder" transform for MEDIATYPE_Video /
HEVC (HEVC, hevc, H265, h265 FourCCs) on FORMAT_VideoInfo, sharing the
MPEG video decoder's output side, and pass the codec data that follows
the VIDEOINFOHEADER to the decoder after the input MFVIDEOFORMAT.
---
diff --git a/dlls/winedmo/main.c b/dlls/winedmo/main.c
index 545b6c5d..fb47672f 100644
--- a/dlls/winedmo/main.c
+++ b/dlls/winedmo/main.c
@@ -856,6 +856,7 @@ static struct class_factory asf_splitter_cf = {{&class_factory_vtbl}, asf_splitt
 static struct class_factory decodebin_parser_cf = {{&class_factory_vtbl}, decodebin_parser_create};
 static struct class_factory aac_audio_decoder_cf = {{&class_factory_vtbl}, aac_audio_decoder_create};
 static struct class_factory ac3_audio_decoder_cf = {{&class_factory_vtbl}, ac3_audio_decoder_create};
+static struct class_factory hevc_video_decoder_cf = {{&class_factory_vtbl}, hevc_video_decoder_create};
 static struct class_factory mpeg_audio_codec_cf = {{&class_factory_vtbl}, mpeg_audio_codec_create};
 static struct class_factory mpeg_video_codec_cf = {{&class_factory_vtbl}, mpeg_video_codec_create};
 static struct class_factory mpeg_layer3_decoder_cf = {{&class_factory_vtbl}, mpeg_layer3_decoder_create};
@@ -901,6 +902,8 @@ HRESULT WINAPI DllGetClassObject(REFCLSID clsid, REFIID iid, void **out)
         factory = &aac_audio_decoder_cf;
     else if (IsEqualGUID(clsid, &CLSID_winedmo_ac3_audio_decoder))
         factory = &ac3_audio_decoder_cf;
+    else if (IsEqualGUID(clsid, &CLSID_winedmo_hevc_video_decoder))
+        factory = &hevc_video_decoder_cf;
     else if (IsEqualGUID(clsid, &CLSID_winedmo_mpeg_audio_decoder))
         factory = &mpeg_audio_codec_cf;
     else if (IsEqualGUID(clsid, &CLSID_winedmo_mpeg_video_decoder))
@@ -1025,6 +1028,32 @@ static const REGFILTER2 reg_ac3_decoder =
     .u.s2.rgPins2 = reg_ac3_decoder_pins,
 };
 
+static const REGPINTYPES reg_hevc_decoder_inputs[] =
+{
+    {&MEDIATYPE_Video, &MFVideoFormat_HEVC},
+};
+
+static const REGFILTERPINS2 reg_hevc_decoder_pins[2] =
+{
+    {
+        .nMediaTypes = ARRAY_SIZE(reg_hevc_decoder_inputs),
+        .lpMediaType = reg_hevc_decoder_inputs,
+    },
+    {
+        .dwFlags = REG_PINFLAG_B_OUTPUT,
+        .nMediaTypes = 1,
+        .lpMediaType = &reg_video_mt,
+    },
+};
+
+static const REGFILTER2 reg_hevc_decoder =
+{
+    .dwVersion = 2,
+    .dwMerit = MERIT_NORMAL,
+    .u.s2.cPins2 = 2,
+    .u.s2.rgPins2 = reg_hevc_decoder_pins,
+};
+
 static const REGFILTERPINS2 reg_decodebin_parser_pins[3] =
 {
     {
@@ -1073,6 +1102,8 @@ HRESULT WINAPI DllRegisterServer(void)
             L"winedmo AAC decoder", NULL, NULL, NULL, &reg_aac_decoder);
     IFilterMapper2_RegisterFilter(mapper, &CLSID_winedmo_ac3_audio_decoder,
             L"winedmo AC3 decoder", NULL, NULL, NULL, &reg_ac3_decoder);
+    IFilterMapper2_RegisterFilter(mapper, &CLSID_winedmo_hevc_video_decoder,
+            L"winedmo HEVC decoder", NULL, NULL, NULL, &reg_hevc_decoder);
 
     IFilterMapper2_Release(mapper);
 
@@ -1097,6 +1128,7 @@ HRESULT WINAPI DllUnregisterServer(void)
     IFilterMapper2_UnregisterFilter(mapper, NULL, NULL, &CLSID_winedmo_asf_splitter);
     IFilterMapper2_UnregisterFilter(mapper, NULL, NULL, &CLSID_winedmo_aac_audio_decoder);
     IFilterMapper2_UnregisterFilter(mapper, NULL, NULL, &CLSID_winedmo_ac3_audio_decoder);
+    IFilterMapper2_UnregisterFilter(mapper, NULL, NULL, &CLSID_winedmo_hevc_video_decoder);
 
     IFilterMapper2_Release(mapper);
 
diff --git a/dlls/winedmo/quartz_transform.c b/dlls/winedmo/quartz_transform.c
index 1ca798e5..42b99f6a 100644
--- a/dlls/winedmo/quartz_transform.c
+++ b/dlls/winedmo/quartz_transform.c
@@ -54,6 +54,8 @@ struct transform
     bool have_video_input;
     bool have_decoded_output;
     bool output_bottom_up;
+    /* the codec data after a FORMAT_VideoInfo header goes to the decoder */
+    bool video_info_extradata;
     REFERENCE_TIME next_output_time;
 };
 
@@ -221,6 +223,20 @@ static HRESULT transform_init_stream(struct strmbase_filter *iface)
                     memcpy(input_format + 1, mpeg->bSequenceHeader, mpeg->cbSequenceHeader);
                 }
             }
+            else if (filter->video_info_extradata && IsEqualGUID(&sink_mt->formattype, &FORMAT_VideoInfo)
+                    && sink_mt->cbFormat > sizeof(VIDEOINFOHEADER))
+            {
+                DWORD size = sink_mt->cbFormat - sizeof(VIDEOINFOHEADER);
+
+                if (size > INT_MAX - sizeof(input_fmt))
+                    return VFW_E_INVALIDMEDIATYPE;
+                /* the parameter sets of length-prefixed samples (an MP4 track's hvcC) */
+                if (!(input_format = malloc(sizeof(input_fmt) + size)))
+                    return E_OUTOFMEMORY;
+                *input_format = input_fmt;
+                input_format->dwSize += size;
+                memcpy(input_format + 1, input_vih + 1, size);
+            }
 
             output_fmt.dwSize = sizeof(output_fmt);
             output_fmt.guidFormat = source_mt->subtype;
@@ -1654,6 +1670,62 @@ HRESULT mpeg_video_codec_create(IUnknown *outer, IUnknown **out)
     return hr;
 }
 
+static BOOL is_hevc_video_subtype(const GUID *subtype)
+{
+    static const DWORD fourccs[] =
+    {
+        MAKEFOURCC('H','E','V','C'), MAKEFOURCC('h','e','v','c'),
+        MAKEFOURCC('H','2','6','5'), MAKEFOURCC('h','2','6','5'),
+    };
+    GUID guid = MFVideoFormat_Base;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(fourccs); ++i)
+    {
+        guid.Data1 = fourccs[i];
+        if (IsEqualGUID(subtype, &guid))
+            return TRUE;
+    }
+    return FALSE;
+}
+
+static HRESULT hevc_video_decoder_sink_query_accept(struct transform *filter, const AM_MEDIA_TYPE *mt)
+{
+    if (!IsEqualGUID(&mt->majortype, &MEDIATYPE_Video) || !is_hevc_video_subtype(&mt->subtype)
+            || !IsEqualGUID(&mt->formattype, &FORMAT_VideoInfo)
+            || !mt->pbFormat || mt->cbFormat < sizeof(VIDEOINFOHEADER))
+        return S_FALSE;
+
+    return S_OK;
+}
+
+static const struct transform_ops hevc_video_decoder_transform_ops =
+{
+    hevc_video_decoder_sink_query_accept,
+    mpeg_video_codec_source_query_accept,
+    mpeg_video_codec_source_get_media_type,
+    mpeg_video_codec_source_decide_buffer_size,
+    passthrough_source_qc_notify,
+};
+
+HRESULT hevc_video_decoder_create(IUnknown *outer, IUnknown **out)
+{
+    struct transform *object;
+    HRESULT hr;
+
+    hr = transform_create(outer, &CLSID_winedmo_hevc_video_decoder, &hevc_video_decoder_transform_ops, &object);
+    if (FAILED(hr))
+        return hr;
+
+    wcscpy(object->sink.pin.name, L"XForm In");
+    wcscpy(object->source.pin.name, L"XForm Out");
+    object->video_info_extradata = true;
+
+    TRACE("Created HEVC video decoder %p.\n", object);
+    *out = &object->filter.IUnknown_inner;
+    return hr;
+}
+
 static HRESULT mpeg_layer3_decoder_sink_query_accept(struct transform *filter, const AM_MEDIA_TYPE *mt)
 {
     const MPEGLAYER3WAVEFORMAT *format;
