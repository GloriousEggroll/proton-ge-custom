From: GloriousEggroll <gloriouseggroll@gmail.com>
Subject: [PATCH] winedmo: Negotiate coded H.264 NV12 output dimensions.

Black Ops III sets only the H.264 major type and subtype, then selects the
decoder's placeholder 1920x1080 NV12 output. Its first decoded frame has
1920x1088 coded dimensions. The requested-size guard in
should_use_coded_video_output_size() makes both format discovery and frame
delivery remain compact, so the decoder suppresses the initial stream
change and returns 3110400 bytes instead of the padded 3133440-byte layout.
This is consistent with the displaced chroma and green bottom strip
reported in issue #771.

Allow H.264 NV12 format discovery to override the smaller initial output
size, as the existing MF H.264 alignment test expects. Use the same helper
for copying and advertising the padded size so the plane offsets, sample
length and media type agree after renegotiation. Keep the visible dimensions
in the aperture and retain the existing initialized-padding copy path.

Other codec/output combinations keep the requested-size guard. Also retain
the guard for frames where FFmpeg does not distinguish visible and coded
dimensions, used by the earlier Dragon's Dogma padding fix.

Extend the existing alignment test to cover input types without frame
dimensions, and check the decoded sample length and visible aperture.

References:
https://github.com/GloriousEggroll/proton-ge-custom/issues/771
https://learn.microsoft.com/en-us/windows/win32/medfound/h-264-video-decoder

---
diff --git a/dlls/winedmo/unix_transform.c b/dlls/winedmo/unix_transform.c
--- a/dlls/winedmo/unix_transform.c
+++ b/dlls/winedmo/unix_transform.c
@@ -311,6 +311,12 @@
             && t->avctx->coded_height > height)
         return false;
 
+    /* H.264 NV12 output must announce the coded size even when the caller
+     * selected a smaller placeholder before decoding the first frame. Both
+     * the format change and the copied planes must use the same padded size. */
+    if (t->avctx->codec_id == AV_CODEC_ID_H264 && t->out_pix_fmt == AV_PIX_FMT_NV12)
+        return true;
+
     if (t->out_width > 0 && t->out_height > 0
             && (t->out_width < t->avctx->coded_width || t->out_height < t->avctx->coded_height))
         return false;
diff --git a/dlls/mf/tests/transform.c b/dlls/mf/tests/transform.c
index d9e2c92df94..3fabef84ea2 100644
--- a/dlls/mf/tests/transform.c
+++ b/dlls/mf/tests/transform.c
@@ -5734,7 +5734,7 @@ failed:
     CoUninitialize();
 }
 
-static void test_h264_decoder_alignment(void)
+static void test_h264_decoder_alignment(BOOL input_frame_size)
 {
     static const DWORD actual_width = 82, actual_height = 84;
     static const DWORD aligned_width = 96, aligned_height = 96;
@@ -5750,16 +5750,17 @@ static void test_h264_decoder_alignment(void)
     IMFSample *input_sample, *output_sample;
     const BYTE *h264_encoded_data;
     ULONG h264_encoded_data_len;
-    IMFMediaType *output_type;
+    IMFMediaType *input_type, *output_type;
     IMFTransform *transform;
-    DWORD output_status;
+    DWORD output_status, length, output_count = 0;
+    MFVideoArea aperture;
     UINT64 frame_size;
     HRESULT hr;
 
     hr = CoInitialize(NULL);
     ok(hr == S_OK, "Failed to initialize, hr %#lx.\n", hr);
 
-    winetest_push_context("h264dec alignment");
+    winetest_push_context("h264dec alignment, input frame size %u", input_frame_size);
 
     if (FAILED(hr = CoCreateInstance(&CLSID_MSH264DecoderMFT, NULL, CLSCTX_INPROC_SERVER,
             &IID_IMFTransform, (void **)&transform)))
@@ -5767,12 +5768,18 @@ static void test_h264_decoder_alignment(void)
 
     load_resource(L"h264data.bin", &h264_encoded_data, &h264_encoded_data_len);
 
-    check_mft_set_input_type(transform, input_type_desc, S_OK);
+    hr = MFCreateMediaType(&input_type);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    init_media_type(input_type, input_type_desc, input_frame_size ? 3 : 2);
+    hr = IMFTransform_SetInputType(transform, 0, input_type, 0);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    IMFMediaType_Release(input_type);
 
     output_type = transform_find_available_output_type(transform, &MFVideoFormat_NV12);
     hr = IMFMediaType_GetUINT64(output_type, &MF_MT_FRAME_SIZE, &frame_size);
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
-    ok(frame_size == (((UINT64)actual_width << 32) | actual_height), "Unexpected frame size %#llx\n", frame_size);
+    ok(frame_size == (input_frame_size ? (((UINT64)actual_width << 32) | actual_height)
+            : (((UINT64)1920 << 32) | 1080)), "Unexpected frame size %#llx\n", frame_size);
 
     hr = IMFTransform_SetOutputType(transform, 0, output_type, 0);
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
@@ -5794,6 +5801,10 @@ static void test_h264_decoder_alignment(void)
         if (hr == S_OK)
         {
             ok(!!output_type, "Stream change not received.\n");
+            hr = IMFSample_GetTotalLength(output_sample, &length);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+            ok(length == aligned_width * aligned_height * 3 / 2, "Unexpected sample length %lu.\n", length);
+            ++output_count;
             IMFSample_Release(output_sample);
             output_sample = create_sample(NULL, aligned_width * aligned_height * 3 / 2);
         }
@@ -5812,12 +5823,20 @@ static void test_h264_decoder_alignment(void)
             ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
             ok(frame_size == (((UINT64)aligned_width << 32) | aligned_height), "Unexpected frame size %#llx\n", frame_size);
 
+            hr = IMFMediaType_GetBlob(output_type, &MF_MT_MINIMUM_DISPLAY_APERTURE,
+                    (BYTE *)&aperture, sizeof(aperture), NULL);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+            if (SUCCEEDED(hr))
+                ok(aperture.Area.cx == actual_width && aperture.Area.cy == actual_height,
+                        "Unexpected display aperture %ldx%ld.\n", aperture.Area.cx, aperture.Area.cy);
+
             hr = IMFTransform_SetOutputType(transform, 0, output_type, 0);
             ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
             IMFMediaType_Release(output_type);
         }
     } while (hr == S_OK);
 
+    ok(output_count, "No decoded frames.\n");
     IMFSample_Release(output_sample);
     IMFTransform_Release(transform);
 
@@ -11589,7 +11608,8 @@ START_TEST(transform)
     test_h264_decoder(FALSE);
     test_h264_decoder(TRUE);
     test_h264_decoder_timestamps();
-    test_h264_decoder_alignment();
+    test_h264_decoder_alignment(FALSE);
+    test_h264_decoder_alignment(TRUE);
     test_wmv_encoder();
     test_wmv_decoder(FALSE);
     test_wmv_decoder(TRUE);
