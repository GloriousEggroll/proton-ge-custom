From: GloriousEggroll <gloriouseggroll@proton.me>
Date: Fri, 28 Aug 2026 06:00:00 -0600
Subject: [PATCH] mfmediaengine: Trace live buffered range length

AVPro reloads a live player when a previously nonempty buffered range becomes
empty.  Trace the bounded value returned by IMFMediaTimeRange::GetLength(),
including the first range endpoints, so the value observed by AVPro can be
distinguished from the successful GetBuffered() HRESULT.
---
 dlls/mfmediaengine/main.c | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/dlls/mfmediaengine/main.c b/dlls/mfmediaengine/main.c
--- a/dlls/mfmediaengine/main.c
+++ b/dlls/mfmediaengine/main.c
@@ -491,6 +491,7 @@ struct time_range
     struct range *ranges;
     size_t count;
     size_t capacity;
+    BOOL trace_live_buffered;
 };
 
 static struct time_range *impl_from_IMFMediaTimeRange(IMFMediaTimeRange *iface)
@@ -664,9 +665,26 @@ static DWORD WINAPI time_range_GetLength(IMFMediaTimeRange *iface)
 static DWORD WINAPI time_range_GetLength(IMFMediaTimeRange *iface)
 {
     struct time_range *range = impl_from_IMFMediaTimeRange(iface);
+    static LONG live_buffered_length_count;
 
     TRACE("%p.\n", iface);
 
+    if (range->trace_live_buffered)
+    {
+        LONG count = InterlockedIncrement(&live_buffered_length_count);
+        double start = 0.0, end = 0.0;
+
+        if (range->count)
+        {
+            start = range->ranges[0].start;
+            end = range->ranges[0].end;
+        }
+
+        if (count <= 32 || !range->count)
+            WARN("Live buffered length call %ld: range %p, length %Iu, first %.6f-%.6f.\n",
+                    count, iface, range->count, start, end);
+    }
+
     return range->count;
 }
 
@@ -2084,6 +2102,8 @@ static HRESULT WINAPI media_engine_GetBuffered(IMFMediaEngineEx *iface, IMFMedia
 
     duration = engine->duration;
     flags = engine->flags;
+    if (isinf(duration))
+        impl_from_IMFMediaTimeRange(*range)->trace_live_buffered = TRUE;
 
     LeaveCriticalSection(&engine->cs);
 
-- 
