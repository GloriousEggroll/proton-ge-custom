 }
+
+/* The WMV decoder MFT without COM, for callers such as mpg4c32's Video for
+ * Windows driver, which runs on application threads that may not have
+ * initialized COM. */
+HRESULT WINAPI winedmo_create_wmv_decoder(IMFTransform **out)
+{
+    IUnknown *unknown;
+    HRESULT hr;
+
+    TRACE("out %p.\n", out);
+
+    if (FAILED(hr = wmv_decoder_create(NULL, &unknown)))
+        return hr;
+    hr = IUnknown_QueryInterface(unknown, &IID_IMFTransform, (void **)out);
+    IUnknown_Release(unknown);
+    return hr;
+}
