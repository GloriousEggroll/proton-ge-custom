diff --git a/dlls/quartz/tests/colour.c b/dlls/quartz/tests/colour.c
new file mode 100644
--- /dev/null
+++ b/dlls/quartz/tests/colour.c
@@ -0,0 +1,364 @@
+/*
+ * Color Space Converter tests
+ *
+ * Copyright 2026 GloriousEggroll
+ *
