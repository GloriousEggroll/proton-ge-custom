+        {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
 static const GUID *const wmv_decoder_input_types[] =
 {
     &MEDIASUBTYPE_WMV1,
@@ -2533,6 +2535,8 @@
     &MFVideoFormat_theora,
     &MFVideoFormat_AV1,
     &MFVideoFormat_VP90,
+    &MFVideoFormat_MP43,
+    &MFVideoFormat_mp43,
 };
 static const GUID *const wmv_decoder_output_types[] =
 {

