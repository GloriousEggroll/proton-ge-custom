 }
 
 static HRESULT source_reader_pull_transform_samples(struct source_reader *reader, struct media_stream *stream,
-        struct transform_entry *entry);
+        struct transform_entry *entry, BOOL draining);
 static inline BOOL source_reader_is_nonfatal_transform_status(HRESULT hr)
 {
     return hr == MF_E_TRANSFORM_NEED_MORE_INPUT || hr == MF_E_END_OF_STREAM;
@@ -1156,20 +1172,50 @@
 
     do
     {
-        if (FAILED(hr = source_reader_pull_transform_samples(reader, stream, entry))
+        if (FAILED(hr = source_reader_pull_transform_samples(reader, stream, entry, FALSE))
                 && !source_reader_is_nonfatal_transform_status(hr))
             return hr;
         if (SUCCEEDED(hr = IMFTransform_ProcessInput(entry->transform, 0, sample, 0)))
         {
-            hr = source_reader_pull_transform_samples(reader, stream, entry);
+            hr = source_reader_pull_transform_samples(reader, stream, entry, FALSE);
             return hr == MF_E_TRANSFORM_NEED_MORE_INPUT ? S_OK : hr;
         }
     }
     while (hr == MF_E_NOTACCEPTING);
 
     return hr;
 }
 
+static HRESULT source_reader_push_drain_sample(struct source_reader *reader, struct media_stream *stream,
+        struct transform_entry *entry, IMFSample *sample, BOOL *accepted)
+{
+    unsigned int attempt;
+    HRESULT hr;
+
+    *accepted = FALSE;
+    for (attempt = 1; attempt <= 2; ++attempt)
+    {
+        hr = IMFTransform_ProcessInput(entry->transform, 0, sample, 0);
+        if (SUCCEEDED(hr))
+        {
+            *accepted = TRUE;
+            return source_reader_pull_transform_samples(reader, stream, entry, TRUE);
+        }
+        if (hr != MF_E_NOTACCEPTING)
+            return hr;
+        if (!stream->requests)
+            return S_OK;
+
+        hr = source_reader_pull_transform_samples(reader, stream, entry, TRUE);
+        if (FAILED(hr) && !source_reader_is_nonfatal_transform_status(hr))
+            return hr;
+        if (!stream->requests)
+            return S_OK;
+    }
+
+    return MF_E_NOTACCEPTING;
+}
