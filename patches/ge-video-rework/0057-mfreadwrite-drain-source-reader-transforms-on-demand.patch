+static HRESULT source_reader_end_stream(struct source_reader *reader, struct media_stream *stream)
+{
+    if (stream->state != STREAM_STATE_READY)
+        return S_OK;
+
+    return source_reader_begin_stream_drain(reader, stream);
+}
