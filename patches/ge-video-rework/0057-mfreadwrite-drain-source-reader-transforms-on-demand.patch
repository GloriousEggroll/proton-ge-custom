-static HRESULT source_reader_drain_transform_samples(struct source_reader *reader, struct media_stream *stream,
-        struct transform_entry *entry)
+static void source_reader_clear_drain_sample(struct media_stream *stream)
+{
+    if (stream->draining_sample)
+        IMFSample_Release(stream->draining_sample);
+    stream->draining_sample = NULL;
+    stream->draining_sample_transform = NULL;
+}
+
+static void source_reader_cancel_stream_drain(struct media_stream *stream, enum media_stream_state state)
+{
+    stream->state = state;
+    stream->draining_transform = NULL;
+    source_reader_clear_drain_sample(stream);
+}
+
+static HRESULT source_reader_finish_stream_drain(struct source_reader *reader, struct media_stream *stream)
+{
+    HRESULT hr = S_OK, queue_hr;
+
+    source_reader_cancel_stream_drain(stream, STREAM_STATE_EOS);
+    while (stream->requests)
+    {
+        queue_hr = source_reader_queue_response(reader, stream, S_OK, MF_SOURCE_READERF_ENDOFSTREAM, 0, NULL);
+        if (FAILED(queue_hr))
+        {
+            hr = queue_hr;
+            break;
+        }
+    }
+
+    return hr;
+}
+
+static HRESULT source_reader_fail_stream_drain(struct source_reader *reader, struct media_stream *stream,
+        HRESULT status)
+{
+    HRESULT hr = S_OK, queue_hr;
+
+    source_reader_cancel_stream_drain(stream, STREAM_STATE_EOS);
+    while (stream->requests)
+    {
+        queue_hr = source_reader_queue_response(reader, stream, status, MF_SOURCE_READERF_ERROR, 0, NULL);
+        if (FAILED(queue_hr))
+        {
+            hr = queue_hr;
+            break;
+        }
+    }
+
+    return hr;
+}
+
+static HRESULT source_reader_start_transform_drain(struct transform_entry *entry)
+{
+    HRESULT hr;
+
+    hr = IMFTransform_ProcessMessage(entry->transform, MFT_MESSAGE_COMMAND_DRAIN, 0);
+    if (FAILED(hr))
+        WARN("Failed to drain transform %p, hr %#lx\n", entry->transform, hr);
+
+    return hr;
+}
+
+static HRESULT source_reader_begin_stream_drain(struct source_reader *reader, struct media_stream *stream)
 {
-    struct transform_entry *next = NULL;
     struct list *ptr;
     HRESULT hr;
 
-    if ((ptr = list_next(&stream->transforms, &entry->entry)))
-        next = LIST_ENTRY(ptr, struct transform_entry, entry);
+    stream->flags &= ~(STREAM_FLAG_SAMPLE_REQUESTED | STREAM_FLAG_EOS_REPORTED);
+    stream->state = STREAM_STATE_DRAINING;
+    stream->draining_transform = NULL;
+    source_reader_clear_drain_sample(stream);
 
-    if (FAILED(hr = IMFTransform_ProcessMessage(entry->transform, MFT_MESSAGE_COMMAND_DRAIN, 0)))
-        WARN("Failed to drain transform %p, hr %#lx\n", entry->transform, hr);
-    /* MF_E_SAMPLEALLOCATOR_EMPTY can occur here if many samples are drained
-     * from a transform, but it's not an issue if a later call succeeds. */
-    if (FAILED(hr = source_reader_pull_transform_samples(reader, stream, entry))
-            && !source_reader_is_nonfatal_transform_status(hr))
-        WARN("Failed to pull pending samples, hr %#lx.\n", hr);
+    if (!(ptr = list_head(&stream->transforms)))
+        return source_reader_finish_stream_drain(reader, stream);
 
-    return next ? source_reader_drain_transform_samples(reader, stream, next) : S_OK;
+    stream->draining_transform = LIST_ENTRY(ptr, struct transform_entry, entry);
+    if (FAILED(hr = source_reader_start_transform_drain(stream->draining_transform)))
+        return source_reader_fail_stream_drain(reader, stream, hr);
+    return source_reader_service_stream_drain(reader, stream);
+}
+
+static HRESULT source_reader_service_stream_drain(struct source_reader *reader, struct media_stream *stream)
+{
+    struct transform_entry *entry;
+    struct list *ptr;
+    HRESULT hr = S_OK;
+
+    while (stream->state == STREAM_STATE_DRAINING && stream->requests)
+    {
+        if (stream->draining_sample)
+        {
+            struct transform_entry *sample_transform = stream->draining_sample_transform;
+            IMFSample *sample = stream->draining_sample;
+            BOOL accepted;
+
+            stream->draining_sample = NULL;
+            stream->draining_sample_transform = NULL;
+            hr = source_reader_push_drain_sample(reader, stream, sample_transform, sample, &accepted);
+            if (!accepted && SUCCEEDED(hr))
+            {
+                stream->draining_sample = sample;
+                stream->draining_sample_transform = sample_transform;
+                break;
+            }
+            IMFSample_Release(sample);
+            if (FAILED(hr) && !source_reader_is_nonfatal_transform_status(hr))
+            {
+                WARN("Failed to submit retained drain sample, hr %#lx.\n", hr);
+                hr = source_reader_fail_stream_drain(reader, stream, hr);
+                break;
+            }
+            if (!stream->requests)
+                break;
+        }
+
+        entry = stream->draining_transform;
+        if (!entry)
+        {
+            hr = source_reader_fail_stream_drain(reader, stream, E_UNEXPECTED);
+            break;
+        }
+        hr = source_reader_pull_transform_samples(reader, stream, entry, TRUE);
+        if (hr == MF_E_TRANSFORM_NEED_MORE_INPUT || hr == MF_E_END_OF_STREAM)
+        {
+            if ((ptr = list_next(&stream->transforms, &entry->entry)))
+            {
+                stream->draining_transform = LIST_ENTRY(ptr, struct transform_entry, entry);
+                if (FAILED(hr = source_reader_start_transform_drain(stream->draining_transform)))
+                {
+                    hr = source_reader_fail_stream_drain(reader, stream, hr);
+                    break;
+                }
+                continue;
+            }
+
+            hr = source_reader_finish_stream_drain(reader, stream);
+            break;
+        }
+        if (FAILED(hr))
+        {
+            WARN("Failed to pull pending samples, hr %#lx.\n", hr);
+            hr = source_reader_fail_stream_drain(reader, stream, hr);
+            break;
+        }
+    }
+
+    return FAILED(hr) && !source_reader_is_nonfatal_transform_status(hr) ? hr : S_OK;
 }
 
