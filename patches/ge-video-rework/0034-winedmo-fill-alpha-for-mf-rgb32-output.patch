From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Proton GE Team <proton-ge@example.com>
Date: Wed, 19 Aug 2026 22:16:00 -0600
Subject: [PATCH] winedmo: Fill alpha for Media Foundation RGB32 output.

The legacy DMO decoder output path fills the high byte of RGB32 and ARGB32
frames with 0xff because texture renderers commonly interpret it as alpha.
The equivalent IMFTransform output path omitted that normalization. This can
leave otherwise valid decoded frames fully transparent when MediaEngine copies
them into a BGRA texture.

Apply the same opaque-alpha normalization to RGB32 and ARGB32 output produced
through IMFTransform.
---
 dlls/winedmo/video_decoder.c | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/dlls/winedmo/video_decoder.c b/dlls/winedmo/video_decoder.c
--- a/dlls/winedmo/video_decoder.c
+++ b/dlls/winedmo/video_decoder.c
@@ -383,6 +383,13 @@ static void flip_bottom_up_rgb_rows(BYTE *data, DWORD size, const DMO_MEDIA_TYPE
     free(tmp);
 }
 
+static void fill_32bit_alpha_bytes(BYTE *data, DWORD size)
+{
+    /* Texture renderers commonly treat the high RGB32 byte as alpha. */
+    for (DWORD i = 3; i < size; i += 4)
+        data[i] = 0xff;
+}
+
 static void fill_32bit_alpha(BYTE *data, DWORD size, const DMO_MEDIA_TYPE *type)
 {
     const VIDEOINFOHEADER *info;
@@ -396,9 +403,7 @@ static void fill_32bit_alpha(BYTE *data, DWORD size, const DMO_MEDIA_TYPE *type)
     if (info->bmiHeader.biBitCount != 32 || info->bmiHeader.biCompression != BI_RGB)
         return;
 
-    /* Texture renderers commonly treat the high RGB32 byte as alpha. */
-    for (DWORD i = 3; i < size; i += 4)
-        data[i] = 0xff;
+    fill_32bit_alpha_bytes(data, size);
 }
 
 static REFERENCE_TIME dmo_output_sample_duration(const DMO_MEDIA_TYPE *type)
@@ -1533,6 +1538,9 @@ static HRESULT WINAPI transform_ProcessOutput(IMFTransform *iface, DWORD flags,
     out_size = sample_size;
     ntstatus = winedmo_transform_get_output(decoder->winedmo_transform, data, &out_size,
             &pts, &dur, &out_flags);
+    if (!ntstatus && !(out_flags & WINEDMO_SAMPLE_FLAG_FORMAT_CHANGED)
+            && (IsEqualGUID(&subtype, &MFVideoFormat_RGB32) || IsEqualGUID(&subtype, &MFVideoFormat_ARGB32)))
+        fill_32bit_alpha_bytes(data, out_size);
     IMFMediaBuffer_Unlock(buffer);
 
     if (!ntstatus && (out_flags & WINEDMO_SAMPLE_FLAG_FORMAT_CHANGED))
-- 
2.52.0
