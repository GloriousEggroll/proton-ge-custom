From: Alexandre Derumier <aderumier@gmail.com>
Date: Fri, 23 Oct 2026 16:00:00 +0200
Subject: [PATCH] winedmo/wmvdecod: Expose MP42 video decoding.

Cooper's 9 (Konami, 2006) plays its movies (AVI, Microsoft MPEG-4 V2
video, MP42) through DirectShow into its own RGB24 texture renderer.
The AVI splitter exposes the MP42 stream, but quartz finds no decoder
for it: the AVI Decompressor has no MP42 VfW codec and no DMO lists the
subtype, so the video pin stays unconnected and the movies never show
(the game draws its movie quad white while the audio plays).

As for MP43 (0066), the FFmpeg backend already maps MP42 to
AV_CODEC_ID_MSMPEG4V2 through its RIFF tag table and the decoder is
enabled in the build; only the Windows-side registration and the
winedmo input-type allowlist leave it out.

Advertise MP42 and its lowercase spelling in the WMVideo MFT/DMO
bridge, next to MP43, and accept them in its shared decoder. The
subtype is kept, so FFmpeg selects Microsoft MPEG-4 V2. Extend the MP43
MF regression test to both MP42 spellings.

Tested with Cooper's 9: its MP42 movies play through the WMVideo
Decoder DMO in RGB24 (its WMV9 movies already did).
---

--- a/dlls/mf/tests/transform.c
+++ b/dlls/mf/tests/transform.c
@@ -61,6 +61,8 @@
 DEFINE_MEDIATYPE_GUID(MFVideoFormat_P208,MAKEFOURCC('P','2','0','8'));
 DEFINE_MEDIATYPE_GUID(MFVideoFormat_VC1S,MAKEFOURCC('V','C','1','S'));
 DEFINE_MEDIATYPE_GUID(MFVideoFormat_mp43,MAKEFOURCC('m','p','4','3'));
+DEFINE_MEDIATYPE_GUID(MFVideoFormat_MP42,MAKEFOURCC('M','P','4','2'));
+DEFINE_MEDIATYPE_GUID(MFVideoFormat_mp42,MAKEFOURCC('m','p','4','2'));
 
 DEFINE_GUID(mft_output_sample_incomplete,0xffffff,0xffff,0xffff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff);
 
@@ -6396,7 +6398,7 @@
 
 static void test_mp43_decoder(void)
 {
-    const GUID *subtypes[] = {&MFVideoFormat_MP43, &MFVideoFormat_mp43};
+    const GUID *subtypes[] = {&MFVideoFormat_MP43, &MFVideoFormat_mp43, &MFVideoFormat_MP42, &MFVideoFormat_mp42};
     const struct attribute_desc input_desc[] =
     {
         ATTR_GUID(MF_MT_MAJOR_TYPE, MFMediaType_Video),
@@ -6447,7 +6449,7 @@
         hr = MFTEnumEx(MFT_CATEGORY_VIDEO_DECODER, MFT_ENUM_FLAG_SYNCMFT,
                 &input_filter, &output_filter, &activates, &count);
         ok(hr == S_OK, "MFTEnumEx returned %#lx.\n", hr);
-        ok(count != 0, "No MP43 video decoder found.\n");
+        ok(count != 0, "No MS MPEG-4 video decoder found.\n");
         if (SUCCEEDED(hr) && count)
         {
             hr = IMFActivate_ActivateObject(activates[0], &IID_IMFTransform, (void **)&transform);
--- a/dlls/winedmo/video_decoder.c
+++ b/dlls/winedmo/video_decoder.c
@@ -2521,6 +2521,10 @@
 extern const GUID MEDIASUBTYPE_WMV_Unknown;
 static const GUID MFVideoFormat_mp43 = {MAKEFOURCC('m','p','4','3'), 0x0000, 0x0010,
         {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
+static const GUID MFVideoFormat_MP42 = {MAKEFOURCC('M','P','4','2'), 0x0000, 0x0010,
+        {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
+static const GUID MFVideoFormat_mp42 = {MAKEFOURCC('m','p','4','2'), 0x0000, 0x0010,
+        {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
 static const GUID *const wmv_decoder_input_types[] =
 {
     &MEDIASUBTYPE_WMV1,
@@ -2537,6 +2541,8 @@
     &MFVideoFormat_VP90,
     &MFVideoFormat_MP43,
     &MFVideoFormat_mp43,
+    &MFVideoFormat_MP42,
+    &MFVideoFormat_mp42,
 };
 static const GUID *const wmv_decoder_output_types[] =
 {
--- a/dlls/wmvdecod/wmvdecod.c
+++ b/dlls/wmvdecod/wmvdecod.c
@@ -37,6 +37,8 @@
 DEFINE_GUID(DMOVideoFormat_RGB555,D3DFMT_X1R5G5B5,0x524f,0x11ce,0x9f,0x53,0x00,0x20,0xaf,0x0b,0xa7,0x70);
 DEFINE_GUID(DMOVideoFormat_RGB8,D3DFMT_P8,0x524f,0x11ce,0x9f,0x53,0x00,0x20,0xaf,0x0b,0xa7,0x70);
 DEFINE_MEDIATYPE_GUID(MFVideoFormat_mp43,MAKEFOURCC('m','p','4','3'));
+DEFINE_MEDIATYPE_GUID(MFVideoFormat_MP42,MAKEFOURCC('M','P','4','2'));
+DEFINE_MEDIATYPE_GUID(MFVideoFormat_mp42,MAKEFOURCC('m','p','4','2'));
 
 /***********************************************************************
  *              DllGetClassObject (wmvdecod.@)
@@ -72,6 +74,8 @@
         {MFMediaType_Video, MFVideoFormat_VP90},
         {MFMediaType_Video, MFVideoFormat_MP43},
         {MFMediaType_Video, MFVideoFormat_mp43},
+        {MFMediaType_Video, MFVideoFormat_MP42},
+        {MFMediaType_Video, MFVideoFormat_mp42},
     };
     MFT_REGISTER_TYPE_INFO wmv_decoder_mft_outputs[] =
     {
@@ -116,6 +120,8 @@
         {.type = MEDIATYPE_Video, .subtype = MFVideoFormat_VP90},
         {.type = MEDIATYPE_Video, .subtype = MFVideoFormat_MP43},
         {.type = MEDIATYPE_Video, .subtype = MFVideoFormat_mp43},
+        {.type = MEDIATYPE_Video, .subtype = MFVideoFormat_MP42},
+        {.type = MEDIATYPE_Video, .subtype = MFVideoFormat_mp42},
     };
     HRESULT hr;
 
