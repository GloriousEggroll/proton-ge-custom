From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: theelderbeever <29295582+theelderbeever@users.noreply.github.com>
Date: Wed, 18 Nov 2026 19:10:00 -0700
Subject: [PATCH] mfmediaengine: Flush the immediate context after
 TransferVideoFrame.

TransferVideoFrame queues an UpdateSubresource or CopySubresourceRegion
on the destination's immediate context but never submits it. When the
destination texture is shared with a D3D12 renderer (Crimson Desert,
3321460) nothing else on that D3D11 device presents or flushes, so DXVK
only submits once ~48 MiB of staging uploads have accumulated. A 4K
frame crosses that almost every frame, but 720p skill-preview videos
only become visible every dozen frames or so, although decoding and
TransferVideoFrame both run at the full 24 fps.

Flush after each transfer so the frame is submitted immediately.
---
--- a/dlls/mfmediaengine/main.c
+++ b/dlls/mfmediaengine/main.c
@@ -3385,6 +3385,8 @@
     stage = "ID3D11DeviceContext_UpdateSubresource";
     ID3D11DeviceContext_UpdateSubresource(dst_context, (ID3D11Resource *)dst_texture,
             0, &dst_box, src_data, pitch, 0);
+    /* The destination may be shared with another API; submit the upload now. */
+    ID3D11DeviceContext_Flush(dst_context);
     hr = S_OK;
     if (diagnostic_id && diagnostic_id <= 4)
         WARN("Live DXGI transfer %ld queued the cross-device upload.\n", diagnostic_id);
@@ -3471,6 +3473,10 @@
     ID3D11Device_GetImmediateContext(device, &context);
     ID3D11DeviceContext_UpdateSubresource(context, (ID3D11Resource *)dst_texture,
             0, &dst_box, data, src_pitch, 0);
+    /* The destination may be shared with another API (e.g. a D3D12 game), which
+     * cannot see the upload until this context submits it. DXVK only submits
+     * on its own after ~48 MiB of uploads, i.e. every dozen or so 720p frames. */
+    ID3D11DeviceContext_Flush(context);
     hr = S_OK;
 
 done:
@@ -3685,6 +3691,7 @@
                 &dst_desc, &dst_box, diagnostic_id, "destination");
         WARN("Live DXGI transfer %ld queued the same-device copy through device %p.\n", diagnostic_id, device);
     }
+    ID3D11DeviceContext_Flush(context);
     ID3D11DeviceContext_Release(context);
 
     media_engine_unlock_d3d_device(engine, device);
