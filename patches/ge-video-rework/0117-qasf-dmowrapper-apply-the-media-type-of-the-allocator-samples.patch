From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alexandre Derumier <aderumier@gmail.com>
Date: Mon, 9 Nov 2026 08:30:00 +0100
Subject: [PATCH] qasf/dmowrapper: Apply the media type of the downstream
 allocator's samples.

A downstream allocator can ask for another output format by returning it
from the sample's GetMediaType() (a dynamic format change).
amstream's DirectDraw stream connects with the decoder's bottom-up RGB type
after checking that the decoder accepts the top-down one, then asks for the
top-down type this way, since its samples are DirectDraw surfaces. The
wrapper ignored it and the DMO kept writing bottom-up frames: videos played
through IAMMultiMediaStream were upside down (Burning Striker's intro).

Set the sample's media type as the DMO's output type and keep it as the
pin's type.
---
 dlls/qasf/dmowrapper.c | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

--- a/dlls/qasf/dmowrapper.c
+++ b/dlls/qasf/dmowrapper.c
@@ -225,8 +225,9 @@
     }
 }
 
-static HRESULT get_output_samples(struct dmo_wrapper *filter)
+static HRESULT get_output_samples(struct dmo_wrapper *filter, IMediaObject *dmo)
 {
+    AM_MEDIA_TYPE *mt;
     HRESULT hr;
     DWORD i;
 
@@ -241,6 +242,21 @@
                 release_output_samples(filter);
                 return hr;
             }
+            /* The downstream allocator may ask for another format (e.g. amstream's
+             * DirectDraw stream wants top-down RGB): switch the DMO's output to it. */
+            if (IMediaSample_GetMediaType(filter->sources[i].buffer.sample, &mt) == S_OK && mt)
+            {
+                TRACE("Source %lu: dynamic format change.\n", i);
+                strmbase_dump_media_type(mt);
+                if (SUCCEEDED(hr = IMediaObject_SetOutputType(dmo, i, mt, 0)))
+                {
+                    FreeMediaType(&filter->sources[i].pin.pin.mt);
+                    CopyMediaType(&filter->sources[i].pin.pin.mt, mt);
+                }
+                else
+                    WARN("Failed to set output type %lu, hr %#lx.\n", i, hr);
+                DeleteMediaType(mt);
+            }
             filter->buffers[i].pBuffer = &filter->sources[i].buffer.IMediaBuffer_iface;
             filter->sources[i].buffer.len = 0;
             IMediaSample_SetActualDataLength(filter->sources[i].buffer.sample, 0);
@@ -278,7 +294,7 @@
 
     do
     {
-        if (FAILED(hr = get_output_samples(filter)))
+        if (FAILED(hr = get_output_samples(filter, dmo)))
             return hr;
 
         hr = IMediaObject_ProcessOutput(dmo, DMO_PROCESS_OUTPUT_DISCARD_WHEN_NO_BUFFER,
-- 
2.47.0
