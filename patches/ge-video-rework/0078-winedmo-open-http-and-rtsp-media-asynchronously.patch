+        if (!(url = strdup( params->url ))) goto failed;
+        for (p = url; *p && *p != ':'; ++p) *p = av_tolower( *p );
+        if (!strncmp( url, "rtspt://", 8 ) || !strncmp( url, "rtspu://", 8 ))
+        {
+            av_dict_set( &options, "rtsp_transport", url[4] == 't' ? "tcp" : "udp", 0 );
