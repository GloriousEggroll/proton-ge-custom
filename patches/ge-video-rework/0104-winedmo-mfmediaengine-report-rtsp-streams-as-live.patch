From: l12436 <l12436@users.noreply.github.com>
Subject: [PATCH] winedmo, mfmediaengine: Report RTSP streams as live and don't
 signal waiting when playing them.

AVPro Video (VRChat's TopazPlayer) treats MF_MEDIA_ENGINE_EVENT_WAITING as
PlaybackStalled. media_engine_Play() always sends it, so for a live stream
that isn't in the loading network state AVPro keeps reloading the stream.

Report MFMEDIASOURCE_IS_LIVE for rtsp/rtspt/rtspu sources without a duration,
and skip the WAITING event in Play() for live sources.

This replaces the earlier workaround that kept live sources in the loading
network state.

Bug: https://github.com/GloriousEggroll/proton-ge-custom/issues/896
Bug: https://github.com/GloriousEggroll/proton-ge-custom/issues/892
Tested by the author with a TopazPlayer RTSP stream in VRChat.
---
--- a/dlls/mfmediaengine/main.c
+++ b/dlls/mfmediaengine/main.c
@@ -2803,6 +2803,8 @@
 {
     struct media_engine *engine = impl_from_IMFMediaEngineEx(iface);
     HRESULT hr = S_OK;
+    DWORD characteristics = 0;
+    BOOL is_live = FALSE;
 
     EnterCriticalSection(&engine->cs);
     WARN("%p enter flags %#x ready %u network %u.\n", iface, engine->flags, engine->ready_state,
@@ -2835,7 +2837,12 @@
         else if (engine->flags & FLAGS_ENGINE_PAUSE_PENDING)
             media_engine_set_flag(engine, FLAGS_ENGINE_PLAY_PENDING, TRUE);
 
-        media_engine_notify_live_event(engine, MF_MEDIA_ENGINE_EVENT_WAITING, 0, 0);
+        if (engine->presentation.source && SUCCEEDED(IMFMediaSource_GetCharacteristics(engine->presentation.source, &characteristics)))
+        {
+            is_live = !!(characteristics & MFMEDIASOURCE_IS_LIVE);
+        }
+        if (!is_live)
+            media_engine_notify_live_event(engine, MF_MEDIA_ENGINE_EVENT_WAITING, 0, 0);
     }
 
     WARN("%p leave hr %#lx flags %#x ready %u network %u.\n", iface, hr, engine->flags,
--- a/dlls/winedmo/media_source.c
+++ b/dlls/winedmo/media_source.c
@@ -350,6 +350,7 @@
     UINT64 duration;
     bool has_duration;
     bool is_network;
+    bool is_rtsp;
 
     struct winedmo_demuxer demuxer;
     struct
@@ -1986,6 +1987,7 @@
     {
         *characteristics = MFMEDIASOURCE_CAN_PAUSE;
         if (source->has_duration) *characteristics |= MFMEDIASOURCE_CAN_SEEK;
+        if (source->is_rtsp && !source->has_duration) *characteristics |= MFMEDIASOURCE_IS_LIVE;
     }
 
     LeaveCriticalSection(&source->cs);
@@ -2247,6 +2249,10 @@
             || !wcsnicmp(context->url, L"rtsp://", 7)
             || !wcsnicmp(context->url, L"rtspt://", 8)
             || !wcsnicmp(context->url, L"rtspu://", 8));
+    object->is_rtsp = context->url &&
+        (!wcsnicmp(context->url, L"rtsp://", 7)
+        || !wcsnicmp(context->url, L"rtspt://", 8)
+        || !wcsnicmp(context->url, L"rtspu://", 8));
     object->rate = 1.0f;
     InitializeCriticalSectionEx(&object->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
     object->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": cs");
