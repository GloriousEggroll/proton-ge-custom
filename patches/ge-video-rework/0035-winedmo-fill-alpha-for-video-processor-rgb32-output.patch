From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Proton GE Team <proton-ge@example.com>
Date: Thu, 20 Aug 2026 00:15:00 -0600
Subject: [PATCH] winedmo: Fill alpha for video processor RGB32 output.

Media Engine inserts the video processor when decoded HLS video is converted
from NV12 to ARGB32.  The decoder's opaque-alpha normalization therefore does
not see the final frame.  The raw video transform can leave the high byte
unset, causing an otherwise valid live-stream frame to be sampled as fully
transparent.

Normalize RGB32 and ARGB32 output produced by the video processor before it is
copied or uploaded to the destination sample.
---
 dlls/winedmo/video_processor.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/dlls/winedmo/video_processor.c b/dlls/winedmo/video_processor.c
--- a/dlls/winedmo/video_processor.c
+++ b/dlls/winedmo/video_processor.c
@@ -235,6 +235,20 @@ static void flip_rgb32_output(struct video_processor *impl, BYTE *data, UINT32 d
     free(tmp);
 }
 
+static void fill_rgb32_output_alpha(struct video_processor *impl, BYTE *data, UINT32 data_size)
+{
+    GUID subtype;
+    UINT32 i;
+
+    if (FAILED(IMFMediaType_GetGUID(impl->output_type, &MF_MT_SUBTYPE, &subtype))
+            || (!IsEqualGUID(&subtype, &MFVideoFormat_RGB32)
+                    && !IsEqualGUID(&subtype, &MFVideoFormat_ARGB32)))
+        return;
+
+    for (i = 3; i < data_size; i += 4)
+        data[i] = 0xff;
+}
+
 static HRESULT try_create_winedmo_transform(struct video_processor *impl)
 {
     BOOL bottom_up = !impl->device_manager; /* when not D3D-enabled, the transform outputs bottom up RGB buffers */
@@ -986,5 +1000,6 @@ static HRESULT video_processor_process_output_cpu(struct video_processor *proces
                 if (out_flags & WINEDMO_SAMPLE_FLAG_FORMAT_CHANGED)
                     return MF_E_TRANSFORM_STREAM_CHANGE;
+                fill_rgb32_output_alpha(processor, data, out_size);
                 flip_rgb32_output(processor, data, out_size);
                 if (SUCCEEDED(hr = video_processor_upload_d3d11_output(processor, output_sample, data, out_size)))
                 {
@@ -1024,6 +1039,7 @@ static HRESULT video_processor_process_output_cpu(struct video_processor *proces
             return MF_E_TRANSFORM_STREAM_CHANGE;
         }
         IMFMediaBuffer_SetCurrentLength(buffer, out_size);
+        fill_rgb32_output_alpha(processor, data, out_size);
         flip_rgb32_output(processor, data, out_size);
         if (out_pts != INT64_MIN)
         {
