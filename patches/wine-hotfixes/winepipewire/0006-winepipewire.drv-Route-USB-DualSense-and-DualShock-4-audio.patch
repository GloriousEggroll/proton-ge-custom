+static void sony_retarget_streams(void)
+{
+    /* An endpoint that came back is still on the added lists here. */
+    static struct list *const lists[] = { &g_render_devices, &g_capture_devices,
+                                          &g_render_added, &g_capture_added };
+    struct sony_target targets[SONY_RETARGET_MAX];
+    struct pipewire_stream *stream;
+    struct pw_phys_device *dev;
+    unsigned int n = 0, i, l;
+    enum pw_stream_state state;
+    const char *want;
+    uint32_t node_id;
+    char *copy;
+
+    pthread_mutex_lock(&device_lists_mutex);
+    for (l = 0; l < ARRAY_SIZE(lists); l++)
+    {
+        LIST_FOR_EACH_ENTRY(dev, lists[l], struct pw_phys_device, entry)
+        {
+            if (!dev->sony_usb || n == SONY_RETARGET_MAX ||
+                find_device_in(&g_render_removed, dev->pw_name) ||
+                find_device_in(&g_capture_removed, dev->pw_name))
+                continue;
+            lstrcpynA(targets[n].endpoint, dev->pw_name, sizeof(targets[n].endpoint));
+            targets[n].flow = dev->flow;
+            lstrcpynA(targets[n].node, dev_node(dev), sizeof(targets[n].node));
+            lstrcpynA(targets[n].haptic, dev->haptic_node ? dev->haptic_node : "",
+                      sizeof(targets[n].haptic));
+            n++;
+        }
+    }
+    pthread_mutex_unlock(&device_lists_mutex);
+    if (!n)
+        return;
+
+    pw_thread_loop_lock(pw_loop_global);
+    LIST_FOR_EACH_ENTRY(stream, &g_streams, struct pipewire_stream, entry)
+    {
+        if (!stream->sony || !stream->pw)
+            continue;
+        for (i = 0; i < n; i++)
+            if (!strcmp(targets[i].endpoint, stream->device) &&
+                (targets[i].flow == stream->dataflow || targets[i].flow == eRender))
+                break;
+        if (i == n)
+            continue;
+        want = stream->haptic ? targets[i].haptic : targets[i].node;
+        if (!want[0])
+            continue;
+        state = pw_stream_get_state(stream->pw, NULL);
+        if (state == PW_STREAM_STATE_ERROR || state == PW_STREAM_STATE_UNCONNECTED)
+        {
+            if (!(copy = strdup(want)))
+                continue;
+            TRACE("Reconnecting stream %p on %s to %s.\n", stream, debugstr_a(stream->device),
+                  debugstr_a(want));
+            if (sony_reconnect_stream(stream, want))
+            {
+                free(stream->target);
+                stream->target = copy;
+            }
+            else
+                free(copy);
+            continue;
+        }
+        if (!strcmp(want, stream->target))
+            continue;
+        if (!hp_meta || (node_id = pw_stream_get_node_id(stream->pw)) == SPA_ID_INVALID)
+        {
+            WARN("Cannot move stream %p from %s to %s.\n", stream, debugstr_a(stream->target),
+                 debugstr_a(want));
+            continue;
+        }
+        if (!(copy = strdup(want)))
+            continue;
+        TRACE("Moving stream %p on %s from %s to %s.\n", stream, debugstr_a(stream->device),
+              debugstr_a(stream->target), debugstr_a(want));
+        pw_metadata_set_property(hp_meta, node_id, "target.object", NULL, want);
+        free(stream->target);
+        stream->target = copy;
+    }
+    pw_thread_loop_unlock(pw_loop_global);
+}
