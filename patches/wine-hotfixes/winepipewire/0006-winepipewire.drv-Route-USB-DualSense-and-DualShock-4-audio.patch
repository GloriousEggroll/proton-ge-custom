+/* Called with the loop lock held.  A stream whose target went away stopped
+ * with "defined target not found"; connect it again, like winepulse's
+ * disconnect and reconnect of its controller speaker streams. */
+static BOOL sony_reconnect_stream(struct pipewire_stream *stream, const char *target)
+{
+    struct spa_dict_item item = SPA_DICT_ITEM_INIT(PW_KEY_TARGET_OBJECT, target);
+    struct spa_dict dict = SPA_DICT_INIT(&item, 1);
+    uint8_t buffer[1024];
+    struct spa_pod_builder b = SPA_POD_BUILDER_INIT(buffer, sizeof(buffer));
+    const struct spa_pod *params[1];
+    int rc;
+
+    if (!(params[0] = spa_format_audio_raw_build(&b, SPA_PARAM_EnumFormat, &stream->info)))
+        return FALSE;
+    pw_stream_disconnect(stream->pw);
+    pw_stream_update_properties(stream->pw, &dict);
+    rc = pw_stream_connect(stream->pw, stream->dataflow == eRender ? PW_DIRECTION_OUTPUT : PW_DIRECTION_INPUT,
+                           PW_ID_ANY, stream->connect_flags, params, 1);
+    if (rc < 0)
+    {
+        WARN("pw_stream_connect failed for stream %p: %d.\n", stream, rc);
+        return FALSE;
+    }
+    if (__atomic_load_n(&stream->started, __ATOMIC_ACQUIRE) && pw_stream_set_active(stream->pw, true) < 0)
+        WARN("pw_stream_set_active failed for stream %p.\n", stream);
+    return TRUE;
+}
