+/* A Sony speaker endpoint can stay while its node changes: another controller
+ * model took its id over, or the controller came back on another ALSA card.
+ * Move its streams the way winepulse reconnects them. */
+#define SONY_RETARGET_MAX 16
+
+struct sony_target
+{
+    char endpoint[256];
+    EDataFlow flow;
+    char node[256];
+    char haptic[256];
+};
