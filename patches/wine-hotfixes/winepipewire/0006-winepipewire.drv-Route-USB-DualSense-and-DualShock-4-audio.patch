+/* USB Sony controllers.
+ *
+ * mmdevapi recognises these endpoints by the ids winepulse gives them (see
+ * devenum.c), so this follows winepulse's scheme:
+ * - a DualSense speaker sink has one canonical id per model, which stays when
+ *   another controller of that model replaces it;
+ * - a second controller of the same model gets "#wine-sony-physical-<container>";
+ * - its other endpoints get "#wine-dualsense-hotplug-<n>", fresh each time the
+ *   controller appears, or "#wine-sony-hotplug-<container>" with Windows
+ *   device names.
+ * winepulse also had to reach the DualSense's four-channel hardware PCM, which
+ * PipeWire's UCM profile hides behind a split node, through the PipeWire ALSA
+ * plugin or raw ALSA.  Here a haptics stream targets that node directly. */
+
+#define DUALSENSE_MONO_ENDPOINT_ID \
+    "alsa_output.usb-Sony_Interactive_Entertainment_Wireless_Controller-00.HiFi__Speaker__sink"
+#define DUALSENSE_EDGE_MONO_ENDPOINT_ID \
+    "alsa_output.usb-Sony_Interactive_Entertainment_DualSense_Edge_Wireless_Controller-00.Default__Speaker__sink"
+
+static struct list g_render_added;
+
+static BOOL env_is_1(const char *name)
+{
+    const char *env = getenv(name);
+
+    return env && env[0] == '1' && !env[1];
+}
+
+static BOOL use_death_stranding_controller_effects(void)
+{
+    return env_is_1("PROTON_DEATH_STRANDING_CONTROLLER_EFFECTS");
+}
+
+/* winepulse's use_pipewire_dualsense_haptic_target(): the game's speaker
+ * audio on channel 2 of the haptics stream is kept and the controller is
+ * switched to its speaker, and channel 1 is muted. */
+static BOOL sony_haptics_carry_speaker(void)
+{
+    return env_is_1("PROTON_DUALSENSE_HAPTICS_PREFER_NON_EVENT") ||
+           use_death_stranding_controller_effects() || bt_windows_audio_mode();
+}
+
+/* PROTON_DUALSENSE_SPLIT_AUDIO.  winepulse sends channel 2 to the public
+ * speaker sink, which the UCM profile feeds into the same hardware channel, and
+ * mutes channels 1 and 2 of the raw stream.  Keeping channel 2 in the stream
+ * reaches that hardware channel directly. */
+static BOOL sony_split_audio(void)
+{
+    return env_is_1("PROTON_DUALSENSE_SPLIT_AUDIO") || use_death_stranding_controller_effects();
+}
+
+static BOOL sony_usb_product(UINT16 vendor_id, UINT16 product_id)
+{
+    return vendor_id == 0x054c && (product_id == 0x05c4 || product_id == 0x09cc ||
+                                   product_id == 0x0ce6 || product_id == 0x0df2);
+}
+
+static BOOL sony_is_dualshock(const struct pw_phys_device *dev)
+{
+    return dev->sony_usb && (dev->product_id == 0x05c4 || dev->product_id == 0x09cc);
+}
+
+static BOOL sony_is_speaker_sink(const struct pw_phys_device *dev)
+{
+    const char *node = dev_node(dev);
+
+    if (dev->flow != eRender)
+        return FALSE;
+    if (sony_is_dualshock(dev))
+        return strstr(node, "Speaker__sink") || strstr(node, "analog-stereo");
+    return strstr(node, "Speaker__sink") &&
+           (dev->sony_usb || (strstr(node, "alsa_output.usb-Sony_Interactive_Entertainment_") &&
+                              strstr(node, "Wireless_Controller")));
+}
+
+/* Windows exposes the DualSense USB audio function as one four-channel
+ * endpoint.  The UCM profile makes the speaker a mono sink, but games still
+ * write the actuators to channels 3 and 4 of that endpoint. */
+static BOOL sony_windows_quad(const struct pw_phys_device *dev)
+{
+    return bt_use_windows_names() && sony_is_speaker_sink(dev) && !sony_is_dualshock(dev);
+}
+
+static void sony_apply_windows_format(const struct pw_phys_device *dev, WAVEFORMATEXTENSIBLE *fmt)
+{
+    WAVEFORMATEX *wfx = &fmt->Format;
+
+    if (!sony_windows_quad(dev))
+        return;
+    /* Keep the probed sample type. */
+    wfx->wFormatTag = WAVE_FORMAT_EXTENSIBLE;
+    wfx->nChannels = 4;
+    wfx->nSamplesPerSec = 48000;
+    wfx->nBlockAlign = wfx->nChannels * wfx->wBitsPerSample / 8;
+    wfx->nAvgBytesPerSec = wfx->nSamplesPerSec * wfx->nBlockAlign;
+    wfx->cbSize = sizeof(WAVEFORMATEXTENSIBLE) - sizeof(WAVEFORMATEX);
+    fmt->dwChannelMask = KSAUDIO_SPEAKER_QUAD;
+}
+
+static const char *sony_render_endpoint_base(const struct pw_phys_device *dev)
+{
+    if (dev->flow != eRender || !dev->sony_usb)
+        return NULL;
+    if (dev->product_id == 0x0df2 || strstr(dev_node(dev), "DualSense_Edge_Wireless_Controller"))
+        return DUALSENSE_EDGE_MONO_ENDPOINT_ID;
+    return DUALSENSE_MONO_ENDPOINT_ID;
+}
+
+static BOOL sony_same_physical(const struct pw_phys_device *a, const struct pw_phys_device *b)
+{
+    if (!IsEqualGUID(&a->container_id, &GUID_NULL) && !IsEqualGUID(&b->container_id, &GUID_NULL))
+        return IsEqualGUID(&a->container_id, &b->container_id);
+    return !strcmp(dev_node(a), dev_node(b));
+}
+
+static char *sony_tagged_id(const char *base, const char *tag, const GUID *g)
+{
+    char id[512];
+
+    snprintf(id, sizeof(id), "%s#wine-sony-%s-%08x-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x",
+             base, tag, (unsigned int)g->Data1, g->Data2, g->Data3, g->Data4[0], g->Data4[1],
+             g->Data4[2], g->Data4[3], g->Data4[4], g->Data4[5], g->Data4[6], g->Data4[7]);
+    return strdup(id);
+}
+
+static char *sony_physical_id(const struct pw_phys_device *dev, const char *base)
+{
+    if (IsEqualGUID(&dev->container_id, &GUID_NULL))
+        return strdup(dev_node(dev));
+    return sony_tagged_id(base, "physical", &dev->container_id);
+}
+
+/* The lists a new render endpoint is compared with: the endpoints of the
+ * probe being built that precede it, then those mmdevapi has or is about to
+ * get.  device_lists_mutex is held. */
+struct sony_scope
+{
+    struct list *lists[3];
+    struct pw_phys_device *stop[3];
+};
+
+static void sony_scope_init(struct sony_scope *scope, struct list *current, struct pw_phys_device *dev)
+{
+    unsigned int n = 0;
+
+    scope->lists[n] = current;
+    scope->stop[n++] = dev;
+    if (current != &g_render_devices)
+    {
+        scope->lists[n] = &g_render_devices;
+        scope->stop[n++] = NULL;
+    }
+    if (current != &g_render_added)
+    {
+        scope->lists[n] = &g_render_added;
+        scope->stop[n++] = NULL;
+    }
+    for (; n < ARRAY_SIZE(scope->lists); n++)
+        scope->lists[n] = NULL;
+}
+
+#define SONY_SCOPE_FOR_EACH(other, scope, i) \
+    for (i = 0; i < ARRAY_SIZE((scope)->lists) && (scope)->lists[i]; i++) \
+        LIST_FOR_EACH_ENTRY(other, (scope)->lists[i], struct pw_phys_device, entry) \
+            if (other == (scope)->stop[i]) break; else
+
+static BOOL sony_assign_render_id(struct pw_phys_device *dev, struct list *current)
+{
+    struct pw_phys_device *other, *canonical = NULL;
+    const char *base = sony_render_endpoint_base(dev), *other_base;
+    struct sony_scope scope;
+    BOOL conflict = FALSE;
+    unsigned int i;
+    char *id;
+
+    sony_scope_init(&scope, current, dev);
+
+    /* An endpoint of this controller already has an id. */
+    SONY_SCOPE_FOR_EACH(other, &scope, i)
+    {
+        if ((other_base = sony_render_endpoint_base(other)) && !strcmp(other_base, base) &&
+            sony_same_physical(dev, other))
+        {
+            if (!(id = strdup(other->pw_name)))
+                return FALSE;
+            free(dev->pw_name);
+            dev->pw_name = id;
+            return TRUE;
+        }
+    }
+
+    if (!sony_is_speaker_sink(dev))
+        return FALSE;
+
+    /* The canonical id goes to the lowest ALSA card. */
+    LIST_FOR_EACH_ENTRY(other, current, struct pw_phys_device, entry)
+    {
+        if (other == dev)
+            break;
+        if ((other_base = sony_render_endpoint_base(other)) && !strcmp(other_base, base) &&
+            !strcmp(other->pw_name, base) && !sony_same_physical(dev, other))
+        {
+            canonical = other;
+            break;
+        }
+    }
+    if (canonical && dev->alsa_card >= 0 &&
+        (canonical->alsa_card < 0 || dev->alsa_card < canonical->alsa_card))
+    {
+        char *physical = sony_physical_id(canonical, base);
+
+        if (!physical || !(id = strdup(base)))
+        {
+            free(physical);
+            return TRUE;
+        }
+        TRACE("canonical Sony endpoint %s moves from ALSA card %d to card %d\n",
+              base, canonical->alsa_card, dev->alsa_card);
+        free(canonical->pw_name);
+        canonical->pw_name = physical;
+        free(dev->pw_name);
+        dev->pw_name = id;
+        return TRUE;
+    }
+
+    SONY_SCOPE_FOR_EACH(other, &scope, i)
+    {
+        if ((other_base = sony_render_endpoint_base(other)) && !strcmp(other_base, base) &&
+            !sony_same_physical(dev, other))
+            conflict = TRUE;
+    }
+    if ((id = conflict ? sony_physical_id(dev, base) : strdup(base)))
+    {
+        free(dev->pw_name);
+        dev->pw_name = id;
+    }
+    return TRUE;
+}
+
+/* Hotplug ids stay while the endpoint does: probes repeat on every graph
+ * change, and a new id would make mmdevapi drop and re-add the endpoint. */
+struct sony_hotplug_id
+{
+    struct list entry;
+    char *base;
+    EDataFlow flow;
+    char *id;
+    BOOL seen;
+};
+
+static struct list sony_hotplug_ids = LIST_INIT(sony_hotplug_ids); /* device_lists_mutex */
+static unsigned int sony_hotplug_generation;
+
+static void sony_assign_hotplug_id(struct pw_phys_device *dev)
+{
+    struct sony_hotplug_id *entry;
+    char buf[512], *id;
+
+    LIST_FOR_EACH_ENTRY(entry, &sony_hotplug_ids, struct sony_hotplug_id, entry)
+    {
+        if (entry->flow == dev->flow && !strcmp(entry->base, dev->pw_name))
+        {
+            entry->seen = TRUE;
+            if ((id = strdup(entry->id)))
+            {
+                free(dev->pw_name);
+                dev->pw_name = id;
+            }
+            return;
+        }
+    }
+
+    if (!bt_use_windows_names())
+    {
+        snprintf(buf, sizeof(buf), "%s#wine-dualsense-hotplug-%u", dev->pw_name, ++sony_hotplug_generation);
+        id = strdup(buf);
+    }
+    else
+        id = sony_tagged_id(dev->pw_name, "hotplug", &dev->container_id);
+    if (!id)
+        return;
+    if ((entry = calloc(1, sizeof(*entry))) && (entry->base = strdup(dev->pw_name)) &&
+        (entry->id = strdup(id)))
+    {
+        entry->flow = dev->flow;
+        entry->seen = TRUE;
+        list_add_tail(&sony_hotplug_ids, &entry->entry);
+    }
+    else if (entry)
+    {
+        free(entry->base);
+        free(entry);
+    }
+    free(dev->pw_name);
+    dev->pw_name = id;
+}
+
+static void sony_assign_ids(struct list *list)
+{
+    struct pw_phys_device *dev;
+
+    LIST_FOR_EACH_ENTRY(dev, list, struct pw_phys_device, entry)
+    {
+        if (!dev->sony_usb)
+            continue;
+        if (!(sony_render_endpoint_base(dev) && sony_assign_render_id(dev, list)) &&
