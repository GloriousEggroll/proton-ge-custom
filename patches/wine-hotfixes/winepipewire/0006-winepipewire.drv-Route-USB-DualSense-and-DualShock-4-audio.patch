+/* After a probe: a controller that went away gets a new id when it returns. */
+static void sony_prune_hotplug_ids(void)
+{
+    struct sony_hotplug_id *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(entry, next, &sony_hotplug_ids, struct sony_hotplug_id, entry)
+    {
+        if (entry->seen)
+        {
+            entry->seen = FALSE;
+            continue;
+        }
+        list_remove(&entry->entry);
+        free(entry->base);
+        free(entry->id);
+        free(entry);
+    }
+}
