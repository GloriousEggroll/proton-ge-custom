+/* Fills the Sony fields of a node's endpoint.  A monitor gets the ".monitor"
+ * name mmdevapi expects from winepulse's monitor sources. */
+static void sony_fill_device(struct pw_phys_device *dev, struct probe_node *pn, BOOL monitor)
+{
+    char *name;
+
+    dev->flow = monitor ? eCapture : pn->flow;
+    dev->monitor = monitor;
+    dev->alsa_card = pn->alsa_card;
+    if (!(dev->sony_usb = dev->bus == PW_BUS_USB && sony_usb_product(dev->vendor_id, dev->product_id)))
+        return;
+    if (!(dev->node = strdup(pn->node_name)))
+    {
+        dev->sony_usb = FALSE;
+        return;
+    }
+    if (monitor && (name = malloc(strlen(pn->node_name) + sizeof(".monitor"))))
+    {
+        sprintf(name, "%s.monitor", pn->node_name);
+        free(dev->pw_name);
+        dev->pw_name = name;
+    }
+    if (monitor || dev->flow != eRender || sony_is_dualshock(dev))
+        return;
+    if (pn->split_name)
+    {
+        /* WirePlumber's split parent: api.alsa.split.hw-position. */
+        if ((dev->haptic_node = strdup(pn->split_name)))
+        {
+            dev->haptic_pos[0] = SPA_AUDIO_CHANNEL_AUX0;
+            dev->haptic_pos[1] = SPA_AUDIO_CHANNEL_AUX1;
+            dev->haptic_pos[2] = SPA_AUDIO_CHANNEL_AUX2;
+            dev->haptic_pos[3] = SPA_AUDIO_CHANNEL_AUX3;
+        }
+    }
+    else if (pn->have_format && pn->channels == 4)
+    {
+        /* The node is the hardware PCM: the ACP 4.0 profile, or UCM's Direct. */
+        if ((dev->haptic_node = strdup(pn->node_name)))
+            memcpy(dev->haptic_pos, pn->position, sizeof(dev->haptic_pos));
+    }
+    TRACE("Sony %04x endpoint %s card %d haptics %s\n", dev->product_id, pn->node_name,
+          dev->alsa_card, debugstr_a(dev->haptic_node));
+}
