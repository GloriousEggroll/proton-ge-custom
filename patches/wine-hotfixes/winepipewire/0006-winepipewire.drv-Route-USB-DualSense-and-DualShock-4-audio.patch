+    if (stream->info.format == SPA_AUDIO_FORMAT_F32_LE)
+    {
+        float *s = (float *)buffer;
+
+        for (i = 0; i < frames; i++, s += 4)
+        {
+            s[0] = 0.f;
+            signal |= s[1] != 0.f;
+        }
+    }
+    else
+    {
+        INT16 *s = (INT16 *)buffer;
+
+        for (i = 0; i < frames; i++, s += 4)
+        {
+            s[0] = 0;
+            signal |= s[1] != 0;
+        }
+    }
+    if (!carry || !signal || stream->speaker_selected)
+        return FALSE;
+    {
+        struct timespec ts;
+        UINT64 now;
+
+        clock_gettime(CLOCK_MONOTONIC, &ts);
+        now = (UINT64)ts.tv_sec * 1000000000 + ts.tv_nsec;
+        if (now < stream->speaker_retry_ns)
+            return FALSE;
+        stream->speaker_retry_ns = now + 1000000000;
+    }
+    return TRUE;
+}
