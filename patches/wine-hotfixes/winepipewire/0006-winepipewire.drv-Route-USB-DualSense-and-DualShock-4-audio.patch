+/* winepulse's pulse_select_dualsense_usb_speaker(): an output report that
+ * switches every USB DualSense to its internal speaker, for games whose
+ * speaker audio rides in the haptics stream. */
+static BOOL sony_select_usb_speaker(void)
+{
+    static const BYTE report[63] =
+    {
+        [0] = 0x02,  /* USB output report. */
+        [1] = 0xa0,  /* Speaker volume and audio routing are valid. */
+        [2] = 0x80,  /* Speaker pre-gain is valid. */
+        [6] = 0x64,  /* Speaker volume. */
+        [8] = 0x30,  /* Route audio to the internal speaker. */
+        [38] = 0x02, /* Speaker pre-gain. */
+    };
+    char path[PATH_MAX], line[256];
+    unsigned int bus, vid, pid;
+    BOOL found = FALSE, selected = FALSE;
+    struct dirent *entry;
+    ssize_t written;
+    DIR *dir;
+    FILE *f;
+    int fd;
+
+    if (!(dir = opendir("/sys/class/hidraw")))
+        return FALSE;
+    while ((entry = readdir(dir)))
+    {
+        if (strncmp(entry->d_name, "hidraw", 6))
+            continue;
+        snprintf(path, sizeof(path), "/sys/class/hidraw/%s/device/uevent", entry->d_name);
+        if (!(f = fopen(path, "r")))
+            continue;
+        bus = vid = pid = 0;
+        while (fgets(line, sizeof(line), f))
+            if (sscanf(line, "HID_ID=%x:%x:%x", &bus, &vid, &pid) == 3)
+                break;
+        fclose(f);
+        if (bus != 0x03 || vid != 0x054c || (pid != 0x0ce6 && pid != 0x0df2))
+            continue;
+
+        found = TRUE;
+        snprintf(path, sizeof(path), "/dev/%s", entry->d_name);
+        if ((fd = open(path, O_RDWR | O_CLOEXEC)) == -1)
+        {
+            WARN("Unable to open %s to select the DualSense USB speaker: %s.\n", path, strerror(errno));
+            continue;
+        }
+        written = write(fd, report, sizeof(report));
+        close(fd);
+        if (written == sizeof(report))
+        {
+            TRACE("Selected the USB internal speaker on Sony controller %04x at %s.\n", pid, path);
+            selected = TRUE;
+        }
+        else
+            WARN("Failed to select the USB internal speaker on Sony controller %04x at %s: "
+                 "wrote %ld of %u bytes, errno %d.\n", pid, path, (long)written,
+                 (unsigned int)sizeof(report), errno);
+    }
+    closedir(dir);
+    if (!found)
+        WARN("No USB DualSense hidraw device was found to select the internal speaker.\n");
+    return selected;
