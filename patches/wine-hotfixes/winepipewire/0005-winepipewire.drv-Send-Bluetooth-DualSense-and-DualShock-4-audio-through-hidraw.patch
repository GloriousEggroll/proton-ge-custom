+/* Both match the conditions under which winebus presents the controller as USB. */
+static BOOL bt_dualsense_haptics_enabled(void)
+{
+    const char *env;
+
+    if ((env = getenv("PROTON_DUALSENSE_BT_AS_USB")) && !strcmp(env, "0"))
+        return FALSE;
+    if ((env = getenv("PROTON_DUALSENSE_BT_HAPTICS")) && !strcmp(env, "0"))
+        return FALSE;
+    if ((env = getenv("PROTON_EMULATE_STEAMINPUT")) && atoi(env))
+        return FALSE;
+    if ((env = getenv("PROTON_NO_STEAMINPUT")) && !strcmp(env, "1"))
+        return TRUE;
+    return !steam_virtual_gamepad_present();
+}
+
+static BOOL bt_dualshock4_audio_enabled(void)
+{
+    const char *env;
+
+    if ((env = getenv("PROTON_DUALSHOCK4_BT_AS_USB")) && !strcmp(env, "0"))
+        return FALSE;
+    if ((env = getenv("PROTON_DUALSHOCK4_BT_AUDIO")) && !strcmp(env, "0"))
+        return FALSE;
+    if ((env = getenv("PROTON_EMULATE_STEAMINPUT")) && atoi(env))
+        return FALSE;
+    if ((env = getenv("PROTON_NO_STEAMINPUT")) && !strcmp(env, "1"))
+        return TRUE;
+    return !steam_virtual_gamepad_present();
+}
+
+/* Must match set_bluetooth_dualsense_container_id() in winebus. */
+static GUID bt_container_id(USHORT pid, const unsigned int *mac)
+{
+    GUID guid = {0};
+    unsigned int i;
+
+    guid.Data1 = MAKELONG(0x054c, pid);
+    guid.Data2 = 0x4254;
+    guid.Data3 = (mac[0] << 8) | mac[1];
+    for (i = 0; i < 4; ++i) guid.Data4[i] = mac[i + 2];
+    return guid;
+}
+
+static LONG windows_names_latched;
+
+void bt_latch_windows_names(void)
+{
+    InterlockedExchange(&windows_names_latched, 1);
+}
+
+/* As winepulse's use_windows_sony_controller_names(). */
+static BOOL use_windows_sony_controller_names(void)
+{
+    const char *env = getenv("PROTON_SONY_WINDOWS_DEVICE_NAMES");
+
+    if (env && env[0] == '1' && !env[1])
+        return TRUE;
+    if ((env = getenv("PROTON_DEATH_STRANDING_CONTROLLER_EFFECTS")) && env[0] == '1' && !env[1])
+        return TRUE;
+    return InterlockedCompareExchange(&windows_names_latched, 0, 0);
+}
+
+/* winepulse gives a Bluetooth DualSense endpoint a fresh id each time the
+ * controller appears, so games treat a reconnected controller as a new
+ * device: "#wine-dualsense-hotplug-<n>", or "#wine-sony-hotplug-<container>"
+ * with Windows device names.  Keep the id while the controller stays. */
+struct bt_endpoint_id
+{
+    struct list entry;
+    char base[160];
+    char *id;
+    BOOL seen;
+};
+
+static struct list bt_endpoint_ids = LIST_INIT(bt_endpoint_ids);
+static unsigned int bt_endpoint_generation;
+static pthread_mutex_t bt_ids_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static const char *bt_dualsense_endpoint_id(const char *base, const GUID *container)
+{
+    struct bt_endpoint_id *entry;
+    char id[256];
+
+    LIST_FOR_EACH_ENTRY(entry, &bt_endpoint_ids, struct bt_endpoint_id, entry)
+    {
+        if (!strcmp(entry->base, base))
+        {
+            entry->seen = TRUE;
+            return entry->id;
+        }
+    }
+
+    if (!use_windows_sony_controller_names())
+        snprintf(id, sizeof(id), "%s#wine-dualsense-hotplug-%u", base, ++bt_endpoint_generation);
+    else
+        snprintf(id, sizeof(id),
+                 "%s#wine-sony-hotplug-%08x-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x",
+                 base, (unsigned int)container->Data1, container->Data2, container->Data3,
+                 container->Data4[0], container->Data4[1], container->Data4[2], container->Data4[3],
+                 container->Data4[4], container->Data4[5], container->Data4[6], container->Data4[7]);
+
+    if (!(entry = calloc(1, sizeof(*entry))) || !(entry->id = strdup(id)))
+    {
+        free(entry);
+        return NULL;
+    }
+    lstrcpynA(entry->base, base, sizeof(entry->base));
+    entry->seen = TRUE;
+    list_add_tail(&bt_endpoint_ids, &entry->entry);
+    return entry->id;
+}
+
+struct bt_controller
+{
+    char hidraw[PATH_MAX];
+    unsigned int pid, mac[6];
+};
+
+/* Calls callback for each Bluetooth Sony controller; returns FALSE if it
+ * asked to stop. */
+static void bt_enum_controllers(BOOL (*callback)(const struct bt_controller *, void *), void *context)
+{
+    char path[PATH_MAX], line[256];
+    struct bt_controller c;
+    struct dirent *entry;
+    DIR *dir;
+    FILE *f;
+
+    if (!(dir = opendir("/sys/class/hidraw")))
+        return;
+    while ((entry = readdir(dir)))
+    {
+        unsigned int bus = 0, vid = 0;
+        BOOL have_mac = FALSE;
+
+        if (strncmp(entry->d_name, "hidraw", 6))
+            continue;
+        snprintf(path, sizeof(path), "/sys/class/hidraw/%s/device/uevent", entry->d_name);
+        if (!(f = fopen(path, "r")))
+            continue;
+        c.pid = 0;
+        while (fgets(line, sizeof(line), f))
+        {
+            if (!strncmp(line, "HID_ID=", 7))
+                sscanf(line + 7, "%x:%x:%x", &bus, &vid, &c.pid);
+            else if (!strncmp(line, "HID_UNIQ=", 9))
+                have_mac = sscanf(line + 9, "%x:%x:%x:%x:%x:%x", &c.mac[0], &c.mac[1], &c.mac[2],
+                                  &c.mac[3], &c.mac[4], &c.mac[5]) == 6;
+        }
+        fclose(f);
+
+        if (bus != 0x0005 || vid != 0x054c || !have_mac)
+            continue;
+        if (c.pid != 0x0ce6 && c.pid != 0x0df2 && c.pid != 0x05c4 && c.pid != 0x09cc)
+            continue;
+        snprintf(c.hidraw, sizeof(c.hidraw), "/dev/%s", entry->d_name);
+        if (!callback(&c, context))
+            break;
+    }
+    closedir(dir);
+}
+
+static BOOL is_dualshock4(unsigned int pid)
+{
+    return pid == 0x05c4 || pid == 0x09cc;
+}
+
+/* The device string without the hotplug suffix. */
+static void bt_base_name(const struct bt_controller *c, EDataFlow flow, char *buf, size_t size)
+{
+    if (is_dualshock4(c->pid))
+        snprintf(buf, size, "%sWireless_Controller.%04x.%02x%02x%02x%02x%02x%02x%s", BT_PULSE_PREFIX,
+                 c->pid, c->mac[0], c->mac[1], c->mac[2], c->mac[3], c->mac[4], c->mac[5],
+                 flow == eRender ? "" : ".mic");
+    else
+        snprintf(buf, size, "%s%s.%02x%02x%02x%02x%02x%02x", BT_PULSE_PREFIX,
+                 c->pid == 0x0df2 ? "DualSense_Edge_Wireless_Controller" : "DualSense_Wireless_Controller",
+                 c->mac[0], c->mac[1], c->mac[2], c->mac[3], c->mac[4], c->mac[5]);
+}
+
+struct enum_context
+{
+    bt_endpoint_cb callback;
+    void *context;
+    BOOL dualsense, dualshock4;
+};
+
+static BOOL enum_controller(const struct bt_controller *c, void *arg)
+{
+    struct enum_context *ctx = arg;
+    struct bt_endpoint ep = {0};
+    char base[160];
+
+    ep.vendor_id = 0x054c;
+    ep.product_id = c->pid;
+    ep.container_id = bt_container_id(c->pid, c->mac);
+
+    if (!is_dualshock4(c->pid))
+    {
+        if (!ctx->dualsense)
+            return TRUE;
+        bt_base_name(c, eRender, base, sizeof(base));
+        if (!(ep.name = bt_dualsense_endpoint_id(base, &ep.container_id)))
+            return TRUE;
+        ep.display = c->pid == 0x0df2 ? "DualSense Edge Wireless Controller" : "DualSense Wireless Controller";
+        ep.flow = eRender;
+        ep.form = Speakers;
+        ep.rate = 48000;
+        ep.channels = 4;
+        ep.channel_mask = SPEAKER_FL | SPEAKER_FR | SPEAKER_BL | SPEAKER_BR;
+        ctx->callback(&ep, ctx->context);
+        TRACE("Bluetooth DualSense haptics endpoint %s for %s.\n", debugstr_a(ep.name), c->hidraw);
+        return TRUE;
+    }
+
+    if (!ctx->dualshock4)
+        return TRUE;
+    /* Like the wired controller: a stereo 32 kHz speaker and a mono 16 kHz
+     * headset microphone. */
+    ep.display = "Wireless Controller";
+    bt_base_name(c, eRender, base, sizeof(base));
+    ep.name = base;
+    ep.flow = eRender;
+    ep.form = Speakers;
+    ep.rate = 32000;
+    ep.channels = 2;
+    ep.channel_mask = SPEAKER_FL | SPEAKER_FR;
+    ctx->callback(&ep, ctx->context);
+
+    bt_base_name(c, eCapture, base, sizeof(base));
+    ep.name = base;
+    ep.flow = eCapture;
+    ep.form = Headset;
+    ep.rate = 16000;
+    ep.channels = 1;
+    ep.channel_mask = SPEAKER_FC;
+    ctx->callback(&ep, ctx->context);
+    TRACE("Bluetooth DualShock 4 speaker and microphone endpoints for %s.\n", c->hidraw);
+    return TRUE;
+}
+
+void bt_enum_endpoints(bt_endpoint_cb callback, void *context)
+{
+    struct enum_context ctx = { callback, context, bt_dualsense_haptics_enabled(), bt_dualshock4_audio_enabled() };
+    struct bt_endpoint_id *entry, *next;
+
+    if (!ctx.dualsense && !ctx.dualshock4)
+        return;
+
+    pthread_mutex_lock(&bt_ids_lock);
+    LIST_FOR_EACH_ENTRY(entry, &bt_endpoint_ids, struct bt_endpoint_id, entry)
+        entry->seen = FALSE;
+    bt_enum_controllers(enum_controller, &ctx);
+    /* A controller that went away gets a new id when it comes back. */
+    LIST_FOR_EACH_ENTRY_SAFE(entry, next, &bt_endpoint_ids, struct bt_endpoint_id, entry)
+    {
+        if (entry->seen)
+            continue;
+        list_remove(&entry->entry);
+        free(entry->id);
+        free(entry);
+    }
+    pthread_mutex_unlock(&bt_ids_lock);
+}
+
+/* Changes when a hidraw device comes or goes, for the hotplug watcher. */
+unsigned int bt_hidraw_signature(void)
+{
+    unsigned int sig = 2166136261u;
+    struct dirent *entry;
+    const char *p;
+    DIR *dir;
+
+    if (!(dir = opendir("/sys/class/hidraw")))
+        return 0;
+    while ((entry = readdir(dir)))
+    {
+        if (strncmp(entry->d_name, "hidraw", 6))
+            continue;
+        /* Order-independent: readdir order is not stable. */
+        {
+            unsigned int h = 2166136261u;
+
+            for (p = entry->d_name; *p; p++)
+                h = (h ^ (unsigned char)*p) * 16777619u;
+            sig += h;
+        }
+    }
+    closedir(dir);
+    return sig;
+}
+
+BOOL bt_is_device(const char *device)
+{
+    return device && !strncmp(device, BT_PULSE_PREFIX, sizeof(BT_PULSE_PREFIX) - 1);
+}
+
+struct resolve_context
+{
+    const char *device;
+    size_t len;
+    struct bt_controller found;
+    BOOL ok;
+    EDataFlow flow;
+};
+
+static BOOL resolve_controller(const struct bt_controller *c, void *arg)
+{
+    struct resolve_context *ctx = arg;
+    char base[160];
+
+    bt_base_name(c, ctx->flow, base, sizeof(base));
+    if (strlen(base) != ctx->len || strncmp(base, ctx->device, ctx->len))
+        return TRUE;
+    ctx->found = *c;
+    ctx->ok = TRUE;
+    return FALSE;
+}
+
+/* Maps an endpoint device string back to its controller. */
+static BOOL bt_resolve(const char *device, EDataFlow flow, struct bt_controller *c)
+{
+    struct resolve_context ctx = { device, 0 };
+    const char *hash = strchr(device, '#');
+
+    ctx.len = hash ? hash - device : strlen(device);
+    ctx.flow = flow;
+    bt_enum_controllers(resolve_controller, &ctx);
+    if (ctx.ok)
+        *c = ctx.found;
+    return ctx.ok;
+}
+
+static BOOL parse_format(const WAVEFORMATEX *fmt, enum bt_format *format)
+{
+    WORD tag = fmt->wFormatTag;
+
+    if (tag == WAVE_FORMAT_EXTENSIBLE && fmt->cbSize >= sizeof(WAVEFORMATEXTENSIBLE) - sizeof(WAVEFORMATEX))
+        tag = ((const WAVEFORMATEXTENSIBLE *)fmt)->SubFormat.Data1;
+    if (tag == WAVE_FORMAT_IEEE_FLOAT && fmt->wBitsPerSample == 32)
+        *format = BT_FORMAT_F32;
+    else if (tag == WAVE_FORMAT_PCM && fmt->wBitsPerSample == 16)
+        *format = BT_FORMAT_S16;
+    else if (tag == WAVE_FORMAT_PCM && fmt->wBitsPerSample == 32)
+        *format = BT_FORMAT_S32;
+    else
+        return FALSE;
+    return fmt->nChannels && fmt->nBlockAlign == fmt->nChannels * fmt->wBitsPerSample / 8;
+}
+
+/* The formats bt_mixer_connect() takes. */
+static BOOL format_usable(BOOL dualshock4, enum bt_format format, UINT32 rate, UINT32 channels)
+{
+    if (dualshock4)
+        return rate >= 8000 && rate <= 192000 && channels <= 8;
+    return (format == BT_FORMAT_F32 || format == BT_FORMAT_S16) && channels == 4 && rate == 48000;
+}
+
+HRESULT bt_is_format_supported(const char *device, EDataFlow flow, const WAVEFORMATEX *fmt)
+{
+    enum bt_format format;
+
+    if (!parse_format(fmt, &format))
+        return AUDCLNT_E_UNSUPPORTED_FORMAT;
+    if (!format_usable(strstr(device, "Interactive_Entertainment_Wireless_Controller.") != NULL,
+                       format, fmt->nSamplesPerSec, fmt->nChannels))
+        return AUDCLNT_E_UNSUPPORTED_FORMAT;
+    return S_OK;
+}
+
+/* Streams. */
+
+static struct bt_stream *bt_get_stream(stream_handle h)
+{
+    return (struct bt_stream *)(UINT_PTR)(h & ~(stream_handle)1);
+}
+
+NTSTATUS bt_create_stream(struct create_stream_params *params)
+{
+    struct bt_controller controller;
+    struct bt_stream *stream;
+    enum bt_format format;
+    UINT32 rate, frames;
+    HRESULT hr;
+
+    if (params->share == AUDCLNT_SHAREMODE_EXCLUSIVE)
+    {
+        params->result = AUDCLNT_E_EXCLUSIVE_MODE_NOT_ALLOWED;
+        return STATUS_SUCCESS;
+    }
+    if (!parse_format(params->fmt, &format))
+    {
+        params->result = AUDCLNT_E_UNSUPPORTED_FORMAT;
+        return STATUS_SUCCESS;
+    }
+    if (!bt_resolve(params->device, params->flow, &controller))
+    {
+        WARN("Bluetooth controller for %s is gone.\n", debugstr_a(params->device));
+        params->result = AUDCLNT_E_DEVICE_INVALIDATED;
+        return STATUS_SUCCESS;
+    }
+    if (params->flow == eCapture && !is_dualshock4(controller.pid))
+    {
+        params->result = AUDCLNT_E_ENDPOINT_CREATE_FAILED;
+        return STATUS_SUCCESS;
+    }
+
+    if (!(stream = calloc(1, sizeof(*stream))))
+    {
+        params->result = E_OUTOFMEMORY;
+        return STATUS_SUCCESS;
+    }
+    rate = params->fmt->nSamplesPerSec;
+    stream->dataflow = params->flow;
+    stream->flags = params->flags;
+    stream->format = format;
+    stream->rate = rate;
+    stream->channels = params->fmt->nChannels;
+    stream->frame_size = params->fmt->nBlockAlign;
+    stream->hid_fd = -1;
+    stream->period = params->period ? params->period : 100000;
+    stream->period_frames = (stream->period * rate + 9999999) / 10000000;
+    if (!stream->period_frames)
+        stream->period_frames = 1;
+    stream->period_bytes = stream->period_frames * stream->frame_size;
+
+    frames = (params->duration * rate + 9999999) / 10000000;
+    if (frames < 2 * stream->period_frames)
+        frames = 2 * stream->period_frames;
+    /* Capture hands out whole periods. */
+    if (params->flow == eCapture)
+        frames = (frames + stream->period_frames - 1) / stream->period_frames * stream->period_frames;
+    stream->bufsize_frames = frames;
+    stream->real_bufsize_bytes = frames * stream->frame_size;
+
+    if (!(stream->local_buffer = calloc(1, stream->real_bufsize_bytes)))
+    {
+        free(stream);
+        params->result = E_OUTOFMEMORY;
+        return STATUS_SUCCESS;
+    }
+
+    pthread_mutex_lock(&bt_lock);
+    hr = bt_mixer_connect(stream, controller.hidraw, is_dualshock4(controller.pid));
+    pthread_mutex_unlock(&bt_lock);
+
+    if (FAILED(hr))
+    {
+        free(stream->local_buffer);
+        free(stream);
+        params->result = hr;
+        return STATUS_SUCCESS;
+    }
+
+    TRACE("Bluetooth %s stream %p on %s: %u Hz, %u channels, period %u frames, buffer %u frames.\n",
+          params->flow == eRender ? "render" : "capture", stream, controller.hidraw, rate,
+          stream->channels, stream->period_frames, stream->bufsize_frames);
+    *params->channel_count = stream->channels;
+    *params->stream = (stream_handle)(UINT_PTR)stream | 1;
+    params->result = S_OK;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS bt_release_stream(struct release_stream_params *params)
+{
+    struct bt_stream *stream = bt_get_stream(params->stream);
+
+    pthread_mutex_lock(&bt_lock);
+    stream->please_quit = TRUE;
+    pthread_mutex_unlock(&bt_lock);
+
+    if (params->timer_thread)
+    {
+        NtWaitForSingleObject(params->timer_thread, FALSE, NULL);
+        NtClose(params->timer_thread);
+    }
+
+    pthread_mutex_lock(&bt_lock);
+    bt_haptic_close(stream);
+    pthread_mutex_unlock(&bt_lock);
+
+    free(stream->local_buffer);
+    free(stream->tmp_buffer);
+    free(stream);
+    params->result = S_OK;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS bt_timer_loop(struct timer_loop_params *params)
+{
+    struct bt_stream *stream = bt_get_stream(params->stream);
+    struct timespec next;
+    UINT64 period_ns = (UINT64)stream->period * 100;
+
+    clock_gettime(CLOCK_MONOTONIC, &next);
+    for (;;)
+    {
+        next.tv_nsec += period_ns % 1000000000;
+        next.tv_sec += period_ns / 1000000000 + next.tv_nsec / 1000000000;
+        next.tv_nsec %= 1000000000;
+        while (clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &next, NULL) == EINTR) ;
+
+        pthread_mutex_lock(&bt_lock);
+        if (stream->please_quit)
+        {
+            pthread_mutex_unlock(&bt_lock);
+            break;
+        }
+        if (stream->started)
+        {
+            if (stream->dataflow == eRender)
+                bt_haptic_write(stream, stream->held_bytes / stream->frame_size, stream->frame_size);
+            else
+                bt_ds4_capture(stream);
+            if (stream->event)
+                NtSetEvent(stream->event, NULL);
+        }
+        pthread_mutex_unlock(&bt_lock);
+    }
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS bt_start(struct start_params *params)
+{
+    struct bt_stream *stream = bt_get_stream(params->stream);
+
+    pthread_mutex_lock(&bt_lock);
+    if ((stream->flags & AUDCLNT_STREAMFLAGS_EVENTCALLBACK) && !stream->event)
+        params->result = AUDCLNT_E_EVENTHANDLE_NOT_SET;
+    else if (stream->started)
+        params->result = AUDCLNT_E_NOT_STOPPED;
+    else
+    {
+        stream->started = TRUE;
+        stream->hid_start_time = 0;
+        params->result = S_OK;
+    }
+    pthread_mutex_unlock(&bt_lock);
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS bt_stop(struct stop_params *params)
+{
+    struct bt_stream *stream = bt_get_stream(params->stream);
+
+    pthread_mutex_lock(&bt_lock);
+    params->result = stream->started ? S_OK : S_FALSE;
+    stream->started = FALSE;
+    pthread_mutex_unlock(&bt_lock);
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS bt_reset(struct reset_params *params)
+{
+    struct bt_stream *stream = bt_get_stream(params->stream);
+
+    pthread_mutex_lock(&bt_lock);
+    if (stream->started)
+        params->result = AUDCLNT_E_NOT_STOPPED;
+    else if (stream->getbuf_last)
+        params->result = AUDCLNT_E_BUFFER_OPERATION_PENDING;
+    else
+    {
+        stream->held_bytes = 0;
+        stream->played_frames = stream->read_frames = 0;
+        stream->discont = FALSE;
+        params->result = S_OK;
+    }
+    pthread_mutex_unlock(&bt_lock);
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS bt_get_render_buffer(struct get_render_buffer_params *params)
+{
+    struct bt_stream *stream = bt_get_stream(params->stream);
+    UINT32 bytes = params->frames * stream->frame_size, write_offs;
+
+    pthread_mutex_lock(&bt_lock);
+    if (stream->getbuf_last)
+        params->result = AUDCLNT_E_OUT_OF_ORDER;
+    else if (!params->frames)
+    {
+        *params->data = NULL;
+        params->result = S_OK;
+    }
+    else if (stream->held_bytes / stream->frame_size + params->frames > stream->bufsize_frames)
+        params->result = AUDCLNT_E_BUFFER_TOO_LARGE;
+    else
+    {
+        write_offs = (stream->pa_offs_bytes + stream->held_bytes) % stream->real_bufsize_bytes;
+        if (write_offs + bytes <= stream->real_bufsize_bytes)
+        {
+            *params->data = stream->local_buffer + write_offs;
+            stream->tmp_in_use = FALSE;
+            params->result = S_OK;
+        }
+        else
+        {
+            if (stream->tmp_buffer_bytes < bytes)
+            {
+                BYTE *tmp = realloc(stream->tmp_buffer, bytes);
+
+                if (tmp)
+                {
+                    stream->tmp_buffer = tmp;
+                    stream->tmp_buffer_bytes = bytes;
+                }
+            }
+            if (stream->tmp_buffer_bytes >= bytes)
+            {
+                *params->data = stream->tmp_buffer;
+                stream->tmp_in_use = TRUE;
+                params->result = S_OK;
+            }
+            else
+                params->result = E_OUTOFMEMORY;
+        }
+        if (SUCCEEDED(params->result))
+            stream->getbuf_last = params->frames;
+    }
+    pthread_mutex_unlock(&bt_lock);
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS bt_release_render_buffer(struct release_render_buffer_params *params)
+{
+    struct bt_stream *stream = bt_get_stream(params->stream);
+    UINT32 bytes = params->written_frames * stream->frame_size, write_offs, first;
+    BYTE *buffer;
+
+    pthread_mutex_lock(&bt_lock);
+    if (!params->written_frames)
+    {
+        stream->getbuf_last = 0;
+        params->result = S_OK;
+    }
+    else if (!stream->getbuf_last)
+        params->result = AUDCLNT_E_OUT_OF_ORDER;
+    else if (params->written_frames > stream->getbuf_last)
+        params->result = AUDCLNT_E_INVALID_SIZE;
+    else
+    {
+        write_offs = (stream->pa_offs_bytes + stream->held_bytes) % stream->real_bufsize_bytes;
+        buffer = stream->tmp_in_use ? stream->tmp_buffer : stream->local_buffer + write_offs;
+        if (params->flags & AUDCLNT_BUFFERFLAGS_SILENT)
+            memset(buffer, 0, bytes);
+        if (stream->tmp_in_use)
+        {
+            first = min(bytes, stream->real_bufsize_bytes - write_offs);
+            memcpy(stream->local_buffer + write_offs, buffer, first);
+            memcpy(stream->local_buffer, buffer + first, bytes - first);
+        }
+        stream->held_bytes += bytes;
+        stream->getbuf_last = 0;
+        params->result = S_OK;
+    }
+    pthread_mutex_unlock(&bt_lock);
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS bt_get_capture_buffer(struct get_capture_buffer_params *params)
+{
+    struct bt_stream *stream = bt_get_stream(params->stream);
+    LARGE_INTEGER now, freq;
+
+    pthread_mutex_lock(&bt_lock);
+    if (stream->getbuf_last)
+    {
+        params->result = AUDCLNT_E_OUT_OF_ORDER;
+        pthread_mutex_unlock(&bt_lock);
+        return STATUS_SUCCESS;
+    }
+    if (stream->held_bytes < stream->period_bytes)
+    {
+        *params->frames = 0;
+        params->result = AUDCLNT_S_BUFFER_EMPTY;
+        pthread_mutex_unlock(&bt_lock);
+        return STATUS_SUCCESS;
+    }
+    *params->data = stream->local_buffer + stream->pa_offs_bytes;
+    *params->frames = stream->period_frames;
+    *params->flags = stream->discont ? AUDCLNT_BUFFERFLAGS_DATA_DISCONTINUITY : 0;
+    stream->discont = FALSE;
+    if (params->devpos)
+        *params->devpos = stream->read_frames;
+    if (params->qpcpos)
+    {
+        /* The packet was captured as many periods ago as are queued. */
+        NtQueryPerformanceCounter(&now, &freq);
+        *params->qpcpos = (now.QuadPart - (LONGLONG)(stream->held_bytes / stream->frame_size) *
+                           freq.QuadPart / stream->rate) * 10000000 / freq.QuadPart;
+    }
+    stream->getbuf_last = stream->period_frames;
+    params->result = S_OK;
+    pthread_mutex_unlock(&bt_lock);
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS bt_release_capture_buffer(struct release_capture_buffer_params *params)
+{
+    struct bt_stream *stream = bt_get_stream(params->stream);
+
+    pthread_mutex_lock(&bt_lock);
+    if (!params->done)
+    {
+        stream->getbuf_last = 0;
+        params->result = S_OK;
+    }
+    else if (!stream->getbuf_last)
+        params->result = AUDCLNT_E_OUT_OF_ORDER;
+    else if (params->done != stream->getbuf_last)
+        params->result = AUDCLNT_E_INVALID_SIZE;
+    else
+    {
+        stream->pa_offs_bytes = (stream->pa_offs_bytes + stream->period_bytes) % stream->real_bufsize_bytes;
+        stream->held_bytes -= stream->period_bytes;
+        stream->read_frames += params->done;
+        stream->getbuf_last = 0;
+        params->result = S_OK;
+    }
+    pthread_mutex_unlock(&bt_lock);
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS bt_get_buffer_size(struct get_buffer_size_params *params)
+{
+    *params->frames = bt_get_stream(params->stream)->bufsize_frames;
+    params->result = S_OK;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS bt_get_latency(struct get_latency_params *params)
+{
+    *params->latency = 2 * bt_get_stream(params->stream)->period;
+    params->result = S_OK;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS bt_get_current_padding(struct get_current_padding_params *params)
+{
+    struct bt_stream *stream = bt_get_stream(params->stream);
+
+    pthread_mutex_lock(&bt_lock);
+    *params->padding = stream->held_bytes / stream->frame_size;
+    pthread_mutex_unlock(&bt_lock);
+    params->result = S_OK;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS bt_get_next_packet_size(struct get_next_packet_size_params *params)
+{
+    struct bt_stream *stream = bt_get_stream(params->stream);
+
+    pthread_mutex_lock(&bt_lock);
+    *params->frames = stream->held_bytes >= stream->period_bytes ? stream->period_frames : 0;
+    pthread_mutex_unlock(&bt_lock);
+    params->result = S_OK;
+    return STATUS_SUCCESS;
+}
+
+/* Shared mode clocks count bytes, as on Windows and in winepulse. */
+NTSTATUS bt_get_frequency(struct get_frequency_params *params)
+{
+    struct bt_stream *stream = bt_get_stream(params->stream);
+
+    *params->freq = (UINT64)stream->rate * stream->frame_size;
+    params->result = S_OK;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS bt_get_position(struct get_position_params *params)
+{
+    struct bt_stream *stream = bt_get_stream(params->stream);
+    LARGE_INTEGER now, freq;
+
+    pthread_mutex_lock(&bt_lock);
+    *params->pos = (stream->dataflow == eRender ? stream->played_frames : stream->read_frames) *
+                   stream->frame_size;
+    pthread_mutex_unlock(&bt_lock);
+    if (params->qpctime)
+    {
+        NtQueryPerformanceCounter(&now, &freq);
+        *params->qpctime = now.QuadPart * 10000000 / freq.QuadPart;
+    }
+    params->result = S_OK;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS bt_set_volumes(struct set_volumes_params *params)
+{
+    /* As in winepulse, the controller audio is sent at full scale. */
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS bt_set_event_handle(struct set_event_handle_params *params)
+{
+    struct bt_stream *stream = bt_get_stream(params->stream);
+
+    pthread_mutex_lock(&bt_lock);
+    if (!(stream->flags & AUDCLNT_STREAMFLAGS_EVENTCALLBACK))
+        params->result = AUDCLNT_E_EVENTHANDLE_NOT_EXPECTED;
+    else if (stream->event)
+        params->result = HRESULT_FROM_WIN32(ERROR_INVALID_NAME);
+    else
+    {
+        stream->event = params->event;
+        params->result = S_OK;
+    }
+    pthread_mutex_unlock(&bt_lock);
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS bt_set_sample_rate(struct set_sample_rate_params *params)
+{
+    params->result = E_NOTIMPL;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS bt_is_started(struct is_started_params *params)
+{
+    struct bt_stream *stream = bt_get_stream(params->stream);
+
+    pthread_mutex_lock(&bt_lock);
+    params->result = stream->started ? S_OK : S_FALSE;
+    pthread_mutex_unlock(&bt_lock);
+    return STATUS_SUCCESS;
+}
