--- a/dlls/winepipewire.drv/Makefile.in
+++ b/dlls/winepipewire.drv/Makefile.in
@@ -5,4 +5,5 @@
 UNIX_CFLAGS  = $(PIPEWIRE_CFLAGS) $(UDEV_CFLAGS)
 
 SOURCES = \
+	bluetooth.c \
 	pipewire.c
diff --git a/dlls/winepipewire.drv/bluetooth.c b/dlls/winepipewire.drv/bluetooth.c
new file mode 100644
--- /dev/null
+++ b/dlls/winepipewire.drv/bluetooth.c
@@ -0,0 +1,1959 @@
