+/* Ported from winepulse.drv. Bluetooth Sony controllers have no USB audio
+ * function, so there is no PipeWire node for their speaker, haptics or
+ * headset microphone. When winebus presents them as USB (Steam Input
+ * disabled) we expose synthetic endpoints with the controller's container
+ * ID and bridge them through hidraw, paced in real time:
+ *
+ * - DualSense: a 48 kHz four-channel endpoint. Channels 3 and 4 (haptics)
+ *   are resampled to 3 kHz, channels 1 and 2 (speaker or headphones) are
+ *   Opus encoded, in output reports 0x32/0x36. Packet layout and resampling
+ *   follow DS5Dongle (https://github.com/awalol/DS5Dongle) and vDS
+ *   (https://github.com/hurryman2212/vds), both MIT licensed.
+ * - DualShock 4: a stereo 32 kHz speaker, SBC encoded in output report
+ *   0x17, and the mono 16 kHz headset microphone, decoded from input
+ *   reports 0x12-0x19. Layouts follow DS4Dongle
+ *   (https://github.com/snipem/DS4Dongle), whose audio code is MPL-2.0.
+ *
+ * libopus and libsbc are loaded at runtime. */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <dirent.h>
+#include <dlfcn.h>
+#include <limits.h>
+#include <pthread.h>
+#include <time.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "winternl.h"
+
+#include "mmdeviceapi.h"
+#include "audioclient.h"
+
+#include "wine/debug.h"
+#include "wine/list.h"
+#include "wine/unixlib.h"
+
+#include "../mmdevapi/unixlib.h"
+#include "bluetooth.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(pipewire);
+
+#define BT_PULSE_PREFIX "wine_bluetooth.Sony_Interactive_Entertainment_"
+#define BT_DUALSENSE_HAPTIC_REPORT_ID 0x32
+#define BT_DUALSENSE_HAPTIC_REPORT_SIZE 142
+#define BT_DUALSENSE_HAPTIC_DECIMATION 16 /* 48 kHz to 3 kHz */
+
+#define SPEAKER_FL 0x1
+#define SPEAKER_FR 0x2
+#define SPEAKER_FC 0x4
+#define SPEAKER_BL 0x10
+#define SPEAKER_BR 0x20
+
+enum bt_format { BT_FORMAT_S16, BT_FORMAT_S32, BT_FORMAT_F32 };
+
+struct bt_dualsense_mixer;
+
+struct bt_stream
+{
+    EDataFlow dataflow;
+    DWORD flags;
+    enum bt_format format;
+    UINT32 rate, channels, frame_size;
+    REFERENCE_TIME period;
+    UINT32 period_frames, period_bytes, bufsize_frames, real_bufsize_bytes;
+    BYTE *local_buffer, *tmp_buffer;
+    UINT32 tmp_buffer_bytes;
+    BOOL tmp_in_use;
+    /* Ring: pa_offs_bytes is the read offset, held_bytes the fill. */
+    UINT32 pa_offs_bytes, held_bytes;
+    UINT32 getbuf_last;
+    UINT64 played_frames;  /* render: sent to the controller */
+    UINT64 read_frames;    /* capture: released by the client */
+    BOOL started, please_quit, discont;
+    HANDLE event;
+    /* Bluetooth state, as in winepulse. */
+    BOOL hid_haptics;
+    int hid_fd;
+    UINT64 hid_start_time, hid_consumed;
+    struct bt_dualsense_mixer *hid_mixer;
+    UINT32 hid_phase;
+    INT32 hid_prev[2];
+    UINT64 hid_mic_pos;
+    BOOL hid_mic_buffering;
+};
+
+/* Guards the mixers and the Bluetooth streams. */
+static pthread_mutex_t bt_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static UINT64 bt_now(void)
+{
+    struct timespec ts;
+
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (UINT64)ts.tv_sec * 1000000 + ts.tv_nsec / 1000;
+}
+
+static int16_t float_to_s16(float sample)
+{
+    if (sample > 1.0f) sample = 1.0f;
+    else if (sample < -1.0f) sample = -1.0f;
+
+    return sample < 0.0f ? sample * 32768.0f : sample * 32767.0f;
+}
+
+static void bt_advance(struct bt_stream *stream, UINT32 frames, UINT32 frame_size)
+{
+    UINT32 bytes = frames * frame_size;
+
+    if (bytes > stream->held_bytes)
+        bytes = stream->held_bytes;
+    stream->pa_offs_bytes = (stream->pa_offs_bytes + bytes) % stream->real_bufsize_bytes;
+    stream->held_bytes -= bytes;
+    stream->played_frames += bytes / frame_size;
+}
+
+/* Takes the next capture period, dropping the oldest one when the client
+ * fell behind, as winepulse's packet list does. */
+static BYTE *bt_capture_packet(struct bt_stream *stream)
+{
+    UINT32 write_offs;
+
+    if (stream->held_bytes + stream->period_bytes > stream->real_bufsize_bytes)
+    {
+        stream->pa_offs_bytes = (stream->pa_offs_bytes + stream->period_bytes) % stream->real_bufsize_bytes;
+        stream->held_bytes -= stream->period_bytes;
+        stream->read_frames += stream->period_frames;
+        stream->discont = TRUE;
+    }
+    write_offs = (stream->pa_offs_bytes + stream->held_bytes) % stream->real_bufsize_bytes;
+    stream->held_bytes += stream->period_bytes;
+    return stream->local_buffer + write_offs;
+}
+
+static UINT32 bt_dualsense_crc32(UINT32 crc, const BYTE *data, SIZE_T size)
+{
+    unsigned int bit;
+
+    while (size--)
+    {
+        crc ^= *data++;
+        for (bit = 0; bit < 8; ++bit)
+            crc = (crc >> 1) ^ (0xedb88320 & -(crc & 1));
+    }
+    return crc;
+}
+
+/* The controller speaker takes Opus over Bluetooth: one 10 ms, 200 byte
+ * CBR frame per haptics chunk, as in vDS and DS5Dongle. libopus is loaded
+ * at runtime; without it only haptics are sent. */
+#define BT_DUALSENSE_SPEAKER_REPORT_ID 0x36
+#define BT_DUALSENSE_SPEAKER_REPORT_SIZE 398
+#define BT_DUALSENSE_SPEAKER_WINDOW_FRAMES 512
+#define BT_DUALSENSE_SPEAKER_OPUS_FRAMES 480
+#define BT_DUALSENSE_SPEAKER_OPUS_SIZE 200
+#define BT_DUALSENSE_OPUS_APPLICATION_RESTRICTED_LOWDELAY 2051
+#define BT_DUALSENSE_OPUS_SET_BITRATE_REQUEST 4002
+#define BT_DUALSENSE_OPUS_SET_VBR_REQUEST 4006
+#define BT_DUALSENSE_OPUS_SET_COMPLEXITY_REQUEST 4010
+
+static void *(*p_opus_encoder_create)(int32_t, int, int, int *);
+static int (*p_opus_encoder_ctl)(void *, int, ...);
+static int32_t (*p_opus_encode)(void *, const int16_t *, int, unsigned char *, int32_t);
+static void (*p_opus_encoder_destroy)(void *);
+static pthread_once_t bt_dualsense_opus_once = PTHREAD_ONCE_INIT;
+
+static void bt_dualsense_load_opus(void)
+{
+    void *handle;
+
+    if (!(handle = dlopen("libopus.so.0", RTLD_NOW)))
+    {
+        WARN("libopus not found, Bluetooth DualSense speaker audio is disabled.\n");
+        return;
+    }
+    p_opus_encoder_create = dlsym(handle, "opus_encoder_create");
+    p_opus_encoder_ctl = dlsym(handle, "opus_encoder_ctl");
+    p_opus_encode = dlsym(handle, "opus_encode");
+    p_opus_encoder_destroy = dlsym(handle, "opus_encoder_destroy");
+    if (!p_opus_encoder_create || !p_opus_encoder_ctl || !p_opus_encode || !p_opus_encoder_destroy)
+    {
+        WARN("libopus is missing symbols, Bluetooth DualSense speaker audio is disabled.\n");
+        p_opus_encoder_create = NULL;
+        dlclose(handle);
+    }
+}
+
+static void *bt_dualsense_create_opus_encoder(void)
+{
+    void *encoder;
+    int err = 0;
+
+    pthread_once(&bt_dualsense_opus_once, bt_dualsense_load_opus);
+    if (!p_opus_encoder_create)
+        return NULL;
+    if (!(encoder = p_opus_encoder_create(48000, 2, BT_DUALSENSE_OPUS_APPLICATION_RESTRICTED_LOWDELAY, &err)) || err)
+    {
+        WARN("opus_encoder_create failed: %d\n", err);
+        return NULL;
+    }
+    p_opus_encoder_ctl(encoder, BT_DUALSENSE_OPUS_SET_VBR_REQUEST, (int32_t)0);
+    p_opus_encoder_ctl(encoder, BT_DUALSENSE_OPUS_SET_COMPLEXITY_REQUEST, (int32_t)0);
+    p_opus_encoder_ctl(encoder, BT_DUALSENSE_OPUS_SET_BITRATE_REQUEST, (int32_t)(BT_DUALSENSE_SPEAKER_OPUS_SIZE * 8 * 100));
+    return encoder;
+}
+
+/* Games may open several streams on the controller endpoint (Assassin's
+ * Creed Shadows opens two). Each controller gets one mixer that sums the
+ * streams on a shared real-time clock and sends one report sequence, with
+ * one Opus encoder and one set of counters; independent senders would
+ * interleave two Opus streams and double the Bluetooth traffic. Streams
+ * write up to BT_DUALSENSE_MIX_LEAD frames ahead of the clock, chunks are
+ * sent BT_DUALSENSE_MIX_SEND_AHEAD frames ahead, so every stream gets to add
+ * its samples before a chunk goes out. */
+#define BT_DUALSENSE_MIX_RING 8192
+#define BT_DUALSENSE_MIX_LEAD 1536
+#define BT_DUALSENSE_MIX_SEND_AHEAD 512
+
+/* The DualShock 4 speaker takes SBC over Bluetooth: 32 kHz dual channel,
+ * 16 blocks, 8 subbands, loudness allocation, bitpool 25, which gives 112 byte
+ * frames of 128 samples, four per output report #0x17 (16 ms), as DS4Dongle
+ * sends them. libsbc is loaded at runtime; without it no speaker audio is
+ * sent. */
+#define BT_DUALSHOCK4_RATE 32000
+#define BT_DUALSHOCK4_AUDIO_REPORT_ID 0x17
+#define BT_DUALSHOCK4_AUDIO_REPORT_SIZE 462
+#define BT_DUALSHOCK4_SBC_FRAME_SAMPLES 128
+#define BT_DUALSHOCK4_SBC_FRAME_SIZE 112
+#define BT_DUALSHOCK4_SBC_FRAMES_PER_REPORT 4
+#define BT_DUALSHOCK4_AUDIO_TARGET_SPEAKER 0x02
+#define BT_DUALSHOCK4_AUDIO_TARGET_HEADSET 0x24
+#define BT_DUALSHOCK4_OUTPUT_REPORT_ID 0x11
+#define BT_DUALSHOCK4_OUTPUT_REPORT_SIZE 78
+#define BT_DUALSHOCK4_VOLUME 0x50
+#define BT_DUALSHOCK4_MIC_VOLUME 0x40
+
+/* Headset microphone, as found by DS4Dongle: with output report byte 2 bit 2
+ * set, the controller sends one input report #0x12 to #0x19 per output report
+ * it receives, carrying the #0x11 state block and SBC frames (16 kHz mono,
+ * 16 blocks, 8 subbands, loudness, bitpool 29: 66 byte frames of 128 samples,
+ * 8 ms) after it. It only offers the microphone with a headset plugged in. */
+#define BT_DUALSHOCK4_MIC_RATE 16000
+#define BT_DUALSHOCK4_MIC_FRAME_SIZE 66
+#define BT_DUALSHOCK4_MIC_FRAME_SAMPLES 128
+#define BT_DUALSHOCK4_MIC_SCAN_OFFSET 74
+#define BT_DUALSHOCK4_MIC_INTERVAL_US 8000
+#define BT_DUALSHOCK4_MIC_RING 8192
+#define BT_DUALSHOCK4_MIC_JITTER 768 /* 48 ms */
+#define BT_DUALSHOCK4_STATUS_HEADSET 0x20
+#define BT_DUALSHOCK4_STATUS_MIC 0x40
+
+/* struct sbc_struct from sbc/sbc.h. */
+struct bt_sbc
+{
+    unsigned long flags;
+    uint8_t frequency;
+    uint8_t blocks;
+    uint8_t subbands;
+    uint8_t mode;
+    uint8_t allocation;
+    uint8_t bitpool;
+    uint8_t endian;
+    void *priv;
+    void *priv_alloc_base;
+};
+
+static int (*p_sbc_init)(struct bt_sbc *, unsigned long);
+static ssize_t (*p_sbc_encode)(struct bt_sbc *, const void *, size_t, void *, size_t, ssize_t *);
+static ssize_t (*p_sbc_decode)(struct bt_sbc *, const void *, size_t, void *, size_t, size_t *);
+static void (*p_sbc_finish)(struct bt_sbc *);
+static pthread_once_t bt_dualshock4_sbc_once = PTHREAD_ONCE_INIT;
+
+static void bt_dualshock4_load_sbc(void)
+{
+    void *handle;
+
+    if (!(handle = dlopen("libsbc.so.1", RTLD_NOW)))
+    {
+        WARN("libsbc not found, Bluetooth DualShock 4 speaker audio is disabled.\n");
+        return;
+    }
+    p_sbc_init = dlsym(handle, "sbc_init");
+    p_sbc_encode = dlsym(handle, "sbc_encode");
+    p_sbc_finish = dlsym(handle, "sbc_finish");
+    p_sbc_decode = dlsym(handle, "sbc_decode");
+    if (!p_sbc_init || !p_sbc_encode || !p_sbc_finish || !p_sbc_decode)
+    {
+        WARN("libsbc is missing symbols, Bluetooth DualShock 4 speaker audio is disabled.\n");
+        p_sbc_init = NULL;
+        dlclose(handle);
+    }
+}
+
+static struct bt_sbc *bt_dualshock4_create_sbc(void)
+{
+    struct bt_sbc *sbc;
+
+    pthread_once(&bt_dualshock4_sbc_once, bt_dualshock4_load_sbc);
+    if (!p_sbc_init || !(sbc = calloc(1, sizeof(*sbc))))
+        return NULL;
+    if (p_sbc_init(sbc, 0) < 0)
+    {
+        WARN("sbc_init failed.\n");
+        free(sbc);
+        return NULL;
+    }
+    sbc->frequency = 0x01;  /* SBC_FREQ_32000 */
+    sbc->blocks = 0x03;     /* SBC_BLK_16 */
+    sbc->subbands = 0x01;   /* SBC_SB_8 */
+    sbc->mode = 0x01;       /* SBC_MODE_DUAL_CHANNEL */
+    sbc->allocation = 0x00; /* SBC_AM_LOUDNESS */
+    sbc->bitpool = 25;
+    sbc->endian = 0x00;     /* SBC_LE */
+    return sbc;
+}
+
+static void bt_dualshock4_destroy_sbc(struct bt_sbc *sbc)
+{
+    if (!sbc) return;
+    p_sbc_finish(sbc);
+    free(sbc);
+}
+
+struct bt_dualsense_mixer
+{
+    struct list entry;
+    char *path;
+    int fd;
+    LONG refs;
+    void *opus;
+    UINT64 start_time;
+    UINT64 sent;
+    BYTE seq, counter;
+    UINT32 silent_chunks, spk_idle_chunks;
+    BOOL headphones;
+    UINT64 stat_time;
+    UINT32 stat_speaker, stat_haptics, stat_skipped, stat_signal, stat_eagain, stat_rebase;
+    /* DualShock 4: 32 kHz stereo speaker audio, SBC encoded. */
+    BOOL dualshock4;
+    UINT32 rate;
+    struct bt_sbc *sbc;
+    UINT16 sbc_frames;
+    UINT64 volume_time;
+    /* DualShock 4 headset microphone. */
+    BOOL mic_present;
+    LONG capture_streams;
+    struct bt_sbc *mic_sbc;
+    UINT64 output_time;
+    UINT64 mic_written;
+    UINT32 stat_mic_frames, stat_mic_underruns;
+    UINT64 mic_stat_time;
+    int16_t mic_ring[BT_DUALSHOCK4_MIC_RING];
+    INT32 ring[BT_DUALSENSE_MIX_RING][4];
+};
+
+static struct list bt_dualsense_mixers = LIST_INIT(bt_dualsense_mixers);
+
+static UINT64 bt_dualsense_mixer_clock(struct bt_dualsense_mixer *mixer)
+{
+    return (bt_now() - mixer->start_time) * mixer->rate / 1000000;
+}
+
+static void bt_haptic_close(struct bt_stream *stream)
+{
+    struct bt_dualsense_mixer *mixer = stream->hid_mixer;
+
+    stream->hid_fd = -1;
+    stream->hid_mixer = NULL;
+    if (mixer && stream->dataflow == eCapture) --mixer->capture_streams;
+    if (!mixer || --mixer->refs) return;
+
+    list_remove(&mixer->entry);
+    close(mixer->fd);
+    if (mixer->opus) p_opus_encoder_destroy(mixer->opus);
+    bt_dualshock4_destroy_sbc(mixer->sbc);
+    bt_dualshock4_destroy_sbc(mixer->mic_sbc);
+    free(mixer->path);
+    free(mixer);
+}
+
+static HRESULT bt_mixer_connect(struct bt_stream *stream, const char *hidraw, BOOL dualshock4)
+{
+    struct bt_dualsense_mixer *mixer;
+
+
+    /* DualShock 4 streams are resampled, and use the first two channels. */
+    if (dualshock4 ? (stream->format != BT_FORMAT_F32 && stream->format != BT_FORMAT_S16 &&
+                      stream->format != BT_FORMAT_S32) || stream->rate < 8000 || stream->rate > 192000
+                   : (stream->format != BT_FORMAT_F32 && stream->format != BT_FORMAT_S16) ||
+                      stream->channels != 4 || stream->rate != 48000)
+    {
+        WARN("Unsupported format %u Hz, %u channels for Bluetooth %s audio.\n", stream->rate,
+                stream->channels, dualshock4 ? "DualShock 4" : "DualSense");
+        return AUDCLNT_E_ENDPOINT_CREATE_FAILED;
+    }
+
+    LIST_FOR_EACH_ENTRY(mixer, &bt_dualsense_mixers, struct bt_dualsense_mixer, entry)
+    {
+        if (!strcmp(mixer->path, hidraw) && mixer->dualshock4 == dualshock4)
+        {
+            mixer->refs++;
+            goto done;
+        }
+    }
+
+    if (!(mixer = calloc(1, sizeof(*mixer))) || !(mixer->path = strdup(hidraw)))
+    {
+        free(mixer);
+        return E_OUTOFMEMORY;
+    }
+    /* Opened for reading too, to follow the headphone jack state. */
+    if ((mixer->fd = open(hidraw, O_RDWR | O_NONBLOCK | O_CLOEXEC)) < 0)
+    {
+        WARN("Unable to open %s for Bluetooth DualSense haptics: %s\n", hidraw, strerror(errno));
+        free(mixer->path);
+        free(mixer);
+        return AUDCLNT_E_ENDPOINT_CREATE_FAILED;
+    }
+    mixer->refs = 1;
+    mixer->start_time = bt_now();
+    mixer->dualshock4 = dualshock4;
+    if (dualshock4)
+    {
+        mixer->rate = BT_DUALSHOCK4_RATE;
+        mixer->sbc = bt_dualshock4_create_sbc();
+        if (mixer->sbc && (mixer->mic_sbc = calloc(1, sizeof(*mixer->mic_sbc))) &&
+                p_sbc_init(mixer->mic_sbc, 0) < 0)
+        {
+            free(mixer->mic_sbc);
+            mixer->mic_sbc = NULL;
+        }
+        TRACE("Sending DualShock 4 speaker audio to Bluetooth controller %s%s.\n", hidraw,
+                mixer->sbc ? "" : " (no SBC encoder, silent)");
+    }
+    else
+    {
+        mixer->rate = 48000;
+        mixer->opus = bt_dualsense_create_opus_encoder();
+        TRACE("Sending DualSense haptics%s to Bluetooth controller %s.\n",
+                mixer->opus ? " and speaker audio" : "", hidraw);
+    }
+    list_add_tail(&bt_dualsense_mixers, &mixer->entry);
+
+done:
+    if (stream->dataflow == eCapture) mixer->capture_streams++;
+    stream->hid_haptics = TRUE;
+    stream->hid_mixer = mixer;
+    stream->hid_fd = mixer->fd;
+    stream->hid_start_time = 0;
+    stream->hid_consumed = 0;
+    TRACE("Mixing stream %p into Bluetooth %s %s (%d streams).\n", stream,
+            dualshock4 ? "DualShock 4" : "DualSense", hidraw, (int)mixer->refs);
+    return S_OK;
+}
+
+static void bt_dualsense_set_crc(BYTE *report, SIZE_T size)
+{
+    static const BYTE seed = 0xa2;
+    UINT32 crc;
+
+    crc = bt_dualsense_crc32(0xffffffff, &seed, 1);
+    crc = ~bt_dualsense_crc32(crc, report, size - 4);
+    report[size - 4] = crc;
+    report[size - 3] = crc >> 8;
+    report[size - 2] = crc >> 16;
+    report[size - 1] = crc >> 24;
+}
+
+static void bt_dualsense_update_jack(struct bt_dualsense_mixer *mixer)
+{
+    BYTE buf[128];
+    ssize_t len;
+
+    /* Bluetooth report 0x31 holds the USB input report from byte 2, the
+     * jack state is USB byte 54, bit 0 headphones. */
+    while ((len = read(mixer->fd, buf, sizeof(buf))) > 0)
+    {
+        if (buf[0] == 0x31 && len >= 56 && (buf[1] & 0x0f) == 0x01 && mixer->headphones != (buf[55] & 1))
+        {
+            mixer->headphones = buf[55] & 1;
+            TRACE("Bluetooth DualSense %s: headphones %s (status %#x).\n", mixer->path,
+                    mixer->headphones ? "plugged" : "unplugged", buf[55]);
+        }
+    }
+}
+
+static BOOL bt_dualsense_encode_speaker(struct bt_dualsense_mixer *mixer,
+        const int16_t (*src)[4], BYTE *out)
+{
+    int16_t pcm[BT_DUALSENSE_SPEAKER_OPUS_FRAMES * 2];
+    UINT32 i, c;
+    int32_t len;
+
+    /* 512 frames per haptics chunk, 480 per Opus frame. */
+    for (i = 0; i < BT_DUALSENSE_SPEAKER_OPUS_FRAMES; ++i)
+    {
+        UINT32 num = i * BT_DUALSENSE_SPEAKER_WINDOW_FRAMES;
+        UINT32 pos = num / BT_DUALSENSE_SPEAKER_OPUS_FRAMES, frac = num % BT_DUALSENSE_SPEAKER_OPUS_FRAMES;
+        UINT32 next = min(pos + 1, BT_DUALSENSE_SPEAKER_WINDOW_FRAMES - 1);
+
+        for (c = 0; c < 2; ++c)
+            pcm[i * 2 + c] = ((INT32)src[pos][c] * (INT32)(BT_DUALSENSE_SPEAKER_OPUS_FRAMES - frac) +
+                    (INT32)src[next][c] * (INT32)frac) / BT_DUALSENSE_SPEAKER_OPUS_FRAMES;
+    }
+
+    len = p_opus_encode(mixer->opus, pcm, BT_DUALSENSE_SPEAKER_OPUS_FRAMES, out, BT_DUALSENSE_SPEAKER_OPUS_SIZE);
+    if (len < 0)
+    {
+        WARN("opus_encode failed: %d\n", (int)len);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static void bt_dualsense_send_chunk(struct bt_dualsense_mixer *mixer, const int16_t (*pcm)[4])
+{
+    BYTE report[BT_DUALSENSE_SPEAKER_REPORT_SIZE] = {0};
+    INT8 haptics[64];
+    BOOL silent = TRUE, speaker = FALSE, spk_signal = FALSE;
+    SIZE_T size;
+    UINT32 i, j, c;
+
+    for (i = 0; i < BT_DUALSENSE_SPEAKER_WINDOW_FRAMES; ++i)
+        spk_signal |= pcm[i][0] || pcm[i][1];
+    mixer->stat_signal += spk_signal;
+
+    /* Channels 3 and 4: 48 kHz to 3 kHz, 8-bit. */
+    for (i = 0; i < sizeof(haptics) / 2; ++i)
+    {
+        for (c = 0; c < 2; ++c)
+        {
+            INT32 sum = 0;
+
+            for (j = 0; j < BT_DUALSENSE_HAPTIC_DECIMATION; ++j)
+                sum += pcm[i * BT_DUALSENSE_HAPTIC_DECIMATION + j][2 + c];
+            haptics[i * 2 + c] = max(-128, min(127, sum / BT_DUALSENSE_HAPTIC_DECIMATION / 256));
+            silent &= !haptics[i * 2 + c];
+        }
+    }
+
+    if (mixer->opus)
+    {
+        /* Keep the speaker going a little past the last sound so the Opus
+         * decoder flushes its tail. */
+        if (spk_signal)
+            mixer->spk_idle_chunks = 0;
+        else if (mixer->spk_idle_chunks < 16)
+            ++mixer->spk_idle_chunks;
+        speaker = mixer->spk_idle_chunks < 16;
+    }
+
+    /* Keep sending a few silent chunks so the actuators settle, then stop
+     * until the game plays haptics again. */
+    if (silent && !speaker && ++mixer->silent_chunks > 4)
+    {
+        mixer->stat_skipped++;
+        return;
+    }
+    if (!silent)
+        mixer->silent_chunks = 0;
+
+    if (speaker)
+    {
+        bt_dualsense_update_jack(mixer);
+        if (!bt_dualsense_encode_speaker(mixer, pcm, report + 144))
+            speaker = FALSE;
+    }
+
+    if (speaker)
+    {
+        BYTE *state = report + 13;
+
+        /* Haptics and speaker report with an embedded state block, layout
+         * from vDS. Over USB the controller routes its audio function to
+         * the speaker by itself; over Bluetooth the output path and volume
+         * must be set, so select them with every speaker report. */
+        size = BT_DUALSENSE_SPEAKER_REPORT_SIZE;
+        report[0] = BT_DUALSENSE_SPEAKER_REPORT_ID;
+        report[1] = (mixer->seq++ & 0x0f) << 4;
+        report[2] = 0x91;
+        report[3] = 7;
+        report[4] = 0xfe;
+        report[5] = report[6] = report[7] = report[8] = report[9] = 64;
+        report[10] = mixer->counter++;
+        report[11] = 0x90;
+        report[12] = 63;
+        state[1] = 0x80; /* allow audio control 2 */
+        state[37] = 0x01; /* audio control 2 */
+        if (mixer->headphones)
+        {
+            state[0] = 0x80 | 0x10; /* allow audio control, headphone volume */
+            state[4] = 0x7f; /* headphone volume */
+            state[7] = 0x08; /* headphone output, automatic mic select */
+        }
+        else
+        {
+            state[0] = 0x80 | 0x20; /* allow audio control, speaker volume */
+            state[5] = 0x64; /* speaker volume */
+            state[7] = 0x39; /* speaker output, internal mic */
+        }
+        report[76] = 0x92;
+        report[77] = sizeof(haptics);
+        memcpy(report + 78, haptics, sizeof(haptics));
+        report[142] = mixer->headphones ? 0x96 : 0x93;
+        report[143] = BT_DUALSENSE_SPEAKER_OPUS_SIZE;
+    }
+    else
+    {
+        size = BT_DUALSENSE_HAPTIC_REPORT_SIZE;
+        report[0] = BT_DUALSENSE_HAPTIC_REPORT_ID;
+        report[1] = (mixer->seq++ & 0x0f) << 4;
+        report[2] = 0x91;
+        report[3] = 4;
+        report[4] = 0x66;
+        report[5] = 48;
+        report[6] = 48;
+        report[7] = mixer->counter++;
+        report[8] = 0x92;
+        report[9] = sizeof(haptics);
+        memcpy(report + 10, haptics, sizeof(haptics));
+    }
+    bt_dualsense_set_crc(report, size);
+
+    if (speaker) mixer->stat_speaker++;
+    else mixer->stat_haptics++;
+    if (write(mixer->fd, report, size) < 0)
+    {
+        if (errno == EAGAIN) mixer->stat_eagain++;
+        else WARN("Bluetooth DualSense haptics write failed: %s\n", strerror(errno));
+    }
+}
+
+static void bt_dualshock4_decode_mic(struct bt_dualsense_mixer *mixer, const BYTE *buf, ssize_t len)
+{
+    int16_t pcm[BT_DUALSHOCK4_MIC_FRAME_SAMPLES];
+    size_t written;
+    ssize_t i;
+    UINT32 j;
+
+    for (i = BT_DUALSHOCK4_MIC_SCAN_OFFSET; i + BT_DUALSHOCK4_MIC_FRAME_SIZE <= len - 4; ++i)
+    {
+        /* Match the whole frame header, a lone sync byte also occurs in the
+         * frame data and would desynchronize the decoder. */
+        if (buf[i] != 0x9c || buf[i + 1] != 0x31 || buf[i + 2] != 0x1d)
+            continue;
+        written = 0;
+        if (p_sbc_decode(mixer->mic_sbc, buf + i, BT_DUALSHOCK4_MIC_FRAME_SIZE, pcm, sizeof(pcm), &written) > 0 &&
+                written == sizeof(pcm))
+        {
+            for (j = 0; j < BT_DUALSHOCK4_MIC_FRAME_SAMPLES; ++j)
+                mixer->mic_ring[(mixer->mic_written + j) % BT_DUALSHOCK4_MIC_RING] = pcm[j];
+            mixer->mic_written += BT_DUALSHOCK4_MIC_FRAME_SAMPLES;
+            mixer->stat_mic_frames++;
+        }
+        i += BT_DUALSHOCK4_MIC_FRAME_SIZE - 1;
+    }
+}
+
+/* Reads the controller's input reports: the headset jack and microphone
+ * state from the status byte, USB byte 30, and microphone audio. */
+static void bt_dualshock4_read_input(struct bt_dualsense_mixer *mixer)
+{
+    BYTE buf[640];
+    ssize_t len;
+
+    while ((len = read(mixer->fd, buf, sizeof(buf))) > 0)
+    {
+        BYTE status;
+
+        if (buf[0] < 0x11 || buf[0] > 0x19 || len < 33)
+            continue;
+        status = buf[32];
+        if (mixer->headphones != !!(status & BT_DUALSHOCK4_STATUS_HEADSET) ||
+                mixer->mic_present != !!(status & BT_DUALSHOCK4_STATUS_MIC))
+        {
+            mixer->headphones = !!(status & BT_DUALSHOCK4_STATUS_HEADSET);
+            mixer->mic_present = !!(status & BT_DUALSHOCK4_STATUS_MIC);
+            TRACE("Bluetooth DualShock 4 %s: headset %s, microphone %s (status %#x).\n", mixer->path,
+                    mixer->headphones ? "plugged" : "unplugged", mixer->mic_present ? "present" : "absent", status);
+        }
+        if (buf[0] != 0x11 && mixer->mic_sbc && mixer->capture_streams)
+            bt_dualshock4_decode_mic(mixer, buf, len);
+    }
+}
+
+/* Output report byte 2: always set bit 5, bit 2 enables the microphone.
+ * winebus sets it the same way, from the same status bit. */
+static BYTE bt_dualshock4_audio_control(struct bt_dualsense_mixer *mixer)
+{
+    return 0x20 | (mixer->mic_present ? 0x04 : 0);
+}
+
+static void bt_dualshock4_write(struct bt_dualsense_mixer *mixer, BYTE *report, SIZE_T size)
+{
+    bt_dualsense_set_crc(report, size);
+    if (write(mixer->fd, report, size) < 0)
+    {
+        if (errno == EAGAIN) mixer->stat_eagain++;
+        else WARN("Bluetooth DualShock 4 write failed: %s\n", strerror(errno));
+    }
+    mixer->output_time = bt_now();
+}
+
+/* Speaker, headset and microphone volume: output report #0x11 with only the
+ * volume fields marked valid, so lightbar and rumble state are left alone.
+ * Resent every second while audio plays, games may change it through their
+ * own output reports. */
+static void bt_dualshock4_send_volume(struct bt_dualsense_mixer *mixer)
+{
+    BYTE report[BT_DUALSHOCK4_OUTPUT_REPORT_SIZE] = {0};
+
+    if (mixer->volume_time && bt_now() - mixer->volume_time < 1000000)
+        return;
+    report[0] = BT_DUALSHOCK4_OUTPUT_REPORT_ID;
+    report[1] = 0xc0; /* HID, CRC */
+    report[2] = bt_dualshock4_audio_control(mixer);
+    report[3] = 0x10 | 0x20 | 0x40 | 0x80; /* headset left, headset right, microphone, speaker volume */
+    report[21] = report[22] = report[24] = BT_DUALSHOCK4_VOLUME;
+    report[23] = BT_DUALSHOCK4_MIC_VOLUME;
+    bt_dualshock4_write(mixer, report, sizeof(report));
+    mixer->volume_time = bt_now();
+}
+
+/* The controller sends one microphone report per output report, so while
+ * the microphone is captured, send a no-op output report whenever 8 ms, one
+ * microphone frame, passed without one. */
+static void bt_dualshock4_clock_mic(struct bt_dualsense_mixer *mixer)
+{
+    BYTE report[BT_DUALSHOCK4_OUTPUT_REPORT_SIZE] = {0};
+    UINT64 now = bt_now();
+    UINT32 count = 0;
+
+    if (!mixer->mic_present || !mixer->capture_streams)
+        return;
+    bt_dualshock4_send_volume(mixer);
+    if (now - mixer->output_time > 4 * BT_DUALSHOCK4_MIC_INTERVAL_US)
+        mixer->output_time = now - BT_DUALSHOCK4_MIC_INTERVAL_US;
+    while (now - mixer->output_time >= BT_DUALSHOCK4_MIC_INTERVAL_US && count++ < 4)
+    {
+        memset(report, 0, sizeof(report));
+        report[0] = BT_DUALSHOCK4_OUTPUT_REPORT_ID;
+        report[1] = 0xc0;
+        report[2] = bt_dualshock4_audio_control(mixer);
+        bt_dualshock4_write(mixer, report, sizeof(report));
+        mixer->output_time += BT_DUALSHOCK4_MIC_INTERVAL_US;
+    }
+}
+
+static void bt_dualshock4_send_chunk(struct bt_dualsense_mixer *mixer, const int16_t (*pcm)[4])
+{
+    BYTE report[BT_DUALSHOCK4_AUDIO_REPORT_SIZE] = {0};
+    int16_t block[BT_DUALSHOCK4_SBC_FRAME_SAMPLES * 2];
+    BOOL signal = FALSE;
+    ssize_t consumed, written;
+    UINT32 i, f;
+
+    for (i = 0; i < BT_DUALSENSE_SPEAKER_WINDOW_FRAMES; ++i)
+        signal |= pcm[i][0] || pcm[i][1];
+    mixer->stat_signal += signal;
+
+    /* Keep going a little past the last sound so the decoder flushes its
+     * tail, then stop until the game plays audio again. */
+    if (signal)
+        mixer->spk_idle_chunks = 0;
+    else if (mixer->spk_idle_chunks < 16)
+        ++mixer->spk_idle_chunks;
+    if (!mixer->sbc || mixer->spk_idle_chunks >= 16)
+    {
+        mixer->stat_skipped++;
+        return;
+    }
+
+    bt_dualshock4_read_input(mixer);
+    bt_dualshock4_send_volume(mixer);
+
+    report[0] = BT_DUALSHOCK4_AUDIO_REPORT_ID;
+    report[1] = 0x40;
+    report[2] = 0x80 | bt_dualshock4_audio_control(mixer); /* enable audio */
+    report[3] = mixer->sbc_frames;
+    report[4] = mixer->sbc_frames >> 8;
+    report[5] = mixer->headphones ? BT_DUALSHOCK4_AUDIO_TARGET_HEADSET : BT_DUALSHOCK4_AUDIO_TARGET_SPEAKER;
+    for (f = 0; f < BT_DUALSHOCK4_SBC_FRAMES_PER_REPORT; ++f)
+    {
+        for (i = 0; i < BT_DUALSHOCK4_SBC_FRAME_SAMPLES; ++i)
+        {
+            block[i * 2] = pcm[f * BT_DUALSHOCK4_SBC_FRAME_SAMPLES + i][0];
+            block[i * 2 + 1] = pcm[f * BT_DUALSHOCK4_SBC_FRAME_SAMPLES + i][1];
+        }
+        written = 0;
+        consumed = p_sbc_encode(mixer->sbc, block, sizeof(block),
+                report + 6 + f * BT_DUALSHOCK4_SBC_FRAME_SIZE, BT_DUALSHOCK4_SBC_FRAME_SIZE, &written);
+        if (consumed != sizeof(block) || written != BT_DUALSHOCK4_SBC_FRAME_SIZE)
+        {
+            WARN("sbc_encode failed: %d, %d bytes.\n", (int)consumed, (int)written);
+            return;
+        }
+    }
+    mixer->sbc_frames += BT_DUALSHOCK4_SBC_FRAMES_PER_REPORT;
+    mixer->stat_speaker++;
+    bt_dualshock4_write(mixer, report, sizeof(report));
+}
+
+static void bt_dualsense_mixer_skip_stale(struct bt_dualsense_mixer *mixer, UINT64 clock)
+{
+    /* Nothing was written for a while, drop what is stale. */
+    if (clock + BT_DUALSENSE_MIX_SEND_AHEAD > mixer->sent + BT_DUALSENSE_MIX_RING / 2)
+    {
+        memset(mixer->ring, 0, sizeof(mixer->ring));
+        mixer->sent = clock / BT_DUALSENSE_SPEAKER_WINDOW_FRAMES * BT_DUALSENSE_SPEAKER_WINDOW_FRAMES;
+    }
+}
+
+static void bt_dualsense_mixer_send(struct bt_dualsense_mixer *mixer, UINT64 clock)
+{
+    int16_t pcm[BT_DUALSENSE_SPEAKER_WINDOW_FRAMES][4];
+    UINT32 i, c;
+
+    while (mixer->sent + BT_DUALSENSE_SPEAKER_WINDOW_FRAMES <= clock + BT_DUALSENSE_MIX_SEND_AHEAD)
+    {
+        for (i = 0; i < BT_DUALSENSE_SPEAKER_WINDOW_FRAMES; ++i)
+        {
+            INT32 *frame = mixer->ring[(mixer->sent + i) % BT_DUALSENSE_MIX_RING];
+
+            for (c = 0; c < 4; ++c)
+                pcm[i][c] = max(-32768, min(32767, frame[c]));
+            memset(frame, 0, sizeof(mixer->ring[0]));
+        }
+        mixer->sent += BT_DUALSENSE_SPEAKER_WINDOW_FRAMES;
+        if (mixer->dualshock4)
+            bt_dualshock4_send_chunk(mixer, (const int16_t (*)[4])pcm);
+        else
+            bt_dualsense_send_chunk(mixer, (const int16_t (*)[4])pcm);
+    }
+
+    if (TRACE_ON(pipewire) && bt_now() - mixer->stat_time >= 1000000)
+    {
+        TRACE("Bluetooth DualSense %s: %u speaker, %u haptics, %u skipped reports, %u chunks with speaker signal, "
+                "%u writes dropped, %u stream rebases, %d streams.\n", mixer->path, mixer->stat_speaker,
+                mixer->stat_haptics, mixer->stat_skipped, mixer->stat_signal, mixer->stat_eagain,
+                mixer->stat_rebase, (int)mixer->refs);
+        mixer->stat_speaker = mixer->stat_haptics = mixer->stat_skipped = 0;
+        mixer->stat_signal = mixer->stat_eagain = mixer->stat_rebase = 0;
+        mixer->stat_time = bt_now();
+    }
+}
+
+/* Source sample of a DualShock 4 stream as 16-bit, mono streams play on both
+ * channels and others use their first two. */
+static INT32 bt_dualshock4_sample(const struct bt_stream *stream, const BYTE *src, UINT32 frame, UINT32 c)
+{
+    UINT32 index = frame * stream->channels + (stream->channels == 1 ? 0 : c);
+
+    switch (stream->format)
+    {
+    case BT_FORMAT_F32: return float_to_s16(((const float *)src)[index]);
+    case BT_FORMAT_S32: return ((const int32_t *)src)[index] >> 16;
+    default: return ((const int16_t *)src)[index];
+    }
+}
+
+/* Like bt_haptic_write(), resampling the stream to the controller's
+ * 32 kHz with linear interpolation. */
+static void bt_ds4_render(struct bt_stream *stream, UINT32 held_frames, UINT32 frame_size)
+{
+    struct bt_dualsense_mixer *mixer = stream->hid_mixer;
+    UINT32 contiguous_frames, avail, in = 0, c;
+    UINT64 clock, target;
+    const BYTE *src;
+
+    clock = bt_dualsense_mixer_clock(mixer);
+    bt_dualsense_mixer_skip_stale(mixer, clock);
+    if (!stream->hid_start_time || stream->hid_consumed < mixer->sent)
+    {
+        /* Started, or fell behind: don't send the missed time in a burst. */
+        if (stream->hid_start_time) mixer->stat_rebase++;
+        stream->hid_start_time = 1;
+        stream->hid_consumed = max(mixer->sent, clock + BT_DUALSENSE_MIX_SEND_AHEAD);
+        stream->hid_phase = BT_DUALSHOCK4_RATE;
+        stream->hid_prev[0] = stream->hid_prev[1] = 0;
+    }
+
+    target = min(clock + BT_DUALSENSE_MIX_LEAD, mixer->sent + BT_DUALSENSE_MIX_RING);
+    contiguous_frames = (stream->real_bufsize_bytes - stream->pa_offs_bytes) / frame_size;
+    avail = min(held_frames, contiguous_frames);
+    src = stream->local_buffer + stream->pa_offs_bytes;
+
+    while (stream->hid_consumed < target)
+    {
+        INT32 *frame;
+
+        while (stream->hid_phase >= BT_DUALSHOCK4_RATE && in < avail)
+        {
+            for (c = 0; c < 2; ++c)
+                stream->hid_prev[c] = bt_dualshock4_sample(stream, src, in, c);
+            ++in;
+            stream->hid_phase -= BT_DUALSHOCK4_RATE;
+        }
+        if (in >= avail)
+            break;
+
+        frame = mixer->ring[stream->hid_consumed % BT_DUALSENSE_MIX_RING];
+        for (c = 0; c < 2; ++c)
+        {
+            INT32 next = bt_dualshock4_sample(stream, src, in, c);
+
+            frame[c] += stream->hid_prev[c] +
+                    (INT32)((INT64)(next - stream->hid_prev[c]) * stream->hid_phase / BT_DUALSHOCK4_RATE);
+        }
+        stream->hid_consumed++;
+        stream->hid_phase += stream->rate;
+    }
+    if (in)
+        bt_advance(stream, in, frame_size);
+
+    bt_dualsense_mixer_send(mixer, clock);
+}
+
+/* Bluetooth DualShock 4 headset microphone capture: there is no device
+ * clock either, so produce packets in real time from the decoded 16 kHz
+ * audio, resampled to the stream rate, with a jitter reserve since the
+ * controller sends it in bursts. */
+static void bt_ds4_capture(struct bt_stream *stream)
+{
+    struct bt_dualsense_mixer *mixer = stream->hid_mixer;
+    UINT32 frame_size = stream->frame_size, period_frames = stream->period_bytes / frame_size;
+    UINT32 rate = stream->rate, i, c, underrun;
+    UINT64 now = bt_now();
+    UINT64 due;
+    BYTE *dst;
+
+    if (!mixer || !period_frames)
+        return;
+    bt_dualshock4_read_input(mixer);
+    bt_dualshock4_clock_mic(mixer);
+
+    if (!stream->hid_start_time)
+    {
+        stream->hid_start_time = now;
+        stream->hid_consumed = 0;
+        stream->hid_mic_pos = mixer->mic_written;
+        stream->hid_mic_buffering = TRUE;
+        stream->hid_phase = 0;
+    }
+
+    due = (now - stream->hid_start_time) * rate / 1000000;
+    while (due >= stream->hid_consumed + period_frames)
+    {
+        if (!(dst = bt_capture_packet(stream)))
+            return;
+        underrun = 0;
+        for (i = 0; i < period_frames; ++i)
+        {
+            INT32 value = 0;
+
+            /* Keep the latency bounded after a burst. */
+            if (mixer->mic_written > stream->hid_mic_pos + 3 * BT_DUALSHOCK4_MIC_JITTER)
+            {
+                stream->hid_mic_pos = mixer->mic_written - BT_DUALSHOCK4_MIC_JITTER;
+                stream->hid_phase = 0;
+            }
+            if (stream->hid_mic_buffering && mixer->mic_written >= stream->hid_mic_pos + BT_DUALSHOCK4_MIC_JITTER)
+                stream->hid_mic_buffering = FALSE;
+            if (!stream->hid_mic_buffering && stream->hid_mic_pos + 1 < mixer->mic_written)
+            {
+                INT32 a = mixer->mic_ring[stream->hid_mic_pos % BT_DUALSHOCK4_MIC_RING];
+                INT32 b = mixer->mic_ring[(stream->hid_mic_pos + 1) % BT_DUALSHOCK4_MIC_RING];
+
+                value = a + (INT32)((INT64)(b - a) * stream->hid_phase / rate);
+                stream->hid_phase += BT_DUALSHOCK4_MIC_RATE;
+                while (stream->hid_phase >= rate)
+                {
+                    stream->hid_mic_pos++;
+                    stream->hid_phase -= rate;
+                }
+            }
+            else if (!stream->hid_mic_buffering)
+            {
+                /* Ran dry, refill the jitter reserve. */
+                stream->hid_mic_buffering = TRUE;
+                underrun = 1;
+            }
+
+            for (c = 0; c < stream->channels; ++c)
+            {
+                UINT32 index = i * stream->channels + c;
+
+                switch (stream->format)
+                {
+                case BT_FORMAT_F32: ((float *)dst)[index] = value / 32768.0f; break;
+                case BT_FORMAT_S32: ((int32_t *)dst)[index] = value * 65536; break;
+                default: ((int16_t *)dst)[index] = value; break;
+                }
+            }
+        }
+        mixer->stat_mic_underruns += underrun;
+        stream->hid_consumed += period_frames;
+    }
+
+    if (TRACE_ON(pipewire) && now - mixer->mic_stat_time >= 1000000)
+    {
+        TRACE("Bluetooth DualShock 4 %s: microphone %s, %u frames, %u underruns, %d capture streams.\n",
+                mixer->path, mixer->mic_present ? "present" : "absent", mixer->stat_mic_frames,
+                mixer->stat_mic_underruns, (int)mixer->capture_streams);
+        mixer->stat_mic_frames = mixer->stat_mic_underruns = 0;
+        mixer->mic_stat_time = now;
+    }
+}
+
+static void bt_haptic_write(struct bt_stream *stream, UINT32 held_frames, UINT32 frame_size)
+{
+    struct bt_dualsense_mixer *mixer = stream->hid_mixer;
+    UINT32 frames, contiguous_frames, i, c;
+    UINT64 clock, target, pos;
+    const BYTE *src;
+
+    if (!mixer)
+        return;
+    if (mixer->dualshock4)
+    {
+        bt_ds4_render(stream, held_frames, frame_size);
+        return;
+    }
+
+    /* There is no device clock, consume the buffer in real time, ahead of
+     * the mixer clock. hid_consumed is the stream's position on it. */
+    clock = bt_dualsense_mixer_clock(mixer);
+    bt_dualsense_mixer_skip_stale(mixer, clock);
+    target = clock + BT_DUALSENSE_MIX_LEAD;
+    if (!stream->hid_start_time || stream->hid_consumed < mixer->sent)
+    {
+        /* Started, or fell behind: don't send the missed time in a burst. */
+        if (stream->hid_start_time) mixer->stat_rebase++;
+        stream->hid_start_time = 1;
+        stream->hid_consumed = max(mixer->sent, clock + BT_DUALSENSE_MIX_SEND_AHEAD);
+    }
+
+    if (target > stream->hid_consumed)
+    {
+        contiguous_frames = (stream->real_bufsize_bytes - stream->pa_offs_bytes) / frame_size;
+        frames = min(min((UINT32)(target - stream->hid_consumed), held_frames), contiguous_frames);
+        frames = min(frames, (UINT32)(mixer->sent + BT_DUALSENSE_MIX_RING - stream->hid_consumed));
+        src = stream->local_buffer + stream->pa_offs_bytes;
+
+        for (i = 0, pos = stream->hid_consumed; i < frames; ++i, ++pos)
+        {
+            INT32 *frame = mixer->ring[pos % BT_DUALSENSE_MIX_RING];
+
+            for (c = 0; c < 4; ++c)
+            {
+                if (stream->format == BT_FORMAT_F32)
+                    frame[c] += float_to_s16(((const float *)src)[i * 4 + c]);
+                else
+                    frame[c] += ((const int16_t *)src)[i * 4 + c];
+            }
+        }
+        if (frames)
+        {
+            stream->hid_consumed += frames;
+            bt_advance(stream, frames, frame_size);
+        }
+    }
+
+    bt_dualsense_mixer_send(mixer, clock);
+}
+
+/* Endpoints. */
+
+static BOOL steam_virtual_gamepad_present(void)
+{
+    char path[PATH_MAX], value[16];
+    struct dirent *entry;
+    BOOL found = FALSE;
+    DIR *dir;
+    FILE *f;
+
+    if (!(dir = opendir("/sys/class/input")))
+        return FALSE;
+    while (!found && (entry = readdir(dir)))
+    {
+        if (strncmp(entry->d_name, "input", 5))
+            continue;
+        snprintf(path, sizeof(path), "/sys/class/input/%s/id/vendor", entry->d_name);
+        if (!(f = fopen(path, "r")))
+            continue;
+        found = fgets(value, sizeof(value), f) && !strncmp(value, "28de", 4);
+        fclose(f);
+        if (!found)
+            continue;
+        snprintf(path, sizeof(path), "/sys/class/input/%s/id/product", entry->d_name);
+        found = FALSE;
+        if (!(f = fopen(path, "r")))
+            continue;
+        found = fgets(value, sizeof(value), f) && !strncmp(value, "11ff", 4);
+        fclose(f);
+    }
+    closedir(dir);
+    return found;
+}
