+
+static void free_device(struct pw_phys_device *dev)
+{
+    list_remove(&dev->entry);
+    free(dev->display);
+    free(dev);
+}
+
+static struct pw_phys_device *dup_device(const struct pw_phys_device *dev)
+{
+    size_t size = offsetof(struct pw_phys_device, pw_name) + strlen(dev->pw_name) + 1;
+    struct pw_phys_device *copy;
+
+    if (!(copy = malloc(size)))
+        return NULL;
+    memcpy(copy, dev, size);
+    if (!(copy->display = malloc((lstrlenW(dev->display) + 1) * sizeof(WCHAR))))
+    {
+        free(copy);
+        return NULL;
+    }
+    memcpy(copy->display, dev->display, (lstrlenW(dev->display) + 1) * sizeof(WCHAR));
+    return copy;
+}
+
+/* Recomputes the pending changes of one flow from a fresh probe.  cur is what
+ * mmdevapi has; fresh is consumed.  Called with device_lists_mutex held. */
+static void diff_devices(struct list *cur, struct list *fresh, struct list *added,
+                         struct list *removed)
+{
+    struct pw_phys_device *dev, *next, *old;
+
+    LIST_FOR_EACH_ENTRY_SAFE(dev, next, added, struct pw_phys_device, entry)
+        free_device(dev);
+    LIST_FOR_EACH_ENTRY_SAFE(dev, next, removed, struct pw_phys_device, entry)
+        free_device(dev);
+
+    LIST_FOR_EACH_ENTRY(old, cur, struct pw_phys_device, entry)
+    {
+        /* The default endpoints stay for the life of the process. */
+        if (!old->pw_name[0] || find_device_in(fresh, old->pw_name))
+            continue;
+        if ((dev = dup_device(old)))
+            list_add_tail(removed, &dev->entry);
+    }
+
+    LIST_FOR_EACH_ENTRY_SAFE(dev, next, fresh, struct pw_phys_device, entry)
+    {
+        list_remove(&dev->entry);
+        if (!(old = find_device_in(cur, dev->pw_name)))
+        {
+            list_add_tail(added, &dev->entry);
+            continue;
+        }
+        /* Same node name: it may have come back with another profile or
+         * description.  Keep the index and container id mmdevapi knows. */
+        old->form = dev->form;
+        old->fmt = dev->fmt;
+        old->channel_mask = dev->channel_mask;
+        old->def_period = dev->def_period;
+        old->min_period = dev->min_period;
+        free(old->display);
+        old->display = dev->display;
+        free(dev);
+    }
+}
+
+static void hp_refresh(void)
+{
+    struct list render = LIST_INIT(render), capture = LIST_INIT(capture);
+    struct pw_phys_device *dev, *next;
+    struct probe p;
+    UINT index;
+
+    if (run_probe(&p))
+    {
+        pthread_mutex_lock(&device_lists_mutex);
+        index = g_next_index;
+        build_device_cache(&p, &render, &capture, &index, FALSE);
+        g_next_index = index;
+        diff_devices(&g_render_devices, &render, &g_render_added, &g_render_removed);
+        diff_devices(&g_capture_devices, &capture, &g_capture_added, &g_capture_removed);
+        TRACE("render +%u -%u, capture +%u -%u\n",
+              list_count(&g_render_added), list_count(&g_render_removed),
+              list_count(&g_capture_added), list_count(&g_capture_removed));
+        pthread_mutex_unlock(&device_lists_mutex);
+    }
+    free_probe(&p);
+
+    LIST_FOR_EACH_ENTRY_SAFE(dev, next, &render, struct pw_phys_device, entry)
+        free_device(dev);
+    LIST_FOR_EACH_ENTRY_SAFE(dev, next, &capture, struct pw_phys_device, entry)
+        free_device(dev);
+}
+
+static BOOL endpoints_fit(struct list *list, size_t *needed, unsigned int size)
+{
+    struct pw_phys_device *dev;
+
+    LIST_FOR_EACH_ENTRY(dev, list, struct pw_phys_device, entry)
+        *needed += (lstrlenW(dev->display) + 1) * sizeof(WCHAR) + ((strlen(dev->pw_name) + 2) & ~1);
+    return *needed <= size;
+}
+
+static void write_endpoints(struct list *list, struct endpoint **endpoint, unsigned int *offset,
+                            struct endpoint *base)
+{
+    struct pw_phys_device *dev;
+    size_t name_len, len;
 
     LIST_FOR_EACH_ENTRY(dev, list, struct pw_phys_device, entry)
     {
         name_len = lstrlenW(dev->display) + 1;
         len = strlen(dev->pw_name) + 1;
-        needed += name_len * sizeof(WCHAR) + ((len + 1) & ~1);
+        (*endpoint)->name = *offset;
+        memcpy((char *)base + *offset, dev->display, name_len * sizeof(WCHAR));
+        *offset += name_len * sizeof(WCHAR);
+        (*endpoint)->device = *offset;
+        memcpy((char *)base + *offset, dev->pw_name, len);
+        *offset += (len + 1) & ~1;
+        (*endpoint)++;
+    }
+}
