+        mask = HP_RENDER | HP_CAPTURE;
+    else if (!strcmp(media_class, "Audio/Source"))
+        mask = HP_CAPTURE;
     else
+        return;
+
+    if (hp_node_count == hp_node_size && hp_node_size < PROBE_MAX_GLOBALS)
     {
-        /* The pw loop is fully stopped: safe to do Wine string conversion. */
