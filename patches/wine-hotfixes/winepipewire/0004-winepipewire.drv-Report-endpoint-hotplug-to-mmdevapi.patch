+/* Endpoint hotplug.
+ *
+ * mmdevapi's update thread calls get_endpoint_ids with delta set and expects
+ * the endpoints added and removed since the last call, waiting about a second
+ * when nothing changed.  A registry listener on the main loop flags sink and
+ * source node changes; the delta call then takes a fresh probe and diffs it
+ * against what mmdevapi has been given.  Entries that survive keep their
+ * index and container id. */
+
+#define HP_RENDER  1
+#define HP_CAPTURE 2
+
+static pthread_mutex_t hp_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t hp_cond = PTHREAD_COND_INITIALIZER;
+static unsigned int hp_events; /* hp_mutex */
+
+/* Main loop thread only, apart from the setup under the loop lock. */
+static struct pw_core *hp_core;
+static struct pw_registry *hp_registry;
+static struct spa_hook hp_core_listener, hp_registry_listener;
+static int hp_sync_seq;
+static BOOL hp_ready;
+struct hp_node { uint32_t id; unsigned int mask; };
+static struct hp_node *hp_nodes;
+static unsigned int hp_node_count, hp_node_size;
+
+/* Not yet returned to mmdevapi; device_lists_mutex. */
+static struct list g_render_added = LIST_INIT(g_render_added);
+static struct list g_render_removed = LIST_INIT(g_render_removed);
+static struct list g_capture_added = LIST_INIT(g_capture_added);
+static struct list g_capture_removed = LIST_INIT(g_capture_removed);
+
+/* Runs on the main loop thread: no Wine calls. */
+static void hp_signal(unsigned int mask)
+{
+    pthread_mutex_lock(&hp_mutex);
+    hp_events |= mask;
+    pthread_cond_broadcast(&hp_cond);
+    pthread_mutex_unlock(&hp_mutex);
+}
