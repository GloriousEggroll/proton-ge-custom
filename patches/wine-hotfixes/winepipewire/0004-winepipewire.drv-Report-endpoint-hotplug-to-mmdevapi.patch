+static void get_endpoint_ids_delta(struct get_endpoint_ids_params *params)
+{
+    unsigned int mask = params->flow == eRender ? HP_RENDER : HP_CAPTURE;
+    unsigned int other = (HP_RENDER | HP_CAPTURE) & ~mask;
+    struct list *cur = params->flow == eRender ? &g_render_devices : &g_capture_devices;
+    struct list *added = params->flow == eRender ? &g_render_added : &g_capture_added;
+    struct list *removed = params->flow == eRender ? &g_render_removed : &g_capture_removed;
+    struct list *other_added = params->flow == eRender ? &g_capture_added : &g_render_added;
+    struct list *other_removed = params->flow == eRender ? &g_capture_removed : &g_render_removed;
+    struct endpoint *endpoint = params->endpoints;
+    struct pw_phys_device *dev, *next, *old;
+    unsigned int events, offset;
+    struct timespec deadline;
+    BOOL pending, other_pending;
+    size_t needed;
+
+    params->num = params->num_removed = 0;
+    params->more_data = FALSE;
+    params->default_idx = -1;
