+
+static void on_hp_core_done(void *data, uint32_t id, int seq)
+{
+    if (id != PW_ID_CORE || seq != hp_sync_seq || hp_ready)
+        return;
+    /* The registry has replayed the existing globals.  Compare once against
+     * the startup probe, in case a device came or went in between. */
+    hp_ready = TRUE;
+    hp_signal(HP_RENDER | HP_CAPTURE);
+}
