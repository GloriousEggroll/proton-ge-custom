From 7a8f5e568ba3fb74fc6ce4757b59562595f0339e Mon Sep 17 00:00:00 2001
From: Etaash Mathamsetty <45927311+BananaWorks07@users.noreply.github.com>
Date: Wed, 2 Sep 2026 01:31:12 -0500
Subject: [PATCH] winewayland: Ignore null state updates.

---
 dlls/winewayland.drv/window.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index ac345000f4a..0887d820e50 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -942,6 +942,7 @@ BOOL WAYLAND_GetWindowStateUpdates(HWND hwnd, UINT *state_cmd, UINT *swp_flags,
     if (!(style & WS_VISIBLE)) return FALSE;
     if ((style & (WS_POPUP | WS_CHILD)) == WS_CHILD) return FALSE;
     if (style & WS_DISABLED) return FALSE;
+    if (!foreground) return FALSE;
 
     pthread_mutex_lock(&keyboard->mutex);
     focused_hwnd = keyboard->focused_hwnd;
