From 73e68369d2f2e7220fc27120fd6d24784f795152 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?R=C3=A9mi=20Bernon?= <rbernon@codeweavers.com>
Date: Fri, 4 Sep 2026 13:41:41 +0200
Subject: [PATCH] winevulkan: Don't flag dynamic array / lengths as
 returnedonly.

---
 dlls/winevulkan/make_vulkan | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/dlls/winevulkan/make_vulkan b/dlls/winevulkan/make_vulkan
index 172492781b2..6defde8f272 100755
--- a/dlls/winevulkan/make_vulkan
+++ b/dlls/winevulkan/make_vulkan
@@ -1864,6 +1864,13 @@ class VkStruct(Sequence):
         members = filter(is_api_supported, struct.findall("member"))
         members = [VkMember.from_xml(registry, member, returnedonly) for member in members]
 
+        # don't flag dynamic arrays with input/output lengths as returnedonly
+        for member in filter(lambda m: m.returnedonly, members):
+            for len in filter(lambda m: m.name == member.dyn_array_len, members):
+                len.returnedonly = False
+            if member.is_dynamic_array():
+                member.returnedonly = False
+
         return VkStruct(registry, name, members, structextends, union=union)
 
     def set_order(self, order, structs):
