From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Thu, 3 Sep 2026 01:10:00 -0600
Subject: [PATCH] winewayland: Wake shaped clients after navigation repaint

Some Chromium-style launchers use a shaped GDI host around an accelerated
client surface.  After navigation, the host can repaint most of its GDI
carrier and then stop requesting accelerated frames until Windows exposes
the child hierarchy.  Moving or maximizing the window supplies that expose
incidentally, leaving an otherwise responsive launcher visually frozen.

Remember when the accelerated client last presented.  If a visible shaped
toplevel with an attached, below-parent client stops presenting while its GDI
carrier receives a near-full update, invalidate the window hierarchy once.
Reset the latch on smaller damage so later navigations can be woken without a
periodic repaint loop.
---
 dlls/winewayland.drv/wayland_surface.c |  1 +
 dlls/winewayland.drv/waylanddrv.h      |  2 ++
 dlls/winewayland.drv/window.c          | 54 +++++++++++++++++++++++++-
 3 files changed, 57 insertions(+), 1 deletion(-)

diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -4681,6 +4681,7 @@ static void wayland_client_surface_present(struct client_surface *client, HDC hd
     struct wayland_client_surface *surface = impl_from_client_surface(client);
     HWND hwnd = client->hwnd, toplevel = NtUserGetAncestor(hwnd, GA_ROOT);
 
+    WriteRelease(&surface->last_present_tick, (LONG)NtGetTickCount());
     TRACE("%s hdc=%p toplevel=%p\n", debugstr_client_surface(client), hdc, toplevel);
     wayland_client_surface_update_visual_constraint(surface, toplevel);
 
diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -454,6 +454,7 @@ struct wayland_client_surface
     /* if true then the client surface has an alpha channel controlling transparency */
     BOOL has_alpha;
     BOOL has_presented;
+    LONG last_present_tick;
     struct wayland_visual_constraint visual_constraint;
 };
 
@@ -539,6 +540,7 @@ struct wayland_surface
     HRGN child_region;
     BOOL shaped;
     BOOL occlusion_clipped;
+    BOOL client_repaint_wakeup_latched;
     struct wayland_window_config window, comitted;
     RECT geometry;
     int content_width, content_height;
diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -1739,12 +1739,56 @@ static BOOL window_surface_has_hwnd_dmabuf_content(HWND hwnd)
     return ret;
 }
 
+static BOOL window_surface_damage_covers_buffer(struct wayland_shm_buffer *buffer, HRGN region)
+{
+    RECT damage;
+    int width, height;
+
+    if (!buffer || !region || NtGdiGetRgnBox(region, &damage) == ERROR) return FALSE;
+    width = damage.right - damage.left;
+    height = damage.bottom - damage.top;
+    if (width <= 0 || height <= 0) return FALSE;
+
+    return (LONGLONG)width * 4 >= (LONGLONG)buffer->width * 3 &&
+           (LONGLONG)height * 4 >= (LONGLONG)buffer->height * 3;
+}
+
+static BOOL window_surface_needs_client_repaint_wakeup(struct wayland_win_data *data,
+                                                       struct wayland_shm_buffer *buffer,
+                                                       HRGN damage_region)
+{
+    struct wayland_client_surface *client = data->client_surface;
+    struct wayland_surface *surface = data->wayland_surface;
+    DWORD last_present_tick;
+
+    if (!window_surface_damage_covers_buffer(buffer, damage_region))
+    {
+        if (surface) surface->client_repaint_wakeup_latched = FALSE;
+        return FALSE;
+    }
+
+    if (!surface || surface->client_repaint_wakeup_latched ||
+        surface->role != WAYLAND_SURFACE_ROLE_TOPLEVEL || !surface->window.visible ||
+        surface->window.minimized || !surface->shaped || data->content_over_producer ||
+        !client || client->client.hwnd != data->hwnd || !client->wl_subsurface ||
+        client->toplevel != data->hwnd || client->stack_above_parent ||
+        client->hwnd_dmabuf_producer || !ReadAcquire(&client->has_presented))
+        return FALSE;
+
+    last_present_tick = ReadAcquire(&client->last_present_tick);
+    if (!last_present_tick || (int)(NtGetTickCount() - last_present_tick) < 250)
+        return FALSE;
+
+    surface->client_repaint_wakeup_latched = TRUE;
+    return TRUE;
+}
+
 BOOL set_window_surface_contents(HWND hwnd, struct wayland_shm_buffer *shm_buffer,
                                  HRGN damage_region, BOOL content_over_producer)
 {
     struct wayland_surface *wayland_surface;
     struct wayland_win_data *data;
-    BOOL committed = FALSE;
+    BOOL committed = FALSE, wake_client = FALSE;
     BOOL content_over_changed;
 
     if (!(data = wayland_win_data_get(hwnd))) return FALSE;
@@ -1818,7 +1862,16 @@ BOOL set_window_surface_contents(HWND hwnd, struct wayland_shm_buffer *shm_buffer
             wayland_client_surface_attach(data->client_surface, NULL);
     }
 
+    if (committed)
+        wake_client = window_surface_needs_client_repaint_wakeup(data, shm_buffer, damage_region);
+
     wayland_win_data_release(data);
 
+    /* Chromium-style shaped hosts can stop requesting accelerated frames after
+     * a navigation repaint. A native move happens to expose the children and
+     * unstick them; issue the equivalent one-shot Win32 repaint instead. */
+    if (wake_client)
+        NtUserRedrawWindow(hwnd, NULL, 0, RDW_INVALIDATE | RDW_INTERNALPAINT | RDW_ALLCHILDREN);
+
     return committed;
 }
-- 
2.53.0
