         static const char *props[] = { "Category", "Id", "Title", "Status", "IconName",
-                                       "IconPixmap", "ToolTip", "ItemIsMenu", "WindowId", "Menu" };
+                                       "IconPixmap", "ToolTip", "ItemIsMenu", "WindowId" };
         DBusMessageIter ret, dict;
         unsigned int i;
