+/* Called with output_mutex held. */
+static BOOL wayland_output_supports_hdr(struct wayland_output *output)
+{
+    BOOL enabled;
+
+    /* KWin's SDR reference brightness can equal the HDR peak. Its explicit
+     * per-output state avoids confusing this with a genuinely SDR output. */
+    if (process_wayland.wp_color_manager_v1 &&
+        wayland_kde_output_get_hdr_state(output->current.name, &enabled))
+        return enabled;
+
+    /* Other compositors expose HDR through the output's luminance headroom,
+     * independently of the optional Windows image descriptions. */
+    return output->current.max_lum > output->current.ref_lum;
+}
+
+void wayland_output_refresh_hdr_state(void)
+{
+    struct wayland_output **output;
+    BOOL changed = FALSE, enabled;
+
+    pthread_mutex_lock(&process_wayland.output_mutex);
+    wl_array_for_each(output, &process_wayland.output_array)
+    {
+        enabled = wayland_output_supports_hdr(*output);
+        if ((*output)->current.supports_hdr == enabled) continue;
+        (*output)->current.supports_hdr = enabled;
+        TRACE("name=%s hdr=%u\n", (*output)->current.name, enabled);
+        changed = TRUE;
+    }
+    pthread_mutex_unlock(&process_wayland.output_mutex);
+
+    if (changed) maybe_init_display_devices();
+}
