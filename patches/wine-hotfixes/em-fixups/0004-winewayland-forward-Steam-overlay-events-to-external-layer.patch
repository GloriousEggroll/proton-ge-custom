diff --git a/dlls/winewayland.drv/steam_overlay.c b/dlls/winewayland.drv/steam_overlay.c
new file mode 100644
index 00000000000..c26324d50de
--- /dev/null
+++ b/dlls/winewayland.drv/steam_overlay.c
@@ -0,0 +1,388 @@
+/*
+ * Wine Wayland forwarding shim for the external Steam overlay bridge
+ *
+ * Copyright 2026 GloriousEggroll
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <dlfcn.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+
+#include "steam_overlay_bridge.h"
+#include "waylanddrv.h"
+#include "wine/debug.h"
+#include "winternl.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(waylanddrv);
+
+static pthread_mutex_t overlay_api_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t overlay_api_cond = PTHREAD_COND_INITIALIZER;
+static pthread_mutex_t overlay_event_mutex = PTHREAD_MUTEX_INITIALIZER;
+static const struct ge_steam_overlay_api_v1 *overlay_api;
+static void *overlay_library;
+static unsigned int overlay_api_users;
+static BOOL overlay_api_enabled;
+static BOOL overlay_api_destroying;
+static HANDLE overlay_event;
+static BOOL overlay_event_owned;
+
+static void create_overlay_event_locked(void)
+{
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING str;
+    WCHAR buffer[128];
+    char path[128];
+    unsigned int i;
+    int len;
+
+    if (overlay_event) return;
+
+    len = snprintf(path, sizeof(path),
+                   "\\Sessions\\%u\\BaseNamedObjects\\__wine_steamclient_GameOverlayActivated",
+                   (unsigned int)NtCurrentTeb()->Peb->SessionId);
+    if (len < 0 || len >= (int)ARRAY_SIZE(buffer)) return;
+
+    for (i = 0; i <= len; ++i) buffer[i] = (unsigned char)path[i];
+    str.Buffer = buffer;
+    str.Length = len * sizeof(WCHAR);
+    str.MaximumLength = (len + 1) * sizeof(WCHAR);
+    InitializeObjectAttributes(&attr, &str,
+                               OBJ_CASE_INSENSITIVE | OBJ_OPENIF, 0, NULL);
+
+    if (NtCreateEvent(&overlay_event, EVENT_ALL_ACCESS, &attr,
+                      NotificationEvent, FALSE))
+        overlay_event = NULL;
+}
+
+static int host_overlay_event_is_active(void *userdata)
+{
+    LARGE_INTEGER timeout = {0};
+    BOOL active;
+
+    (void)userdata;
+    pthread_mutex_lock(&overlay_event_mutex);
+    create_overlay_event_locked();
+    active = overlay_event &&
+             NtWaitForSingleObject(overlay_event, FALSE, &timeout) == WAIT_OBJECT_0;
+    pthread_mutex_unlock(&overlay_event_mutex);
+    return active;
+}
+
+static void host_set_overlay_event_owned(void *userdata, int owned)
+{
+    LARGE_INTEGER timeout = {0};
+    BOOL event_active;
+
+    (void)userdata;
+    pthread_mutex_lock(&overlay_event_mutex);
+    create_overlay_event_locked();
+    event_active = overlay_event &&
+                   NtWaitForSingleObject(overlay_event, FALSE, &timeout) == WAIT_OBJECT_0;
+
+    /* Do not reset an event signalled by lsteamclient. Only undo a signal
+     * which this bridge owns. */
+    if (owned && overlay_event && !event_active)
+    {
+        if (!NtSetEvent(overlay_event, NULL)) overlay_event_owned = TRUE;
+    }
+    else if (!owned && overlay_event_owned)
+    {
+        if (!NtResetEvent(overlay_event, NULL)) overlay_event_owned = FALSE;
+    }
+    pthread_mutex_unlock(&overlay_event_mutex);
+}
+
+static enum wp_cursor_shape_device_v1_shape bridge_shape_to_wayland(uint32_t shape)
+{
+    switch (shape)
+    {
+    case GE_STEAM_OVERLAY_CURSOR_POINTER:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_POINTER;
+    case GE_STEAM_OVERLAY_CURSOR_TEXT:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_TEXT;
+    case GE_STEAM_OVERLAY_CURSOR_WAIT:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_WAIT;
+    case GE_STEAM_OVERLAY_CURSOR_CROSSHAIR:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_CROSSHAIR;
+    case GE_STEAM_OVERLAY_CURSOR_ALL_RESIZE:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_ALL_RESIZE;
+    case GE_STEAM_OVERLAY_CURSOR_EW_RESIZE:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_EW_RESIZE;
+    case GE_STEAM_OVERLAY_CURSOR_NS_RESIZE:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_NS_RESIZE;
+    case GE_STEAM_OVERLAY_CURSOR_NWSE_RESIZE:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_NWSE_RESIZE;
+    case GE_STEAM_OVERLAY_CURSOR_NESW_RESIZE:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_NESW_RESIZE;
+    case GE_STEAM_OVERLAY_CURSOR_NOT_ALLOWED:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_NOT_ALLOWED;
+    case GE_STEAM_OVERLAY_CURSOR_HELP:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_HELP;
+    default:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_DEFAULT;
+    }
+}
+
+static uint32_t wayland_shape_to_bridge(enum wp_cursor_shape_device_v1_shape shape)
+{
+    switch (shape)
+    {
+    case WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_POINTER:
+        return GE_STEAM_OVERLAY_CURSOR_POINTER;
+    case WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_TEXT:
+        return GE_STEAM_OVERLAY_CURSOR_TEXT;
+    case WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_WAIT:
+        return GE_STEAM_OVERLAY_CURSOR_WAIT;
+    case WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_CROSSHAIR:
+        return GE_STEAM_OVERLAY_CURSOR_CROSSHAIR;
+    case WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_ALL_RESIZE:
+        return GE_STEAM_OVERLAY_CURSOR_ALL_RESIZE;
+    case WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_EW_RESIZE:
+        return GE_STEAM_OVERLAY_CURSOR_EW_RESIZE;
+    case WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_NS_RESIZE:
+        return GE_STEAM_OVERLAY_CURSOR_NS_RESIZE;
+    case WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_NWSE_RESIZE:
+        return GE_STEAM_OVERLAY_CURSOR_NWSE_RESIZE;
+    case WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_NESW_RESIZE:
+        return GE_STEAM_OVERLAY_CURSOR_NESW_RESIZE;
+    case WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_NOT_ALLOWED:
+        return GE_STEAM_OVERLAY_CURSOR_NOT_ALLOWED;
+    case WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_HELP:
+        return GE_STEAM_OVERLAY_CURSOR_HELP;
+    default:
+        return GE_STEAM_OVERLAY_CURSOR_DEFAULT;
+    }
+}
+
+static void host_set_overlay_active(void *userdata, int active)
+{
+    (void)userdata;
+    wayland_pointer_set_overlay_active(active);
+}
+
+static void host_set_cursor_shape(void *userdata, uint32_t shape)
+{
+    (void)userdata;
+    wayland_pointer_set_overlay_cursor_shape(bridge_shape_to_wayland(shape));
+}
+
+static void load_overlay_api_locked(void)
+{
+    ge_steam_overlay_bridge_get_v1_fn get_api;
+    struct ge_steam_overlay_host_v1 host = {
+        .abi_version = GE_STEAM_OVERLAY_BRIDGE_ABI_VERSION,
+        .struct_size = sizeof(host),
+        .set_overlay_active = host_set_overlay_active,
+        .set_cursor_shape = host_set_cursor_shape,
+        .overlay_event_is_active = host_overlay_event_is_active,
+        .set_overlay_event_owned = host_set_overlay_event_owned,
+    };
+    const char *env = getenv("WINE_WAYLAND_STEAM_OVERLAY_LAYER");
+
+    if (!env || !atoi(env)) return;
+    if (!(overlay_library = dlopen("libVkLayer_GE_Wayland_SteamOverlay.so",
+                                   RTLD_NOW | RTLD_LOCAL)))
+    {
+        TRACE("Steam overlay bridge unavailable: %s\n", dlerror());
+        return;
+    }
+
+    if (!(get_api = (ge_steam_overlay_bridge_get_v1_fn)dlsym(
+              overlay_library, "ge_steam_overlay_bridge_get_v1")) ||
+        !(overlay_api = get_api(GE_STEAM_OVERLAY_BRIDGE_ABI_VERSION, &host)) ||
+        overlay_api->abi_version != GE_STEAM_OVERLAY_BRIDGE_ABI_VERSION ||
+        overlay_api->struct_size < sizeof(*overlay_api))
+    {
+        TRACE("Steam overlay bridge has an incompatible ABI\n");
+        overlay_api = NULL;
+        dlclose(overlay_library);
+        overlay_library = NULL;
+    }
+}
+
+static const struct ge_steam_overlay_api_v1 *acquire_overlay_api(void)
+{
+    const struct ge_steam_overlay_api_v1 *api;
+
+    pthread_mutex_lock(&overlay_api_mutex);
+    api = overlay_api_enabled && !overlay_api_destroying ? overlay_api : NULL;
+    if (api) ++overlay_api_users;
+    pthread_mutex_unlock(&overlay_api_mutex);
+    return api;
+}
+
+static void release_overlay_api(void)
+{
+    pthread_mutex_lock(&overlay_api_mutex);
+    if (!--overlay_api_users) pthread_cond_broadcast(&overlay_api_cond);
+    pthread_mutex_unlock(&overlay_api_mutex);
+}
+
+void wayland_steam_overlay_focus(BOOL focused)
+{
+    const struct ge_steam_overlay_api_v1 *api = acquire_overlay_api();
+
+    if (api)
+    {
+        api->focus(focused);
+        release_overlay_api();
+    }
+}
+
+BOOL wayland_steam_overlay_filter_key(uint32_t time, uint32_t key, uint32_t state)
+{
+    const struct ge_steam_overlay_api_v1 *api = acquire_overlay_api();
+    BOOL ret = FALSE;
+
+    if (api)
+    {
+        ret = api->filter_key(time, key,
+                              state == WL_KEYBOARD_KEY_STATE_PRESSED);
+        release_overlay_api();
+    }
+    return ret;
+}
+
+BOOL wayland_steam_overlay_filter_pointer_button(uint32_t time, uint32_t button,
+                                                 uint32_t state)
+{
+    const struct ge_steam_overlay_api_v1 *api = acquire_overlay_api();
+    BOOL ret = FALSE;
+
+    if (api)
+    {
+        ret = api->filter_pointer_button(
+            time, button, state == WL_POINTER_BUTTON_STATE_PRESSED);
+        release_overlay_api();
+    }
+    return ret;
+}
+
+BOOL wayland_steam_overlay_filter_pointer_frame(const struct wayland_pointer_frame *frame)
+{
+    const struct ge_steam_overlay_api_v1 *api = acquire_overlay_api();
+    struct ge_steam_overlay_pointer_frame_v1 bridge_frame;
+    BOOL ret;
+
+    if (!api) return FALSE;
+
+    bridge_frame.time = frame->time;
+    bridge_frame.x = frame->x;
+    bridge_frame.y = frame->y;
+    bridge_frame.dx = frame->dx;
+    bridge_frame.dy = frame->dy;
+    bridge_frame.axis = frame->axis;
+    bridge_frame.horz_axis = frame->horz_axis;
+    bridge_frame.scroll = frame->scroll;
+    bridge_frame.horz_scroll = frame->horz_scroll;
+    bridge_frame.flags = 0;
+    if (frame->flags & WAYLAND_POINTER_FRAME_RELATIVE)
+        bridge_frame.flags |= GE_STEAM_OVERLAY_FRAME_RELATIVE;
+    if (frame->flags & WAYLAND_POINTER_FRAME_ABSOLUTE)
+        bridge_frame.flags |= GE_STEAM_OVERLAY_FRAME_ABSOLUTE;
+    if (frame->flags & WAYLAND_POINTER_FRAME_DISCRETE_WHEEL)
+        bridge_frame.flags |= GE_STEAM_OVERLAY_FRAME_DISCRETE_WHEEL;
+    if (frame->flags & WAYLAND_POINTER_FRAME_DISCRETE_WHEEL_HORZ)
+        bridge_frame.flags |= GE_STEAM_OVERLAY_FRAME_DISCRETE_WHEEL_HORZ;
+    if (frame->flags & WAYLAND_POINTER_FRAME_AXIS)
+        bridge_frame.flags |= GE_STEAM_OVERLAY_FRAME_AXIS;
+    if (frame->flags & WAYLAND_POINTER_FRAME_AXIS_HORZ)
+        bridge_frame.flags |= GE_STEAM_OVERLAY_FRAME_AXIS_HORZ;
+
+    ret = api->filter_pointer_frame(&bridge_frame);
+    release_overlay_api();
+    return ret;
+}
+
+BOOL wayland_steam_overlay_is_active(void)
+{
+    const struct ge_steam_overlay_api_v1 *api = acquire_overlay_api();
+    BOOL ret = FALSE;
+
+    if (api)
+    {
+        ret = api->is_active();
+        release_overlay_api();
+    }
+    return ret;
+}
+
+void wayland_steam_overlay_set_cursor_shape(
+    enum wp_cursor_shape_device_v1_shape shape)
+{
+    const struct ge_steam_overlay_api_v1 *api = acquire_overlay_api();
+
+    if (api)
+    {
+        api->set_cursor_shape(wayland_shape_to_bridge(shape));
+        release_overlay_api();
+    }
+}
+
+void wayland_steam_overlay_enable(void)
+{
+    const struct ge_steam_overlay_api_v1 *api;
+
+    pthread_mutex_lock(&overlay_api_mutex);
+    while (overlay_api_destroying)
+        pthread_cond_wait(&overlay_api_cond, &overlay_api_mutex);
+    overlay_api_enabled = TRUE;
+    if (!overlay_api) load_overlay_api_locked();
+    api = overlay_api;
+    if (api) ++overlay_api_users;
+    pthread_mutex_unlock(&overlay_api_mutex);
+
+    if (api)
+    {
+        api->enable();
+        release_overlay_api();
+    }
+}
+
+void wayland_steam_overlay_destroy(void)
+{
+    const struct ge_steam_overlay_api_v1 *api;
+    HANDLE event;
+
+    pthread_mutex_lock(&overlay_api_mutex);
+    while (overlay_api_destroying)
+        pthread_cond_wait(&overlay_api_cond, &overlay_api_mutex);
+    overlay_api_enabled = FALSE;
+    while (overlay_api_users)
+        pthread_cond_wait(&overlay_api_cond, &overlay_api_mutex);
+    overlay_api_destroying = TRUE;
+    api = overlay_api;
+    pthread_mutex_unlock(&overlay_api_mutex);
+
+    if (api) api->destroy();
+
+    pthread_mutex_lock(&overlay_event_mutex);
+    if (overlay_event_owned && overlay_event)
+        NtResetEvent(overlay_event, NULL);
+    event = overlay_event;
+    overlay_event = NULL;
+    overlay_event_owned = FALSE;
+    pthread_mutex_unlock(&overlay_event_mutex);
+    if (event) NtClose(event);
+
+    pthread_mutex_lock(&overlay_api_mutex);
+    overlay_api_destroying = FALSE;
+    pthread_cond_broadcast(&overlay_api_cond);
+    pthread_mutex_unlock(&overlay_api_mutex);
+}
diff --git a/dlls/winewayland.drv/steam_overlay_bridge.h b/dlls/winewayland.drv/steam_overlay_bridge.h
new file mode 100644
index 00000000000..0119f587f45
--- /dev/null
+++ b/dlls/winewayland.drv/steam_overlay_bridge.h
@@ -0,0 +1,83 @@
+#ifndef GE_STEAM_OVERLAY_BRIDGE_H
+#define GE_STEAM_OVERLAY_BRIDGE_H
+
+#include <stdint.h>
+
+#define GE_STEAM_OVERLAY_BRIDGE_ABI_VERSION 1u
+
+enum ge_steam_overlay_cursor_shape
+{
+    GE_STEAM_OVERLAY_CURSOR_DEFAULT,
+    GE_STEAM_OVERLAY_CURSOR_POINTER,
+    GE_STEAM_OVERLAY_CURSOR_TEXT,
+    GE_STEAM_OVERLAY_CURSOR_WAIT,
+    GE_STEAM_OVERLAY_CURSOR_CROSSHAIR,
+    GE_STEAM_OVERLAY_CURSOR_ALL_RESIZE,
+    GE_STEAM_OVERLAY_CURSOR_EW_RESIZE,
+    GE_STEAM_OVERLAY_CURSOR_NS_RESIZE,
+    GE_STEAM_OVERLAY_CURSOR_NWSE_RESIZE,
+    GE_STEAM_OVERLAY_CURSOR_NESW_RESIZE,
+    GE_STEAM_OVERLAY_CURSOR_NOT_ALLOWED,
+    GE_STEAM_OVERLAY_CURSOR_HELP,
+};
+
+enum ge_steam_overlay_pointer_frame_flags
+{
+    GE_STEAM_OVERLAY_FRAME_RELATIVE = 1u << 0,
+    GE_STEAM_OVERLAY_FRAME_ABSOLUTE = 1u << 1,
+    GE_STEAM_OVERLAY_FRAME_DISCRETE_WHEEL = 1u << 2,
+    GE_STEAM_OVERLAY_FRAME_DISCRETE_WHEEL_HORZ = 1u << 3,
+    GE_STEAM_OVERLAY_FRAME_AXIS = 1u << 4,
+    GE_STEAM_OVERLAY_FRAME_AXIS_HORZ = 1u << 5,
+};
+
+struct ge_steam_overlay_pointer_frame_v1
+{
+    uint32_t time;
+    int32_t x;
+    int32_t y;
+    double dx;
+    double dy;
+    double axis;
+    double horz_axis;
+    int32_t scroll;
+    int32_t horz_scroll;
+    uint32_t flags;
+};
+
+struct ge_steam_overlay_host_v1
+{
+    uint32_t abi_version;
+    uint32_t struct_size;
+    void *userdata;
+
+    void (*set_overlay_active)(void *userdata, int active);
+    void (*set_cursor_shape)(void *userdata, uint32_t shape);
+    int (*overlay_event_is_active)(void *userdata);
+    void (*set_overlay_event_owned)(void *userdata, int owned);
+};
+
+struct ge_steam_overlay_api_v1
+{
+    uint32_t abi_version;
+    uint32_t struct_size;
+
+    void (*enable)(void);
+    void (*destroy)(void);
+    void (*focus)(int focused);
+    int (*filter_key)(uint32_t time, uint32_t key, int pressed);
+    int (*filter_pointer_button)(uint32_t time, uint32_t button, int pressed);
+    int (*filter_pointer_frame)(const struct ge_steam_overlay_pointer_frame_v1 *frame);
+    int (*is_active)(void);
+    void (*set_cursor_shape)(uint32_t shape);
+};
+
+typedef const struct ge_steam_overlay_api_v1 *
+(*ge_steam_overlay_bridge_get_v1_fn)(uint32_t abi_version,
+                                     const struct ge_steam_overlay_host_v1 *host);
+
+const struct ge_steam_overlay_api_v1 *
+ge_steam_overlay_bridge_get_v1(uint32_t abi_version,
+                               const struct ge_steam_overlay_host_v1 *host);
+
+#endif
diff --git a/dlls/winewayland.drv/wayland_keyboard.c b/dlls/winewayland.drv/wayland_keyboard.c
index a135e346a76..723ca4a59de 100644
--- a/dlls/winewayland.drv/wayland_keyboard.c
+++ b/dlls/winewayland.drv/wayland_keyboard.c
@@ -927,6 +927,8 @@ static void keyboard_handle_enter(void *private, struct wl_keyboard *wl_keyboard
     keyboard->focused_hwnd = hwnd;
     pthread_mutex_unlock(&keyboard->mutex);
 
+    wayland_steam_overlay_focus(TRUE);
+
     NtUserPostMessage(hwnd, WM_INPUTLANGCHANGEREQUEST, 0 /*FIXME*/, (LPARAM)keyboard_hkl);
     NtUserPostMessage(hwnd, WM_WINE_WINDOW_STATE_CHANGED, 0, 0);
     if (wayland_is_layer_menu_hwnd(hwnd))
@@ -967,6 +969,8 @@ static void keyboard_handle_leave(void *private, struct wl_keyboard *wl_keyboard
         keyboard->focused_hwnd = NULL;
     pthread_mutex_unlock(&keyboard->mutex);
 
+    wayland_steam_overlay_focus(FALSE);
+
     /* The spec for the leave event tells us to treat all keys as released,
      * and for any key repetition to stop. */
     release_all_keys(hwnd);
@@ -1076,6 +1080,12 @@ static void keyboard_handle_key(void *data, struct wl_keyboard *wl_keyboard,
 
     TRACE_(key)("serial=%u hwnd=%p key=%d scan=%#x state=%#x\n", serial, hwnd, key, scan, state);
 
+    if (wayland_steam_overlay_filter_key(time, key, state))
+    {
+        update_keystate(key, state);
+        return;
+    }
+
     if (key == KEY_ESC && state == WL_KEYBOARD_KEY_STATE_PRESSED)
         wayland_cancel_layer_menu_if_needed(NULL);
 
diff --git a/dlls/winewayland.drv/wayland_pointer.c b/dlls/winewayland.drv/wayland_pointer.c
index a515956ab9c..f9cdc2ca2f3 100644
--- a/dlls/winewayland.drv/wayland_pointer.c
+++ b/dlls/winewayland.drv/wayland_pointer.c
@@ -125,6 +125,7 @@ static void wayland_pointer_reset_frame(void)
 {
     struct wayland_pointer_frame *frame = &process_wayland.pointer.frame;
 
+    frame->time = 0;
     frame->dx = frame->dy = 0.0;
     frame->dx_raw = frame->dy_raw = 0.0;
     frame->horz_scroll = frame->scroll = 0.0;
@@ -132,7 +133,7 @@ static void wayland_pointer_reset_frame(void)
     frame->flags = 0;
 }
 
-static void pointer_handle_motion_internal(wl_fixed_t sx, wl_fixed_t sy)
+static void pointer_handle_motion_internal(uint32_t time, wl_fixed_t sx, wl_fixed_t sy)
 {
     struct wayland_pointer *pointer = &process_wayland.pointer;
     struct wayland_pointer_frame *frame = &pointer->frame;
@@ -166,6 +167,7 @@ static void pointer_handle_motion_internal(wl_fixed_t sx, wl_fixed_t sy)
 
     pthread_mutex_lock(&pointer->mutex);
 
+    frame->time = time;
     frame->x = screen.x;
