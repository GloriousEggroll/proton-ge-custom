+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef SONAME_LIBX11
+#include <dlfcn.h>
+#include <linux/input.h>
+#undef SW_MAX /* Also defined in winuser.rh */
+#include <X11/cursorfont.h>
+#include <X11/Xlib.h>
+enum { OVERLAY_X11_CONTROL_MASK = ControlMask };
+#undef Status /* Avoid conflicts with winternl.h */
+#undef ControlMask /* Avoid conflicts with processthreadsapi.h */
+#endif
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+
+#include "waylanddrv.h"
+#include "wine/debug.h"
+#include "winternl.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(waylanddrv);
+
+#ifdef SONAME_LIBX11
+
+enum overlay_x11_request_type
+{
+    OVERLAY_X11_CHANGE_WINDOW_ATTRIBUTES = 2,
+    OVERLAY_X11_CREATE_CURSOR = 93,
+    OVERLAY_X11_CREATE_GLYPH_CURSOR = 94,
+    OVERLAY_X11_FREE_CURSOR = 95,
+};
+
+struct overlay_x11_request
+{
+    uint8_t type;
+    uint8_t data;
+    uint16_t length;
+};
+
+struct overlay_x11_resource_request
+{
+    uint8_t type;
+    uint8_t pad;
+    uint16_t length;
+    uint32_t id;
+};
+
+struct overlay_x11_change_window_attributes_request
+{
+    uint8_t type;
+    uint8_t pad;
+    uint16_t length;
+    uint32_t window;
+    uint32_t value_mask;
+};
+
+struct overlay_x11_create_cursor_request
+{
+    uint8_t type;
+    uint8_t pad;
+    uint16_t length;
+    uint32_t cursor;
+    uint32_t source;
+    uint32_t mask;
+    uint16_t foreground_red;
+    uint16_t foreground_green;
+    uint16_t foreground_blue;
+    uint16_t background_red;
+    uint16_t background_green;
+    uint16_t background_blue;
+    uint16_t x;
+    uint16_t y;
+};
+
+struct overlay_x11_create_glyph_cursor_request
+{
+    uint8_t type;
+    uint8_t pad;
+    uint16_t length;
+    uint32_t cursor;
+    uint32_t source;
+    uint32_t mask;
+    uint16_t source_char;
+    uint16_t mask_char;
+    uint16_t foreground_red;
+    uint16_t foreground_green;
+    uint16_t foreground_blue;
+    uint16_t background_red;
+    uint16_t background_green;
+    uint16_t background_blue;
+};
+
+/* gameoverlayrenderer wraps XPutBackEvent and marks the next event returned
+ * for that display as already processed. Queue bridge events through Xlib's
+ * internal implementation so Steam sees them for the first time when we call
+ * its wrapped XCheckIfEvent below. */
+extern int _XPutBackEvent(Display *display, XEvent *event);
+
+static pthread_mutex_t overlay_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t overlay_cursor_mutex = PTHREAD_MUTEX_INITIALIZER;
+static Display *overlay_display;
+static Window overlay_window;
+static Window overlay_root;
+static HANDLE overlay_event;
+static int (*previous_after_function)(Display *display);
+static unsigned long overlay_serial;
+static unsigned int overlay_state;
+static int overlay_initialized;
+static BOOL overlay_active;
+static BOOL overlay_input_active;
+static int pointer_x, pointer_y;
+
+#define OVERLAY_CURSOR_MAP_SIZE 64
+
+static struct
+{
+    Cursor cursor;
+    enum wp_cursor_shape_device_v1_shape shape;
+} overlay_cursor_map[OVERLAY_CURSOR_MAP_SIZE];
+
+static enum wp_cursor_shape_device_v1_shape overlay_cursor_shape =
+    WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_DEFAULT;
+static BOOL overlay_cursor_dirty;
+
+struct overlay_event_match
+{
+    Window window;
+    unsigned long serial;
+    int type;
+};
+
+static Bool match_overlay_event(Display *display, XEvent *event, XPointer arg)
+{
+    const struct overlay_event_match *match = (const struct overlay_event_match *)arg;
+
+    (void)display;
+    return event->xany.window == match->window && event->xany.serial == match->serial &&
+           event->type == match->type;
+}
+
+static enum wp_cursor_shape_device_v1_shape cursor_shape_from_glyph(unsigned int glyph)
+{
+    switch (glyph)
+    {
+    case XC_hand1:
+    case XC_hand2:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_POINTER;
+    case XC_xterm:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_TEXT;
+    case XC_clock:
+    case XC_watch:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_WAIT;
+    case XC_cross:
+    case XC_cross_reverse:
+    case XC_crosshair:
+    case XC_diamond_cross:
+    case XC_dot:
+    case XC_dotbox:
+    case XC_iron_cross:
+    case XC_plus:
+    case XC_target:
+    case XC_tcross:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_CROSSHAIR;
+    case XC_fleur:
+    case XC_sizing:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_ALL_RESIZE;
+    case XC_left_side:
+    case XC_left_tee:
+    case XC_right_side:
+    case XC_right_tee:
+    case XC_sb_h_double_arrow:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_EW_RESIZE;
+    case XC_bottom_side:
+    case XC_bottom_tee:
+    case XC_sb_v_double_arrow:
+    case XC_top_side:
+    case XC_top_tee:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_NS_RESIZE;
+    case XC_bottom_right_corner:
+    case XC_top_left_corner:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_NWSE_RESIZE;
+    case XC_bottom_left_corner:
+    case XC_top_right_corner:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_NESW_RESIZE;
+    case XC_pirate:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_NOT_ALLOWED;
+    case XC_question_arrow:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_HELP;
+    default:
+        return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_DEFAULT;
+    }
+}
+
+static void record_overlay_cursor(Cursor cursor,
+                                  enum wp_cursor_shape_device_v1_shape shape)
+{
+    unsigned int i, free_slot = OVERLAY_CURSOR_MAP_SIZE;
+
+    for (i = 0; i < OVERLAY_CURSOR_MAP_SIZE; ++i)
+    {
+        if (overlay_cursor_map[i].cursor == cursor)
+        {
+            overlay_cursor_map[i].shape = shape;
+            return;
+        }
+        if (!overlay_cursor_map[i].cursor && free_slot == OVERLAY_CURSOR_MAP_SIZE)
+            free_slot = i;
+    }
+
+    if (free_slot == OVERLAY_CURSOR_MAP_SIZE) free_slot = cursor % OVERLAY_CURSOR_MAP_SIZE;
+    overlay_cursor_map[free_slot].cursor = cursor;
+    overlay_cursor_map[free_slot].shape = shape;
+}
+
+static enum wp_cursor_shape_device_v1_shape find_overlay_cursor_shape(Cursor cursor)
+{
+    unsigned int i;
+
+    if (!cursor) return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_DEFAULT;
+    for (i = 0; i < OVERLAY_CURSOR_MAP_SIZE; ++i)
+        if (overlay_cursor_map[i].cursor == cursor) return overlay_cursor_map[i].shape;
+
+    return WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_DEFAULT;
+}
+
+void wayland_steam_overlay_set_cursor_shape(enum wp_cursor_shape_device_v1_shape shape)
+{
+    pthread_mutex_lock(&overlay_cursor_mutex);
+    overlay_cursor_shape = shape;
+    overlay_cursor_dirty = TRUE;
+    pthread_mutex_unlock(&overlay_cursor_mutex);
+}
+
+static unsigned int window_attribute_value_index(unsigned long mask, unsigned long attribute)
+{
+    unsigned int index = 0;
+    unsigned long bit;
+
+    for (bit = 1; bit < attribute; bit <<= 1)
+        if (mask & bit) ++index;
+
+    return index;
+}
+
+static int overlay_x11_after_request(Display *display)
+{
+    const struct overlay_x11_request *request =
+        (const struct overlay_x11_request *)((_XPrivDisplay)display)->private11;
+
+    pthread_mutex_lock(&overlay_cursor_mutex);
+    if (request)
+    {
+        switch (request->type)
+        {
+        case OVERLAY_X11_CREATE_GLYPH_CURSOR:
+        {
+            const struct overlay_x11_create_glyph_cursor_request *cursor =
+                (const struct overlay_x11_create_glyph_cursor_request *)request;
+            record_overlay_cursor(cursor->cursor,
+                                  cursor_shape_from_glyph(cursor->source_char));
+            break;
+        }
+        case OVERLAY_X11_CREATE_CURSOR:
+        {
+            const struct overlay_x11_create_cursor_request *cursor =
+                (const struct overlay_x11_create_cursor_request *)request;
+            record_overlay_cursor(cursor->cursor, WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_DEFAULT);
+            break;
+        }
+        case OVERLAY_X11_FREE_CURSOR:
+        {
+            const struct overlay_x11_resource_request *cursor =
+                (const struct overlay_x11_resource_request *)request;
+            unsigned int i;
+
+            for (i = 0; i < OVERLAY_CURSOR_MAP_SIZE; ++i)
+                if (overlay_cursor_map[i].cursor == cursor->id)
+                {
+                    overlay_cursor_map[i].cursor = 0;
+                    break;
+                }
+            break;
+        }
+        case OVERLAY_X11_CHANGE_WINDOW_ATTRIBUTES:
+        {
+            const struct overlay_x11_change_window_attributes_request *attributes =
+                (const struct overlay_x11_change_window_attributes_request *)request;
+
+            /* This display is private to the overlay bridge, so every cursor
+             * request on it belongs to gameoverlayrenderer. Steam may target
+             * the root or one of its own helper windows instead of the input
+             * proxy that delivered the event. */
+            if (attributes->value_mask & CWCursor)
+            {
+                const uint32_t *values = (const uint32_t *)(attributes + 1);
+                Cursor cursor = values[window_attribute_value_index(attributes->value_mask,
+                                                                     CWCursor)];
+
+                overlay_cursor_shape = find_overlay_cursor_shape(cursor);
+                overlay_cursor_dirty = TRUE;
+            }
+            break;
+        }
+        }
+    }
+    pthread_mutex_unlock(&overlay_cursor_mutex);
+
+    if (previous_after_function && previous_after_function != overlay_x11_after_request)
+        return previous_after_function(display);
+    return 0;
+}
+
+static void apply_overlay_cursor(BOOL force)
+{
+    enum wp_cursor_shape_device_v1_shape shape;
+    BOOL dirty;
+
+    pthread_mutex_lock(&overlay_cursor_mutex);
+    shape = overlay_cursor_shape;
+    dirty = overlay_cursor_dirty;
+    overlay_cursor_dirty = FALSE;
+    pthread_mutex_unlock(&overlay_cursor_mutex);
+
+    if (dirty || force)
+    {
+        TRACE("applying Steam overlay cursor shape %u\n", shape);
+        wayland_pointer_set_overlay_cursor_shape(shape);
+    }
+}
+
+static void create_overlay_event(void)
+{
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING str;
+    WCHAR buffer[128];
+    char path[128];
+    unsigned int i;
+    int len;
+
+    len = snprintf(path, sizeof(path),
+                   "\\Sessions\\%u\\BaseNamedObjects\\__wine_steamclient_GameOverlayActivated",
+                   (unsigned int)NtCurrentTeb()->Peb->SessionId);
+    if (len < 0 || len >= (int)ARRAY_SIZE(buffer)) return;
+
+    for (i = 0; i <= len; ++i) buffer[i] = (unsigned char)path[i];
+    str.Buffer = buffer;
+    str.Length = len * sizeof(WCHAR);
+    str.MaximumLength = (len + 1) * sizeof(WCHAR);
+    InitializeObjectAttributes(&attr, &str, OBJ_CASE_INSENSITIVE | OBJ_OPENIF, 0, NULL);
+
+    if (NtCreateEvent(&overlay_event, EVENT_ALL_ACCESS, &attr, NotificationEvent, FALSE))
+        overlay_event = NULL;
+}
+
+static BOOL update_overlay_active(void)
+{
+    LARGE_INTEGER timeout = {0};
+    BOOL active, event_active, changed;
+
+    pthread_mutex_lock(&overlay_mutex);
+    event_active = overlay_event &&
+                   NtWaitForSingleObject(overlay_event, FALSE, &timeout) == WAIT_OBJECT_0;
+    active = event_active || overlay_input_active;
+    changed = active != overlay_active;
+    overlay_active = active;
+    pthread_mutex_unlock(&overlay_mutex);
+
+    if (changed)
+    {
+        TRACE("Steam overlay is now %s\n", active ? "active" : "inactive");
+        if (active)
+            wayland_steam_overlay_set_cursor_shape(
+                WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_DEFAULT);
+        wayland_pointer_set_overlay_active(active);
+    }
+
+    return active;
+}
+
+static void update_overlay_pointer_ownership(BOOL consumed)
+{
+    BOOL changed;
+
+    pthread_mutex_lock(&overlay_mutex);
+    changed = consumed != overlay_input_active;
+    overlay_input_active = consumed;
+    pthread_mutex_unlock(&overlay_mutex);
+
+    if (changed)
+        TRACE("Steam overlay %s pointer ownership through X11 input\n",
+              consumed ? "acquired" : "released");
+}
+
+static BOOL init_overlay_bridge(void)
+{
+    XSetWindowAttributes attributes = {0};
+    const char *display_name, *env;
+    Dl_info info;
+
+    pthread_mutex_lock(&overlay_mutex);
+    if (overlay_initialized)
+    {
+        BOOL ready = overlay_initialized > 0;
+        pthread_mutex_unlock(&overlay_mutex);
+        return ready;
+    }
+
+    if ((env = getenv("WAYLANDDRV_STEAM_OVERLAY_X11")) && !atoi(env))
+        goto unavailable;
+
+    /* The renderer is loaded globally before winewayland.so.  Checking the
+     * resolved Xlib entry point avoids opening Xwayland when Steam's overlay
+     * is disabled or the process was not launched by Steam. */
+    if (!dladdr((void *)XCheckIfEvent, &info) || !info.dli_fname ||
+        !strstr(info.dli_fname, "gameoverlayrenderer"))
+        goto unavailable;
+
+    display_name = getenv("DISPLAY");
+    if (!display_name) display_name = getenv("GAMESCOPE_XWAYLAND_DISPLAY");
+    if (!display_name) goto unavailable;
+
+    XInitThreads();
+    if (!(overlay_display = XOpenDisplay(display_name))) goto unavailable;
+
+    overlay_root = DefaultRootWindow(overlay_display);
+    attributes.override_redirect = True;
+    attributes.event_mask = KeyPressMask | KeyReleaseMask | ButtonPressMask |
+                            ButtonReleaseMask | PointerMotionMask | FocusChangeMask;
+    overlay_window = XCreateWindow(overlay_display, overlay_root, -1, -1, 1, 1, 0, 0,
+                                   InputOnly, CopyFromParent,
+                                   CWOverrideRedirect | CWEventMask, &attributes);
+    if (!overlay_window)
+    {
+        XCloseDisplay(overlay_display);
+        overlay_display = NULL;
+        goto unavailable;
+    }
+
+    XSelectInput(overlay_display, overlay_window, attributes.event_mask);
+    previous_after_function = XSetAfterFunction(overlay_display, overlay_x11_after_request);
+    XMapWindow(overlay_display, overlay_window);
+    XFlush(overlay_display);
+    create_overlay_event();
+    overlay_initialized = 1;
+    pthread_mutex_unlock(&overlay_mutex);
+
+    TRACE("created Steam overlay X11 input proxy window %#lx\n", overlay_window);
+    return TRUE;
+
+unavailable:
+    overlay_initialized = -1;
+    pthread_mutex_unlock(&overlay_mutex);
+    return FALSE;
+}
+
+static BOOL dispatch_overlay_event(XEvent *event)
+{
+    struct overlay_event_match match;
+    XEvent returned;
+    BOOL active, consumed = FALSE;
+
+    if (!init_overlay_bridge()) return FALSE;
+
+    pthread_mutex_lock(&overlay_mutex);
+    event->xany.display = overlay_display;
+    event->xany.window = overlay_window;
+    event->xany.send_event = False;
+    event->xany.serial = ++overlay_serial;
+
+    match.window = overlay_window;
+    match.serial = overlay_serial;
+    match.type = event->type;
+
+    XLockDisplay(overlay_display);
+    _XPutBackEvent(overlay_display, event);
+    XUnlockDisplay(overlay_display);
+
+    consumed = !XCheckIfEvent(overlay_display, &returned, match_overlay_event,
+                              (XPointer)&match);
+    pthread_mutex_unlock(&overlay_mutex);
+
+    /* Some games do not pump the Steam callback that signals
+     * __wine_steamclient_GameOverlayActivated. gameoverlayrenderer consuming
+     * pointer motion remains an authoritative ownership signal: while the
+     * overlay is visible it removes these events from the private X11 queue,
+     * and leaves them untouched after returning input to the game. */
+    if (event->type == MotionNotify) update_overlay_pointer_ownership(consumed);
+
+    active = update_overlay_active();
+    /* Retry the selected shape for every overlay event. Activation can happen
+     * while the pointer has no valid enter serial (for example while a game
+     * has it locked), in which case the first request cannot be applied. */
+    if (active) apply_overlay_cursor(TRUE);
+    return consumed || active;
+}
+
+static void update_key_state(uint32_t key, BOOL pressed)
+{
+    unsigned int mask = 0;
+
+    switch (key)
+    {
+    case KEY_LEFTSHIFT:
+    case KEY_RIGHTSHIFT: mask = ShiftMask; break;
+    case KEY_LEFTCTRL:
+    case KEY_RIGHTCTRL: mask = OVERLAY_X11_CONTROL_MASK; break;
+    case KEY_LEFTALT:
+    case KEY_RIGHTALT: mask = Mod1Mask; break;
+    case KEY_LEFTMETA:
+    case KEY_RIGHTMETA: mask = Mod4Mask; break;
+    case KEY_CAPSLOCK:
+        if (pressed) overlay_state ^= LockMask;
+        return;
+    case KEY_NUMLOCK:
+        if (pressed) overlay_state ^= Mod2Mask;
+        return;
+    default: return;
+    }
+
+    if (pressed) overlay_state |= mask;
+    else overlay_state &= ~mask;
+}
+
+static unsigned int button_to_xbutton(uint32_t button)
+{
+    switch (button)
+    {
+    case BTN_LEFT: return Button1;
+    case BTN_MIDDLE: return Button2;
+    case BTN_RIGHT: return Button3;
+    case BTN_SIDE:
+    case BTN_BACK: return 8;
+    case BTN_EXTRA:
+    case BTN_FORWARD: return 9;
+    default: return 0;
+    }
+}
+
+static unsigned int button_to_mask(unsigned int button)
+{
+    switch (button)
+    {
+    case Button1: return Button1Mask;
+    case Button2: return Button2Mask;
+    case Button3: return Button3Mask;
+    case Button4: return Button4Mask;
+    case Button5: return Button5Mask;
+    default: return 0;
+    }
+}
+
+static BOOL dispatch_button(uint32_t time, unsigned int button, BOOL pressed)
+{
+    XEvent event = {0};
+    BOOL consumed;
+
+    event.type = pressed ? ButtonPress : ButtonRelease;
+    event.xbutton.root = overlay_root;
+    event.xbutton.subwindow = None;
+    event.xbutton.time = time;
+    event.xbutton.x = pointer_x;
+    event.xbutton.y = pointer_y;
+    event.xbutton.x_root = pointer_x;
+    event.xbutton.y_root = pointer_y;
+    event.xbutton.state = overlay_state;
+    event.xbutton.button = button;
+    event.xbutton.same_screen = True;
+
+    consumed = dispatch_overlay_event(&event);
+    if (pressed) overlay_state |= button_to_mask(button);
+    else overlay_state &= ~button_to_mask(button);
+    return consumed;
+}
+
+static BOOL dispatch_wheel(uint32_t time, int value, BOOL horizontal)
+{
+    unsigned int button;
+    int count, i;
+    BOOL consumed = FALSE;
+
+    if (!value) return update_overlay_active();
+
+    button = horizontal ? (value > 0 ? 7 : 6) : (value > 0 ? Button4 : Button5);
+    count = min(abs(value) / WHEEL_DELTA, 32);
+    for (i = 0; i < count && !consumed; ++i)
+    {
+        consumed = dispatch_button(time, button, TRUE);
+        if (!consumed) consumed = dispatch_button(time, button, FALSE);
+    }
+
+    return consumed || update_overlay_active();
+}
+
+void wayland_steam_overlay_focus(BOOL focused)
+{
+    XEvent event = {0};
+
+    if (!init_overlay_bridge()) return;
+
+    event.type = focused ? FocusIn : FocusOut;
+    event.xfocus.mode = NotifyNormal;
+    event.xfocus.detail = NotifyNonlinear;
+    dispatch_overlay_event(&event);
+}
+
+BOOL wayland_steam_overlay_filter_key(uint32_t time, uint32_t key, uint32_t state)
+{
+    XEvent event = {0};
+    BOOL consumed, pressed = state == WL_KEYBOARD_KEY_STATE_PRESSED;
+
+    if (!init_overlay_bridge()) return FALSE;
+    if (key > 247) return update_overlay_active();
+
+    event.type = pressed ? KeyPress : KeyRelease;
+    event.xkey.root = overlay_root;
+    event.xkey.subwindow = None;
+    event.xkey.time = time;
+    event.xkey.x = pointer_x;
+    event.xkey.y = pointer_y;
+    event.xkey.x_root = pointer_x;
+    event.xkey.y_root = pointer_y;
+    event.xkey.state = overlay_state;
+    event.xkey.keycode = key + 8;
+    event.xkey.same_screen = True;
+
+    consumed = dispatch_overlay_event(&event);
+    update_key_state(key, pressed);
+    return consumed;
+}
+
+BOOL wayland_steam_overlay_filter_pointer_button(uint32_t time, uint32_t button,
+                                                 uint32_t state)
+{
+    unsigned int xbutton;
+
+    if (!init_overlay_bridge()) return FALSE;
+    if (!(xbutton = button_to_xbutton(button))) return update_overlay_active();
+
+    return dispatch_button(time, xbutton, state == WL_POINTER_BUTTON_STATE_PRESSED);
+}
+
+BOOL wayland_steam_overlay_filter_pointer_frame(const struct wayland_pointer_frame *frame)
+{
+    XEvent event = {0};
+    BOOL consumed = FALSE;
+    int scroll = 0, horz_scroll = 0;
+
+    if (!init_overlay_bridge()) return FALSE;
+
+    if (frame->flags & WAYLAND_POINTER_FRAME_ABSOLUTE)
+    {
+        pointer_x = frame->x;
+        pointer_y = frame->y;
+    }
+    else if (frame->flags & WAYLAND_POINTER_FRAME_RELATIVE)
+    {
+        pointer_x += round(frame->dx);
+        pointer_y += round(frame->dy);
+        pointer_x = max(0, min(pointer_x,
+                               DisplayWidth(overlay_display, DefaultScreen(overlay_display)) - 1));
+        pointer_y = max(0, min(pointer_y,
+                               DisplayHeight(overlay_display, DefaultScreen(overlay_display)) - 1));
+    }
+
+    if (frame->flags & (WAYLAND_POINTER_FRAME_ABSOLUTE | WAYLAND_POINTER_FRAME_RELATIVE))
+    {
+        event.type = MotionNotify;
+        event.xmotion.root = overlay_root;
+        event.xmotion.subwindow = None;
+        event.xmotion.time = frame->time;
+        event.xmotion.x = pointer_x;
+        event.xmotion.y = pointer_y;
+        event.xmotion.x_root = pointer_x;
+        event.xmotion.y_root = pointer_y;
+        event.xmotion.state = overlay_state;
+        event.xmotion.is_hint = NotifyNormal;
+        event.xmotion.same_screen = True;
+        consumed = dispatch_overlay_event(&event);
+    }
+
+    if (frame->flags & WAYLAND_POINTER_FRAME_DISCRETE_WHEEL)
+        scroll = frame->scroll;
+    else if (frame->flags & WAYLAND_POINTER_FRAME_AXIS)
+        scroll = trunc(frame->axis / WHEEL_DELTA) * WHEEL_DELTA;
+
+    if (frame->flags & WAYLAND_POINTER_FRAME_DISCRETE_WHEEL_HORZ)
+        horz_scroll = frame->horz_scroll;
+    else if (frame->flags & WAYLAND_POINTER_FRAME_AXIS_HORZ)
+        horz_scroll = trunc(frame->horz_axis / WHEEL_DELTA) * WHEEL_DELTA;
+
+    if (!consumed) consumed = dispatch_wheel(frame->time, scroll, FALSE);
+    if (!consumed) consumed = dispatch_wheel(frame->time, horz_scroll, TRUE);
+    return consumed || update_overlay_active();
+}
+
+BOOL wayland_steam_overlay_is_active(void)
+{
+    BOOL ready;
+
+    pthread_mutex_lock(&overlay_mutex);
+    ready = overlay_initialized > 0;
+    pthread_mutex_unlock(&overlay_mutex);
+    if (!ready) return FALSE;
+    return update_overlay_active();
+}
