From 9f772683eced85e091afe0f0bb220afbd19dc640 Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Thu, 3 Sep 2026 18:35:00 -0600
Subject: [PATCH] server: Terminate system threads with the last user thread

System threads are intentionally excluded from ThreadAmILastThread and process
enumeration, but they still count toward running_threads.  A process whose last
user thread exits without calling RtlExitUserProcess can therefore remain alive
indefinitely when it owns a long-lived system thread, such as Wine-Wayland's
event dispatcher.

Before removing the last user thread, terminate every other thread in the
process.  At that point all remaining threads are system threads, so normal
last-thread process teardown runs after they have exited.
---
 server/process.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/server/process.c b/server/process.c
index 20718ec0ae6..bc269fe54a8 100644
--- a/server/process.c
+++ b/server/process.c
@@ -1057,6 +1057,13 @@ void remove_process_thread( struct process *process, struct thread *thread )
     assert( process->running_threads > 0 );
     assert( !list_empty( &process->thread_list ));
 
+    /* System threads must not keep a process alive after its final user thread
+     * exits. At this point every other running thread is a system thread. */
+    if (!thread->is_system && process->user_threads == 1)
+    {
+        terminate_process( process, thread, thread->exit_code );
+    }
+
     list_remove( &thread->proc_entry );
     if (!thread->is_system) process->user_threads--;
 
