 dlls/winewayland.drv/waylanddrv.h      |   4 +
 dlls/winewayland.drv/window.c          |  50 +++---
 include/wine/gdi_driver.h              |   2 +
 include/wine/opengl_driver.h           |   1 +
 9 files changed, 208 insertions(+), 78 deletions(-)

diff --git a/dlls/win32u/opengl.c b/dlls/win32u/opengl.c
index a75f923b4b2..7bb204847ff 100644
--- a/dlls/win32u/opengl.c
+++ b/dlls/win32u/opengl.c
@@ -156,7 +156,11 @@ void opengl_drawable_release( struct opengl_drawable *drawable )
         if (drawable->surface) funcs->p_eglDestroySurface( egl->display, drawable->surface );
         if (drawable->client)
         {
+            if (drawable->client_active)
+                InterlockedDecrement( &drawable->client->native_ref );
             InterlockedDecrement( &drawable->client->busy_ref );
+            if (drawable->client_active)
+                client_surface_update( drawable->client );
             client_surface_release( drawable->client );
         }
         free( drawable );
@@ -2101,7 +2105,12 @@ static struct opengl_drawable *get_window_unused_drawable( HWND hwnd, int format
     if (!drawable)
     {
         driver_funcs->p_surface_create( hwnd, raw, format, &drawable );
-        if (drawable && drawable->client) add_window_client_surface( hwnd, drawable->client );
+        if (drawable && drawable->client)
+        {
+            InterlockedIncrement( &drawable->client->native_ref );
+            drawable->client_active = TRUE;
+            add_window_client_surface( hwnd, drawable->client );
+        }
     }
 
     if (drawable && drawable->funcs != &framebuffer_surface_funcs && raw)
