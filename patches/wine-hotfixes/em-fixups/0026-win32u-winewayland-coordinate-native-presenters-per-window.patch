diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
index 08ef39f8749..ceecdc8e63c 100644
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -964,17 +964,9 @@ static void xdg_surface_handle_configure(void *private, struct xdg_surface *xdg_
 
         if (was_suspended != wayland_surface_repaint_suspended(surface))
         {
-            struct wayland_client_surface *client = data->client_surface;
-
-            /* Keep an opaque client surface associated with the compositor's
-             * workspace visibility. The logical stacking choice is preserved
-             * so it can be restored when repainting resumes. */
-            if (client && client->wl_subsurface && client->toplevel == surface->hwnd &&
-                client->toplevel_wl_surface == surface->wl_surface)
-            {
-                wayland_client_surface_stack(surface, client, client->stack_above_parent);
-                wl_surface_commit(surface->wl_surface);
-            }
+            /* Re-evaluate every native presenter when workspace visibility
+             * changes, then restore the selected presenter last. */
+            wayland_client_surfaces_attach(data, surface->hwnd);
             should_expose = TRUE;
         }
     }
@@ -2485,6 +2477,7 @@ static BOOL wayland_client_surface_should_stack_above_parent(
         struct wayland_surface *surface, struct wayland_client_surface *client,
         HWND hwnd, HWND toplevel, BOOL content_over_producer)
 {
+    if (!ReadAcquire(&client->client.presentation_owner)) return FALSE;
     /* A single opaque client surface covering the whole toplevel can sit above
      * an opaque parent carrier without using transparent punch-through. */
     if (hwnd != toplevel) return FALSE;
@@ -4530,13 +4523,139 @@ struct wayland_client_surface *impl_from_client_surface(struct client_surface *c
     return CONTAINING_RECORD(client, struct wayland_client_surface, client);
 }
 
+static BOOL is_client_visible(HWND hwnd);
+
+static void wayland_client_surface_register(struct wayland_win_data *data,
+                                            struct wayland_client_surface *surface)
+{
+    if (list_empty(&surface->hwnd_entry))
+    {
+        if (data->client_surface)
+            InterlockedExchange(&surface->client.presentation_owner, FALSE);
+        list_add_tail(&data->client_surfaces, &surface->hwnd_entry);
+    }
+}
+
+static void wayland_client_surface_unregister(struct wayland_client_surface *surface)
+{
+    if (list_empty(&surface->hwnd_entry)) return;
+    list_remove(&surface->hwnd_entry);
+    list_init(&surface->hwnd_entry);
+}
+
+static void wayland_client_surface_register_latest(
+        struct wayland_win_data *data, struct wayland_client_surface *surface)
+{
+    wayland_client_surface_unregister(surface);
+    if (data->client_surface != surface)
+        InterlockedExchange(&surface->client.presentation_owner, FALSE);
+    list_add_tail(&data->client_surfaces, &surface->hwnd_entry);
+}
+
+static struct wayland_client_surface *wayland_client_surface_find_latest(
+        struct wayland_win_data *data, BOOL native, BOOL presented)
+{
+    struct wayland_client_surface *surface;
+
+    LIST_FOR_EACH_ENTRY_REV(surface, &data->client_surfaces,
+                            struct wayland_client_surface, hwnd_entry)
+    {
+        if (native && !ReadAcquire(&surface->client.native_ref)) continue;
+        if (presented && !ReadAcquire(&surface->has_presented)) continue;
+        return surface;
+    }
+    return NULL;
+}
+
+static struct wayland_client_surface *wayland_client_surface_select_owner(
+        struct wayland_win_data *data)
+{
+    struct wayland_client_surface *owner;
+
+    if ((owner = wayland_client_surface_find_latest(data, TRUE, TRUE)))
+        return owner;
+    if (data->client_surface &&
+        ReadAcquire(&data->client_surface->client.native_ref))
+        return data->client_surface;
+    if ((owner = wayland_client_surface_find_latest(data, TRUE, FALSE)))
+        return owner;
+    if (data->client_surface && !list_empty(&data->client_surface->hwnd_entry))
+        return data->client_surface;
+    return wayland_client_surface_find_latest(data, FALSE, FALSE);
+}
+
+void wayland_client_surfaces_attach(struct wayland_win_data *data, HWND toplevel)
+{
+    struct wayland_client_surface *surface;
+    struct wayland_client_surface *owner = data->client_surface;
+    BOOL visible = toplevel && is_client_visible(data->hwnd);
+
+    /* Background native presenters must stay compositor-serviced, but attach
+     * the owner last so it controls carrier selection and final stacking. */
+    LIST_FOR_EACH_ENTRY(surface, &data->client_surfaces,
+                        struct wayland_client_surface, hwnd_entry)
+    {
+        BOOL pending, mapped;
+
+        if (surface == owner) continue;
+
+        pending = ReadAcquire(&surface->client.busy_ref) &&
+                  !ReadAcquire(&surface->has_presented);
+        mapped = ReadAcquire(&surface->client.native_ref) || pending;
+
+        if (mapped && visible)
+            wayland_client_surface_attach(surface, toplevel);
+        else
+            wayland_client_surface_attach(surface, NULL);
+    }
+
+    if (owner)
+    {
+        if (visible) wayland_client_surface_attach(owner, toplevel);
+        else wayland_client_surface_attach(owner, NULL);
+    }
+}
+
+static void wayland_client_surface_update_owner(struct wayland_win_data *data)
+{
+    struct wayland_client_surface *previous = data->client_surface;
+    struct wayland_client_surface *owner =
+        wayland_client_surface_select_owner(data);
+
+    if (previous != owner)
+    {
+        if (previous)
+            InterlockedExchange(&previous->client.presentation_owner, FALSE);
+        data->client_surface = owner;
+        if (owner)
+            InterlockedExchange(&owner->client.presentation_owner, TRUE);
+        TRACE("hwnd=%p presentation owner %s -> %s\n", data->hwnd,
+              previous ? debugstr_client_surface(&previous->client) : "(none)",
+              owner ? debugstr_client_surface(&owner->client) : "(none)");
+    }
+    wayland_client_surfaces_attach(data, NtUserGetAncestor(data->hwnd, GA_ROOT));
+}
+
 static void wayland_client_surface_destroy(struct client_surface *client)
 {
     struct wayland_client_surface *surface = impl_from_client_surface(client);
+    struct wayland_win_data *data;
     struct wl_callback *callback;
 
     TRACE("%s\n", debugstr_client_surface(client));
 
+    if ((data = wayland_win_data_get(client->hwnd)))
+    {
+        wayland_client_surface_attach(surface, NULL);
+        wayland_client_surface_unregister(surface);
+        if (data->client_surface == surface) data->client_surface = NULL;
+        wayland_client_surface_update_owner(data);
+        wayland_win_data_release(data);
+    }
+    else
+        wayland_client_surface_unregister(surface);
+    InterlockedExchange(&client->presentation_owner, FALSE);
+
     if ((callback = InterlockedExchangePointer((void **)&surface->wl_callback, NULL)))
         wl_callback_destroy(callback);
     if (surface->throttle)
@@ -4562,10 +4681,13 @@ static void wayland_client_surface_detach(struct client_surface *client)
 
     if ((data = wayland_win_data_get(client->hwnd)))
     {
-        if (data->client_surface == surface) data->client_surface = NULL;
         wayland_client_surface_attach(surface, NULL);
+        wayland_client_surface_unregister(surface);
+        if (data->client_surface == surface) data->client_surface = NULL;
+        wayland_client_surface_update_owner(data);
         wayland_win_data_release(data);
     }
+    InterlockedExchange(&client->presentation_owner, FALSE);
 }
 
 static BOOL is_client_visible(HWND hwnd)
@@ -4583,28 +4705,17 @@ static void wayland_client_surface_update(struct client_surface *client)
 {
     struct wayland_client_surface *surface = impl_from_client_surface(client);
     struct wayland_win_data *data;
-    HWND toplevel;
 
     TRACE("%s\n", debugstr_client_surface(client));
 
-    set_client_surface(client->hwnd, surface);
+    if (!(data = wayland_win_data_get(client->hwnd))) return;
 
-    /* Keep the selected client attached without letting list order choose the
-     * renderer. Also attach an active replacement before its first present so
-     * host WSI can make progress while the old client preserves the last frame. */
-    if ((data = wayland_win_data_get(client->hwnd)))
-    {
-        if (data->client_surface != surface && ReadAcquire(&client->busy_ref) &&
-            !ReadAcquire(&surface->has_presented))
-        {
-            toplevel = NtUserGetAncestor(client->hwnd, GA_ROOT);
-            if (toplevel && is_client_visible(client->hwnd))
-                wayland_client_surface_attach(surface, toplevel);
-            else
-                wayland_client_surface_attach(surface, NULL);
-        }
-        wayland_win_data_release(data);
-    }
+    /* Preserve VkSurface creation order while updating activity. Reordering
+     * on every present makes concurrent old and replacement presenters trade
+     * ownership every frame. */
+    wayland_client_surface_register(data, surface);
+    wayland_client_surface_update_owner(data);
+    wayland_win_data_release(data);
 }
 
 static BOOL wayland_surface_has_live_role(struct wayland_surface *surface);
@@ -4698,45 +4809,22 @@ static void wayland_client_surface_present(struct client_surface *client, HDC hd
     }
 
     surface->has_presented = TRUE;
-    set_client_surface(hwnd, surface);
+    wayland_client_surface_update(client);
     ensure_window_surface_contents(toplevel);
 }
 
 void set_client_surface(HWND hwnd, struct wayland_client_surface *new_client)
 {
-    HWND toplevel = NtUserGetAncestor(hwnd, GA_ROOT);
-    struct wayland_client_surface *old_client;
     struct wayland_win_data *data;
-    BOOL visible;
 
     /* ownership is shared with the callers, the last caller to release
      * its reference will also destroy it and clear our pointer. */
 
     if (!(data = wayland_win_data_get(hwnd))) return;
 
-    visible = is_client_visible(hwnd);
-
-    if (new_client && new_client != data->client_surface && data->client_surface &&
-        data->client_surface->has_presented && !new_client->has_presented)
-        goto done;
-
-    if (new_client != data->client_surface)
-    {
-        if ((old_client = data->client_surface))
-            wayland_client_surface_attach(old_client, NULL);
-
-        data->client_surface = new_client;
-    }
-
-    if (data->client_surface)
-    {
-        if (toplevel && visible)
-            wayland_client_surface_attach(data->client_surface, toplevel);
-        else
-            wayland_client_surface_attach(data->client_surface, NULL);
-    }
-
-done:
+    if (new_client) wayland_client_surface_register_latest(data, new_client);
+    if (!data->client_surface) data->client_surface = new_client;
+    wayland_client_surface_update_owner(data);
     wayland_win_data_release(data);
 }
 
@@ -4754,6 +4842,7 @@ struct wayland_client_surface *wayland_client_surface_create(HWND hwnd)
     struct wl_region *empty_region;
 
     if (!(client = client_surface_create(sizeof(*client), &wayland_client_surface_funcs, hwnd))) return NULL;
+    list_init(&client->hwnd_entry);
 
     client->wl_surface =
         wl_compositor_create_surface(process_wayland.wl_compositor);
diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
index f7613534b06..96398b3a1a7 100644
--- a/dlls/winewayland.drv/waylanddrv.h
