+++ b/dlls/win32u/vulkan.c
@@ -4168,6 +4168,7 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
     else driver_funcs->p_vulkan_map_colorspace( create_info->imageColorSpace, surface->client );
 
