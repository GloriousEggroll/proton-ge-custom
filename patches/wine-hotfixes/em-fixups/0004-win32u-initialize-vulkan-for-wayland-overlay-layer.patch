From: GE-Proton <noreply@localhost>
Subject: [PATCH] win32u: bootstrap the selected overlay layer for launchers

Proton selects the Wine-Wayland Steam overlay layer and adds its private
manifest directory. Wine's D3DKMT Vulkan instance is otherwise created lazily,
so create it after a real display driver has loaded when Proton enabled the
layer. This reaches the layer's vkCreateInstance hook before a non-Vulkan game
launcher creates its first window and preserves controller focus handling.

Do not create the instance from win32u's Unix-library initialization. That is
too early to start the layer's worker thread and can recursively crash and
respawn Wine desktop helpers. Waiting for display-driver initialization keeps
the hook process-local and skips service/null-driver processes.

Do not bootstrap D3DKMT while the process is already initializing Vulkan.
Vulkan initialization loads the display driver to map its WSI extensions, so
recursively creating the D3DKMT instance there waits on the same pthread_once
and deadlocks. The application's Vulkan instance will load the implicit layer
itself; only non-Vulkan processes need the bootstrap instance.

--- a/dlls/win32u/d3dkmt.c
+++ b/dlls/win32u/d3dkmt.c
@@ -500,7 +500,7 @@ static void d3dkmt_init_vulkan(void)
     if (!d3dkmt_vulkan_instance) WARN( "Failed to create the vulkan instance\n" );
 }
 
-static struct vulkan_instance *get_d3dkmt_vulkan_instance(void)
+struct vulkan_instance *get_d3dkmt_vulkan_instance(void)
 {
     static pthread_once_t once = PTHREAD_ONCE_INIT;
     pthread_once( &once, d3dkmt_init_vulkan );
--- a/dlls/win32u/ntuser_private.h
+++ b/dlls/win32u/ntuser_private.h
@@ -245,6 +245,8 @@ extern void release_opengl_drawables( struct list *drawables );
 
 /* vulkan.c */
 extern struct vulkan_instance *vulkan_instance_create( const struct vulkan_instance_extensions *extensions );
+extern struct vulkan_instance *get_d3dkmt_vulkan_instance( void );
+extern BOOL vulkan_init_in_progress( void );
 
 /* window.c */
 HANDLE alloc_user_handle( void *ptr, unsigned short type );
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -6336,6 +6336,13 @@ static void vulkan_init_once(void)
     free( properties );
 }
 
+static LONG vulkan_init_active;
+
+BOOL vulkan_init_in_progress(void)
+{
+    return ReadAcquire( &vulkan_init_active ) != 0;
+}
+
 /***********************************************************************
  *      __wine_get_vulkan_driver  (win32u.so)
  */
@@ -6349,7 +6356,9 @@ const struct vulkan_funcs *__wine_get_vulkan_driver( UINT version )
         return NULL;
     }
 
+    InterlockedIncrement( &vulkan_init_active );
     pthread_once( &init_once, vulkan_init_once );
+    InterlockedDecrement( &vulkan_init_active );
     if (!vulkan_handle) return NULL;
     return &vulkan_funcs;
 }
--- a/dlls/win32u/driver.c
+++ b/dlls/win32u/driver.c
@@ -23,6 +23,7 @@
 
 #include <assert.h>
 #include <pthread.h>
+#include <stdlib.h>
 
 #include "ntstatus.h"
 #define WIN32_NO_STATUS
@@ -1037,7 +1038,15 @@ static const struct user_driver_funcs *load_driver(void)
 
 void init_display_driver(void)
 {
+    const char *env;
+
     if (user_driver == &lazy_load_driver) load_display_driver();
+    if (user_driver == &null_user_driver) return;
+
+    env = getenv( "WINE_WAYLAND_STEAM_OVERLAY_LAYER" );
+    if (env && atoi( env ) && !vulkan_init_in_progress() &&
+        (!(env = getenv( "DISABLE_WINE_WAYLAND_STEAM_OVERLAY_LAYER" )) || !atoi( env )))
+        (void)get_d3dkmt_vulkan_instance();
 }
 
 /**********************************************************************
