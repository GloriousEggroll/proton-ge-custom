From b9638444e73d451402805c1713f50bd4427559f4 Mon Sep 17 00:00:00 2001
From: Erhan Bilgili <erhan.bilgili@gmail.com>
Date: Mon, 10 Aug 2026 15:28:07 +0200
Subject: [PATCH] winewayland.drv: Clear carrier state when replacing contents.

A GDI carrier may install an opaque region on its wl_surface, and that
state survives replacing the attached buffer. Clear all carrier-owned
state before SHM, dma-buf, or Vulkan content takes over so stale opacity
cannot affect the replacement.

(cherry picked from commit b9638444e73d451402805c1713f50bd4427559f4)

GE-Proton partial import: the direct-toplevel promotion and reactivation
hunks operate on struct wayland_client_surface direct_client handoff
state that this base does not have. Only the carrier bookkeeping and the
wayland_surface_attach_shm_buffer split are imported.

Source: https://github.com/nanomatters/wine-salkim/commit/b9638444e73d451402805c1713f50bd4427559f4
---
 dlls/winewayland.drv/wayland_surface.c | 36 +++++++++++++++++++-------
 dlls/winewayland.drv/window.c          |  1 -
 2 files changed, 26 insertions(+), 11 deletions(-)

diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
index 1b413c90e2f..b8505448aff 100644
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -1999,6 +1999,18 @@ err:
     ERR("Failed to assign layer role to wayland surface\n");
 }
 
+static void wayland_surface_clear_carrier(struct wayland_surface *surface)
+{
+    /* wl_surface state survives buffer replacement. */
+    if (surface->carrier_attached && surface->carrier_opaque)
+        wl_surface_set_opaque_region(surface->wl_surface, NULL);
+
+    surface->carrier_attached = FALSE;
+    surface->carrier_opaque = FALSE;
+    surface->carrier_single_pixel = FALSE;
+    surface->carrier_width = surface->carrier_height = 0;
+}
+
 /**********************************************************************
  *          wayland_surface_clear_role
  *
@@ -2012,10 +2024,7 @@ void wayland_surface_clear_role(struct wayland_surface *surface)
 
     /* Keep input state across role churn; it follows wl_surface enter/leave. */
     wayland_surface_clear_child_surfaces(surface);
-    surface->carrier_attached = FALSE;
-    surface->carrier_opaque = FALSE;
-    surface->carrier_single_pixel = FALSE;
-    surface->carrier_width = surface->carrier_height = 0;
+    wayland_surface_clear_carrier(surface);
 
     /* some objects are shared between several roles */
 
@@ -2132,16 +2141,16 @@ void wayland_surface_clear_role(struct wayland_surface *surface)
 }
 
 /**********************************************************************
- *          wayland_surface_attach_shm
+ *          wayland_surface_attach_shm_buffer
  *
  * Attaches a SHM buffer to a wayland surface.
  *
  * The buffer is marked as unavailable until committed and subsequently
  * released by the compositor.
  */
-void wayland_surface_attach_shm(struct wayland_surface *surface,
-                                struct wayland_shm_buffer *shm_buffer,
-                                HRGN surface_damage_region)
+static void wayland_surface_attach_shm_buffer(struct wayland_surface *surface,
+                                              struct wayland_shm_buffer *shm_buffer,
+                                              HRGN surface_damage_region)
 {
     RGNDATA *surface_damage;
     int win_width, win_height;
@@ -2191,6 +2200,14 @@ void wayland_surface_attach_shm(struct wayland_surface *surface,
     surface->content_height = win_height;
 }
 
+void wayland_surface_attach_shm(struct wayland_surface *surface,
+                                struct wayland_shm_buffer *shm_buffer,
+                                HRGN surface_damage_region)
+{
+    wayland_surface_clear_carrier(surface);
+    wayland_surface_attach_shm_buffer(surface, shm_buffer, surface_damage_region);
+}
+
 /**********************************************************************
  *          wayland_surface_config_is_compatible
  *
@@ -3443,7 +3460,6 @@ static BOOL wayland_surface_replace_direct_dmabuf_with_shm(struct wayland_surfac
     wl_surface_set_opaque_region(surface->wl_surface, NULL);
     wayland_surface_attach_shm(surface, data->window_contents,
                                data->window_contents->damage_region);
-    surface->carrier_attached = FALSE;
     wl_surface_commit(surface->wl_surface);
     wayland_hwnd_dmabuf_surface_destroy(direct);
     return TRUE;
@@ -3503,7 +3519,7 @@ static BOOL wayland_surface_attach_carrier(struct wayland_surface *surface, BOOL
         wl_region_destroy(region);
     }
     else wl_surface_set_opaque_region(surface->wl_surface, NULL);
-    wayland_surface_attach_shm(surface, shm_buffer, shm_buffer->damage_region);
+    wayland_surface_attach_shm_buffer(surface, shm_buffer, shm_buffer->damage_region);
     wl_surface_commit(surface->wl_surface);
     wayland_shm_buffer_unref(shm_buffer);
     surface->carrier_attached = TRUE;
diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index d13243f3b18..ff2490078ad 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -1722,7 +1722,6 @@ BOOL set_window_surface_contents(HWND hwnd, struct wayland_shm_buffer *shm_buffe
                 wayland_surface_prepare_direct_dmabuf_shm_commit(wayland_surface);
                 wl_surface_set_opaque_region(wayland_surface->wl_surface, NULL);
                 wayland_surface_attach_shm(wayland_surface, shm_buffer, damage_region);
-                wayland_surface->carrier_attached = FALSE;
                 wl_surface_commit(wayland_surface->wl_surface);
                 wayland_surface_finish_direct_dmabuf_shm_commit(wayland_surface);
                 wayland_surface->ensured_contents = WAYLAND_SURFACE_ENSURED_FLUSH;
-- 
