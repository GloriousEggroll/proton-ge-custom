From d979e4299b14362650f9226b034bb43ad0500cee Mon Sep 17 00:00:00 2001
From: M0n7y5 <17201053+M0n7y5@users.noreply.github.com>
Date: Fri, 12 Jun 2026 18:37:56 +0200
Subject: [PATCH] server: Don't send debug events for system threads.

(cherry picked from commit ca175f340c3005c0817e9ca47dbae05dec05422d)
---
 server/mapping.c | 4 ++--
 server/process.c | 2 +-
 server/thread.c  | 2 +-
 3 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/server/mapping.c b/server/mapping.c
index 2085290cf39..a3f54ac55a4 100644
--- a/server/mapping.c
+++ b/server/mapping.c
@@ -1347,8 +1347,8 @@ void generate_startup_debug_events( struct process *process )
     /* generate creation events */
     LIST_FOR_EACH_ENTRY( thread, &process->thread_list, struct thread, proc_entry )
     {
-        if (thread != first_thread)
-            generate_debug_event( thread, DbgCreateThreadStateChange, NULL );
+        if (thread->is_system) continue;
+        if (thread != first_thread) generate_debug_event( thread, DbgCreateThreadStateChange, NULL );
     }
 
     /* generate dll events (in loading order) */
diff --git a/server/process.c b/server/process.c
index 5bd62c651b1..20718ec0ae6 100644
--- a/server/process.c
+++ b/server/process.c
@@ -1069,7 +1069,7 @@ void remove_process_thread( struct process *process, struct thread *thread )
         list_remove( &process->entry );
         process_killed( process );
     }
-    else generate_debug_event( thread, DbgExitThreadStateChange, thread );
+    else if (!thread->is_system) generate_debug_event( thread, DbgExitThreadStateChange, thread );
     release_object( thread );
 }
 
diff --git a/server/thread.c b/server/thread.c
index 5c873b2af81..ee4f787599a 100644
--- a/server/thread.c
+++ b/server/thread.c
@@ -1862,7 +1862,7 @@ DECL_HANDLER(init_thread)
     current->entry_point = req->entry;
 
     init_thread_context( current );
-    generate_debug_event( current, DbgCreateThreadStateChange, &req->entry );
+    if (!current->is_system) generate_debug_event( current, DbgCreateThreadStateChange, &req->entry );
     set_thread_base_priority( current, current->base_priority );
     set_thread_affinity( current, current->affinity );
 
-- 
2.55.0

