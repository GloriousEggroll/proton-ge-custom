From: GloriousEggroll <gloriouseggroll@gmail.com>
Subject: [PATCH] kernelbase: Recognize EOS EAC launchers by filename

The EOS bootstrapper workaround imported from wine-wayland identifies the
launcher through its ProductName version resource. Some publishers copy the
game's version information over both bootstrapper executables, so the child
which maps the native anti-cheat module no longer has the expected
"Easy Anti-Cheat Bootstrapper (EOS)" product name.

Also recognize the canonical start_protected_game.exe basename. This keeps
the existing resource-based path while ensuring PROTON_SYSCALL_HACK and
PROTON_EOS_EAC reach launchers whose resources were replaced.

---
 dlls/kernelbase/process.c | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/dlls/kernelbase/process.c b/dlls/kernelbase/process.c
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -676,6 +676,23 @@ static void sync_env_var_to_unix( WCHAR *env, const char *name )
     } else __wine_set_unix_env( name, NULL );
 }
 
+static BOOL is_eos_eac_launcher( const WCHAR *path, const char *product_name )
+{
+    const WCHAR *name, *slash;
+
+    if (product_name && !strcmp( product_name, "Easy Anti-Cheat Bootstrapper (EOS)" ))
+        return TRUE;
+    if (!path) return FALSE;
+
+    name = wcsrchr( path, '\\' );
+    slash = wcsrchr( path, '/' );
+    if (!name || (slash && slash > name)) name = slash;
+    if (name) ++name;
+    else name = path;
+
+    return !wcsicmp( name, L"start_protected_game.exe" );
+}
+
 /**********************************************************************
  *           CreateProcessInternalW   (kernelbase.@)
  */
@@ -795,7 +813,7 @@ BOOL WINAPI DECLSPEC_HOTPATCH CreateProcessInternalW( HANDLE token, const WCHAR
 
         RtlDestroyProcessParameters( params );
 
-        if (product_name && !strcmp( product_name, "Easy Anti-Cheat Bootstrapper (EOS)" ))
+        if (is_eos_eac_launcher( app_name, product_name ))
         {
             /* EOS EAC bootstrapper will start the game process directly without using WINAPI, so env vars set on the
              * PE side will be lost. Preserve some critical ones. */
@@ -956,7 +974,7 @@ BOOL WINAPI DECLSPEC_HOTPATCH CreateProcessInternalW( HANDLE token, const WCHAR
  done:
 
     /* clean up the syscall hack env now that we are done using it */
-    if (product_name && !strcmp( product_name, "Easy Anti-Cheat Bootstrapper (EOS)" ))
+    if (is_eos_eac_launcher( app_name, product_name ))
         __wine_set_unix_env("PROTON_SYSCALL_HACK", NULL);
 
     RtlDestroyProcessParameters( params );
-- 
2.55.0
