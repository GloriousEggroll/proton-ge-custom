From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Sun, 30 Aug 2026 16:30:00 -0600
Subject: [PATCH] winewayland: Preserve fullscreen clients across transient hide

Some fullscreen games issue an explicit SWP_HIDEWINDOW while transferring
focus during alt-tab, then show the same window again immediately. Clearing
the xdg_toplevel role in between tears down its managed client surfaces and
can leave the restored window with no producer attached.

Keep an established, client-rendered fullscreen toplevel mapped across this
specific hide transition when the window is not actually minimized. Real
minimization still unmaps the surface, as do explicit hides for ordinary
windows, launchers, and popups.
---
 dlls/winewayland.drv/window.c | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -263,15 +263,24 @@ static BOOL rect_intersects_virtual_screen(const RECT *rect)
     return intersect_rect(&intersect, rect, &virtual_rect);
 }
 
-static BOOL should_keep_toplevel_mapped(struct wayland_surface *surface,
+static BOOL should_keep_toplevel_mapped(struct wayland_win_data *data,
                                         DWORD style, UINT swp_flags)
 {
+    struct wayland_surface *surface = data->wayland_surface;
+
     if (!surface || surface->role != WAYLAND_SURFACE_ROLE_TOPLEVEL) return FALSE;
-    if (swp_flags & SWP_HIDEWINDOW) return FALSE;
+
+    /* A fullscreen renderer may hide and show the same HWND synchronously
+     * while focus changes. Preserve its established presentation tree, but
+     * continue to unmap minimized windows and non-rendering launchers. */
+    if (swp_flags & SWP_HIDEWINDOW)
+        return data->is_fullscreen && !(style & WS_MINIMIZE) &&
+               (data->client_surface ||
+                wayland_surface_has_hwnd_dmabuf_content(surface));
 
     /* Invisible without an explicit hide is presumed transient; visible
      * windows map through the normal path. */
     if (!(style & WS_MINIMIZE)) return !(style & WS_VISIBLE);
 
     return !surface->current.caps ||
            (surface->current.caps & WAYLAND_SURFACE_WM_CAPS_MINIMIZE);
@@ -314,7 +323,7 @@ static BOOL wayland_win_data_create_wayland_surface(struct wayland_win_data *dat
 
     TRACE("hwnd=%p\n", data->hwnd);
 
     surface = data->wayland_surface;
-    keep_mapped = should_keep_toplevel_mapped(surface, style, swp_flags);
+    keep_mapped = should_keep_toplevel_mapped(data, style, swp_flags);
 
     layer_set = !(exstyle & WS_EX_LAYERED) || data->layered_attribs_set;
     visible = ((style & WS_VISIBLE) == WS_VISIBLE);
-- 
