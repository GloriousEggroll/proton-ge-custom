From 550f2fc48bdf84ec1975290c3f6a288a7c5f8729 Mon Sep 17 00:00:00 2001
From: Erhan Bilgili <erhan.bilgili@gmail.com>
Date: Sat, 8 Aug 2026 14:42:44 +0200
Subject: [PATCH] winewayland.drv: Honor xdg-shell suspended state

Bind xdg_wm_base at up to version 6 and track suspended separately
from geometry-managed states.

Pause managed dma-buf producers and reject new direct attachments while
the compositor is not repainting the toplevel, then reactivate them on
resume.

Keep an opaque client surface stacked below its carrier while the
toplevel is suspended, then restore its logical stacking position on
resume. This keeps child-rendered fullscreen content associated with its
compositor workspace.

This complements Wine's process-local occlusion handling; neither
mechanism replaces the other.

Source: https://github.com/nanomatters/wine-wineland/commit/550f2fc48bdf84ec1975290c3f6a288a7c5f8729
---
 dlls/winewayland.drv/wayland.c         |  5 +-
 dlls/winewayland.drv/wayland_surface.c | 79 ++++++++++++++++++++++++--
 dlls/winewayland.drv/waylanddrv.h      |  3 +-
 dlls/winewayland.drv/window.c          |  6 +-
 dlls/winewayland.drv/xdg-shell.xml     | 17 ++++--
 5 files changed, 91 insertions(+), 19 deletions(-)

diff --git a/dlls/winewayland.drv/wayland.c b/dlls/winewayland.drv/wayland.c
--- a/dlls/winewayland.drv/wayland.c
+++ b/dlls/winewayland.drv/wayland.c
@@ -419,9 +419,10 @@ static void registry_handle_global(void *data, struct wl_registry *registry,
     }
     else if (strcmp(interface, "xdg_wm_base") == 0)
     {
-        /* version 3 is required for xdg_popup::reposition */
+        /* Version 3 provides popup repositioning; version 6 adds suspension. */
         if (version < 3) return;
-        process_wayland.xdg_wm_base = wl_registry_bind(registry, id, &xdg_wm_base_interface, 3);
+        process_wayland.xdg_wm_base =
+            wl_registry_bind(registry, id, &xdg_wm_base_interface, version < 6 ? version : 6);
         xdg_wm_base_add_listener(process_wayland.xdg_wm_base, &xdg_wm_base_listener, NULL);
     }
     else if (strcmp(interface, "wl_shm") == 0)
diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -47,6 +47,9 @@ static void wayland_surface_clear_direct_dmabuf(struct wayland_surface *surface,
                                                 struct wayland_win_data *data);
 void wayland_surface_update_hwnd_dmabufs(struct wayland_surface *surface);
 static BOOL wayland_surface_try_direct_dmabuf(HWND hwnd);
+static void wayland_client_surface_stack(struct wayland_surface *surface,
+                                         struct wayland_client_surface *client,
+                                         BOOL stack_above_parent);
 
 struct wayland_child_visibility_info
 {
@@ -892,6 +895,13 @@ static const struct wayland_surface_config *wayland_surface_latest_config(struct
     return NULL;
 }
 
+static BOOL wayland_surface_repaint_suspended(struct wayland_surface *surface)
+{
+    const struct wayland_surface_config *config = wayland_surface_latest_config(surface);
+
+    return config && (config->state & WAYLAND_SURFACE_CONFIG_STATE_SUSPENDED);
+}
+
 static void wayland_surface_config_inherit_caps_and_bounds(struct wayland_surface_config *config,
                                                            struct wayland_surface *surface)
 {
@@ -930,6 +940,8 @@ static void xdg_surface_handle_configure(void *private, struct xdg_surface *xdg_s
 
     if (wayland_surface_is_toplevel(surface))
     {
+        BOOL was_suspended = wayland_surface_repaint_suspended(surface);
+
         /* If we have a previously requested config, we have already sent a
          * WM_WAYLAND_CONFIGURE which hasn't been handled yet. In that case,
          * avoid sending another message to reduce message queue traffic. */
@@ -949,6 +961,22 @@ static void xdg_surface_handle_configure(void *private, struct xdg_surface *xdg_s
         }
         surface->requested = surface->pending;
         memset(&surface->pending, 0, sizeof(surface->pending));
+
+        if (was_suspended != wayland_surface_repaint_suspended(surface))
+        {
+            struct wayland_client_surface *client = data->client_surface;
+
+            /* Keep an opaque client surface associated with the compositor's
+             * workspace visibility. The logical stacking choice is preserved
+             * so it can be restored when repainting resumes. */
+            if (client && client->wl_subsurface && client->toplevel == surface->hwnd &&
+                client->toplevel_wl_surface == surface->wl_surface)
+            {
+                wayland_client_surface_stack(surface, client, client->stack_above_parent);
+                wl_surface_commit(surface->wl_surface);
+            }
+            should_expose = TRUE;
+        }
     }
     else if (wayland_surface_is_popup(surface))
     {
@@ -1007,6 +1035,9 @@ static void xdg_toplevel_handle_configure(void *private,
         case XDG_TOPLEVEL_STATE_FULLSCREEN:
             config_state |= WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN;
             break;
+        case XDG_TOPLEVEL_STATE_SUSPENDED:
+            config_state |= WAYLAND_SURFACE_CONFIG_STATE_SUSPENDED;
+            break;
         default:
             break;
         }
@@ -1024,7 +1055,8 @@ static void xdg_toplevel_handle_configure(void *private,
 
     wayland_win_data_release(data);
 
-    TRACE("hwnd=%p %s,%#x\n", hwnd, wine_dbgstr_rect(&rect), config_state);
+    TRACE("hwnd=%p %s,%#x suspended=%u\n", hwnd, wine_dbgstr_rect(&rect), config_state,
+          !!(config_state & WAYLAND_SURFACE_CONFIG_STATE_SUSPENDED));
 }
 
 static void xdg_toplevel_handle_close(void *data, struct xdg_toplevel *xdg_toplevel)
@@ -2443,9 +2475,13 @@ static void wayland_client_surface_stack(struct wayland_surface *surface,
                                          struct wayland_client_surface *client,
                                          BOOL stack_above_parent)
 {
+    BOOL effective_stack_above_parent;
+
     if (!client->wl_subsurface) return;
 
-    if (stack_above_parent)
+    effective_stack_above_parent = stack_above_parent &&
+                                    !wayland_surface_repaint_suspended(surface);
+    if (effective_stack_above_parent)
         wl_subsurface_place_above(client->wl_subsurface, surface->wl_surface);
     else
         wl_subsurface_place_below(client->wl_subsurface,
@@ -3649,11 +3685,12 @@ static BOOL wayland_surface_try_direct_dmabuf(HWND hwnd)
         struct wayland_surface *surface = data->wayland_surface;
 
         had_direct = surface && surface->direct_dmabuf_surface;
-        may_try = surface && (had_direct ||
-                              (wayland_surface_is_toplevel(surface) &&
-                               !data->window_contents &&
-                               !data->client_surface &&
-                               wayland_surface_client_fills_window(surface)));
+        may_try = surface && !wayland_surface_repaint_suspended(surface) &&
+                  (had_direct ||
+                   (wayland_surface_is_toplevel(surface) &&
+                    !data->window_contents &&
+                    !data->client_surface &&
+                    wayland_surface_client_fills_window(surface)));
         wayland_win_data_release(data);
     }
     if (!may_try) return FALSE;
@@ -3704,7 +3741,7 @@ void wayland_surface_reannounce_hwnd_dmabuf_consumers(struct wayland_surface *su
         surface->direct_dmabuf_surface->consumer_state = WAYLAND_HWNDDMABUF_CONSUMER_UNKNOWN;
 }
 
-/* Stop publishing while this surface cannot import producer frames. */
+/* Stop producer updates while new frames cannot be displayed. */
 static void wayland_surface_suspend_hwnd_dmabuf_consumers(struct wayland_surface *surface)
 {
     struct wayland_hwnd_dmabuf_surface *dmabuf_surface;
@@ -3722,6 +3759,23 @@ static void wayland_surface_suspend_hwnd_dmabuf_consumers(struct wayland_surface
         dmabuf_surface->consumer_state = WAYLAND_HWNDDMABUF_CONSUMER_SUSPENDED;
 }
 
+static void wayland_surface_activate_hwnd_dmabuf_consumers(struct wayland_surface *surface)
+{
+    struct wayland_hwnd_dmabuf_surface *dmabuf_surface;
+
+    wl_list_for_each(dmabuf_surface, &surface->hwnd_dmabuf_surfaces, link)
+        if (dmabuf_surface->consumer_state != WAYLAND_HWNDDMABUF_CONSUMER_ACTIVE &&
+            !wayland_hwnd_dmabuf_surface_send_consumer_state(dmabuf_surface,
+                    HWND_DMABUF_RELEASE_CONSUMER_ACTIVE))
+            dmabuf_surface->consumer_state = WAYLAND_HWNDDMABUF_CONSUMER_ACTIVE;
+
+    if ((dmabuf_surface = surface->direct_dmabuf_surface) &&
+        dmabuf_surface->consumer_state != WAYLAND_HWNDDMABUF_CONSUMER_ACTIVE &&
+        !wayland_hwnd_dmabuf_surface_send_consumer_state(dmabuf_surface,
+                HWND_DMABUF_RELEASE_CONSUMER_ACTIVE))
+        dmabuf_surface->consumer_state = WAYLAND_HWNDDMABUF_CONSUMER_ACTIVE;
+}
+
 void wayland_surface_update_hwnd_dmabufs(struct wayland_surface *surface)
 {
     hwnd_dmabuf_frame_info_t stack_frames[16], *frames = stack_frames;
@@ -3741,6 +3795,15 @@ void wayland_surface_update_hwnd_dmabufs(struct wayland_surface *surface)
         wayland_surface_suspend_hwnd_dmabuf_consumers(surface);
         return;
     }
+    if (surface->role == WAYLAND_SURFACE_ROLE_TOPLEVEL)
+    {
+        if (surface->window.minimized || wayland_surface_repaint_suspended(surface))
+        {
+            wayland_surface_suspend_hwnd_dmabuf_consumers(surface);
+            return;
+        }
+        wayland_surface_activate_hwnd_dmabuf_consumers(surface);
+    }
 
     /* Import is driven by producer wakes (WM_WAYLAND_DMABUF_FRAME) at the producer's
      * self-paced rate, regardless of whether our toplevel is presented. We do not pace
diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -94,7 +94,8 @@ enum wayland_surface_config_state
     WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED = (1 << 0),
     WAYLAND_SURFACE_CONFIG_STATE_RESIZING = (1 << 1),
     WAYLAND_SURFACE_CONFIG_STATE_TILED = (1 << 2),
-    WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN = (1 << 3)
+    WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN = (1 << 3),
+    WAYLAND_SURFACE_CONFIG_STATE_SUSPENDED = (1 << 4)
 };
 
 enum wayland_surface_role
diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -999,9 +999,9 @@ static void wayland_configure_window(HWND hwnd)
      * their sizes cannot change while we are still processing the new config.
      * This allows us to respect the size hint on transitions of maximized/tiled
      * to a stateless regular window. */
-    if (state || surface->current.state &
-        (WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED |
-               WAYLAND_SURFACE_CONFIG_STATE_TILED))
+    if ((state & ~WAYLAND_SURFACE_CONFIG_STATE_SUSPENDED) ||
+        (surface->current.state & (WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED |
+                                   WAYLAND_SURFACE_CONFIG_STATE_TILED)))
     {
         width = surface->processing.rect.right - surface->processing.rect.left;
         height = surface->processing.rect.bottom - surface->processing.rect.top;
diff --git a/dlls/winewayland.drv/xdg-shell.xml b/dlls/winewayland.drv/xdg-shell.xml
--- a/dlls/winewayland.drv/xdg-shell.xml
+++ b/dlls/winewayland.drv/xdg-shell.xml
@@ -29,7 +29,7 @@
     DEALINGS IN THE SOFTWARE.
   </copyright>
 
-  <interface name="xdg_wm_base" version="5">
+  <interface name="xdg_wm_base" version="6">
     <description summary="create desktop-style surfaces">
       The xdg_wm_base interface is exposed as a global object enabling clients
       to turn their wl_surfaces into windows in a desktop environment. It
@@ -122,7 +122,7 @@
     </event>
   </interface>
 
-  <interface name="xdg_positioner" version="5">
+  <interface name="xdg_positioner" version="6">
     <description summary="child surface positioner">
       The xdg_positioner provides a collection of rules for the placement of a
       child surface relative to a parent surface. Rules can be defined to ensure
@@ -407,7 +407,7 @@
     </request>
   </interface>
 
-  <interface name="xdg_surface" version="5">
+  <interface name="xdg_surface" version="6">
     <description summary="desktop user interface surface base interface">
       An interface that may be implemented by a wl_surface, for
       implementations that provide a desktop-style user interface.
@@ -606,7 +606,7 @@
 
   </interface>
 
-  <interface name="xdg_toplevel" version="5">
+  <interface name="xdg_toplevel" version="6">
     <description summary="toplevel surface">
       This interface defines an xdg_surface role which allows a surface to,
       among other things, set window-like properties such as maximize,
@@ -877,6 +877,13 @@
 	  considered to be adjacent to another part of the tiling grid.
 	</description>
       </entry>
+      <entry name="suspended" value="9" since="6">
+        <description summary="surface repaint is suspended">
+	  The surface is currently not ordinarily being repainted; for
+	  example because its content is occluded by another window, or its
+	  outputs are switched off due to screen locking.
+	</description>
+      </entry>
     </enum>
 
     <request name="set_max_size">
@@ -1175,7 +1182,7 @@
     </event>
   </interface>
 
-  <interface name="xdg_popup" version="5">
+  <interface name="xdg_popup" version="6">
     <description summary="short-lived, popup surfaces for menus">
       A popup surface is a short-lived, temporary surface. It can be used to
       implement for example menus, popovers, tooltips and other similar user
-- 
