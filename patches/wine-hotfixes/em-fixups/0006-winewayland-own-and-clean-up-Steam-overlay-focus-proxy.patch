From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Mon, 17 Aug 2026 17:22:00 -0600
Subject: [PATCH] winewayland: own and clean up Steam overlay focus proxy

Only one Wine process for a Steam AppID may advertise native Wayland focus
through X11 at a time. Keep that ownership across temporary focus transitions
so transient secondary processes cannot steal Steam controller focus.

The proxy is an implementation detail, not an application window. Destroy it,
release its selection and event handles, and reset the bridge after the last
real Wayland toplevel is destroyed. This prevents the mapped proxy from
outliving the game window and allows a later toplevel to initialize a fresh
bridge.

Focus events are injected explicitly, so do not also select server-generated
focus events for the proxy.
---
 dlls/winewayland.drv/steam_overlay.c | 112 +++++++++++++++++++++++++--
 dlls/winewayland.drv/waylanddrv.h    |   1 +
 dlls/winewayland.drv/window.c        |  25 ++++++
 3 files changed, 132 insertions(+), 6 deletions(-)

diff --git a/dlls/winewayland.drv/steam_overlay.c b/dlls/winewayland.drv/steam_overlay.c
--- a/dlls/winewayland.drv/steam_overlay.c
+++ b/dlls/winewayland.drv/steam_overlay.c
@@ -142,6 +142,8 @@ static BOOL overlay_initialized;
 static BOOL overlay_active;
 static BOOL overlay_input_active;
 static BOOL overlay_event_owned;
+static BOOL overlay_focus_owner;
+static Atom overlay_owner_atom;
 static int pointer_x, pointer_y;
 
 #define OVERLAY_CURSOR_MAP_SIZE 64
@@ -479,7 +481,7 @@ static BOOL init_overlay_bridge(void)
     XSetWindowAttributes attributes = {0};
     XClassHint class_hint;
     const char *display_name, *env;
-    char window_class[128];
+    char owner_selection[160], window_class[128];
     unsigned long pid;
     Atom net_wm_pid;
     Dl_info info;
@@ -512,7 +514,7 @@ static BOOL init_overlay_bridge(void)
     overlay_root = DefaultRootWindow(overlay_display);
     attributes.override_redirect = True;
     attributes.event_mask = KeyPressMask | KeyReleaseMask | ButtonPressMask |
-                            ButtonReleaseMask | PointerMotionMask | FocusChangeMask;
+                            ButtonReleaseMask | PointerMotionMask;
     overlay_window = XCreateWindow(overlay_display, overlay_root, -1, -1, 1, 1, 0, 0,
                                    InputOnly, CopyFromParent,
                                    CWOverrideRedirect | CWEventMask, &attributes);
@@ -526,9 +528,18 @@ static BOOL init_overlay_bridge(void)
     XSelectInput(overlay_display, overlay_window, attributes.event_mask);
     env = getenv("SteamAppId");
     if (env && env[0])
+    {
         snprintf(window_class, sizeof(window_class), "steam_app_%s", env);
+        snprintf(owner_selection, sizeof(owner_selection),
+                 "_WINE_WAYLAND_STEAM_FOCUS_%s", env);
+    }
     else
+    {
         snprintf(window_class, sizeof(window_class), "steam_proton");
+        snprintf(owner_selection, sizeof(owner_selection),
+                 "_WINE_WAYLAND_STEAM_FOCUS_DEFAULT");
+    }
+    overlay_owner_atom = XInternAtom(overlay_display, owner_selection, False);
     class_hint.res_name = window_class;
     class_hint.res_class = window_class;
     XSetClassHint(overlay_display, overlay_window, &class_hint);
@@ -676,7 +687,8 @@ static BOOL dispatch_wheel(uint32_t time, int value, BOOL horizontal)
 void wayland_steam_overlay_focus(BOOL focused)
 {
     XEvent event = {0};
-    Window current_focus;
+    Window current_focus, selection_owner;
+    BOOL advertise_focus = FALSE;
     int revert_to;
 
     if (!init_overlay_bridge()) return;
@@ -685,19 +697,41 @@ void wayland_steam_overlay_focus(BOOL focused)
     XLockDisplay(overlay_display);
     if (focused)
     {
-        XSetInputFocus(overlay_display, overlay_window, RevertToParent, CurrentTime);
+        selection_owner = XGetSelectionOwner(overlay_display, overlay_owner_atom);
+        if (selection_owner == None || selection_owner == overlay_window)
+        {
+            XSetSelectionOwner(overlay_display, overlay_owner_atom,
+                               overlay_window, CurrentTime);
+            XSync(overlay_display, False);
+            overlay_focus_owner =
+                XGetSelectionOwner(overlay_display, overlay_owner_atom) == overlay_window;
+        }
+
+        if (overlay_focus_owner)
+        {
+            XSetInputFocus(overlay_display, overlay_window, RevertToParent, CurrentTime);
+            advertise_focus = TRUE;
+        }
     }
-    else
+    else if (overlay_focus_owner)
     {
         XGetInputFocus(overlay_display, &current_focus, &revert_to);
         if (current_focus == overlay_window)
             XSetInputFocus(overlay_display, PointerRoot, RevertToPointerRoot, CurrentTime);
+        advertise_focus = TRUE;
     }
     XFlush(overlay_display);
     XUnlockDisplay(overlay_display);
     pthread_mutex_unlock(&overlay_mutex);
 
-    TRACE("Steam overlay X11 focus proxy is now %s\n", focused ? "focused" : "unfocused");
+    if (!advertise_focus)
+    {
+        TRACE("another process owns the Steam overlay X11 focus proxy\n");
+        return;
+    }
+
+    TRACE("Steam overlay X11 focus proxy is now %s\n",
+          focused ? "focused" : "unfocused");
 
     event.type = focused ? FocusIn : FocusOut;
     event.xfocus.mode = NotifyNormal;
@@ -812,6 +846,68 @@ BOOL wayland_steam_overlay_is_active(void)
     return update_overlay_active();
 }
 
+void wayland_steam_overlay_destroy(void)
+{
+    Window current_focus;
+    HANDLE event = NULL;
+    BOOL restore_pointer = FALSE;
+    int revert_to;
+
+    pthread_mutex_lock(&overlay_mutex);
+    if (overlay_initialized <= 0)
+    {
+        pthread_mutex_unlock(&overlay_mutex);
+        return;
+    }
+
+    restore_pointer = overlay_active || overlay_input_active;
+    if (overlay_event_owned && overlay_event)
+        NtResetEvent(overlay_event, NULL);
+
+    XLockDisplay(overlay_display);
+    if (overlay_focus_owner &&
+        XGetSelectionOwner(overlay_display, overlay_owner_atom) == overlay_window)
+        XSetSelectionOwner(overlay_display, overlay_owner_atom, None, CurrentTime);
+
+    XGetInputFocus(overlay_display, &current_focus, &revert_to);
+    if (current_focus == overlay_window)
+        XSetInputFocus(overlay_display, PointerRoot, RevertToPointerRoot, CurrentTime);
+
+    XSetAfterFunction(overlay_display, previous_after_function);
+    XDestroyWindow(overlay_display, overlay_window);
+    XSync(overlay_display, False);
+    XUnlockDisplay(overlay_display);
+    XCloseDisplay(overlay_display);
+
+    event = overlay_event;
+    overlay_display = NULL;
+    overlay_window = None;
+    overlay_root = None;
+    overlay_event = NULL;
+    previous_after_function = NULL;
+    overlay_serial = 0;
+    overlay_state = 0;
+    overlay_initialized = 0;
+    overlay_active = FALSE;
+    overlay_input_active = FALSE;
+    overlay_event_owned = FALSE;
+    overlay_focus_owner = FALSE;
+    overlay_owner_atom = None;
+    pointer_x = pointer_y = 0;
+
+    if (event) NtClose(event);
+
+    pthread_mutex_lock(&overlay_cursor_mutex);
+    memset(overlay_cursor_map, 0, sizeof(overlay_cursor_map));
+    overlay_cursor_shape = WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_DEFAULT;
+    overlay_cursor_dirty = FALSE;
+    pthread_mutex_unlock(&overlay_cursor_mutex);
+    pthread_mutex_unlock(&overlay_mutex);
+
+    if (restore_pointer) wayland_pointer_set_overlay_active(FALSE);
+    TRACE("destroyed Steam overlay X11 input proxy\n");
+}
+
 #else /* SONAME_LIBX11 */
 
 void wayland_steam_overlay_focus(BOOL focused)
@@ -839,6 +935,10 @@ BOOL wayland_steam_overlay_is_active(void)
     return FALSE;
 }
 
+void wayland_steam_overlay_destroy(void)
+{
+}
+
 void wayland_steam_overlay_set_cursor_shape(enum wp_cursor_shape_device_v1_shape shape)
 {
 }
diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -589,6 +589,7 @@ BOOL wayland_steam_overlay_filter_pointer_button(uint32_t time, uint32_t button,
 BOOL wayland_steam_overlay_filter_pointer_frame(const struct wayland_pointer_frame *frame);
 BOOL wayland_steam_overlay_is_active(void);
 void wayland_steam_overlay_set_cursor_shape(enum wp_cursor_shape_device_v1_shape shape);
+void wayland_steam_overlay_destroy(void);
 
 
 /**********************************************************************
diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -600,16 +600,34 @@ static BOOL is_notification_window(HWND hwnd, UINT swp_flags,
 }
 
 /***********************************************************************
  *           WAYLAND_DestroyWindow
  */
+static BOOL wayland_win_data_is_last_toplevel(struct wayland_win_data *data)
+{
+    struct wayland_win_data *other;
+
+    if (!data->wayland_surface || !wayland_surface_is_toplevel(data->wayland_surface))
+        return FALSE;
+
+    RB_FOR_EACH_ENTRY(other, &win_data_rb, struct wayland_win_data, entry)
+        if (other != data && other->wayland_surface &&
+            wayland_surface_is_toplevel(other->wayland_surface))
+            return FALSE;
+
+    return TRUE;
+}
+
 void WAYLAND_DestroyWindow(HWND hwnd)
 {
     struct wayland_win_data *data;
+    BOOL last_toplevel = FALSE;
 
     TRACE("%p\n", hwnd);
 
     if (!(data = wayland_win_data_get(hwnd))) return;
+    last_toplevel = wayland_win_data_is_last_toplevel(data);
     wayland_win_data_destroy(data);
+    if (last_toplevel) wayland_steam_overlay_destroy();
 }
 
 /***********************************************************************
@@ -659,6 +679,7 @@ void WAYLAND_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UINT
     BOOL tray_menu = swp_flags & WINE_SWP_TRAY_MENU;
     BOOL notification = FALSE;
     BOOL use_layer_shell = FALSE;
+    BOOL last_toplevel, destroy_overlay;
 
     /* Get the managed state with win_data unlocked, as is_window_managed
      * may need to query win_data information about other HWNDs and thus
@@ -675,6 +696,7 @@ void WAYLAND_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UINT
           owner, debugstr_window_rects(new_rects), insert_after, swp_flags);
 
     if (!(data = wayland_win_data_get(hwnd))) return;
+    last_toplevel = wayland_win_data_is_last_toplevel(data);
     owner_data = owner && owner != hwnd ? wayland_win_data_get(owner) : NULL;
     owner_surface = owner_data ? owner_data->wayland_surface : NULL;
     /* for it to be a popup, we need a valid xdg surface. */
@@ -697,8 +719,13 @@ void WAYLAND_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UINT
         wayland_win_data_update_wayland_state(data);
     }
 
+    destroy_overlay = last_toplevel &&
+                      (!data->wayland_surface ||
+                       !wayland_surface_is_toplevel(data->wayland_surface));
+
     if (owner_data) wayland_win_data_release(owner_data);
     wayland_win_data_release(data);
+    if (destroy_overlay) wayland_steam_overlay_destroy();
 }
 
 static void wayland_configure_window(HWND hwnd)
-- 
