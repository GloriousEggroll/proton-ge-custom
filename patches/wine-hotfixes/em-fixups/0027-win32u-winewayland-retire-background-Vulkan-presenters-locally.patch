From 77ccabfbf4c48ca64ef0763146a320480e7a55af Mon Sep 17 00:00:00 2001
From: Erhan Bilgili <erhan.bilgili@gmail.com>
Date: Thu, 3 Sep 2026 18:36:00 -0600
Subject: [PATCH] win32u, winewayland: Retire background Vulkan presenters
 locally

Windows permits multiple graphics presenters to target one HWND, but exposing
each Vulkan presenter through host Wayland WSI creates competing visible
surfaces. A background presenter can then block indefinitely while acquiring a
host image and stall another renderer in the same application.

Track successful client-surface activations in creation order. Keep the newest
active presenter on host WSI and back older Vulkan presenters with ordinary
local images whose completed frames are discarded. Split infinite host image
acquires into bounded waits so an ownership-generation change can wake a
presenter that was already blocked in the host driver.

Keep a replacement surface attached while its host WSI swapchain is being
created. This bootstrap state is tracked separately from generic busy
references, so local discard and cross-process managed swapchains remain
detached.

This is a focused GE-Proton adaptation of Wine-Wineland commit
13bb88cb72c8a86fad4f1c6ca1152380ceb7c89d. It retains the existing GE-Proton
cross-process dmabuf path and omits unrelated direct-toplevel and Steam-overlay
changes.

Co-authored-by: GloriousEggroll <gloriouseggroll@gmail.com>
Source: https://github.com/nanomatters/wine-wineland/commit/13bb88cb72c8a86fad4f1c6ca1152380ceb7c89d

diff --git a/dlls/win32u/opengl.c b/dlls/win32u/opengl.c
index 7bb204847ff..a9bbea3a12b 100644
--- a/dlls/win32u/opengl.c
+++ b/dlls/win32u/opengl.c
@@ -157,10 +157,8 @@ void opengl_drawable_release( struct opengl_drawable *drawable )
         if (drawable->client)
         {
             if (drawable->client_active)
-                InterlockedDecrement( &drawable->client->native_ref );
+                client_surface_deactivate( drawable->client, TRUE );
             InterlockedDecrement( &drawable->client->busy_ref );
-            if (drawable->client_active)
-                client_surface_update( drawable->client );
             client_surface_release( drawable->client );
         }
         free( drawable );
@@ -2107,7 +2105,7 @@ static struct opengl_drawable *get_window_unused_drawable( HWND hwnd, int format
         driver_funcs->p_surface_create( hwnd, raw, format, &drawable );
         if (drawable && drawable->client)
         {
-            InterlockedIncrement( &drawable->client->native_ref );
+            client_surface_activate( drawable->client, TRUE, NULL );
             drawable->client_active = TRUE;
             add_window_client_surface( hwnd, drawable->client );
         }
