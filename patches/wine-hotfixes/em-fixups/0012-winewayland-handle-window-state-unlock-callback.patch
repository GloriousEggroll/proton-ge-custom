From 04d3c4c5967965c37a7447e65fcdcdfad1425d1b Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Sat, 29 Aug 2026 18:30:00 -0600
Subject: [PATCH] winewayland: Handle the window-state unlock callback

Wine commit a62c54a70b0bdb1e9ff2da77f4c8a7a27975d08b changed
WM_WINE_WINDOW_STATE_CHANGED handling to call pGetWindowStateUpdates() a
second time with NULL output pointers. Drivers which lock host state use that
call to release the lock after applying the corresponding Win32 state.

Wine-Wayland does not currently lock host state in this callback, so treat the
second call as a no-op before querying any Win32 window state. Without this
guard every window-state update writes through NULL output pointers, raising
STATUS_ACCESS_VIOLATION from winewayland.so and aborting the remainder of the
internal window message.
---
 dlls/winewayland.drv/window.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index a23b65015cd..2bc82718fa1 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -1502,10 +1502,18 @@ BOOL WAYLAND_GetWindowStateUpdates(HWND hwnd, UINT *state_cmd, UINT *swp_flags,
 {
     struct wayland_keyboard *keyboard = &process_wayland.keyboard;
     struct wayland_win_data *data;
-    DWORD style = NtUserGetWindowLongW(hwnd, GWL_STYLE);
-    HWND focused_hwnd, old_foreground = NtUserGetForegroundWindow();
+    DWORD style;
+    HWND focused_hwnd, old_foreground;
     BOOL ret;
 
+    /* win32u uses a second call with NULL outputs to release any host state
+     * lock acquired by the first call. Wine-Wayland does not acquire one. */
+    if (!state_cmd)
+        return FALSE;
+
+    style = NtUserGetWindowLongW(hwnd, GWL_STYLE);
+    old_foreground = NtUserGetForegroundWindow();
+
     *state_cmd = *swp_flags = 0;
     *foreground = NULL;
     SetRectEmpty(rect);
-- 
