From 5ca67189918f7a995a9bf27ee03142007f40c333 Mon Sep 17 00:00:00 2001
From: Etaash Mathamsetty
 <45927311+Etaash-mathamsetty@users.noreply.github.com>
Date: Thu, 2 Jul 2026 16:48:22 -0400
Subject: [PATCH 177/285] winewayland: Treat 0x0 windows as roleless.

---
 dlls/winewayland.drv/window.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index 565cd4a7f0d..97c329d3306 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -198,7 +198,7 @@ static BOOL wayland_win_data_create_wayland_surface(struct wayland_win_data *dat
     if (!(surface = data->wayland_surface) || !surface->window.visible)
         visible = visible && layer_set;
 
-    if (!visible) role = WAYLAND_SURFACE_ROLE_NONE;
+    if (!visible || IsRectEmpty(&data->rects.visible)) role = WAYLAND_SURFACE_ROLE_NONE;
     else if (owner_surface) role = WAYLAND_SURFACE_ROLE_POPUP;
     else role = WAYLAND_SURFACE_ROLE_TOPLEVEL;
 
