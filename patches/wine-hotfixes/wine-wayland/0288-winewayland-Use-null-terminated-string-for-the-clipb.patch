From 054c0770c73fbad6ff9e77e39b2031d6cae47904 Mon Sep 17 00:00:00 2001
From: Nikolay Sivov <nsivov@codeweavers.com>
Date: Tue, 1 Sep 2026 10:45:23 +0200
Subject: [PATCH] winewayland: Use null-terminated string for the clipboard
 class name.

Signed-off-by: Nikolay Sivov <nsivov@codeweavers.com>
---
 dlls/winewayland.drv/wayland_data_device.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dlls/winewayland.drv/wayland_data_device.c b/dlls/winewayland.drv/wayland_data_device.c
index 6fbbc49e2f8..5bb39ffe44f 100644
--- a/dlls/winewayland.drv/wayland_data_device.c
+++ b/dlls/winewayland.drv/wayland_data_device.c
@@ -907,7 +907,7 @@ static BOOL is_winewayland_clipboard_hwnd(HWND hwnd)
 {
     static const WCHAR clipboard_classnameW[] = {
         '_','_','w','i','n','e','w','a','y','l','a','n','d','_',
-        'c','l','i','p','b','o','a','r','d','_','m','a','n','a','g','e','r'};
+        'c','l','i','p','b','o','a','r','d','_','m','a','n','a','g','e','r',0};
     WCHAR buffer[64];
     UNICODE_STRING name = {.Buffer = buffer, .MaximumLength = sizeof(buffer)};
 
