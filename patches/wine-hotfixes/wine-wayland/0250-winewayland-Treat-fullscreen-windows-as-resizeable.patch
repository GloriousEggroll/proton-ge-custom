From 9b0f666424e4f454d596e8970ac548d215636d92 Mon Sep 17 00:00:00 2001
From: Etaash Mathamsetty
 <45927311+Etaash-mathamsetty@users.noreply.github.com>
Date: Mon, 3 Aug 2026 10:11:10 -0400
Subject: [PATCH 250/268] winewayland: Treat fullscreen windows as resizeable.

---
 dlls/winewayland.drv/wayland_surface.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
index 9c2f7512a22..eb06b44fda0 100644
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -907,7 +907,9 @@ static void wayland_surface_reconfigure_geometry(struct wayland_surface *surface
 
         if (!wayland_surface_is_toplevel(surface)) return;
 
-        if (surface->window.resizeable)
+        /* some compositors have issues entering fullscreen state with a strict size hint */
+        if (surface->window.resizeable ||
+            (surface->current.state & WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN))
         {
             xdg_toplevel_set_min_size(surface->xdg_toplevel, 0, 0);
             xdg_toplevel_set_max_size(surface->xdg_toplevel, 0, 0);
-- 
