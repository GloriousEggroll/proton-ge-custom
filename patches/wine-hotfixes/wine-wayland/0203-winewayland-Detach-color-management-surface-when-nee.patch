From b9ca0950b2f8dbd3d8713ccbfca181da7db635c9 Mon Sep 17 00:00:00 2001
From: Etaash Mathamsetty
 <45927311+Etaash-mathamsetty@users.noreply.github.com>
Date: Sun, 19 Jul 2026 18:30:21 -0400
Subject: [PATCH 203/268] winewayland: Detach color management surface when
 needed.

---
 dlls/win32u/vulkan.c          | 4 +++-
 dlls/winewayland.drv/vulkan.c | 8 ++++++--
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/dlls/win32u/vulkan.c b/dlls/win32u/vulkan.c
index eeea5b517d9..2f7b4acb7e5 100644
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -2558,7 +2558,7 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
     res = instance->p_vkGetPhysicalDeviceSurfaceCapabilitiesKHR( physical_device->host.physical_device, surface->obj.host.surface, &capabilities );
     if (res) return res;
 
-    create_info_host.imageColorSpace = driver_funcs->p_vulkan_map_colorspace( create_info_host.imageColorSpace, surface->client );
+    create_info_host.imageColorSpace = driver_funcs->p_vulkan_map_colorspace( create_info_host.imageColorSpace, NULL );
     create_info_host.imageExtent.width = max( create_info_host.imageExtent.width, capabilities.minImageExtent.width );
     create_info_host.imageExtent.height = max( create_info_host.imageExtent.height, capabilities.minImageExtent.height );
 
@@ -2630,9 +2630,11 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
                 create_info_host.imageColorSpace, create_info_host.imageFormat);
             create_info_host.imageColorSpace = create_info->imageColorSpace;
         }
+        else driver_funcs->p_vulkan_map_colorspace( create_info->imageColorSpace, surface->client );
 
         free(formats);
     }
+    else driver_funcs->p_vulkan_map_colorspace( create_info->imageColorSpace, surface->client );
 
     InterlockedIncrement( &surface->client->busy_ref );
 
diff --git a/dlls/winewayland.drv/vulkan.c b/dlls/winewayland.drv/vulkan.c
index c2439a78143..2eb2bdfb0d3 100644
--- a/dlls/winewayland.drv/vulkan.c
+++ b/dlls/winewayland.drv/vulkan.c
@@ -151,9 +151,13 @@ static VkColorSpaceKHR wayland_vulkan_map_colorspace(VkColorSpaceKHR colorspace,
         new = VK_COLOR_SPACE_PASS_THROUGH_EXT;
 
     if (!client) return new;
-    if (new == colorspace) return colorspace;
+    if (new == colorspace)
+    {
+        wayland_client_surface_attach_image_description(client, NULL);
+        return colorspace;
+    }
 
-    switch(colorspace)
+    switch (colorspace)
     {
     case VK_COLOR_SPACE_EXTENDED_SRGB_LINEAR_EXT:
         wp_image_description_v1 =
-- 
2.55.0

