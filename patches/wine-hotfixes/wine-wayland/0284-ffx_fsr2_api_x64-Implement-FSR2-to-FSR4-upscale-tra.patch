+/* ---- minimal COM surface for amdxc64.dll's AGS-style extension interfaces ---- */
+
+DEFINE_GUID(IID_IAmdExtD3DFactory,        0x014937ec, 0x9288, 0x446f, 0xa9, 0xac, 0xd7, 0x5a, 0x8e, 0x3a, 0x98, 0x4f);
+DEFINE_GUID(IID_IAmdExtD3DShaderIntrinsics, 0xba019d53, 0xccab, 0x4cbd, 0xb5, 0x6a, 0x72, 0x30, 0xed, 0x43, 0x30, 0xad);
+
+typedef struct IAmdExtD3DFactory IAmdExtD3DFactory;
+typedef struct IAmdExtD3DFactoryVtbl
+{
+    HRESULT (STDMETHODCALLTYPE *QueryInterface)(IAmdExtD3DFactory *iface, REFIID iid, void **out);
+    ULONG (STDMETHODCALLTYPE *AddRef)(IAmdExtD3DFactory *iface);
+    ULONG (STDMETHODCALLTYPE *Release)(IAmdExtD3DFactory *iface);
+    HRESULT (STDMETHODCALLTYPE *CreateInterface)(IAmdExtD3DFactory *iface, IUnknown *outer, REFIID iid, void **out);
+} IAmdExtD3DFactoryVtbl;
+struct IAmdExtD3DFactory { const IAmdExtD3DFactoryVtbl *lpVtbl; };
+
+typedef struct IAmdExtD3DShaderIntrinsics IAmdExtD3DShaderIntrinsics;
+typedef struct IAmdExtD3DShaderIntrinsicsVtbl
+{
+    HRESULT (STDMETHODCALLTYPE *QueryInterface)(IAmdExtD3DShaderIntrinsics *iface, REFIID iid, void **out);
+    ULONG (STDMETHODCALLTYPE *AddRef)(IAmdExtD3DShaderIntrinsics *iface);
+    ULONG (STDMETHODCALLTYPE *Release)(IAmdExtD3DShaderIntrinsics *iface);
+    HRESULT (STDMETHODCALLTYPE *GetInfo)(IAmdExtD3DShaderIntrinsics *iface, void *info);
+    HRESULT (STDMETHODCALLTYPE *CheckSupport)(IAmdExtD3DShaderIntrinsics *iface, DWORD opcodeSupport);
+    HRESULT (STDMETHODCALLTYPE *Enable)(IAmdExtD3DShaderIntrinsics *iface);
+} IAmdExtD3DShaderIntrinsicsVtbl;
+struct IAmdExtD3DShaderIntrinsics { const IAmdExtD3DShaderIntrinsicsVtbl *lpVtbl; };
+
+#define AmdExtD3DShaderIntrinsicsSupport_Float8Conversion 0x20
+#define AmdExtD3DShaderIntrinsicsSupport_WaveMatrix       0x1F
+
+typedef HRESULT (CDECL *pfnAmdExtD3DCreateInterface)(IUnknown *outer, REFIID iid, void **obj);
+
+/* Query FP8/WMMA support through wine's own amdxc64.dll, exactly like the
+ * FSR 3.1-to-4 upgrade path does; avoids duplicating the vkd3d-proton
+ * extension probing here. */
+static BOOL check_fsr4_supported(void *device, BOOL *fp8, BOOL *wmma)
+{
+    HMODULE amdxc64;
+    pfnAmdExtD3DCreateInterface create;
+    IAmdExtD3DFactory *factory = NULL;
+    IAmdExtD3DShaderIntrinsics *intrinsics = NULL;
+    BOOL ret = FALSE;
+
+    if (fp8) *fp8 = FALSE;
+    if (wmma) *wmma = FALSE;
+
+    if (!(amdxc64 = LoadLibraryA("amdxc64.dll")))
+    {
+        ERR("Failed to load amdxc64.dll for FSR4 support detection!\n");
+        return FALSE;
+    }
+
+    create = (pfnAmdExtD3DCreateInterface)GetProcAddress(amdxc64, "AmdExtD3DCreateInterface");
+    if (!create) goto done;
+
+    if (FAILED(create((IUnknown *)device, &IID_IAmdExtD3DFactory, (void **)&factory)) || !factory)
+        goto done;
+
+    if (FAILED(factory->lpVtbl->CreateInterface(factory, (IUnknown *)device, &IID_IAmdExtD3DShaderIntrinsics, (void **)&intrinsics)) || !intrinsics)
+        goto done;
+
+    if (fp8 && SUCCEEDED(intrinsics->lpVtbl->CheckSupport(intrinsics, AmdExtD3DShaderIntrinsicsSupport_Float8Conversion)))
+        *fp8 = TRUE;
+    if (wmma && SUCCEEDED(intrinsics->lpVtbl->CheckSupport(intrinsics, AmdExtD3DShaderIntrinsicsSupport_WaveMatrix)))
+        *wmma = TRUE;
+
+    ret = TRUE;
+
+done:
+    if (intrinsics) intrinsics->lpVtbl->Release(intrinsics);
+    if (factory) factory->lpVtbl->Release(factory);
+    return ret;
+}
+
+/* ---- provider acquisition ---- */
+
+static BOOL get_fsr4_provider(struct ffxExternalProvider *provider, BOOL fp8_supported)
+{
+    HMODULE amdffx;
+    updateffxapi_pfn_ex pfn_ex;
+    updateffxapi_pfn pfn;
+    struct unk_data unk_data[1] = {{{0, 1, 0, 0}, NULL}};
+    HRESULT hr;
+
+    memset(provider, 0, sizeof(*provider));
+    provider->structVersion = 2;
+    provider->descType = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE;
+
+    if (fp8_supported) unk_data->unk[2] = 1;
+
+    if (!(amdffx = LoadLibraryA("amdxcffx64")))
+    {
+        WARN("Failed to load FSR4 dll (amdxcffx64); is PROTON_FSR4_UPGRADE / PROTON_FFX4_UPGRADE set up?\n");
+        return FALSE;
+    }
+
+    pfn_ex = (updateffxapi_pfn_ex)GetProcAddress(amdffx, "UpdateFfxApiProviderEx");
+    pfn = (updateffxapi_pfn)GetProcAddress(amdffx, "UpdateFfxApiProvider");
+
+    if (pfn_ex)
+        hr = pfn_ex(provider, sizeof(*provider), unk_data);
+    else if (pfn)
+        hr = pfn(provider, sizeof(*provider));
+    else
+    {
+        ERR("UpdateFfxApiProvider[Ex] symbol not found in amdxcffx64!\n");
+        return FALSE;
+    }
+
+    if (FAILED(hr) || !provider->createContext || !provider->dispatch)
+    {
+        ERR("amdxcffx64 did not return a usable FSR4 provider (hr=%#lx)\n", hr);
+        return FALSE;
+    }
+
+    TRACE("FSR4 provider acquired: version=%s\n", debugstr_a(provider->versionName));
+    return TRUE;
+}
+
+/* ---- resource / format translation ---- */
+
+static uint32_t translate_resource_type(uint32_t fsr2_type)
+{
+    switch (fsr2_type)
+    {
+        case FFX_RESOURCE_TYPE_BUFFER:    return FFX_API_RESOURCE_TYPE_BUFFER;
+        case FFX_RESOURCE_TYPE_TEXTURE1D: return FFX_API_RESOURCE_TYPE_TEXTURE1D;
+        case FFX_RESOURCE_TYPE_TEXTURE2D: return FFX_API_RESOURCE_TYPE_TEXTURE2D;
+        case FFX_RESOURCE_TYPE_TEXTURE3D: return FFX_API_RESOURCE_TYPE_TEXTURE3D;
+        default:
+            WARN("Unknown FfxResourceType %u, assuming TEXTURE2D\n", fsr2_type);
+            return FFX_API_RESOURCE_TYPE_TEXTURE2D;
+    }
+}
+
+static uint32_t translate_resource_state(uint32_t fsr2_state)
+{
+    uint32_t out = 0;
+
+    if (fsr2_state & FFX_RESOURCE_STATE_UNORDERED_ACCESS) out |= FFX_API_RESOURCE_STATE_UNORDERED_ACCESS;
+    if (fsr2_state & FFX_RESOURCE_STATE_COMPUTE_READ)     out |= FFX_API_RESOURCE_STATE_COMPUTE_READ;
+    if (fsr2_state & FFX_RESOURCE_STATE_COPY_SRC)         out |= FFX_API_RESOURCE_STATE_COPY_SRC;
+    if (fsr2_state & FFX_RESOURCE_STATE_COPY_DEST)        out |= FFX_API_RESOURCE_STATE_COPY_DEST;
+    if (!out) out = FFX_API_RESOURCE_STATE_COMMON;
+    return out;
+}
+
+/* FfxSurfaceFormat and FfxApiSurfaceFormat share the same enumerator ordering
+ * for every value either SDK actually uses for FSR2/FSR4 resources, so the
+ * numeric value is passed straight through. */
+static FfxApiResource translate_resource(const FfxResource *in)
+{
+    FfxApiResource out = {0};
+
+    out.resource = in->resource;
+    out.state = translate_resource_state(in->state);
+    if (!in->resource) return out;
+
+    out.description.type = translate_resource_type(in->description.type);
+    out.description.format = in->description.format;
+    out.description.width = in->description.width;
+    out.description.height = in->description.height;
+    out.description.depth = in->description.depth;
+    out.description.mipCount = in->description.mipCount;
+    out.description.flags = in->description.flags;
+    /* FfxResourceDescription (FSR2) has no usage field; FSR4's backend
+     * derives usage requirements from context/dispatch state rather than
+     * from imported resource descriptions, so 0 (no extra usage hints) is
+     * the correct conservative default here. */
+    out.description.usage = 0;
+    return out;
+}
+
+static uint32_t translate_context_flags(uint32_t fsr2_flags)
+{
+    uint32_t out = 0;
+
+    if (fsr2_flags & FFX_FSR2_ENABLE_HIGH_DYNAMIC_RANGE) out |= FFX_UPSCALE_ENABLE_HIGH_DYNAMIC_RANGE;
+    if (fsr2_flags & FFX_FSR2_ENABLE_DISPLAY_RESOLUTION_MOTION_VECTORS) out |= FFX_UPSCALE_ENABLE_DISPLAY_RESOLUTION_MOTION_VECTORS;
+    if (fsr2_flags & FFX_FSR2_ENABLE_MOTION_VECTORS_JITTER_CANCELLATION) out |= FFX_UPSCALE_ENABLE_MOTION_VECTORS_JITTER_CANCELLATION;
+    if (fsr2_flags & FFX_FSR2_ENABLE_DEPTH_INVERTED) out |= FFX_UPSCALE_ENABLE_DEPTH_INVERTED;
+    if (fsr2_flags & FFX_FSR2_ENABLE_DEPTH_INFINITE) out |= FFX_UPSCALE_ENABLE_DEPTH_INFINITE;
+    if (fsr2_flags & FFX_FSR2_ENABLE_AUTO_EXPOSURE) out |= FFX_UPSCALE_ENABLE_AUTO_EXPOSURE;
+    if (fsr2_flags & FFX_FSR2_ENABLE_DYNAMIC_RESOLUTION) out |= FFX_UPSCALE_ENABLE_DYNAMIC_RESOLUTION;
+    /* FFX_FSR2_ENABLE_TEXTURE1D_USAGE has no FSR4 equivalent (deprecated upstream too) */
+    if (fsr2_flags & FFX_FSR2_ENABLE_DEBUG_CHECKING) out |= FFX_UPSCALE_ENABLE_DEBUG_CHECKING;
+    return out;
+}
+
+/* ---- internal context ---- */
+
+struct fsr2_shim_context
+{
+    struct ffxExternalProvider provider;
+    ffxContext ffx_context;
+    FfxDimensions2D display_size;
+    BOOL valid;
+};
+
+typedef char fsr2_shim_context_size_check[(sizeof(struct fsr2_shim_context) <= sizeof(FfxFsr2Context)) ? 1 : -1];
+
+static struct fsr2_shim_context *get_shim_context(FfxFsr2Context *context)
+{
+    return (struct fsr2_shim_context *)context->data;
+}
+
+/* ---- exported FSR2 context API ---- */
+
+FfxErrorCode CDECL ffxFsr2ContextCreate(FfxFsr2Context *context, const FfxFsr2ContextDescription *desc)
+{
+    struct fsr2_shim_context *ctx;
+    struct ffxCreateBackendDX12Desc backend = {0};
+    struct ffxCreateContextDescUpscale upscale = {0};
+    BOOL fp8 = FALSE;
+    ffxReturnCode_t rc;
+
+    if (!context || !desc) return FFX_ERROR_INVALID_POINTER;
+    if (!desc->device) return FFX_ERROR_NULL_DEVICE;
+
+    memset(context, 0, sizeof(*context));
+    ctx = get_shim_context(context);
+
+    if (!check_fsr4_supported(desc->device, &fp8, NULL) || !fp8)
+    {
+        WARN("FSR4 (FP8/WMMA) not supported on this device; PROTON_FSR2_UPGRADE will have no effect here.\n");
+        return FFX_ERROR_BACKEND_API_ERROR;
+    }
+
+    if (!get_fsr4_provider(&ctx->provider, fp8))
+        return FFX_ERROR_BACKEND_API_ERROR;
+
+    backend.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_DX12;
+    backend.device = desc->device;
+
+    upscale.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE;
+    upscale.header.pNext = &backend.header;
+    upscale.flags = translate_context_flags(desc->flags);
+    upscale.maxRenderSize.width = desc->maxRenderSize.width;
+    upscale.maxRenderSize.height = desc->maxRenderSize.height;
+    upscale.maxUpscaleSize.width = desc->displaySize.width;
+    upscale.maxUpscaleSize.height = desc->displaySize.height;
+    upscale.fpMessage = (ffxApiMessage)desc->fpMessage;
+
+    rc = ctx->provider.createContext(&ctx->ffx_context, &upscale, NULL);
+    if (rc != FFX_API_RETURN_OK)
+    {
+        ERR("FSR4 createContext failed: %u\n", rc);
+        return FFX_ERROR_BACKEND_API_ERROR;
+    }
+
+    ctx->display_size = desc->displaySize;
+    ctx->valid = TRUE;
+
+    WARN("FSR2 upgraded to FSR4 (%s)\n", debugstr_a(ctx->provider.versionName));
+    return FFX_OK;
+}
+
+FfxErrorCode CDECL ffxFsr2ContextDestroy(FfxFsr2Context *context)
+{
+    struct fsr2_shim_context *ctx;
+
+    if (!context) return FFX_ERROR_INVALID_POINTER;
+    ctx = get_shim_context(context);
+    if (!ctx->valid) return FFX_OK;
+
+    ctx->provider.destroyContext(&ctx->ffx_context, NULL);
+    ctx->valid = FALSE;
+    return FFX_OK;
+}
+
+FfxErrorCode CDECL ffxFsr2ContextDispatch(FfxFsr2Context *context, const FfxFsr2DispatchDescription *desc)
+{
+    struct fsr2_shim_context *ctx;
+    struct ffxDispatchDescUpscale dispatch = {0};
+    ffxReturnCode_t rc;
+    float vsm;
+
+    if (!context || !desc) return FFX_ERROR_INVALID_POINTER;
+    ctx = get_shim_context(context);
+    if (!ctx->valid) return FFX_ERROR_BACKEND_API_ERROR;
+
+    dispatch.header.type = FFX_API_DISPATCH_DESC_TYPE_UPSCALE;
+    dispatch.commandList = desc->commandList;
+    dispatch.color = translate_resource(&desc->color);
+    dispatch.depth = translate_resource(&desc->depth);
+    dispatch.motionVectors = translate_resource(&desc->motionVectors);
+    dispatch.exposure = translate_resource(&desc->exposure);
+    dispatch.reactive = translate_resource(&desc->reactive);
+    dispatch.transparencyAndComposition = translate_resource(&desc->transparencyAndComposition);
+    dispatch.output = translate_resource(&desc->output);
+    dispatch.jitterOffset.x = desc->jitterOffset.x;
+    dispatch.jitterOffset.y = desc->jitterOffset.y;
+    dispatch.motionVectorScale.x = desc->motionVectorScale.x;
+    dispatch.motionVectorScale.y = desc->motionVectorScale.y;
+    dispatch.renderSize.width = desc->renderSize.width;
+    dispatch.renderSize.height = desc->renderSize.height;
+    dispatch.upscaleSize.width = ctx->display_size.width;
+    dispatch.upscaleSize.height = ctx->display_size.height;
+    dispatch.enableSharpening = desc->enableSharpening;
+    dispatch.sharpness = desc->sharpness;
+    dispatch.frameTimeDelta = desc->frameTimeDelta;
+    dispatch.preExposure = desc->preExposure > 0.0f ? desc->preExposure : 1.0f;
+    dispatch.reset = desc->reset;
+    dispatch.cameraNear = desc->cameraNear;
+    dispatch.cameraFar = desc->cameraFar;
+    dispatch.cameraFovAngleVertical = desc->cameraFovAngleVertical;
+
+    /* viewSpaceToMetersFactor was added to FfxFsr2DispatchDescription after
+     * some 2.x releases; clamp defensively in case the game's struct layout
+     * predates the field (would otherwise read uninitialized/adjacent data).
+     * The range comparisons below also reject NaN and +/-inf without
+     * needing isfinite(). */
+    vsm = desc->viewSpaceToMetersFactor;
+    dispatch.viewSpaceToMetersFactor = (vsm > 1e-6f && vsm < 1e6f) ? vsm : 1.0f;
+
+    rc = ctx->provider.dispatch(&ctx->ffx_context, &dispatch);
+    if (rc != FFX_API_RETURN_OK)
+    {
+        ERR("FSR4 dispatch failed: %u\n", rc);
+        return FFX_ERROR_BACKEND_API_ERROR;
+    }
+    return FFX_OK;
+}
+
+FfxErrorCode CDECL ffxFsr2ContextGenerateReactiveMask(FfxFsr2Context *context, const FfxFsr2GenerateReactiveDescription *params)
+{
+    struct fsr2_shim_context *ctx;
+    struct ffxDispatchDescUpscaleGenerateReactiveMask dispatch = {0};
+    ffxReturnCode_t rc;
+
+    if (!context || !params) return FFX_ERROR_INVALID_POINTER;
+    ctx = get_shim_context(context);
+    if (!ctx->valid) return FFX_ERROR_BACKEND_API_ERROR;
+
+    dispatch.header.type = FFX_API_DISPATCH_DESC_TYPE_UPSCALE_GENERATEREACTIVEMASK;
+    dispatch.commandList = params->commandList;
+    dispatch.colorOpaqueOnly = translate_resource(&params->colorOpaqueOnly);
+    dispatch.colorPreUpscale = translate_resource(&params->colorPreUpscale);
+    dispatch.outReactive = translate_resource(&params->outReactive);
+    dispatch.renderSize.width = params->renderSize.width;
+    dispatch.renderSize.height = params->renderSize.height;
+    dispatch.scale = params->scale;
+    dispatch.cutoffThreshold = params->cutoffThreshold;
+    dispatch.binaryValue = params->binaryValue;
+    dispatch.flags = params->flags;
+
+    rc = ctx->provider.dispatch(&ctx->ffx_context, &dispatch);
+    return (rc == FFX_API_RETURN_OK) ? FFX_OK : FFX_ERROR_BACKEND_API_ERROR;
+}
+
+/* ---- pure helper exports (no FSR4 involvement, public FSR2 SDK formulas) ---- */
+
+float CDECL ffxFsr2GetUpscaleRatioFromQualityMode(FfxFsr2QualityMode qualityMode)
+{
+    switch (qualityMode)
+    {
+        case FFX_FSR2_QUALITY_MODE_QUALITY: return 1.5f;
+        case FFX_FSR2_QUALITY_MODE_BALANCED: return 1.7f;
+        case FFX_FSR2_QUALITY_MODE_PERFORMANCE: return 2.0f;
+        case FFX_FSR2_QUALITY_MODE_ULTRA_PERFORMANCE: return 3.0f;
+        default: return 0.0f;
+    }
+}
+
+FfxErrorCode CDECL ffxFsr2GetRenderResolutionFromQualityMode(uint32_t *renderWidth, uint32_t *renderHeight,
+        uint32_t displayWidth, uint32_t displayHeight, FfxFsr2QualityMode qualityMode)
+{
+    float ratio;
+
+    if (!renderWidth || !renderHeight) return FFX_ERROR_INVALID_POINTER;
+    if (qualityMode < FFX_FSR2_QUALITY_MODE_QUALITY || qualityMode > FFX_FSR2_QUALITY_MODE_ULTRA_PERFORMANCE)
+        return FFX_ERROR_INVALID_ENUM;
+
+    ratio = ffxFsr2GetUpscaleRatioFromQualityMode(qualityMode);
+    *renderWidth = (uint32_t)((float)displayWidth / ratio);
+    *renderHeight = (uint32_t)((float)displayHeight / ratio);
+    return FFX_OK;
+}
+
+int32_t CDECL ffxFsr2GetJitterPhaseCount(int32_t renderWidth, int32_t displayWidth)
+{
+    const float basePhaseCount = 8.0f;
+    const float ratio = (float)displayWidth / (float)renderWidth;
+    return (int32_t)(basePhaseCount * ratio * ratio);
+}
+
+static float halton(int32_t index, int32_t base)
+{
+    float f = 1.0f, r = 0.0f;
+
+    while (index > 0)
+    {
+        f /= base;
+        r += f * (index % base);
+        index /= base;
+    }
+    return r;
+}
+
+FfxErrorCode CDECL ffxFsr2GetJitterOffset(float *outX, float *outY, int32_t index, int32_t phaseCount)
+{
+    if (!outX || !outY) return FFX_ERROR_INVALID_POINTER;
+    if (phaseCount <= 0) return FFX_ERROR_INVALID_ARGUMENT;
+
+    *outX = halton((index % phaseCount) + 1, 2) - 0.5f;
+    *outY = halton((index % phaseCount) + 1, 3) - 0.5f;
+    return FFX_OK;
+}
+
+int CDECL ffxFsr2ResourceIsNull(FfxResource resource)
+{
+    return resource.resource == NULL;
+}
+
+/* ---- assert plumbing (mirrors ffx_assert.h; never breaks into a debugger) ---- */
+
+static void (CDECL *assert_callback)(const char *);
+
+int CDECL ffxAssertReport(const char *file, int32_t line, const char *condition, const char *msg)
+{
+    ERR("FSR2 shim assertion failed: %s:%d %s%s%s\n", debugstr_a(file), line,
+        condition ? debugstr_a(condition) : "", condition && msg ? ": " : "", msg ? debugstr_a(msg) : "");
+    if (assert_callback) assert_callback(msg ? msg : condition);
+    return 0; /* never request a debug break */
+}
+
+void CDECL ffxAssertSetPrintingCallback(void (CDECL *callback)(const char *))
+{
+    assert_callback = callback;
+}
+
+BOOL WINAPI DllMain(HINSTANCE inst, DWORD reason, void *reserved)
+{
+    return TRUE;
+}
