+#ifndef __FFX_FSR2_API_H
+#define __FFX_FSR2_API_H
+
+#include <stdint.h>
+
+/* ---- FSR2 SDK types (ffx_types.h / ffx_fsr2.h) ---- */
+
+typedef int32_t FfxErrorCode;
+
+#define FFX_OK                          0
+#define FFX_ERROR_INVALID_POINTER       0x80000000u
+#define FFX_ERROR_INVALID_SIZE          0x80000002u
+#define FFX_ERROR_INCOMPLETE_INTERFACE  0x80000008u
+#define FFX_ERROR_INVALID_ENUM         0x80000009u
+#define FFX_ERROR_INVALID_ARGUMENT      0x8000000au
+#define FFX_ERROR_OUT_OF_RANGE          0x8000000bu
+#define FFX_ERROR_NULL_DEVICE           0x8000000cu
+#define FFX_ERROR_BACKEND_API_ERROR     0x8000000du
+
+typedef void *FfxDevice;
+typedef void *FfxCommandList;
+
+typedef struct FfxDimensions2D
+{
+    uint32_t width;
+    uint32_t height;
+} FfxDimensions2D;
+
+typedef struct FfxFloatCoords2D
+{
+    float x;
+    float y;
+} FfxFloatCoords2D;
+
+/* FfxResourceType: BUFFER=0, TEXTURE1D=1, TEXTURE2D=2, TEXTURE3D=3.
+ * Note: unlike the ffx_api version there is no TEXTURE_CUBE entry. */
+enum FfxResourceType
+{
+    FFX_RESOURCE_TYPE_BUFFER = 0,
+    FFX_RESOURCE_TYPE_TEXTURE1D = 1,
+    FFX_RESOURCE_TYPE_TEXTURE2D = 2,
+    FFX_RESOURCE_TYPE_TEXTURE3D = 3,
+};
+
+/* FfxResourceStates: bit flags, distinct numbering from FfxApiResourceState. */
+enum FfxResourceStates
+{
+    FFX_RESOURCE_STATE_UNORDERED_ACCESS = (1 << 0),
+    FFX_RESOURCE_STATE_COMPUTE_READ = (1 << 1),
+    FFX_RESOURCE_STATE_COPY_SRC = (1 << 2),
+    FFX_RESOURCE_STATE_COPY_DEST = (1 << 3),
+    FFX_RESOURCE_STATE_GENERIC_READ = (FFX_RESOURCE_STATE_COPY_SRC | FFX_RESOURCE_STATE_COMPUTE_READ),
+};
+
+typedef struct FfxResourceDescription
+{
+    uint32_t type;      /* enum FfxResourceType */
+    uint32_t format;    /* enum FfxSurfaceFormat, numerically identical to FfxApiSurfaceFormat */
+    uint32_t width;
+    uint32_t height;
+    uint32_t depth;
+    uint32_t mipCount;
+    uint32_t flags;
+} FfxResourceDescription;
+
+typedef struct FfxResource
+{
+    void *resource;
+    uint16_t name[64];
+    FfxResourceDescription description;
+    uint32_t state;    /* enum FfxResourceStates */
+    int isDepth;
+    uint64_t descriptorData;
+} FfxResource;
+
+typedef enum FfxFsr2QualityMode
+{
+    FFX_FSR2_QUALITY_MODE_QUALITY = 1,
+    FFX_FSR2_QUALITY_MODE_BALANCED = 2,
+    FFX_FSR2_QUALITY_MODE_PERFORMANCE = 3,
+    FFX_FSR2_QUALITY_MODE_ULTRA_PERFORMANCE = 4,
+} FfxFsr2QualityMode;
+
+typedef enum FfxFsr2InitializationFlagBits
+{
+    FFX_FSR2_ENABLE_HIGH_DYNAMIC_RANGE = (1 << 0),
+    FFX_FSR2_ENABLE_DISPLAY_RESOLUTION_MOTION_VECTORS = (1 << 1),
+    FFX_FSR2_ENABLE_MOTION_VECTORS_JITTER_CANCELLATION = (1 << 2),
+    FFX_FSR2_ENABLE_DEPTH_INVERTED = (1 << 3),
+    FFX_FSR2_ENABLE_DEPTH_INFINITE = (1 << 4),
+    FFX_FSR2_ENABLE_AUTO_EXPOSURE = (1 << 5),
+    FFX_FSR2_ENABLE_DYNAMIC_RESOLUTION = (1 << 6),
+    FFX_FSR2_ENABLE_TEXTURE1D_USAGE = (1 << 7),
+    FFX_FSR2_ENABLE_DEBUG_CHECKING = (1 << 8),
+} FfxFsr2InitializationFlagBits;
+
+/* Opaque interface/message types: the real frontend fills `callbacks` itself
+ * from a backend dll; we never dereference it. */
+typedef struct FfxFsr2Interface { uint8_t opaque[128]; } FfxFsr2Interface;
+typedef void (*FfxFsr2Message)(uint32_t type, const wchar_t *message);
+
+typedef struct FfxFsr2ContextDescription
+{
+    uint32_t flags;
+    FfxDimensions2D maxRenderSize;
+    FfxDimensions2D displaySize;
+    FfxFsr2Interface callbacks;
+    FfxDevice device;
+    FfxFsr2Message fpMessage;
+} FfxFsr2ContextDescription;
+
+typedef struct FfxFsr2DispatchDescription
+{
+    FfxCommandList commandList;
+    FfxResource color;
+    FfxResource depth;
+    FfxResource motionVectors;
+    FfxResource exposure;
+    FfxResource reactive;
+    FfxResource transparencyAndComposition;
+    FfxResource output;
+    FfxFloatCoords2D jitterOffset;
+    FfxFloatCoords2D motionVectorScale;
+    FfxDimensions2D renderSize;
+    int enableSharpening;
+    float sharpness;
+    float frameTimeDelta;
+    float preExposure;
+    int reset;
+    float cameraNear;
+    float cameraFar;
+    float cameraFovAngleVertical;
+    float viewSpaceToMetersFactor;
+
+    /* EXPERIMENTAL reactive mask generation parameters (2.2+, may not be
+     * initialized by older games; we never read past preExposure/camera
+     * fields except viewSpaceToMetersFactor, which we clamp defensively). */
+    int enableAutoReactive;
+    FfxResource colorOpaqueOnly;
+    float autoTcThreshold;
+    float autoTcScale;
+    float autoReactiveScale;
+    float autoReactiveMax;
+} FfxFsr2DispatchDescription;
+
+typedef struct FfxFsr2GenerateReactiveDescription
+{
+    FfxCommandList commandList;
+    FfxResource colorOpaqueOnly;
+    FfxResource colorPreUpscale;
+    FfxResource outReactive;
+    FfxDimensions2D renderSize;
+    float scale;
+    float cutoffThreshold;
+    float binaryValue;
+    uint32_t flags;
+} FfxFsr2GenerateReactiveDescription;
+
+#define FFX_FSR2_CONTEXT_SIZE 16536
+
+typedef struct FfxFsr2Context
+{
+    uint32_t data[FFX_FSR2_CONTEXT_SIZE];
+} FfxFsr2Context;
+
+/* ---- ffx_api generic (Kits/FidelityFX/api/include/ffx_api.h, ffx_api_types.h) ---- */
+
+typedef void *ffxContext;
+typedef uint32_t ffxReturnCode_t;
+
+enum FfxApiReturnCodes
+{
+    FFX_API_RETURN_OK = 0,
+    FFX_API_RETURN_ERROR = 1,
+    FFX_API_RETURN_ERROR_UNKNOWN_DESCTYPE = 2,
+    FFX_API_RETURN_ERROR_RUNTIME_ERROR = 3,
+    FFX_API_RETURN_NO_PROVIDER = 4,
+    FFX_API_RETURN_ERROR_MEMORY = 5,
+    FFX_API_RETURN_ERROR_PARAMETER = 6,
+};
+
+#define FFX_API_EFFECT_MASK 0x00ff0000u
+#define FFX_API_BACKEND_MASK 0xff000000u
+#define FFX_API_EFFECT_ID_UPSCALE 0x00010000u
+#define FFX_API_MAKE_EFFECT_SUB_ID(effectId, sub) (((effectId) & FFX_API_EFFECT_MASK) | ((sub) & ~FFX_API_EFFECT_MASK))
+#define FFX_API_BACKEND_ID_DX12 0x00000000u
+#define FFX_API_MAKE_BACKEND_SUB_ID(backendId, sub) (((backendId) & FFX_API_BACKEND_MASK) | ((sub) & ~FFX_API_BACKEND_MASK))
+
+typedef uint64_t ffxStructType_t;
+typedef struct ffxApiHeader
+{
+    ffxStructType_t type;
+    struct ffxApiHeader *pNext;
+} ffxApiHeader;
+
+typedef ffxApiHeader ffxCreateContextDescHeader;
+typedef ffxApiHeader ffxDispatchDescHeader;
+
+typedef void (*ffxApiMessage)(uint32_t type, const wchar_t *message);
+
+typedef struct FfxApiDimensions2D
+{
+    uint32_t width;
+    uint32_t height;
+} FfxApiDimensions2D;
+
+typedef struct FfxApiFloatCoords2D
+{
+    float x;
+    float y;
+} FfxApiFloatCoords2D;
+
+/* FfxApiResourceType: BUFFER=0, TEXTURE1D=1, TEXTURE2D=2, TEXTURE_CUBE=3, TEXTURE3D=4 */
+enum FfxApiResourceType
+{
+    FFX_API_RESOURCE_TYPE_BUFFER = 0,
+    FFX_API_RESOURCE_TYPE_TEXTURE1D = 1,
+    FFX_API_RESOURCE_TYPE_TEXTURE2D = 2,
+    FFX_API_RESOURCE_TYPE_TEXTURE_CUBE = 3,
+    FFX_API_RESOURCE_TYPE_TEXTURE3D = 4,
+};
+
+enum FfxApiResourceState
+{
+    FFX_API_RESOURCE_STATE_COMMON = (1 << 0),
+    FFX_API_RESOURCE_STATE_UNORDERED_ACCESS = (1 << 1),
+    FFX_API_RESOURCE_STATE_COMPUTE_READ = (1 << 2),
+    FFX_API_RESOURCE_STATE_COPY_SRC = (1 << 4),
+    FFX_API_RESOURCE_STATE_COPY_DEST = (1 << 5),
+    FFX_API_RESOURCE_STATE_GENERIC_READ = (FFX_API_RESOURCE_STATE_COPY_SRC | FFX_API_RESOURCE_STATE_COMPUTE_READ),
+};
+
+typedef struct FfxApiResourceDescription
+{
+    uint32_t type;
+    uint32_t format;
+    uint32_t width;
+    uint32_t height;
+    uint32_t depth;
+    uint32_t mipCount;
+    uint32_t flags;
+    uint32_t usage;
+} FfxApiResourceDescription;
+
+typedef struct FfxApiResource
+{
+    void *resource;
+    FfxApiResourceDescription description;
+    uint32_t state;
+} FfxApiResource;
+
+/* ---- ffx_api DX12 backend (Kits/FidelityFX/api/include/dx12/ffx_api_dx12.h) ---- */
+
+#define FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_DX12 FFX_API_MAKE_BACKEND_SUB_ID(FFX_API_BACKEND_ID_DX12, 0x02)
+struct ffxCreateBackendDX12Desc
+{
+    ffxCreateContextDescHeader header;
+    void *device; /* ID3D12Device* */
+};
+
+/* ---- ffx_api upscale effect (Kits/FidelityFX/upscalers/include/ffx_upscale.h) ---- */
+
+enum FfxApiCreateContextUpscaleFlags
+{
+    FFX_UPSCALE_ENABLE_HIGH_DYNAMIC_RANGE = (1 << 0),
+    FFX_UPSCALE_ENABLE_DISPLAY_RESOLUTION_MOTION_VECTORS = (1 << 1),
+    FFX_UPSCALE_ENABLE_MOTION_VECTORS_JITTER_CANCELLATION = (1 << 2),
+    FFX_UPSCALE_ENABLE_DEPTH_INVERTED = (1 << 3),
+    FFX_UPSCALE_ENABLE_DEPTH_INFINITE = (1 << 4),
+    FFX_UPSCALE_ENABLE_AUTO_EXPOSURE = (1 << 5),
+    FFX_UPSCALE_ENABLE_DYNAMIC_RESOLUTION = (1 << 6),
+    FFX_UPSCALE_ENABLE_DEBUG_CHECKING = (1 << 7),
+};
+
+#define FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE FFX_API_MAKE_EFFECT_SUB_ID(FFX_API_EFFECT_ID_UPSCALE, 0x00)
+struct ffxCreateContextDescUpscale
+{
+    ffxCreateContextDescHeader header;
+    uint32_t flags;
+    FfxApiDimensions2D maxRenderSize;
+    FfxApiDimensions2D maxUpscaleSize;
+    ffxApiMessage fpMessage;
+};
+
+#define FFX_API_DISPATCH_DESC_TYPE_UPSCALE FFX_API_MAKE_EFFECT_SUB_ID(FFX_API_EFFECT_ID_UPSCALE, 0x01)
+struct ffxDispatchDescUpscale
+{
+    ffxDispatchDescHeader header;
+    void *commandList;
+    FfxApiResource color;
+    FfxApiResource depth;
+    FfxApiResource motionVectors;
+    FfxApiResource exposure;
+    FfxApiResource reactive;
+    FfxApiResource transparencyAndComposition;
+    FfxApiResource output;
+    FfxApiFloatCoords2D jitterOffset;
+    FfxApiFloatCoords2D motionVectorScale;
+    FfxApiDimensions2D renderSize;
+    FfxApiDimensions2D upscaleSize;
+    int enableSharpening;
+    float sharpness;
+    float frameTimeDelta;
+    float preExposure;
+    int reset;
+    float cameraNear;
+    float cameraFar;
+    float cameraFovAngleVertical;
+    float viewSpaceToMetersFactor;
+    uint32_t flags;
+};
+
+#define FFX_API_DISPATCH_DESC_TYPE_UPSCALE_GENERATEREACTIVEMASK FFX_API_MAKE_EFFECT_SUB_ID(FFX_API_EFFECT_ID_UPSCALE, 0x06)
+struct ffxDispatchDescUpscaleGenerateReactiveMask
+{
+    ffxDispatchDescHeader header;
+    void *commandList;
+    FfxApiResource colorOpaqueOnly;
+    FfxApiResource colorPreUpscale;
+    FfxApiResource outReactive;
+    FfxApiDimensions2D renderSize;
+    float scale;
+    float cutoffThreshold;
+    float binaryValue;
+    uint32_t flags;
+};
+
+/* ---- external provider ABI (reverse engineered, see dlls/amdxc64/main.c) ---- */
+
+typedef ULONG (*pfnCreateContext)(void *context, void *desc, const void *allocator);
+typedef ULONG (*pfnDestroyContext)(void *context, const void *allocator);
+typedef ULONG (*pfnConfigure)(void *context, const void *desc);
+typedef ULONG (*pfnQuery)(void *context, void *desc);
+typedef ULONG (*pfnDispatch)(void *context, const void *desc);
+typedef ULONG (*pfnCanProvide)(uint64_t typeId);
+
+struct ffxExternalProvider
+{
+    ULONG structVersion;      /* must be 2 for UpdateFfxApiProviderEx */
+    ULONG64 descType;         /* effect id this provider blob advertises, e.g. FFX_API_EFFECT_ID_UPSCALE */
+    ULONG64 versionId;
+    const char *versionName;
+    pfnCanProvide canProvide;
+    pfnCreateContext createContext;
+    pfnDestroyContext destroyContext;
+    pfnConfigure configure;
+    pfnQuery query;
+    pfnDispatch dispatch;
+};
+
+struct unk_data
+{
+    int unk[4];
+    struct unk_data *next;
+};
+
+typedef HRESULT (__stdcall *updateffxapi_pfn)(void *, unsigned int);
+typedef HRESULT (__stdcall *updateffxapi_pfn_ex)(void *, unsigned int, void *);
+
+#endif /* __FFX_FSR2_API_H */
