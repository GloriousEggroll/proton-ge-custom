+/* Source sample of a DualShock 4 stream as 16-bit, mono streams play on both
+ * channels and others use their first two. */
+static INT32 bt_dualshock4_sample(const struct pulse_stream *stream, const BYTE *src, UINT32 frame, UINT32 c)
+{
+    UINT32 index = frame * stream->ss.channels + (stream->ss.channels == 1 ? 0 : c);
+
+    switch (stream->ss.format)
+    {
+    case PA_SAMPLE_FLOAT32LE: return float_to_s16(((const float *)src)[index]);
+    case PA_SAMPLE_S32LE: return ((const int32_t *)src)[index] >> 16;
+    default: return ((const int16_t *)src)[index];
+    }
+}
+
+/* Like pulse_bt_haptic_write(), resampling the stream to the controller's
+ * 32 kHz with linear interpolation. */
+static void pulse_bt_ds4_render(struct pulse_stream *stream, UINT32 held_frames, UINT32 frame_size)
+{
+    struct bt_dualsense_mixer *mixer = stream->hid_mixer;
+    UINT32 contiguous_frames, avail, in = 0, c;
+    UINT64 clock, target;
+    const BYTE *src;
+
+    clock = bt_dualsense_mixer_clock(mixer);
+    bt_dualsense_mixer_skip_stale(mixer, clock);
+    if (!stream->hid_start_time || stream->hid_consumed < mixer->sent)
+    {
+        /* Started, or fell behind: don't send the missed time in a burst. */
+        if (stream->hid_start_time) mixer->stat_rebase++;
+        stream->hid_start_time = 1;
+        stream->hid_consumed = max(mixer->sent, clock + BT_DUALSENSE_MIX_SEND_AHEAD);
+        stream->hid_phase = BT_DUALSHOCK4_RATE;
+        stream->hid_prev[0] = stream->hid_prev[1] = 0;
+    }
+
+    target = min(clock + BT_DUALSENSE_MIX_LEAD, mixer->sent + BT_DUALSENSE_MIX_RING);
+    contiguous_frames = (stream->real_bufsize_bytes - stream->pa_offs_bytes) / frame_size;
+    avail = min(held_frames, contiguous_frames);
+    src = stream->local_buffer + stream->pa_offs_bytes;
+
+    while (stream->hid_consumed < target)
+    {
+        INT32 *frame;
+
+        while (stream->hid_phase >= BT_DUALSHOCK4_RATE && in < avail)
+        {
+            for (c = 0; c < 2; ++c)
+                stream->hid_prev[c] = bt_dualshock4_sample(stream, src, in, c);
+            ++in;
+            stream->hid_phase -= BT_DUALSHOCK4_RATE;
+        }
+        if (in >= avail)
+            break;
+
+        frame = mixer->ring[stream->hid_consumed % BT_DUALSENSE_MIX_RING];
+        for (c = 0; c < 2; ++c)
+        {
+            INT32 next = bt_dualshock4_sample(stream, src, in, c);
+
+            frame[c] += stream->hid_prev[c] +
+                    (INT32)((INT64)(next - stream->hid_prev[c]) * stream->hid_phase / BT_DUALSHOCK4_RATE);
+        }
+        stream->hid_consumed++;
+        stream->hid_phase += stream->ss.rate;
+    }
+    if (in)
+        pulse_haptic_advance(stream, in, frame_size);
+
+    bt_dualsense_mixer_send(mixer, clock);
+}
+
+/* Takes the next capture packet, as pulse_read() does. */
+static BYTE *pulse_bt_capture_packet(struct pulse_stream *stream)
+{
+    LARGE_INTEGER stamp;
+    ACPacket *p, *next;
+
+    if (!(p = (ACPacket *)list_head(&stream->packet_free_head)))
+    {
+        p = (ACPacket *)list_head(&stream->packet_filled_head);
+        if (!p) return NULL;
+        if (!p->discont) {
+            next = (ACPacket *)p->entry.next;
+            next->discont = 1;
+        } else
+            p = (ACPacket *)list_tail(&stream->packet_filled_head);
+    }
+    else
+        stream->held_bytes += stream->period_bytes;
+    NtQueryPerformanceCounter(&stamp, NULL);
+    p->qpcpos = stamp.QuadPart;
+    p->discont = 0;
+    list_remove(&p->entry);
+    list_add_tail(&stream->packet_filled_head, &p->entry);
+    return p->data;
+}
+
+/* Bluetooth DualShock 4 headset microphone capture: there is no device
+ * clock either, so produce packets in real time from the decoded 16 kHz
+ * audio, resampled to the stream rate, with a jitter reserve since the
+ * controller sends it in bursts. */
+static void pulse_bt_ds4_capture(struct pulse_stream *stream)
+{
+    struct bt_dualsense_mixer *mixer = stream->hid_mixer;
+    UINT32 frame_size = pa_frame_size(&stream->ss), period_frames = stream->period_bytes / frame_size;
+    UINT32 rate = stream->ss.rate, i, c, underrun;
+    pa_usec_t now = pa_rtclock_now();
+    UINT64 due;
+    BYTE *dst;
+
+    if (!mixer || !period_frames)
+        return;
+    bt_dualshock4_read_input(mixer);
+    bt_dualshock4_clock_mic(mixer);
+
+    if (!stream->hid_start_time)
+    {
+        stream->hid_start_time = now;
+        stream->hid_consumed = 0;
+        stream->hid_mic_pos = mixer->mic_written;
+        stream->hid_mic_buffering = TRUE;
+        stream->hid_phase = 0;
+    }
+
+    due = (now - stream->hid_start_time) * rate / 1000000;
+    while (due >= stream->hid_consumed + period_frames)
+    {
+        if (!(dst = pulse_bt_capture_packet(stream)))
+            return;
+        underrun = 0;
+        for (i = 0; i < period_frames; ++i)
+        {
+            INT32 value = 0;
+
+            /* Keep the latency bounded after a burst. */
+            if (mixer->mic_written > stream->hid_mic_pos + 3 * BT_DUALSHOCK4_MIC_JITTER)
+            {
+                stream->hid_mic_pos = mixer->mic_written - BT_DUALSHOCK4_MIC_JITTER;
+                stream->hid_phase = 0;
+            }
+            if (stream->hid_mic_buffering && mixer->mic_written >= stream->hid_mic_pos + BT_DUALSHOCK4_MIC_JITTER)
+                stream->hid_mic_buffering = FALSE;
+            if (!stream->hid_mic_buffering && stream->hid_mic_pos + 1 < mixer->mic_written)
+            {
+                INT32 a = mixer->mic_ring[stream->hid_mic_pos % BT_DUALSHOCK4_MIC_RING];
+                INT32 b = mixer->mic_ring[(stream->hid_mic_pos + 1) % BT_DUALSHOCK4_MIC_RING];
+
+                value = a + (INT32)((INT64)(b - a) * stream->hid_phase / rate);
+                stream->hid_phase += BT_DUALSHOCK4_MIC_RATE;
+                while (stream->hid_phase >= rate)
+                {
+                    stream->hid_mic_pos++;
+                    stream->hid_phase -= rate;
+                }
+            }
+            else if (!stream->hid_mic_buffering)
+            {
+                /* Ran dry, refill the jitter reserve. */
+                stream->hid_mic_buffering = TRUE;
+                underrun = 1;
+            }
+
+            for (c = 0; c < stream->ss.channels; ++c)
+            {
+                UINT32 index = i * stream->ss.channels + c;
+
+                switch (stream->ss.format)
+                {
+                case PA_SAMPLE_FLOAT32LE: ((float *)dst)[index] = value / 32768.0f; break;
+                case PA_SAMPLE_S32LE: ((int32_t *)dst)[index] = value * 65536; break;
+                default: ((int16_t *)dst)[index] = value; break;
+                }
+            }
+        }
+        mixer->stat_mic_underruns += underrun;
+        stream->hid_consumed += period_frames;
+    }
+
+    if (TRACE_ON(pulse) && now - mixer->mic_stat_time >= 1000000)
+    {
+        TRACE("Bluetooth DualShock 4 %s: microphone %s, %u frames, %u underruns, %d capture streams.\n",
+                mixer->path, mixer->mic_present ? "present" : "absent", mixer->stat_mic_frames,
+                mixer->stat_mic_underruns, (int)mixer->capture_streams);
+        mixer->stat_mic_frames = mixer->stat_mic_underruns = 0;
+        mixer->mic_stat_time = now;
+    }
+}
