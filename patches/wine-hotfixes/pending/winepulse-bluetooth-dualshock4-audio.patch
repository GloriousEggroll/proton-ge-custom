+static void bt_dualshock4_decode_mic(struct bt_dualsense_mixer *mixer, const BYTE *buf, ssize_t len)
+{
+    int16_t pcm[BT_DUALSHOCK4_MIC_FRAME_SAMPLES];
+    size_t written;
+    ssize_t i;
+    UINT32 j;
+
+    for (i = BT_DUALSHOCK4_MIC_SCAN_OFFSET; i + BT_DUALSHOCK4_MIC_FRAME_SIZE <= len - 4; ++i)
+    {
+        /* Match the whole frame header, a lone sync byte also occurs in the
+         * frame data and would desynchronize the decoder. */
+        if (buf[i] != 0x9c || buf[i + 1] != 0x31 || buf[i + 2] != 0x1d)
+            continue;
+        written = 0;
+        if (p_sbc_decode(mixer->mic_sbc, buf + i, BT_DUALSHOCK4_MIC_FRAME_SIZE, pcm, sizeof(pcm), &written) > 0 &&
+                written == sizeof(pcm))
+        {
+            for (j = 0; j < BT_DUALSHOCK4_MIC_FRAME_SAMPLES; ++j)
+                mixer->mic_ring[(mixer->mic_written + j) % BT_DUALSHOCK4_MIC_RING] = pcm[j];
+            mixer->mic_written += BT_DUALSHOCK4_MIC_FRAME_SAMPLES;
+            mixer->stat_mic_frames++;
+        }
+        i += BT_DUALSHOCK4_MIC_FRAME_SIZE - 1;
+    }
+}
