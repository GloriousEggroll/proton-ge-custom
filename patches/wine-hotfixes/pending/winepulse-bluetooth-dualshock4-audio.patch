+/* Reads the controller's input reports: the headset jack and microphone
+ * state from the status byte, USB byte 30, and microphone audio. */
+static void bt_dualshock4_read_input(struct bt_dualsense_mixer *mixer)
+{
+    BYTE buf[640];
+    ssize_t len;
+
+    while ((len = read(mixer->fd, buf, sizeof(buf))) > 0)
+    {
+        BYTE status;
+
+        if (buf[0] < 0x11 || buf[0] > 0x19 || len < 33)
+            continue;
+        status = buf[32];
+        if (mixer->headphones != !!(status & BT_DUALSHOCK4_STATUS_HEADSET) ||
+                mixer->mic_present != !!(status & BT_DUALSHOCK4_STATUS_MIC))
+        {
+            mixer->headphones = !!(status & BT_DUALSHOCK4_STATUS_HEADSET);
+            mixer->mic_present = !!(status & BT_DUALSHOCK4_STATUS_MIC);
+            TRACE("Bluetooth DualShock 4 %s: headset %s, microphone %s (status %#x).\n", mixer->path,
+                    mixer->headphones ? "plugged" : "unplugged", mixer->mic_present ? "present" : "absent", status);
+        }
+        if (buf[0] != 0x11 && mixer->mic_sbc && mixer->capture_streams)
+            bt_dualshock4_decode_mic(mixer, buf, len);
+    }
+}
+
+/* Output report byte 2: always set bit 5, bit 2 enables the microphone.
+ * winebus sets it the same way, from the same status bit. */
+static BYTE bt_dualshock4_audio_control(struct bt_dualsense_mixer *mixer)
+{
+    return 0x20 | (mixer->mic_present ? 0x04 : 0);
+}
+
+static void bt_dualshock4_write(struct bt_dualsense_mixer *mixer, BYTE *report, SIZE_T size)
+{
+    bt_dualsense_set_crc(report, size);
+    if (write(mixer->fd, report, size) < 0)
+    {
+        if (errno == EAGAIN) mixer->stat_eagain++;
+        else WARN("Bluetooth DualShock 4 write failed: %s\n", strerror(errno));
+    }
+    mixer->output_time = pa_rtclock_now();
+}
+
+/* Speaker, headset and microphone volume: output report #0x11 with only the
+ * volume fields marked valid, so lightbar and rumble state are left alone.
+ * Resent every second while audio plays, games may change it through their
+ * own output reports. */
+static void bt_dualshock4_send_volume(struct bt_dualsense_mixer *mixer)
+{
+    BYTE report[BT_DUALSHOCK4_OUTPUT_REPORT_SIZE] = {0};
+
+    if (mixer->volume_time && pa_rtclock_now() - mixer->volume_time < 1000000)
+        return;
+    report[0] = BT_DUALSHOCK4_OUTPUT_REPORT_ID;
+    report[1] = 0xc0; /* HID, CRC */
+    report[2] = bt_dualshock4_audio_control(mixer);
+    report[3] = 0x10 | 0x20 | 0x40 | 0x80; /* headset left, headset right, microphone, speaker volume */
+    report[21] = report[22] = report[24] = BT_DUALSHOCK4_VOLUME;
+    report[23] = BT_DUALSHOCK4_MIC_VOLUME;
+    bt_dualshock4_write(mixer, report, sizeof(report));
+    mixer->volume_time = pa_rtclock_now();
+}
+
+/* The controller sends one microphone report per output report, so while
+ * the microphone is captured, send a no-op output report whenever 8 ms, one
+ * microphone frame, passed without one. */
+static void bt_dualshock4_clock_mic(struct bt_dualsense_mixer *mixer)
+{
+    BYTE report[BT_DUALSHOCK4_OUTPUT_REPORT_SIZE] = {0};
+    pa_usec_t now = pa_rtclock_now();
+    UINT32 count = 0;
+
+    if (!mixer->mic_present || !mixer->capture_streams)
+        return;
+    bt_dualshock4_send_volume(mixer);
+    if (now - mixer->output_time > 4 * BT_DUALSHOCK4_MIC_INTERVAL_US)
+        mixer->output_time = now - BT_DUALSHOCK4_MIC_INTERVAL_US;
+    while (now - mixer->output_time >= BT_DUALSHOCK4_MIC_INTERVAL_US && count++ < 4)
+    {
+        memset(report, 0, sizeof(report));
+        report[0] = BT_DUALSHOCK4_OUTPUT_REPORT_ID;
+        report[1] = 0xc0;
+        report[2] = bt_dualshock4_audio_control(mixer);
+        bt_dualshock4_write(mixer, report, sizeof(report));
+        mixer->output_time += BT_DUALSHOCK4_MIC_INTERVAL_US;
+    }
+}
+
+static void bt_dualshock4_send_chunk(struct bt_dualsense_mixer *mixer, const int16_t (*pcm)[4])
+{
+    BYTE report[BT_DUALSHOCK4_AUDIO_REPORT_SIZE] = {0};
+    int16_t block[BT_DUALSHOCK4_SBC_FRAME_SAMPLES * 2];
+    BOOL signal = FALSE;
+    ssize_t consumed, written;
+    UINT32 i, f;
+
+    for (i = 0; i < BT_DUALSENSE_SPEAKER_WINDOW_FRAMES; ++i)
+        signal |= pcm[i][0] || pcm[i][1];
+    mixer->stat_signal += signal;
+
+    /* Keep going a little past the last sound so the decoder flushes its
+     * tail, then stop until the game plays audio again. */
+    if (signal)
+        mixer->spk_idle_chunks = 0;
+    else if (mixer->spk_idle_chunks < 16)
+        ++mixer->spk_idle_chunks;
+    if (!mixer->sbc || mixer->spk_idle_chunks >= 16)
+    {
+        mixer->stat_skipped++;
+        return;
+    }
+
+    bt_dualshock4_read_input(mixer);
+    bt_dualshock4_send_volume(mixer);
+
+    report[0] = BT_DUALSHOCK4_AUDIO_REPORT_ID;
+    report[1] = 0x40;
+    report[2] = 0x80 | bt_dualshock4_audio_control(mixer); /* enable audio */
+    report[3] = mixer->sbc_frames;
+    report[4] = mixer->sbc_frames >> 8;
+    report[5] = mixer->headphones ? BT_DUALSHOCK4_AUDIO_TARGET_HEADSET : BT_DUALSHOCK4_AUDIO_TARGET_SPEAKER;
+    for (f = 0; f < BT_DUALSHOCK4_SBC_FRAMES_PER_REPORT; ++f)
+    {
+        for (i = 0; i < BT_DUALSHOCK4_SBC_FRAME_SAMPLES; ++i)
+        {
+            block[i * 2] = pcm[f * BT_DUALSHOCK4_SBC_FRAME_SAMPLES + i][0];
+            block[i * 2 + 1] = pcm[f * BT_DUALSHOCK4_SBC_FRAME_SAMPLES + i][1];
+        }
+        written = 0;
+        consumed = p_sbc_encode(mixer->sbc, block, sizeof(block),
+                report + 6 + f * BT_DUALSHOCK4_SBC_FRAME_SIZE, BT_DUALSHOCK4_SBC_FRAME_SIZE, &written);
+        if (consumed != sizeof(block) || written != BT_DUALSHOCK4_SBC_FRAME_SIZE)
+        {
+            WARN("sbc_encode failed: %d, %d bytes.\n", (int)consumed, (int)written);
+            return;
+        }
+    }
+    mixer->sbc_frames += BT_DUALSHOCK4_SBC_FRAMES_PER_REPORT;
+    mixer->stat_speaker++;
+    bt_dualshock4_write(mixer, report, sizeof(report));
+}
