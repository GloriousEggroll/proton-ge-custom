From: GloriousEggroll <gloriouseggroll@gmail.com>
Subject: [PATCH] HACK: kernelbase, ntdll: List upgraded Streamline plugins the game doesn't ship.

PROTON_STREAMLINE_UPGRADE (WINE_UPSCALER_REPLACE contains "streamline")
redirects the sl.*.dll a game loads to newer copies in
c:\windows\system32\umu\streamline\. The Streamline interposer only
loads the plugins it finds in the game's plugin folder, so newer plugins
the game doesn't ship never load. Streamline 2.7 and later expect
sl.pcl: the 2.14 sl.dlss_g calls a PCL marker function without a null
check, and STAR WARS Jedi: Survivor, which ships Streamline 2.1 without
sl.pcl.dll, crashes with the upgrade.

- kernelbase: when a folder holding sl.interposer.dll is listed with a
  wildcard, list the upgraded sl.*.dll it doesn't have after its own
  entries.
- ntdll: when a missing sl.*.dll is opened in a folder holding
  sl.interposer.dll, open the upgraded copy, so attribute queries and
  the interposer's checks of the listed file see a real file. The
  loader already redirects sl.*.dll by name.

Nothing in the game's folder is changed.

Bug: https://github.com/GloriousEggroll/proton-ge-custom/issues/964
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -58,6 +58,10 @@
     UINT              data_pos;    /* current position in dir data */
     UINT              data_len;    /* length of dir data */
     UINT              data_size;   /* size of data buffer, or 0 when everything has been read */
+    HANDLE            extra_dir;   /* upgraded Streamline directory listed after this one */
+    UNICODE_STRING    extra_mask;  /* search mask for extra_dir */
+    BOOL              extra_first; /* the next extra_dir query is its first */
+    BOOL              in_extra;    /* listing extra_dir */
     BYTE              data[1];     /* directory data */
 } FIND_FIRST_INFO;
 
@@ -1269,6 +1273,87 @@
 /******************************************************************************
  *	FindFirstFileExW   (kernelbase.@)
  */
+/* HACK: PROTON_STREAMLINE_UPGRADE (WINE_UPSCALER_REPLACE contains "streamline")
+ * redirects the sl.*.dll a game loads to newer copies in umu\streamline. The
+ * Streamline interposer only loads the plugins it finds in the game's plugin
+ * folder, so newer plugins the game doesn't ship (sl.pcl.dll before 2.7, which
+ * the newer sl.dlss_g relies on) would never load. List them after the real
+ * entries of a folder that holds sl.interposer.dll; ntdll resolves them to the
+ * upgraded copies. */
+static const WCHAR streamline_dirW[] = L"\\??\\C:\\windows\\system32\\umu\\streamline";
+
+static BOOL streamline_upgrade_enabled(void)
+{
+    static int enabled = -1;
+    WCHAR envW[64];
+
+    if (enabled == -1)
+        enabled = GetEnvironmentVariableW( L"WINE_UPSCALER_REPLACE", envW, ARRAY_SIZE(envW) ) &&
+                  wcsstr( envW, L"streamline" );
+    return enabled;
+}
+
+static BOOL nt_dir_has_file( const UNICODE_STRING *dir, const WCHAR *file, ULONG file_len )
+{
+    FILE_BASIC_INFORMATION basic;
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING name;
+    NTSTATUS status;
+    ULONG dir_len = dir->Length / sizeof(WCHAR);
+
+    name.Length = (dir_len + 1 + file_len) * sizeof(WCHAR);
+    name.MaximumLength = name.Length + sizeof(WCHAR);
+    if (!(name.Buffer = HeapAlloc( GetProcessHeap(), 0, name.MaximumLength ))) return FALSE;
+    memcpy( name.Buffer, dir->Buffer, dir->Length );
+    if (dir_len && name.Buffer[dir_len - 1] == '\\') name.Length -= sizeof(WCHAR);
+    else name.Buffer[dir_len++] = '\\';
+    memcpy( name.Buffer + dir_len, file, file_len * sizeof(WCHAR) );
+    name.Buffer[name.Length / sizeof(WCHAR)] = 0;
+
+    InitializeObjectAttributes( &attr, &name, OBJ_CASE_INSENSITIVE, 0, NULL );
+    status = NtQueryAttributesFile( &attr, &basic );
+    HeapFree( GetProcessHeap(), 0, name.Buffer );
+    return !status;
+}
+
+static BOOL is_streamline_plugin_name( const WCHAR *name, ULONG len )
+{
+    return len > 7 && !wcsnicmp( name, L"sl.", 3 ) && !wcsnicmp( name + len - 4, L".dll", 4 );
+}
+
+static void init_streamline_extra_dir( FIND_FIRST_INFO *info, const WCHAR *mask )
+{
+    UNICODE_STRING dir;
+    OBJECT_ATTRIBUTES attr;
+    IO_STATUS_BLOCK io;
+    ULONG len = info->path.Length / sizeof(WCHAR);
+
+    if (!streamline_upgrade_enabled()) return;
+    if (!nt_dir_has_file( &info->path, L"sl.interposer.dll", 17 )) return;
+
+    /* not when listing the upgraded copy itself */
+    while (len && info->path.Buffer[len - 1] == '\\') len--;
+    if (len == wcslen( streamline_dirW ) && !wcsnicmp( info->path.Buffer, streamline_dirW, len )) return;
+
+    RtlInitUnicodeString( &dir, streamline_dirW );
+    InitializeObjectAttributes( &attr, &dir, OBJ_CASE_INSENSITIVE, 0, NULL );
+    if (NtOpenFile( &info->extra_dir, FILE_LIST_DIRECTORY | SYNCHRONIZE, &attr, &io,
+                    FILE_SHARE_READ | FILE_SHARE_WRITE,
+                    FILE_DIRECTORY_FILE | FILE_SYNCHRONOUS_IO_NONALERT | FILE_OPEN_FOR_BACKUP_INTENT ))
+    {
+        info->extra_dir = 0;
+        return;
+    }
+    if (!RtlCreateUnicodeString( &info->extra_mask, mask ))
+    {
+        CloseHandle( info->extra_dir );
+        info->extra_dir = 0;
+        return;
+    }
+    TRACE( "HACK: listing upgraded Streamline plugins after %s\n",
+           debugstr_wn( info->path.Buffer, info->path.Length / sizeof(WCHAR) ));
+}
+
 HANDLE WINAPI DECLSPEC_HOTPATCH FindFirstFileExW( LPCWSTR filename, FINDEX_INFO_LEVELS level,
                                                   LPVOID data, FINDEX_SEARCH_OPS search_op,
                                                   LPVOID filter, DWORD flags )
@@ -1355,6 +1440,9 @@
         SetLastError( ERROR_NOT_ENOUGH_MEMORY );
         goto error;
     }
+    info->extra_dir = 0;
+    memset( &info->extra_mask, 0, sizeof(info->extra_mask) );
+    info->extra_first = info->in_extra = FALSE;
 
     /* check if path is the root of the drive, skipping the \??\ prefix */
     info->is_root = FALSE;
@@ -1407,6 +1495,7 @@
         else
         {
             RtlInitUnicodeString( &mask_str, fixedup_mask );
+            if (has_wildcard) init_streamline_extra_dir( info, fixedup_mask );
             status = NtQueryDirectoryFile( info->handle, 0, NULL, NULL, &io, info->data, info->data_size,
                                            FileBothDirectoryInformation, FALSE, &mask_str, TRUE );
         }
@@ -1541,12 +1630,30 @@
         {
             IO_STATUS_BLOCK io;
 
-            if (info->data_size)
+            if (info->extra_first)
+            {
+                info->extra_first = FALSE;
+                status = NtQueryDirectoryFile( info->handle, 0, NULL, NULL, &io, info->data, info->data_size,
+                                               FileBothDirectoryInformation, FALSE, &info->extra_mask, TRUE );
+                if (status == STATUS_NO_SUCH_FILE) status = STATUS_NO_MORE_FILES;
+            }
+            else if (info->data_size)
                 status = NtQueryDirectoryFile( info->handle, 0, NULL, NULL, &io, info->data, info->data_size,
                                                FileBothDirectoryInformation, FALSE, NULL, FALSE );
             else
                 status = STATUS_NO_MORE_FILES;
 
+            if (status == STATUS_NO_MORE_FILES && info->extra_dir)
+            {
+                /* the real entries are done, continue with the upgraded Streamline plugins */
+                CloseHandle( info->handle );
+                info->handle = info->extra_dir;
+                info->extra_dir = 0;
+                info->in_extra = info->extra_first = TRUE;
+                info->data_pos = info->data_len = 0;
+                continue;
+            }
+
             if (!set_ntstatus( status ))
             {
                 if (status == STATUS_NO_MORE_FILES)
@@ -1565,6 +1672,13 @@
         if (dir_info->NextEntryOffset) info->data_pos += dir_info->NextEntryOffset;
         else info->data_pos = info->data_len;
 
+        /* only upgraded plugins the listed folder doesn't have */
+        if (info->in_extra &&
+            (!is_streamline_plugin_name( dir_info->FileName, dir_info->FileNameLength / sizeof(WCHAR) ) ||
+             (dir_info->FileAttributes & FILE_ATTRIBUTE_DIRECTORY) ||
+             nt_dir_has_file( &info->path, dir_info->FileName, dir_info->FileNameLength / sizeof(WCHAR) )))
+            continue;
+
         /* don't return '.' and '..' in the root of the drive */
         if (info->is_root)
         {
@@ -1645,6 +1759,9 @@
                 info->magic = 0;
                 if (info->handle) CloseHandle( info->handle );
                 info->handle = 0;
+                if (info->extra_dir) CloseHandle( info->extra_dir );
+                info->extra_dir = 0;
+                RtlFreeUnicodeString( &info->extra_mask );
                 RtlFreeUnicodeString( &info->path );
                 info->data_pos = 0;
                 info->data_len = 0;
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -3216,6 +3216,101 @@
     return TRUE;
 }
 
+/* HACK: PROTON_STREAMLINE_UPGRADE (WINE_UPSCALER_REPLACE contains "streamline").
+ * kernelbase lists upgraded Streamline plugins the game's plugin folder doesn't
+ * ship, such as sl.pcl.dll. When such a missing sl.*.dll is opened from a folder
+ * that holds sl.interposer.dll, open the upgraded copy instead, so the
+ * interposer's checks and the loader see a real file. */
+static BOOL streamline_upgrade_enabled(void)
+{
+    static int enabled = -1;
+    const char *env;
+
+    if (enabled == -1) enabled = (env = getenv( "WINE_UPSCALER_REPLACE" )) && strstr( env, "streamline" );
+    return enabled;
+}
+
+NTSTATUS nt_to_unix_file_name( OBJECT_ATTRIBUTES *attr, UNICODE_STRING *nt_name,
+                               char **name_ret, UINT disposition, BOOL open_reparse );
+
+static BOOL nt_path_exists( const WCHAR *path, USHORT len )
+{
+    UNICODE_STRING name = { len, len, (WCHAR *)path }, nt_tmp = { 0 };
+    OBJECT_ATTRIBUTES attr;
+    char *unix_name = NULL;
+    NTSTATUS status;
+
+    InitializeObjectAttributes( &attr, &name, OBJ_CASE_INSENSITIVE, 0, NULL );
+    status = nt_to_unix_file_name( &attr, &nt_tmp, &unix_name, FILE_OPEN, FALSE );
+    free( unix_name );
+    free( nt_tmp.Buffer );
+    return !status;
+}
+
+static BOOL ascii_wcsnicmp( const WCHAR *str, const char *ascii, size_t len )
+{
+    size_t i;
+
+    for (i = 0; i < len; i++)
+    {
+        WCHAR c = str[i] >= 'A' && str[i] <= 'Z' ? str[i] + 'a' - 'A' : str[i];
+        if (c != (unsigned char)ascii[i]) return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL replace_streamline_path( OBJECT_ATTRIBUTES *attr, UNICODE_STRING *redir )
+{
+    static const char streamline_dir[] = "\\??\\c:\\windows\\system32\\umu\\streamline\\";
+    static const char interposer[] = "sl.interposer.dll";
+    const size_t dir_len = sizeof(streamline_dir) - 1, interposer_len = sizeof(interposer) - 1;
+    UNICODE_STRING *path = attr->ObjectName;
+    const WCHAR *base;
+    size_t len, base_len, prefix_len, i;
+    WCHAR *buffer;
+
+    if (attr->RootDirectory || !path || !path->Buffer || !streamline_upgrade_enabled()) return FALSE;
+    len = path->Length / sizeof(WCHAR);
+    if (len < 4 || ascii_wcsnicmp( path->Buffer, "\\??\\", 4 )) return FALSE;
+
+    for (base = path->Buffer + len; base > path->Buffer && base[-1] != '\\'; base--) ;
+    base_len = path->Buffer + len - base;
+    prefix_len = base - path->Buffer;
+    if (base_len <= 7 || ascii_wcsnicmp( base, "sl.", 3 ) || ascii_wcsnicmp( base + base_len - 4, ".dll", 4 ))
+        return FALSE;
+    if (base_len == interposer_len && !ascii_wcsnicmp( base, interposer, interposer_len )) return FALSE;
+    if (prefix_len == dir_len && !ascii_wcsnicmp( path->Buffer, streamline_dir, dir_len )) return FALSE;
+    if (nt_path_exists( path->Buffer, path->Length )) return FALSE;
+
+    if (!(buffer = malloc( (max( prefix_len + interposer_len, dir_len + base_len ) + 1) * sizeof(WCHAR) )))
+        return FALSE;
+
+    /* only for folders with the game's Streamline */
+    memcpy( buffer, path->Buffer, prefix_len * sizeof(WCHAR) );
+    for (i = 0; i < interposer_len; i++) buffer[prefix_len + i] = interposer[i];
+    if (!nt_path_exists( buffer, (prefix_len + interposer_len) * sizeof(WCHAR) ))
+    {
+        free( buffer );
+        return FALSE;
+    }
+
+    for (i = 0; i < dir_len; i++) buffer[i] = streamline_dir[i];
+    memcpy( buffer + dir_len, base, base_len * sizeof(WCHAR) );
+    buffer[dir_len + base_len] = 0;
+    if (!nt_path_exists( buffer, (dir_len + base_len) * sizeof(WCHAR) ))
+    {
+        free( buffer );
+        return FALSE;
+    }
+
+    redir->Buffer = buffer;
+    redir->Length = (dir_len + base_len) * sizeof(WCHAR);
+    redir->MaximumLength = redir->Length + sizeof(WCHAR);
+    TRACE( "HACK: %s -> %s\n", debugstr_us(attr->ObjectName), debugstr_us(redir) );
+    attr->ObjectName = redir;
+    return TRUE;
+}
+
 #ifndef _WIN64
 
 static const WCHAR catrootW[] = {'s','y','s','t','e','m','3','2','\\','c','a','t','r','o','o','t',0};
@@ -3319,6 +3414,7 @@
 
     /* CW-Bug-Id: #23185 Emulate Steam Input native hooks for native SDL */
     if (replace_steam_input_path( attr, redir )) return;
+    if (replace_streamline_path( attr, redir )) return;
 
     if (!attr->RootDirectory)
     {
@@ -4653,7 +4749,8 @@
         get_redirect( attr, nt_name );
 #else
         /* CW-Bug-Id: #23185 Emulate Steam Input native hooks for native SDL */
-        replace_steam_input_path( attr, nt_name );
+        if (!replace_steam_input_path( attr, nt_name ))
+            replace_streamline_path( attr, nt_name );
 #endif
         status = nt_to_unix_file_name( attr, nt_name, unix_name_ret, disposition, open_reparse );
     }
