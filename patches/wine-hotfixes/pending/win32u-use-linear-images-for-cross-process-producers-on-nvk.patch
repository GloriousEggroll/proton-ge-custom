From: GloriousEggroll <gloriouseggroll@gmail.com>
Subject: [PATCH] win32u: Use linear images for cross-process producers on NVK.

Battle.net's Chromium GPU process on NVK (RTX 2060 SUPER, Sway, Flatpak
Mesa 26.2.5 producer, host Mesa 26.3.1 compositor) rendered its login page
with a black rectangle over the lower part when the managed swapchain
shared its images with the NVIDIA block-linear modifier
(0x300000000606015). With WINE_VK_MANAGED_LINEAR=1 the page rendered
correctly. Other GPUs are not affected.

Default to DRM_FORMAT_MOD_LINEAR for cross-process producers on NVK.
These are launcher and browser windows drawn by another process, not a
game's own swapchain. WINE_VK_MANAGED_LINEAR=1 still forces linear on any
driver, and WINE_VK_MANAGED_LINEAR=0 now keeps the modifier on NVK too.

https://github.com/GloriousEggroll/proton-ge-custom/issues/1020

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -4053,20 +4053,43 @@
                                      VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT, image_info );
 }
 
-/* Diagnostic: WINE_VK_MANAGED_LINEAR=1 exports cross-process producer images only
- * with DRM_FORMAT_MOD_LINEAR, to tell layout-specific driver faults apart. */
-static BOOL vk_managed_force_linear_modifier(void)
+static BOOL vk_device_is_nvk( struct vulkan_device *device )
 {
-    static int force = -1;
+    struct vulkan_physical_device *physical_device = device->physical_device;
+    VkPhysicalDeviceDriverProperties driver_props = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES};
+    VkPhysicalDeviceProperties2 props = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, .pNext = &driver_props};
+
+    if (physical_device->api_version < VK_API_VERSION_1_2 || physical_device->instance->api_version < VK_API_VERSION_1_2 ||
+        !physical_device->instance->p_vkGetPhysicalDeviceProperties2)
+        return FALSE;
 
-    if (force < 0)
+    physical_device->instance->p_vkGetPhysicalDeviceProperties2( physical_device->host.physical_device, &props );
+    return driver_props.driverID == VK_DRIVER_ID_MESA_NVK;
+}
+
+/* WINE_VK_MANAGED_LINEAR=1 exports cross-process producer images only with
+ * DRM_FORMAT_MOD_LINEAR, to tell layout-specific driver faults apart, and
+ * WINE_VK_MANAGED_LINEAR=0 never forces it.
+ *
+ * Without the variable, NVK producers use linear images: Battle.net's
+ * Chromium GPU process on NVK rendered its login page with a black
+ * rectangle over the lower part when its images were shared with the
+ * NVIDIA block-linear modifier, and correctly when they were linear
+ * (GE-Proton #1020). These producers are launcher and browser windows
+ * drawn by another process, not a game's own swapchain. */
+static BOOL vk_managed_force_linear_modifier( struct vulkan_device *device )
+{
+    static int env_force = -2;
+
+    if (env_force == -2)
     {
         const char *env = getenv( "WINE_VK_MANAGED_LINEAR" );
 
-        force = env && atoi( env ) ? 1 : 0;
-        if (force) WARN( "WINE_VK_MANAGED_LINEAR set, cross-process producers use linear images\n" );
+        env_force = env && *env ? !!atoi( env ) : -1;
+        if (env_force == 1) WARN( "WINE_VK_MANAGED_LINEAR set, cross-process producers use linear images\n" );
     }
-    return force;
+    if (env_force >= 0) return env_force;
+    return vk_device_is_nvk( device );
 }
 
 static uint32_t vk_collect_managed_modifiers( struct vulkan_device *device, VkFormat format,
@@ -4078,6 +4101,7 @@
                                               uint64_t *out_mods, uint64_t *out_wire_mods,
                                               uint32_t max_out )
 {
+    BOOL force_linear = vk_managed_force_linear_modifier( device );
     UINT best_tranche = ~0u, i;
     uint32_t out_count = 0;
 
@@ -4095,7 +4119,7 @@
         {
             if (modifier == WINE_VK_DRM_FORMAT_MOD_INVALID)
                 modifier = 0 /* DRM_FORMAT_MOD_LINEAR */;
-            if (modifier != 0 && vk_managed_force_linear_modifier()) continue;
+            if (modifier != 0 && force_linear) continue;
             if (!vk_host_modifier_exportable( device, format, usage, modifier, image_info )) continue;
         }
         if (caps_mods[i].tranche_index < best_tranche)
@@ -4120,7 +4144,7 @@
             /* MOD_INVALID means "any/implicit". Let the host pick by offering LINEAR. */
             if (modifier == WINE_VK_DRM_FORMAT_MOD_INVALID)
                 modifier = 0 /* DRM_FORMAT_MOD_LINEAR */;
-            if (modifier != 0 && vk_managed_force_linear_modifier()) continue;
+            if (modifier != 0 && force_linear) continue;
             if (!vk_host_modifier_exportable( device, format, usage, modifier, image_info )) continue;
         }
         /* dedupe */
