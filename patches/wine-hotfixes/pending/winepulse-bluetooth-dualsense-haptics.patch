+/* Bluetooth DualSense controllers have no USB audio function, so there is no
+ * Pulse sink for their haptics. Expose a four-channel endpoint like the USB
+ * one for each of them, with the container ID winebus gives the controller,
+ * and send channels 3 and 4 to the controller as Bluetooth haptics reports.
+ * Packet layout and resampling follow DS5Dongle and vDS (MIT license). */
+static PhysDevice *pulse_find_device(struct list *list, const char *pulse_name);
+
+#define BT_DUALSENSE_PULSE_PREFIX "wine_bluetooth.Sony_Interactive_Entertainment_"
+#define BT_DUALSENSE_HAPTIC_PATH_PREFIX "wine-bluetooth-hidraw:"
+#define BT_DUALSENSE_HAPTIC_REPORT_ID 0x32
+#define BT_DUALSENSE_HAPTIC_REPORT_SIZE 142
+#define BT_DUALSENSE_HAPTIC_DECIMATION 16 /* 48 kHz to 3 kHz */
+#define BT_DUALSENSE_HAPTIC_LEAD_FRAMES 1024
+
+static BOOL steam_virtual_gamepad_present(void)
+{
+    char path[PATH_MAX], value[16];
+    struct dirent *entry;
+    BOOL found = FALSE;
+    DIR *dir;
+    FILE *f;
+
+    if (!(dir = opendir("/sys/class/input")))
+        return FALSE;
+    while (!found && (entry = readdir(dir)))
+    {
+        if (strncmp(entry->d_name, "input", 5))
+            continue;
+        snprintf(path, sizeof(path), "/sys/class/input/%s/id/vendor", entry->d_name);
+        if (!(f = fopen(path, "r")))
+            continue;
+        found = fgets(value, sizeof(value), f) && !strncmp(value, "28de", 4);
+        fclose(f);
+        if (!found)
+            continue;
+        snprintf(path, sizeof(path), "/sys/class/input/%s/id/product", entry->d_name);
+        found = FALSE;
+        if (!(f = fopen(path, "r")))
+            continue;
+        found = fgets(value, sizeof(value), f) && !strncmp(value, "11ff", 4);
+        fclose(f);
+    }
+    closedir(dir);
+    return found;
+}
+
+/* Matches the conditions under which winebus presents the controller as USB. */
+static BOOL bt_dualsense_haptics_enabled(void)
+{
+    const char *env;
+
+    if ((env = getenv("PROTON_DUALSENSE_BT_AS_USB")) && !strcmp(env, "0"))
+        return FALSE;
+    if ((env = getenv("PROTON_DUALSENSE_BT_HAPTICS")) && !strcmp(env, "0"))
+        return FALSE;
+    if ((env = getenv("PROTON_EMULATE_STEAMINPUT")) && atoi(env))
+        return FALSE;
+    if ((env = getenv("PROTON_NO_STEAMINPUT")) && !strcmp(env, "1"))
+        return TRUE;
+    return !steam_virtual_gamepad_present();
+}
+
+/* Must match set_bluetooth_dualsense_container_id() in winebus. */
+static GUID bt_dualsense_container_id(USHORT pid, const unsigned int *mac)
+{
+    GUID guid = {0};
+    unsigned int i;
+
+    guid.Data1 = MAKELONG(0x054c, pid);
+    guid.Data2 = 0x4254;
+    guid.Data3 = (mac[0] << 8) | mac[1];
+    for (i = 0; i < 4; ++i) guid.Data4[i] = mac[i + 2];
+    return guid;
+}
+
+static void pulse_add_bluetooth_dualsense_device(struct list *list, const char *hidraw,
+        USHORT pid, const unsigned int *mac)
+{
+    const char *model = pid == 0x0df2 ? "DualSense_Edge_Wireless_Controller" : "DualSense_Wireless_Controller";
+    const char *desc = pid == 0x0df2 ? "DualSense Edge Wireless Controller" : "DualSense Wireless Controller";
+    WAVEFORMATEXTENSIBLE *fmt;
+    char pulse_name[160];
+    PhysDevice *dev;
+    size_t len;
+
+    len = snprintf(pulse_name, sizeof(pulse_name), "%s%s.%02x%02x%02x%02x%02x%02x",
+            BT_DUALSENSE_PULSE_PREFIX, model, mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+    if (pulse_find_device(list, pulse_name))
+        return;
+    if (!(dev = calloc(1, FIELD_OFFSET(PhysDevice, pulse_name[len + 1]))))
+        return;
+    if (!(dev->name = get_device_name(desc, NULL)) || !(dev->bt_hidraw = strdup(hidraw)))
+    {
+        free(dev->name);
+        free(dev);
+        return;
+    }
+
+    dev->flow = eRender;
+    dev->form = Speakers;
+    dev->channel_mask = KSAUDIO_SPEAKER_QUAD;
+    dev->bus_type = phys_device_bus_usb;
+    dev->vendor_id = 0x054c;
+    dev->product_id = pid;
+    dev->alsa_card = -1;
+    dev->container_id = bt_dualsense_container_id(pid, mac);
+    dev->def_period = 100000;
+    dev->min_period = 30000;
+    dev->ready = TRUE;
+    dev->probe_status = 0;
+    pthread_mutex_init(&dev->ready_mutex, NULL);
+    pthread_cond_init(&dev->ready_cond, NULL);
+
+    fmt = &dev->fmt;
+    fmt->Format.wFormatTag = WAVE_FORMAT_EXTENSIBLE;
+    fmt->Format.nChannels = 4;
+    fmt->Format.nSamplesPerSec = 48000;
+    fmt->Format.wBitsPerSample = 32;
+    fmt->Format.nBlockAlign = 16;
+    fmt->Format.nAvgBytesPerSec = 48000 * 16;
+    fmt->Format.cbSize = sizeof(WAVEFORMATEXTENSIBLE) - sizeof(WAVEFORMATEX);
+    fmt->Samples.wValidBitsPerSample = 32;
+    fmt->dwChannelMask = KSAUDIO_SPEAKER_QUAD;
+    fmt->SubFormat = KSDATAFORMAT_SUBTYPE_IEEE_FLOAT;
+
+    memcpy(dev->pulse_name, pulse_name, len + 1);
+    if (!pulse_set_endpoint_id(dev, list))
+    {
+        pulse_dev_free(dev);
+        return;
+    }
+    list_add_tail(list, &dev->entry);
+    TRACE("Added Bluetooth DualSense haptics endpoint %s for %s, container %s.\n",
+            debugstr_a(dev->pulse_name), hidraw, debugstr_guid(&dev->container_id));
+}
+
+static void pulse_add_bluetooth_dualsense_devices(struct list *list)
+{
+    char path[PATH_MAX], line[256], hidraw[PATH_MAX];
+    struct dirent *entry;
+    DIR *dir;
+    FILE *f;
+
+    if (!bt_dualsense_haptics_enabled())
+        return;
+    if (!(dir = opendir("/sys/class/hidraw")))
+        return;
+    while ((entry = readdir(dir)))
+    {
+        unsigned int bus = 0, vid = 0, pid = 0, mac[6];
+        BOOL have_mac = FALSE;
+
+        if (strncmp(entry->d_name, "hidraw", 6))
+            continue;
+        snprintf(path, sizeof(path), "/sys/class/hidraw/%s/device/uevent", entry->d_name);
+        if (!(f = fopen(path, "r")))
+            continue;
+        while (fgets(line, sizeof(line), f))
+        {
+            if (!strncmp(line, "HID_ID=", 7))
+                sscanf(line + 7, "%x:%x:%x", &bus, &vid, &pid);
+            else if (!strncmp(line, "HID_UNIQ=", 9))
+                have_mac = sscanf(line + 9, "%x:%x:%x:%x:%x:%x", &mac[0], &mac[1], &mac[2],
+                        &mac[3], &mac[4], &mac[5]) == 6;
+        }
+        fclose(f);
+
+        if (bus != 0x0005 || vid != 0x054c || (pid != 0x0ce6 && pid != 0x0df2) || !have_mac)
+            continue;
+        snprintf(hidraw, sizeof(hidraw), "/dev/%s", entry->d_name);
+        pulse_add_bluetooth_dualsense_device(list, hidraw, pid, mac);
+    }
+    closedir(dir);
+}
+
+/* Returns the haptic path for a Bluetooth DualSense endpoint, or NULL. */
+static char *pulse_find_bluetooth_dualsense_haptic_path(const char *name)
+{
+    PhysDevice *dev;
+    char *path = NULL;
+
+    if (!name)
+        return NULL;
+    g_phys_lock();
+    LIST_FOR_EACH_ENTRY(dev, &g_phys_speakers, PhysDevice, entry)
+    {
+        size_t len;
+
+        if (!dev->bt_hidraw || !pulse_device_matches(dev, name))
+            continue;
+        len = sizeof(BT_DUALSENSE_HAPTIC_PATH_PREFIX) + strlen(dev->bt_hidraw);
+        if ((path = malloc(len)))
+            snprintf(path, len, "%s%s", BT_DUALSENSE_HAPTIC_PATH_PREFIX, dev->bt_hidraw);
+        break;
+    }
+    g_phys_unlock();
+    return path;
+}
