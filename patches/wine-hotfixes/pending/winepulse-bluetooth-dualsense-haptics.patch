     }
 
     pulse_probe_device_list(ml, ctx, &current, flow == eRender);
+    if (flow == eRender)
+        pulse_add_bluetooth_dualsense_devices(&current);
 
     g_phys_lock();
 
@@ -2573,6 +2788,7 @@
         pulse_probe_settings(ml, ctx, 1, dev->pulse_name, &dev->fmt, &dev->def_period, &dev->min_period);
         apply_windows_sony_audio_format(dev);
     }
+    pulse_add_bluetooth_dualsense_devices(&g_phys_speakers);
 
     LIST_FOR_EACH_ENTRY(dev, &g_phys_sources, PhysDevice, entry) {
         pulse_probe_settings(ml, ctx, 0, dev->pulse_name, &dev->fmt, &dev->def_period, &dev->min_period);
@@ -3629,6 +3845,457 @@
 #endif
 }
 
+static void pulse_haptic_advance(struct pulse_stream *stream, UINT32 frames, UINT32 frame_size);
+
+static UINT32 bt_dualsense_crc32(UINT32 crc, const BYTE *data, SIZE_T size)
+{
+    unsigned int bit;
+
+    while (size--)
+    {
+        crc ^= *data++;
+        for (bit = 0; bit < 8; ++bit)
+            crc = (crc >> 1) ^ (0xedb88320 & -(crc & 1));
+    }
+    return crc;
+}
+
+/* The controller speaker takes Opus over Bluetooth: one 10 ms, 200 byte
+ * CBR frame per haptics chunk, as in vDS and DS5Dongle. libopus is loaded
+ * at runtime; without it only haptics are sent. */
+#define BT_DUALSENSE_SPEAKER_REPORT_ID 0x36
+#define BT_DUALSENSE_SPEAKER_REPORT_SIZE 398
+#define BT_DUALSENSE_SPEAKER_WINDOW_FRAMES 512
+#define BT_DUALSENSE_SPEAKER_OPUS_FRAMES 480
+#define BT_DUALSENSE_SPEAKER_OPUS_SIZE 200
+#define BT_DUALSENSE_OPUS_APPLICATION_RESTRICTED_LOWDELAY 2051
+#define BT_DUALSENSE_OPUS_SET_BITRATE_REQUEST 4002
+#define BT_DUALSENSE_OPUS_SET_VBR_REQUEST 4006
+#define BT_DUALSENSE_OPUS_SET_COMPLEXITY_REQUEST 4010
+
+static void *(*p_opus_encoder_create)(int32_t, int, int, int *);
+static int (*p_opus_encoder_ctl)(void *, int, ...);
+static int32_t (*p_opus_encode)(void *, const int16_t *, int, unsigned char *, int32_t);
+static void (*p_opus_encoder_destroy)(void *);
+static pthread_once_t bt_dualsense_opus_once = PTHREAD_ONCE_INIT;
+
+static void bt_dualsense_load_opus(void)
+{
+    void *handle;
+
+    if (!(handle = dlopen("libopus.so.0", RTLD_NOW)))
+    {
+        WARN("libopus not found, Bluetooth DualSense speaker audio is disabled.\n");
+        return;
+    }
+    p_opus_encoder_create = dlsym(handle, "opus_encoder_create");
+    p_opus_encoder_ctl = dlsym(handle, "opus_encoder_ctl");
+    p_opus_encode = dlsym(handle, "opus_encode");
+    p_opus_encoder_destroy = dlsym(handle, "opus_encoder_destroy");
+    if (!p_opus_encoder_create || !p_opus_encoder_ctl || !p_opus_encode || !p_opus_encoder_destroy)
+    {
+        WARN("libopus is missing symbols, Bluetooth DualSense speaker audio is disabled.\n");
+        p_opus_encoder_create = NULL;
+        dlclose(handle);
+    }
+}
+
+static void *bt_dualsense_create_opus_encoder(void)
+{
+    void *encoder;
+    int err = 0;
+
+    pthread_once(&bt_dualsense_opus_once, bt_dualsense_load_opus);
+    if (!p_opus_encoder_create)
+        return NULL;
+    if (!(encoder = p_opus_encoder_create(48000, 2, BT_DUALSENSE_OPUS_APPLICATION_RESTRICTED_LOWDELAY, &err)) || err)
+    {
+        WARN("opus_encoder_create failed: %d\n", err);
+        return NULL;
+    }
+    p_opus_encoder_ctl(encoder, BT_DUALSENSE_OPUS_SET_VBR_REQUEST, (int32_t)0);
+    p_opus_encoder_ctl(encoder, BT_DUALSENSE_OPUS_SET_COMPLEXITY_REQUEST, (int32_t)0);
+    p_opus_encoder_ctl(encoder, BT_DUALSENSE_OPUS_SET_BITRATE_REQUEST, (int32_t)(BT_DUALSENSE_SPEAKER_OPUS_SIZE * 8 * 100));
+    return encoder;
+}
+
+/* Games may open several streams on the controller endpoint (Assassin's
+ * Creed Shadows opens two). Each controller gets one mixer that sums the
+ * streams on a shared real-time clock and sends one report sequence, with
+ * one Opus encoder and one set of counters; independent senders would
+ * interleave two Opus streams and double the Bluetooth traffic. Streams
+ * write up to BT_DUALSENSE_MIX_LEAD frames ahead of the clock, chunks are
+ * sent BT_DUALSENSE_MIX_SEND_AHEAD frames ahead, so every stream gets to add
+ * its samples before a chunk goes out. */
+#define BT_DUALSENSE_MIX_RING 8192
+#define BT_DUALSENSE_MIX_LEAD 1536
+#define BT_DUALSENSE_MIX_SEND_AHEAD 512
+
+struct bt_dualsense_mixer
+{
+    struct list entry;
+    char *path;
+    int fd;
+    LONG refs;
+    void *opus;
+    pa_usec_t start_time;
+    UINT64 sent;
+    BYTE seq, counter;
+    UINT32 silent_chunks, spk_idle_chunks;
+    BOOL headphones;
+    pa_usec_t stat_time;
+    UINT32 stat_speaker, stat_haptics, stat_skipped, stat_signal, stat_eagain, stat_rebase;
+    INT32 ring[BT_DUALSENSE_MIX_RING][4];
+};
+
+static struct list bt_dualsense_mixers = LIST_INIT(bt_dualsense_mixers);
+
+static UINT64 bt_dualsense_mixer_clock(struct bt_dualsense_mixer *mixer)
+{
+    return (pa_rtclock_now() - mixer->start_time) * 48000 / 1000000;
+}
+
+static void pulse_bt_haptic_close(struct pulse_stream *stream)
+{
+    struct bt_dualsense_mixer *mixer = stream->hid_mixer;
+
+    stream->hid_fd = -1;
+    stream->hid_mixer = NULL;
+    if (!mixer || --mixer->refs) return;
+
+    list_remove(&mixer->entry);
+    close(mixer->fd);
+    if (mixer->opus) p_opus_encoder_destroy(mixer->opus);
+    free(mixer->path);
+    free(mixer);
+}
+
+static HRESULT pulse_bt_haptic_connect(struct pulse_stream *stream, const char *hidraw)
+{
+    struct bt_dualsense_mixer *mixer;
+
+    stream->attr.minreq = stream->period_bytes;
+    stream->attr.fragsize = stream->period_bytes;
+    stream->attr.tlength = stream->period_bytes * 3;
+    stream->attr.maxlength = stream->bufsize_frames * pa_frame_size(&stream->ss);
+    stream->attr.prebuf = 0;
+
+    if (stream->ss.channels != 4 || stream->ss.rate != 48000 ||
+            (stream->ss.format != PA_SAMPLE_FLOAT32LE && stream->ss.format != PA_SAMPLE_S16LE))
+    {
+        WARN("Unsupported format for Bluetooth DualSense haptics.\n");
+        return AUDCLNT_E_ENDPOINT_CREATE_FAILED;
+    }
+
+    LIST_FOR_EACH_ENTRY(mixer, &bt_dualsense_mixers, struct bt_dualsense_mixer, entry)
+    {
+        if (!strcmp(mixer->path, hidraw))
+        {
+            mixer->refs++;
+            goto done;
+        }
+    }
+
+    if (!(mixer = calloc(1, sizeof(*mixer))) || !(mixer->path = strdup(hidraw)))
+    {
+        free(mixer);
+        return E_OUTOFMEMORY;
+    }
+    /* Opened for reading too, to follow the headphone jack state. */
+    if ((mixer->fd = open(hidraw, O_RDWR | O_NONBLOCK | O_CLOEXEC)) < 0)
+    {
+        WARN("Unable to open %s for Bluetooth DualSense haptics: %s\n", hidraw, strerror(errno));
+        free(mixer->path);
+        free(mixer);
+        return AUDCLNT_E_ENDPOINT_CREATE_FAILED;
+    }
+    mixer->refs = 1;
+    mixer->start_time = pa_rtclock_now();
+    mixer->opus = bt_dualsense_create_opus_encoder();
+    list_add_tail(&bt_dualsense_mixers, &mixer->entry);
+    TRACE("Sending DualSense haptics%s to Bluetooth controller %s.\n",
+            mixer->opus ? " and speaker audio" : "", hidraw);
+
+done:
+    stream->hid_haptics = TRUE;
+    stream->hid_mixer = mixer;
+    stream->hid_fd = mixer->fd;
+    stream->hid_start_time = 0;
+    stream->hid_consumed = 0;
+    TRACE("Mixing stream %p into Bluetooth DualSense %s (%d streams).\n", stream, hidraw, (int)mixer->refs);
+    return S_OK;
+}
+
+static void bt_dualsense_set_crc(BYTE *report, SIZE_T size)
+{
+    static const BYTE seed = 0xa2;
+    UINT32 crc;
+
+    crc = bt_dualsense_crc32(0xffffffff, &seed, 1);
+    crc = ~bt_dualsense_crc32(crc, report, size - 4);
+    report[size - 4] = crc;
+    report[size - 3] = crc >> 8;
+    report[size - 2] = crc >> 16;
+    report[size - 1] = crc >> 24;
+}
+
+static void bt_dualsense_update_jack(struct bt_dualsense_mixer *mixer)
+{
+    BYTE buf[128];
+    ssize_t len;
+
+    /* Bluetooth report 0x31 holds the USB input report from byte 2, the
+     * jack state is USB byte 54, bit 0 headphones. */
+    while ((len = read(mixer->fd, buf, sizeof(buf))) > 0)
+    {
+        if (buf[0] == 0x31 && len >= 56 && (buf[1] & 0x0f) == 0x01 && mixer->headphones != (buf[55] & 1))
+        {
+            mixer->headphones = buf[55] & 1;
+            TRACE("Bluetooth DualSense %s: headphones %s (status %#x).\n", mixer->path,
+                    mixer->headphones ? "plugged" : "unplugged", buf[55]);
+        }
+    }
+}
+
+static BOOL bt_dualsense_encode_speaker(struct bt_dualsense_mixer *mixer,
+        const int16_t (*src)[4], BYTE *out)
+{
+    int16_t pcm[BT_DUALSENSE_SPEAKER_OPUS_FRAMES * 2];
+    UINT32 i, c;
+    int32_t len;
+
+    /* 512 frames per haptics chunk, 480 per Opus frame. */
+    for (i = 0; i < BT_DUALSENSE_SPEAKER_OPUS_FRAMES; ++i)
+    {
+        UINT32 num = i * BT_DUALSENSE_SPEAKER_WINDOW_FRAMES;
+        UINT32 pos = num / BT_DUALSENSE_SPEAKER_OPUS_FRAMES, frac = num % BT_DUALSENSE_SPEAKER_OPUS_FRAMES;
+        UINT32 next = min(pos + 1, BT_DUALSENSE_SPEAKER_WINDOW_FRAMES - 1);
+
+        for (c = 0; c < 2; ++c)
+            pcm[i * 2 + c] = ((INT32)src[pos][c] * (INT32)(BT_DUALSENSE_SPEAKER_OPUS_FRAMES - frac) +
+                    (INT32)src[next][c] * (INT32)frac) / BT_DUALSENSE_SPEAKER_OPUS_FRAMES;
+    }
+
+    len = p_opus_encode(mixer->opus, pcm, BT_DUALSENSE_SPEAKER_OPUS_FRAMES, out, BT_DUALSENSE_SPEAKER_OPUS_SIZE);
+    if (len < 0)
+    {
+        WARN("opus_encode failed: %d\n", (int)len);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static void bt_dualsense_send_chunk(struct bt_dualsense_mixer *mixer, const int16_t (*pcm)[4])
+{
+    BYTE report[BT_DUALSENSE_SPEAKER_REPORT_SIZE] = {0};
+    INT8 haptics[64];
+    BOOL silent = TRUE, speaker = FALSE, spk_signal = FALSE;
+    SIZE_T size;
+    UINT32 i, j, c;
+
+    for (i = 0; i < BT_DUALSENSE_SPEAKER_WINDOW_FRAMES; ++i)
+        spk_signal |= pcm[i][0] || pcm[i][1];
+    mixer->stat_signal += spk_signal;
+
+    /* Channels 3 and 4: 48 kHz to 3 kHz, 8-bit. */
+    for (i = 0; i < sizeof(haptics) / 2; ++i)
+    {
+        for (c = 0; c < 2; ++c)
+        {
+            INT32 sum = 0;
+
+            for (j = 0; j < BT_DUALSENSE_HAPTIC_DECIMATION; ++j)
+                sum += pcm[i * BT_DUALSENSE_HAPTIC_DECIMATION + j][2 + c];
+            haptics[i * 2 + c] = max(-128, min(127, sum / BT_DUALSENSE_HAPTIC_DECIMATION / 256));
+            silent &= !haptics[i * 2 + c];
+        }
+    }
+
+    if (mixer->opus)
+    {
+        /* Keep the speaker going a little past the last sound so the Opus
+         * decoder flushes its tail. */
+        if (spk_signal)
+            mixer->spk_idle_chunks = 0;
+        else if (mixer->spk_idle_chunks < 16)
+            ++mixer->spk_idle_chunks;
+        speaker = mixer->spk_idle_chunks < 16;
+    }
+
+    /* Keep sending a few silent chunks so the actuators settle, then stop
+     * until the game plays haptics again. */
+    if (silent && !speaker && ++mixer->silent_chunks > 4)
+    {
+        mixer->stat_skipped++;
+        return;
+    }
+    if (!silent)
+        mixer->silent_chunks = 0;
+
+    if (speaker)
+    {
+        bt_dualsense_update_jack(mixer);
+        if (!bt_dualsense_encode_speaker(mixer, pcm, report + 144))
+            speaker = FALSE;
+    }
+
+    if (speaker)
+    {
+        BYTE *state = report + 13;
+
+        /* Haptics and speaker report with an embedded state block, layout
+         * from vDS. Over USB the controller routes its audio function to
+         * the speaker by itself; over Bluetooth the output path and volume
+         * must be set, so select them with every speaker report. */
+        size = BT_DUALSENSE_SPEAKER_REPORT_SIZE;
+        report[0] = BT_DUALSENSE_SPEAKER_REPORT_ID;
+        report[1] = (mixer->seq++ & 0x0f) << 4;
+        report[2] = 0x91;
+        report[3] = 7;
+        report[4] = 0xfe;
+        report[5] = report[6] = report[7] = report[8] = report[9] = 64;
+        report[10] = mixer->counter++;
+        report[11] = 0x90;
+        report[12] = 63;
+        state[1] = 0x80; /* allow audio control 2 */
+        state[37] = 0x01; /* audio control 2 */
+        if (mixer->headphones)
+        {
+            state[0] = 0x80 | 0x10; /* allow audio control, headphone volume */
+            state[4] = 0x7f; /* headphone volume */
+            state[7] = 0x08; /* headphone output, automatic mic select */
+        }
+        else
+        {
+            state[0] = 0x80 | 0x20; /* allow audio control, speaker volume */
+            state[5] = 0x64; /* speaker volume */
+            state[7] = 0x39; /* speaker output, internal mic */
+        }
+        report[76] = 0x92;
+        report[77] = sizeof(haptics);
+        memcpy(report + 78, haptics, sizeof(haptics));
+        report[142] = mixer->headphones ? 0x96 : 0x93;
+        report[143] = BT_DUALSENSE_SPEAKER_OPUS_SIZE;
+    }
+    else
+    {
+        size = BT_DUALSENSE_HAPTIC_REPORT_SIZE;
+        report[0] = BT_DUALSENSE_HAPTIC_REPORT_ID;
+        report[1] = (mixer->seq++ & 0x0f) << 4;
+        report[2] = 0x91;
+        report[3] = 4;
+        report[4] = 0x66;
+        report[5] = 48;
+        report[6] = 48;
+        report[7] = mixer->counter++;
+        report[8] = 0x92;
+        report[9] = sizeof(haptics);
+        memcpy(report + 10, haptics, sizeof(haptics));
+    }
+    bt_dualsense_set_crc(report, size);
+
+    if (speaker) mixer->stat_speaker++;
+    else mixer->stat_haptics++;
+    if (write(mixer->fd, report, size) < 0)
+    {
+        if (errno == EAGAIN) mixer->stat_eagain++;
+        else WARN("Bluetooth DualSense haptics write failed: %s\n", strerror(errno));
+    }
+}
+
+static void bt_dualsense_mixer_skip_stale(struct bt_dualsense_mixer *mixer, UINT64 clock)
+{
+    /* Nothing was written for a while, drop what is stale. */
+    if (clock + BT_DUALSENSE_MIX_SEND_AHEAD > mixer->sent + BT_DUALSENSE_MIX_RING / 2)
+    {
+        memset(mixer->ring, 0, sizeof(mixer->ring));
+        mixer->sent = clock / BT_DUALSENSE_SPEAKER_WINDOW_FRAMES * BT_DUALSENSE_SPEAKER_WINDOW_FRAMES;
+    }
+}
+
+static void bt_dualsense_mixer_send(struct bt_dualsense_mixer *mixer, UINT64 clock)
+{
+    int16_t pcm[BT_DUALSENSE_SPEAKER_WINDOW_FRAMES][4];
+    UINT32 i, c;
+
+    while (mixer->sent + BT_DUALSENSE_SPEAKER_WINDOW_FRAMES <= clock + BT_DUALSENSE_MIX_SEND_AHEAD)
+    {
+        for (i = 0; i < BT_DUALSENSE_SPEAKER_WINDOW_FRAMES; ++i)
+        {
+            INT32 *frame = mixer->ring[(mixer->sent + i) % BT_DUALSENSE_MIX_RING];
+
+            for (c = 0; c < 4; ++c)
+                pcm[i][c] = max(-32768, min(32767, frame[c]));
+            memset(frame, 0, sizeof(mixer->ring[0]));
+        }
+        mixer->sent += BT_DUALSENSE_SPEAKER_WINDOW_FRAMES;
+        bt_dualsense_send_chunk(mixer, (const int16_t (*)[4])pcm);
+    }
+
+    if (TRACE_ON(pulse) && pa_rtclock_now() - mixer->stat_time >= 1000000)
+    {
+        TRACE("Bluetooth DualSense %s: %u speaker, %u haptics, %u skipped reports, %u chunks with speaker signal, "
+                "%u writes dropped, %u stream rebases, %d streams.\n", mixer->path, mixer->stat_speaker,
+                mixer->stat_haptics, mixer->stat_skipped, mixer->stat_signal, mixer->stat_eagain,
+                mixer->stat_rebase, (int)mixer->refs);
+        mixer->stat_speaker = mixer->stat_haptics = mixer->stat_skipped = 0;
+        mixer->stat_signal = mixer->stat_eagain = mixer->stat_rebase = 0;
+        mixer->stat_time = pa_rtclock_now();
+    }
+}
+
+static void pulse_bt_haptic_write(struct pulse_stream *stream, UINT32 held_frames, UINT32 frame_size)
+{
+    struct bt_dualsense_mixer *mixer = stream->hid_mixer;
+    UINT32 frames, contiguous_frames, i, c;
+    UINT64 clock, target, pos;
+    const BYTE *src;
+
+    if (!mixer)
+        return;
+
+    /* There is no device clock, consume the buffer in real time, ahead of
+     * the mixer clock. hid_consumed is the stream's position on it. */
+    clock = bt_dualsense_mixer_clock(mixer);
+    bt_dualsense_mixer_skip_stale(mixer, clock);
+    target = clock + BT_DUALSENSE_MIX_LEAD;
+    if (!stream->hid_start_time || stream->hid_consumed < mixer->sent)
+    {
+        /* Started, or fell behind: don't send the missed time in a burst. */
+        if (stream->hid_start_time) mixer->stat_rebase++;
+        stream->hid_start_time = 1;
+        stream->hid_consumed = max(mixer->sent, clock + BT_DUALSENSE_MIX_SEND_AHEAD);
+    }
+
+    if (target > stream->hid_consumed)
+    {
+        contiguous_frames = (stream->real_bufsize_bytes - stream->pa_offs_bytes) / frame_size;
+        frames = min(min((UINT32)(target - stream->hid_consumed), held_frames), contiguous_frames);
+        frames = min(frames, (UINT32)(mixer->sent + BT_DUALSENSE_MIX_RING - stream->hid_consumed));
+        src = stream->local_buffer + stream->pa_offs_bytes;
+
+        for (i = 0, pos = stream->hid_consumed; i < frames; ++i, ++pos)
+        {
+            INT32 *frame = mixer->ring[pos % BT_DUALSENSE_MIX_RING];
+
+            for (c = 0; c < 4; ++c)
+            {
+                if (stream->ss.format == PA_SAMPLE_FLOAT32LE)
+                    frame[c] += float_to_s16(((const float *)src)[i * 4 + c]);
+                else
+                    frame[c] += ((const int16_t *)src)[i * 4 + c];
+            }
+        }
+        if (frames)
+        {
+            stream->hid_consumed += frames;
+            pulse_haptic_advance(stream, frames, frame_size);
+        }
+    }
+
+    bt_dualsense_mixer_send(mixer, clock);
+}
