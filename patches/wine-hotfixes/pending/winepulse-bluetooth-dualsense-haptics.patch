+static void pulse_haptic_advance(struct pulse_stream *stream, UINT32 frames, UINT32 frame_size);
+
+static UINT32 bt_dualsense_crc32(UINT32 crc, const BYTE *data, SIZE_T size)
+{
+    unsigned int bit;
+
+    while (size--)
+    {
+        crc ^= *data++;
+        for (bit = 0; bit < 8; ++bit)
+            crc = (crc >> 1) ^ (0xedb88320 & -(crc & 1));
+    }
+    return crc;
+}
+
+static void pulse_bt_haptic_close(struct pulse_stream *stream)
+{
+    if (stream->hid_haptics && stream->hid_fd >= 0)
+        close(stream->hid_fd);
+    stream->hid_fd = -1;
+}
+
+static HRESULT pulse_bt_haptic_connect(struct pulse_stream *stream, const char *hidraw)
+{
+    stream->attr.minreq = stream->period_bytes;
+    stream->attr.fragsize = stream->period_bytes;
+    stream->attr.tlength = stream->period_bytes * 3;
+    stream->attr.maxlength = stream->bufsize_frames * pa_frame_size(&stream->ss);
+    stream->attr.prebuf = 0;
+
+    if (stream->ss.channels != 4 || stream->ss.rate != 48000 ||
+            (stream->ss.format != PA_SAMPLE_FLOAT32LE && stream->ss.format != PA_SAMPLE_S16LE))
+    {
+        WARN("Unsupported format for Bluetooth DualSense haptics.\n");
+        return AUDCLNT_E_ENDPOINT_CREATE_FAILED;
+    }
+
+    if ((stream->hid_fd = open(hidraw, O_WRONLY | O_NONBLOCK | O_CLOEXEC)) < 0)
+    {
+        WARN("Unable to open %s for Bluetooth DualSense haptics: %s\n", hidraw, strerror(errno));
+        return AUDCLNT_E_ENDPOINT_CREATE_FAILED;
+    }
+    stream->hid_haptics = TRUE;
+    stream->hid_start_time = 0;
+    stream->hid_consumed = 0;
+    stream->hid_sum_count = stream->hid_chunk_pos = stream->hid_silent_chunks = 0;
+    stream->hid_sum[0] = stream->hid_sum[1] = 0;
+    TRACE("Sending DualSense haptics to Bluetooth controller %s.\n", hidraw);
+    return S_OK;
+}
+
+static void pulse_bt_haptic_send_chunk(struct pulse_stream *stream)
+{
+    static const BYTE seed = 0xa2;
+    BYTE report[BT_DUALSENSE_HAPTIC_REPORT_SIZE] = {0};
+    BOOL silent = TRUE;
+    UINT32 crc, i;
+
+    for (i = 0; i < sizeof(stream->hid_chunk); ++i)
+        silent &= !stream->hid_chunk[i];
+    /* Keep sending a few silent chunks so the actuators settle, then stop
+     * until the game plays haptics again. */
+    if (silent && ++stream->hid_silent_chunks > 4)
+        return;
+    if (!silent)
+        stream->hid_silent_chunks = 0;
+
+    report[0] = BT_DUALSENSE_HAPTIC_REPORT_ID;
+    report[1] = (stream->hid_seq++ & 0x0f) << 4;
+    report[2] = 0x91;
+    report[3] = 4;
+    report[4] = 0x66;
+    report[5] = 48;
+    report[6] = 48;
+    report[7] = stream->hid_counter++;
+    report[8] = 0x92;
+    report[9] = sizeof(stream->hid_chunk);
+    memcpy(report + 10, stream->hid_chunk, sizeof(stream->hid_chunk));
+
+    crc = bt_dualsense_crc32(0xffffffff, &seed, 1);
+    crc = ~bt_dualsense_crc32(crc, report, sizeof(report) - 4);
+    report[sizeof(report) - 4] = crc;
+    report[sizeof(report) - 3] = crc >> 8;
+    report[sizeof(report) - 2] = crc >> 16;
+    report[sizeof(report) - 1] = crc >> 24;
+
+    if (write(stream->hid_fd, report, sizeof(report)) < 0 && errno != EAGAIN)
+        WARN("Bluetooth DualSense haptics write failed: %s\n", strerror(errno));
+}
+
+static void pulse_bt_haptic_write(struct pulse_stream *stream, UINT32 held_frames, UINT32 frame_size)
+{
+    UINT64 played;
+    UINT32 frames, contiguous_frames, i, c;
+    const BYTE *src;
+    pa_usec_t now;
+
+    if (stream->hid_fd < 0)
+        return;
+
+    /* There is no device clock, consume the buffer in real time, a short
+     * lead ahead so the controller always has the next packet. */
+    now = pa_rtclock_now();
+    if (!stream->hid_start_time)
+    {
+        stream->hid_start_time = now;
+        stream->hid_consumed = 0;
+    }
+    played = (now - stream->hid_start_time) * stream->ss.rate / 1000000 + BT_DUALSENSE_HAPTIC_LEAD_FRAMES;
+    if (played > stream->hid_consumed + 2 * BT_DUALSENSE_HAPTIC_LEAD_FRAMES)
+    {
+        /* Underrun, don't send the missed time in a burst. */
+        stream->hid_start_time = now - stream->hid_consumed * 1000000 / stream->ss.rate;
+        played = stream->hid_consumed + BT_DUALSENSE_HAPTIC_LEAD_FRAMES;
+    }
+    if (played <= stream->hid_consumed)
+        return;
+
+    contiguous_frames = (stream->real_bufsize_bytes - stream->pa_offs_bytes) / frame_size;
+    frames = min(min((UINT32)(played - stream->hid_consumed), held_frames), contiguous_frames);
+    if (!frames)
+        return;
+    src = stream->local_buffer + stream->pa_offs_bytes;
+
+    for (i = 0; i < frames; ++i)
+    {
+        for (c = 0; c < 2; ++c)
+        {
+            int sample;
+
+            if (stream->ss.format == PA_SAMPLE_FLOAT32LE)
+                sample = float_to_s16(((const float *)src)[i * 4 + 2 + c]);
+            else
+                sample = ((const int16_t *)src)[i * 4 + 2 + c];
+            stream->hid_sum[c] += sample;
+        }
+        if (++stream->hid_sum_count < BT_DUALSENSE_HAPTIC_DECIMATION)
+            continue;
+
+        for (c = 0; c < 2; ++c)
+        {
+            int value = stream->hid_sum[c] / BT_DUALSENSE_HAPTIC_DECIMATION / 256;
+
+            stream->hid_chunk[stream->hid_chunk_pos++] = max(-128, min(127, value));
+            stream->hid_sum[c] = 0;
+        }
+        stream->hid_sum_count = 0;
+        if (stream->hid_chunk_pos == sizeof(stream->hid_chunk))
+        {
+            pulse_bt_haptic_send_chunk(stream);
+            stream->hid_chunk_pos = 0;
+        }
+    }
+
+    stream->hid_consumed += frames;
+    pulse_haptic_advance(stream, frames, frame_size);
+}
