From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Thu, 26 Nov 2026 09:30:00 -0500
Subject: [PATCH] ddraw: Clip the cursor to the display mode again when an exclusive window is activated.

SetCooperativeLevel(), SetDisplayMode() and RestoreDisplayMode() clip the
cursor to the display mode, but when an exclusive mode window is activated
again after a minimize, wined3d restores the mode without clipping. Age of
Wonders then loses the clip after a restore and its edge scrolling moves the
pointer onto another monitor instead.
---
diff -ruN a/dlls/ddraw/ddraw.c b/dlls/ddraw/ddraw.c
--- a/dlls/ddraw/ddraw.c
+++ b/dlls/ddraw/ddraw.c
@@ -5165,6 +5165,19 @@
     else
     {
         InterlockedCompareExchange(&ddraw->device_state, DDRAW_DEVICE_STATE_NOT_RESTORED, DDRAW_DEVICE_STATE_LOST);
+
+        /* wined3d restored the display mode, clip the cursor to it again as
+         * SetCooperativeLevel() and SetDisplayMode() do, or it leaves the
+         * screen once the window was minimized (Age of Wonders edge
+         * scrolling on multiple monitors). */
+        if (ddraw->cooperative_level & DDSCL_EXCLUSIVE)
+        {
+            RECT clip_rect;
+
+            SetRect(&clip_rect, 0, 0, GetSystemMetrics(SM_CXSCREEN), GetSystemMetrics(SM_CYSCREEN));
+            TRACE("Clipping the cursor to %s.\n", wine_dbgstr_rect(&clip_rect));
+            ClipCursor(&clip_rect);
+        }
     }
 }
 
