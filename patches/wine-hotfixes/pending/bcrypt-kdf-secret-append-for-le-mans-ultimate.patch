Subject: [PATCH] bcrypt: support hash KDF append buffers with checked input lengths
Original-author: schlegp
Source: https://github.com/JacKeTUs/wine/commit/cd8cbc6f89fc1c50c98efda742cbf030b2d370d6

Adapted for GE-Proton11-7 with local input-length and null-buffer checks.

--- a/dlls/bcrypt/bcrypt_main.c
+++ b/dlls/bcrypt/bcrypt_main.c
@@ -2709,7 +2709,7 @@
     ULONG buffer_count = desc ? desc->cBuffers : 0;
     UCHAR hash_buf[MAX_HASH_OUTPUT_BYTES];
     struct algorithm *alg = NULL;
-    ULONG secret_len = 0;
+    ULONG prepend_len = 0, append_len = 0, offset, input_len = derived_key_len;
     UCHAR *derived_key;
     NTSTATUS status;
     ULONG i;
@@ -2721,12 +2721,21 @@
             alg = get_hash_alg( desc->pBuffers + i, FALSE );
             if (!alg) return STATUS_NOT_SUPPORTED;
         }
-        else if (desc->pBuffers[i].BufferType == KDF_SECRET_PREPEND) secret_len += desc->pBuffers[i].cbBuffer;
+        else if (desc->pBuffers[i].BufferType == KDF_SECRET_PREPEND
+                || desc->pBuffers[i].BufferType == KDF_SECRET_APPEND)
+        {
+            ULONG len = desc->pBuffers[i].cbBuffer;
+            if (len > ~(ULONG)0 - input_len || (len && !desc->pBuffers[i].pvBuffer))
+                return STATUS_INVALID_PARAMETER;
+            input_len += len;
+            if (desc->pBuffers[i].BufferType == KDF_SECRET_PREPEND) prepend_len += len;
+            else append_len += len;
+        }
         else FIXME( "buffer type %lu not supported\n", desc->pBuffers[i].BufferType );
     }
     if (!alg) alg = get_alg_object( BCRYPT_SHA1_ALG_HANDLE );
 
-    if (!(derived_key = malloc( derived_key_len + secret_len ))) return STATUS_NO_MEMORY;
+    if (!(derived_key = malloc( input_len ))) return STATUS_NO_MEMORY;
 
     params.privkey    = secret->privkey;
     params.pubkey     = secret->pubkey;
@@ -2740,18 +2749,26 @@
     }
     derived_key_len = *params.ret_len;
 
-    if (secret_len)
-    {
-        memmove( derived_key + secret_len, derived_key, derived_key_len );
-
-        secret_len = 0;
+    if (prepend_len || append_len)
+    {
+        memmove( derived_key + prepend_len, derived_key, derived_key_len );
+
+        offset = 0;
         for (i = 0; i < buffer_count; i++)
         {
             if (desc->pBuffers[i].BufferType != KDF_SECRET_PREPEND) continue;
-            memcpy( derived_key + secret_len, desc->pBuffers[i].pvBuffer, desc->pBuffers[i].cbBuffer );
-            secret_len += desc->pBuffers[i].cbBuffer;
-        }
-        derived_key_len += secret_len;
+            memcpy( derived_key + offset, desc->pBuffers[i].pvBuffer, desc->pBuffers[i].cbBuffer );
+            offset += desc->pBuffers[i].cbBuffer;
+        }
+
+        offset = prepend_len + derived_key_len;
+        for (i = 0; i < buffer_count; i++)
+        {
+            if (desc->pBuffers[i].BufferType != KDF_SECRET_APPEND) continue;
+            memcpy( derived_key + offset, desc->pBuffers[i].pvBuffer, desc->pBuffers[i].cbBuffer );
+            offset += desc->pBuffers[i].cbBuffer;
+        }
+        derived_key_len += prepend_len + append_len;
     }
 
     hash_len = builtin_algorithms[alg->id].hash_length;
