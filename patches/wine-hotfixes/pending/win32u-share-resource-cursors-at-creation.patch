From 802d528fcceb32055a8246cb9b6e7605bb139cff Mon Sep 17 00:00:00 2001
From: NEDOSTUPN0 <v.ya.1910@gmail.com>
Date: Sat, 7 Nov 2026 20:33:18 +0100
Subject: [PATCH] win32u: Share resource cursors when they are created.

A process may hand a cursor to another one without ever selecting it
itself. Rockstar's in-game overlay does this: its browser process loads
the system cursors and relays them to the game, which calls SetCursor
with handles owned by the browser process. The browser never selects
them, so share_cursor() is never reached, GetIconInfo fails in the game
and winex11 keeps the window's empty cursor: the pointer disappears
while the overlay is open, and only the arrow, hand or I-beam the game
selected before survives.

Publish shared resource cursors (LR_SHARED, loaded from a module) once
when they are created instead of waiting for the owner's SetCursor.
They are never destroyed, so the cost is one small section for each
system cursor a process loads. Other cursors are still published when
selected.

Extend the cross-process test with a system cursor the parent never
selects.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/user32/tests/cursoricon.c | 5 +++++
 dlls/win32u/cursoricon.c       | 8 ++++++++
 2 files changed, 13 insertions(+)

diff --git a/dlls/user32/tests/cursoricon.c b/dlls/user32/tests/cursoricon.c
index 1baf836b..e2b7e386 100644
--- a/dlls/user32/tests/cursoricon.c
+++ b/dlls/user32/tests/cursoricon.c
@@ -530,6 +530,11 @@ static void test_child_process(void)
             SendMessageA(child, WM_USER+2, ids[i], (LPARAM)cursor);
         }
 
+        /* A system cursor handed over without ever being selected here. */
+        cursor = LoadCursorA(NULL, MAKEINTRESOURCEA(32515)); /* cross */
+        ok(cursor != NULL, "LoadCursor failed\n");
+        SendMessageA(child, WM_USER+2, 32515, (LPARAM)cursor);
+
         memset(mask, 0xff, sizeof(mask) / 2);
         memset(mask + sizeof(mask) / 2, 0, sizeof(mask) / 2);
         cursorInfo.xHotspot = 3;
diff --git a/dlls/win32u/cursoricon.c b/dlls/win32u/cursoricon.c
index 8285f756..7b24f8eb 100644
--- a/dlls/win32u/cursoricon.c
+++ b/dlls/win32u/cursoricon.c
@@ -436,6 +436,7 @@ BOOL WINAPI NtUserSetCursorIconData( HCURSOR cursor, UNICODE_STRING *module, UNI
                                      struct cursoricon_desc *desc )
 {
     struct cursoricon_object *obj;
+    BOOL share = FALSE;
     UINT i, j;
 
     if (!(obj = get_icon_ptr( cursor ))) return FALSE;
@@ -526,10 +527,17 @@ BOOL WINAPI NtUserSetCursorIconData( HCURSOR cursor, UNICODE_STRING *module, UNI
         {
             obj->rsrc = desc->rsrc;
             list_add_head( &icon_cache, &obj->entry );
+            share = TRUE;
         }
     }
 
     release_user_handle_ptr( obj );
+
+    /* A process may hand a cursor to another one without ever selecting it
+     * itself, as Rockstar's in-game overlay does with the system cursors of
+     * its browser process. Shared resource cursors are never destroyed, so
+     * publishing them once at creation costs one small section each. */
+    if (share) share_cursor( cursor );
     return TRUE;
 }
 
