From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Mon, 23 Nov 2026 19:00:00 -0500
Subject: [PATCH] cfgmgr32: Implement DEVPKEY_NAME for devnodes.

Windows reports the friendly name, or the device description when there is
none. Microsoft's GameInput queries it for every HID device and logs an error
when it is missing.

---
--- a/dlls/cfgmgr32/cfgmgr32.c
+++ b/dlls/cfgmgr32/cfgmgr32.c
@@ -737,6 +737,15 @@
         if (*dev->instance) swprintf( id + len, ARRAY_SIZE(id) - len, L"\\%s", dev->instance );
         return return_property_string( prop, id );
     }
+    if (!memcmp( &DEVPKEY_NAME, &prop->key, sizeof(prop->key) ))
+    {
+        /* the display name is the friendly name, falling back to the device description */
+        DWORD size = *prop->size;
+        LSTATUS err = query_named_property( hkey, L"FriendlyName", DEVPROP_TYPE_STRING, prop );
+        if (err != ERROR_NOT_FOUND) return err;
+        *prop->size = size;
+        return query_named_property( hkey, L"DeviceDesc", DEVPROP_TYPE_STRING, prop );
+    }
 
     for (UINT i = 0; i < ARRAY_SIZE(device_properties); i++)
     {
