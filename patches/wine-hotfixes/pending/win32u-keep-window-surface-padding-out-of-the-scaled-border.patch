From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Mon, 24 Nov 2026 23:10:00 -0500
Subject: [PATCH] win32u: Keep window surface padding out of the scaled surface border.

Window surfaces are rounded up to 128 pixels, so the surface of an 800x600
window is 896x640. The scaled surface of a fullscreen window in an emulated
display mode stretched the whole dirty rect, padding included, into the
target, and the unpainted padding covered part of the border: on a 3840x2160
monitor the right pillarbox bar showed garbage from 3360 to 3706.

Clip the stretched copy to the scaled contents.
---

--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -752,9 +752,23 @@
     /* FIXME: implement HALFTONE with alpha for layered surfaces */
     if (!window_surface->alpha_mask) set_stretch_blt_mode( hdc_dst, STRETCH_HALFTONE );
 
+    /* The surface is larger than the window (see get_surface_rect), keep its
+     * unpainted padding out of the border around the scaled contents. */
+    if (!IsRectEmpty( &surface->contents ))
+    {
+        HRGN contents = NtGdiCreateRectRgn( surface->contents.left, surface->contents.top,
+                                            surface->contents.right, surface->contents.bottom );
+        if (contents)
+        {
+            NtGdiExtSelectClipRgn( hdc_dst, contents, RGN_COPY );
+            NtGdiDeleteObjectApp( contents );
+        }
+    }
+
     NtGdiStretchBlt( hdc_dst, dst.left, dst.top, dst.right - dst.left, dst.bottom - dst.top,
                      hdc_src, src.left, src.top, src.right - src.left, src.bottom - src.top,
                      SRCCOPY, 0 );
+    if (!IsRectEmpty( &surface->contents )) intersect_rect( &dst, &dst, &surface->contents );
 
     NtGdiDeleteObjectApp( hdc_dst );
     NtGdiDeleteObjectApp( hdc_src );
