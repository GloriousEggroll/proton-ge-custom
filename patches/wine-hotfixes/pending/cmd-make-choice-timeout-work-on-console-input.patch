From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Tue, 20 Oct 2026 19:00:00 -0600
Subject: [PATCH] cmd: Make CHOICE /T time out when reading from a console.

WCMD_choice() implemented the timeout with an overlapped ReadFile() on
stdin followed by WaitForSingleObject() on the overlapped event. Console
handles are synchronous, so that ReadFile() blocks until a key arrives,
and the timeout never starts. With a hidden console no key ever arrives,
so `choice /D Y /T 3` waits forever.

NCSOFT PURPLE restarts itself after an update with
`cmd /C choice /C Y /N /D Y /T 3 & START PurpleLauncher.exe ...`, which
never got past the choice and left the launcher closed.

When stdin is a console, wait on the input handle with the remaining
timeout and take the next key-down event with ReadConsoleInputW(), as
Windows' choice does. Pipes and files keep the existing path.

https://github.com/GloriousEggroll/proton-ge-custom/issues/870
---
diff --git a/programs/cmd/builtins.c b/programs/cmd/builtins.c
--- a/programs/cmd/builtins.c
+++ b/programs/cmd/builtins.c
@@ -406,6 +406,42 @@
     {
         if (opt_timeout == 0)
             answer[0] = opt_default;
+        else if (have_console)
+        {
+            /* Console handles are synchronous, so the overlapped read below would block
+             * until a key is pressed and never time out. Wait on the input handle and
+             * read key events instead. */
+            HANDLE input = GetStdHandle(STD_INPUT_HANDLE);
+            ULONGLONG deadline = GetTickCount64() + (ULONGLONG)opt_timeout * 1000;
+            INPUT_RECORD ir;
+            DWORD count, wait;
+
+            answer[0] = 0;
+            while (!answer[0] && return_code == NO_ERROR)
+            {
+                if (opt_timeout == -1) wait = INFINITE;
+                else
+                {
+                    ULONGLONG now = GetTickCount64();
+                    wait = now >= deadline ? 0 : deadline - now;
+                }
+                switch (WaitForSingleObject(input, wait))
+                {
+                case WAIT_OBJECT_0:
+                    if (!ReadConsoleInputW(input, &ir, 1, &count))
+                        return_code = ERROR_INVALID_FUNCTION;
+                    else if (count && ir.EventType == KEY_EVENT && ir.Event.KeyEvent.bKeyDown &&
+                             ir.Event.KeyEvent.uChar.UnicodeChar)
+                        answer[0] = ir.Event.KeyEvent.uChar.UnicodeChar;
+                    break;
+                case WAIT_TIMEOUT:
+                    answer[0] = opt_default;
+                    break;
+                default:
+                    return_code = ERROR_INVALID_FUNCTION;
+                }
+            }
+        }
         else
         {
             LARGE_INTEGER li, zeroli = {0};
