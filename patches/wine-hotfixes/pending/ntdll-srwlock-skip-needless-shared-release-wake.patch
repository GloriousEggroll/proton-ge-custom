From f1a25ff823ae58d12aa44dbd37205181e8e2f6a2 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Thu, 15 Oct 2026 20:53:20 +0200
Subject: [PATCH] ntdll: Don't wake exclusive waiters in
 RtlReleaseSRWLockShared() if there are none.

Only RtlAcquireSRWLockExclusive() waits on &owners, and it increments
exclusive_waiters before that, so with exclusive_waiters == 0 there is
nobody to wake. The call takes the futex queue spinlock every time.

MSFS 2024 main thread (perf, 150 s): RtlWakeAddressSingle 5.4% -> ~0%,
ntdll total 24.5% -> 19.1%.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/ntdll/sync.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dlls/ntdll/sync.c b/dlls/ntdll/sync.c
index 18e61e4..e1c1827 100644
--- a/dlls/ntdll/sync.c
+++ b/dlls/ntdll/sync.c
@@ -630,7 +630,7 @@ void WINAPI RtlReleaseSRWLockShared( RTL_SRWLOCK *lock )
         --new.s.owners;
     } while (InterlockedCompareExchange( u.l, new.l, old.l ) != old.l);
 
-    if (!new.s.owners)
+    if (!new.s.owners && new.s.exclusive_waiters)
         RtlWakeAddressSingle( &u.s->owners );
 }
 
