From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Thu, 22 Oct 2026 13:30:00 -0600
Subject: [PATCH] ntdll: Add an opt-out of forced bottom-up allocation order on 64-bit.

ntdll-ForceBottomUpAlloc places every allocation without an address or
limits at the lowest free address, so a large allocation lands right above
the low reserved areas. Native libraries in the process that search a fixed
range for their own memory then find it taken. libcuda searches
0x200000000-0xfff8000000 (up to 16T on newer drivers) when a Vulkan device
is created with VK_NVX_binary_import / VK_NVX_image_view_handle; Star Citizen
allocates 1T at startup, the device creation fails and DXVK falls back to a
device without those extensions, so DLSS is unavailable.

With WINE_DISABLE_BOTTOM_UP_ALLOC=1, let the host place those allocations
instead, which undoes the effect of the patchset for them. This is opt-in
because the patchset exists for games that need bottom-up order. Allocations
with limits or MEM_TOP_DOWN and image mappings are unchanged.
---
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -2472,6 +2472,45 @@
     }
 }
 
+#ifdef _WIN64
+
+static BOOL no_bottom_up_alloc;
+
+/***********************************************************************
+ *           map_host_area
+ *
+ * Map an area at an address chosen by the host.
+ * virtual_mutex must be held by caller.
+ */
+static void *map_host_area( void *end, size_t size, int unix_prot, size_t align_mask )
+{
+    size_t view_size = size + align_mask + 1;
+    struct file_view *view;
+    void *ptr;
+
+    if ((ptr = anon_mmap_alloc( view_size, unix_prot )) == MAP_FAILED) return NULL;
+    ptr = unmap_extra_space( ptr, view_size, size, align_mask );
+    if (is_beyond_limit( ptr, size, end ))
+    {
+        munmap( ptr, size );
+        return NULL;
+    }
+    /* the host only returns unused memory, so native views overlapping it are stale */
+    while ((view = find_view_range( ptr, size )))
+    {
+        if (!(view->protect & VPROT_NATIVE))
+        {
+            ERR( "host mapping %p-%p overlaps view %p\n", ptr, (char *)ptr + size, view->base );
+            munmap( ptr, size );
+            return NULL;
+        }
+        delete_view( view );
+    }
+    return ptr;
+}
+
+#endif  /* _WIN64 */
+
 /***********************************************************************
  *           map_view
  *
@@ -2539,7 +2578,16 @@
         if (limit_low && (void *)limit_low > start) start = (void *)limit_low;
         if (limit_high && (void *)limit_high < end) end = (char *)limit_high + 1;
 
-        if (!(ptr = alloc_free_area( start, end, host_size, top_down, unix_prot, align_mask )))
+        ptr = NULL;
+#ifdef _WIN64
+        /* Forced bottom-up order fills the range native libraries reserve their memory in,
+         * e.g. libcuda searches 8G-1T for it and the Vulkan extensions DLSS needs then fail.
+         * Some games need that order, so let the host place these only when asked to. */
+        if (no_bottom_up_alloc && !top_down && !limit_low && !limit_high)
+            ptr = map_host_area( end, host_size, unix_prot, align_mask );
+#endif
+
+        if (!ptr && !(ptr = alloc_free_area( start, end, host_size, top_down, unix_prot, align_mask )))
         {
             WARN("Allocation failed, clearing native views.\n");
 
@@ -3908,6 +3956,11 @@
 #ifdef _WIN64
     host_addr_space_limit = get_host_addr_space_limit();
     TRACE( "host addr space limit: %p\n", host_addr_space_limit );
+    if ((preload = getenv( "WINE_DISABLE_BOTTOM_UP_ALLOC" )) && *preload == '1')
+    {
+        ERR( "HACK: disabling forced bottom-up allocation order.\n" );
+        no_bottom_up_alloc = TRUE;
+    }
 #else
     host_addr_space_limit = address_space_limit;
 #endif
