From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Sat, 21 Nov 2026 00:00:00 -0500
Subject: [PATCH] win32u: Add WINE_VK_MANAGED_LINEAR to export cross-process
 producers as linear.

Diagnostic for GPU faults in cross-process Vulkan producers (Chromium's
GPU process in the Battle.net launcher on NVIDIA, Wine-Wayland: Xid 13
CT violations, Xid 32/69). The managed swapchain exports its images with
the best modifier the compositor and the driver share, NVIDIA block-linear
there. WINE_VK_MANAGED_LINEAR=1 keeps only DRM_FORMAT_MOD_LINEAR, still
exported as a dmabuf, to tell whether the faults are tied to the tiled
layout. The existing linear fallback is not usable for this: it exports
an opaque fd, which is not a dmabuf on NVIDIA.

When the compositor or the driver offers no linear modifier for the
format, the swapchain falls back as before ("no host-exportable modifier
layout" in +vulkan).

https://github.com/GloriousEggroll/proton-ge-custom/issues/952
---
diff -ruN a/dlls/win32u/vulkan.c b/dlls/win32u/vulkan.c
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -4007,6 +4007,22 @@
                                      VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT );
 }
 
+/* Diagnostic: WINE_VK_MANAGED_LINEAR=1 exports cross-process producer images only
+ * with DRM_FORMAT_MOD_LINEAR, to tell layout-specific driver faults apart. */
+static BOOL vk_managed_force_linear_modifier(void)
+{
+    static int force = -1;
+
+    if (force < 0)
+    {
+        const char *env = getenv( "WINE_VK_MANAGED_LINEAR" );
+
+        force = env && atoi( env ) ? 1 : 0;
+        if (force) WARN( "WINE_VK_MANAGED_LINEAR set, cross-process producers use linear images\n" );
+    }
+    return force;
+}
+
 static uint32_t vk_collect_managed_modifiers( struct vulkan_device *device, VkFormat format,
                                               VkImageUsageFlags usage,
                                               const hwnd_dmabuf_format_modifier_t *caps_mods,
@@ -4032,6 +4048,7 @@
         {
             if (modifier == WINE_VK_DRM_FORMAT_MOD_INVALID)
                 modifier = 0 /* DRM_FORMAT_MOD_LINEAR */;
+            if (modifier != 0 && vk_managed_force_linear_modifier()) continue;
             if (!vk_host_modifier_exportable( device, format, usage, modifier )) continue;
         }
         if (caps_mods[i].tranche_index < best_tranche)
@@ -4056,6 +4073,7 @@
             /* MOD_INVALID means "any/implicit". Let the host pick by offering LINEAR. */
             if (modifier == WINE_VK_DRM_FORMAT_MOD_INVALID)
                 modifier = 0 /* DRM_FORMAT_MOD_LINEAR */;
+            if (modifier != 0 && vk_managed_force_linear_modifier()) continue;
             if (!vk_host_modifier_exportable( device, format, usage, modifier )) continue;
         }
         /* dedupe */
