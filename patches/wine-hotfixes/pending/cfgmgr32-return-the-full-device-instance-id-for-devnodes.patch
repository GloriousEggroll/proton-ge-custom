From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Mon, 23 Nov 2026 19:00:00 -0500
Subject: [PATCH] cfgmgr32: Return the full device instance id for devnodes.

CM_Get_DevNode_PropertyW(DEVPKEY_Device_InstanceId) returned only the last
component of the instance id (e.g. "0&7C:A8:5D:05:A2:28&0&0&0") instead of
"HID\VID_054C&PID_0CE6&MI_03\0&7C:A8:5D:05:A2:28&0&0&0". Microsoft's GameInput
parses the vendor and product ids from it and reported 0000:0000 for HID
devices, so games did not recognize a DualSense as a Sony controller.

---
--- a/dlls/cfgmgr32/cfgmgr32.c
+++ b/dlls/cfgmgr32/cfgmgr32.c
@@ -730,7 +730,13 @@
 static LSTATUS query_device_property( HKEY hkey, const struct device *dev, struct property *prop )
 {
     if (!memcmp( &DEVPKEY_Device_InstanceId, &prop->key, sizeof(prop->key) ))
-        return return_property_string( prop, dev->instance );
+    {
+        WCHAR id[MAX_DEVICE_ID_LEN];
+        UINT len = swprintf( id, ARRAY_SIZE(id), L"%s", dev->enumerator );
+        if (*dev->device) len += swprintf( id + len, ARRAY_SIZE(id) - len, L"\\%s", dev->device );
+        if (*dev->instance) swprintf( id + len, ARRAY_SIZE(id) - len, L"\\%s", dev->instance );
+        return return_property_string( prop, id );
+    }
 
     for (UINT i = 0; i < ARRAY_SIZE(device_properties); i++)
     {
