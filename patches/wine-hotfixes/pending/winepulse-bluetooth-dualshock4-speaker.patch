+/* Bluetooth DualShock 4 controllers have no USB audio function either. Like
+ * for the DualSense, expose the stereo 32 kHz speaker endpoint of a wired
+ * one with the container ID winebus gives the controller, and send it as SBC
+ * in Bluetooth output reports. Layout follows DS4Dongle
+ * (https://github.com/snipem/DS4Dongle). */
+#define BT_DUALSHOCK4_PATH_PREFIX "wine-bluetooth-ds4-hidraw:"
+
+/* Matches the conditions under which winebus presents the controller as USB. */
+static BOOL bt_dualshock4_audio_enabled(void)
+{
+    const char *env;
+
+    if ((env = getenv("PROTON_DUALSHOCK4_BT_AS_USB")) && !strcmp(env, "0"))
+        return FALSE;
+    if ((env = getenv("PROTON_DUALSHOCK4_BT_AUDIO")) && !strcmp(env, "0"))
+        return FALSE;
+    if ((env = getenv("PROTON_EMULATE_STEAMINPUT")) && atoi(env))
+        return FALSE;
+    if ((env = getenv("PROTON_NO_STEAMINPUT")) && !strcmp(env, "1"))
+        return TRUE;
+    return !steam_virtual_gamepad_present();
+}
+
+static void pulse_add_bluetooth_dualshock4_device(struct list *list, const char *hidraw,
+        USHORT pid, const unsigned int *mac)
+{
+    WAVEFORMATEXTENSIBLE *fmt;
+    char pulse_name[160];
+    PhysDevice *dev;
+    size_t len;
+
+    len = snprintf(pulse_name, sizeof(pulse_name), "%sWireless_Controller.%04x.%02x%02x%02x%02x%02x%02x",
+            BT_DUALSENSE_PULSE_PREFIX, pid, mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+    if (pulse_find_device(list, pulse_name))
+        return;
+    if (!(dev = calloc(1, FIELD_OFFSET(PhysDevice, pulse_name[len + 1]))))
+        return;
+    if (!(dev->name = get_device_name("Wireless Controller", NULL)) || !(dev->bt_hidraw = strdup(hidraw)))
+    {
+        free(dev->name);
+        free(dev);
+        return;
+    }
+
+    dev->bt_dualshock4 = TRUE;
+    dev->flow = eRender;
+    dev->form = Speakers;
+    dev->channel_mask = KSAUDIO_SPEAKER_STEREO;
+    dev->bus_type = phys_device_bus_usb;
+    dev->vendor_id = 0x054c;
+    dev->product_id = pid;
+    dev->alsa_card = -1;
+    dev->container_id = bt_dualsense_container_id(pid, mac);
+    dev->def_period = 100000;
+    dev->min_period = 30000;
+    dev->ready = TRUE;
+    dev->probe_status = 0;
+    pthread_mutex_init(&dev->ready_mutex, NULL);
+    pthread_cond_init(&dev->ready_cond, NULL);
+
+    fmt = &dev->fmt;
+    fmt->Format.wFormatTag = WAVE_FORMAT_EXTENSIBLE;
+    fmt->Format.nChannels = 2;
+    fmt->Format.nSamplesPerSec = 32000;
+    fmt->Format.wBitsPerSample = 32;
+    fmt->Format.nBlockAlign = 8;
+    fmt->Format.nAvgBytesPerSec = 32000 * 8;
+    fmt->Format.cbSize = sizeof(WAVEFORMATEXTENSIBLE) - sizeof(WAVEFORMATEX);
+    fmt->Samples.wValidBitsPerSample = 32;
+    fmt->dwChannelMask = KSAUDIO_SPEAKER_STEREO;
+    fmt->SubFormat = KSDATAFORMAT_SUBTYPE_IEEE_FLOAT;
+
+    memcpy(dev->pulse_name, pulse_name, len + 1);
+    if (!pulse_set_endpoint_id(dev, list))
+    {
+        pulse_dev_free(dev);
+        return;
+    }
+    list_add_tail(list, &dev->entry);
+    TRACE("Added Bluetooth DualShock 4 speaker endpoint %s for %s, container %s.\n",
+            debugstr_a(dev->pulse_name), hidraw, debugstr_guid(&dev->container_id));
+}
+
+/* Returns the hidraw path for a Bluetooth DualShock 4 endpoint, or NULL. */
+static char *pulse_find_bluetooth_dualshock4_path(const char *name)
+{
+    PhysDevice *dev;
+    char *path = NULL;
+
+    if (!name)
+        return NULL;
+    g_phys_lock();
+    LIST_FOR_EACH_ENTRY(dev, &g_phys_speakers, PhysDevice, entry)
+    {
+        size_t len;
+
+        if (!dev->bt_dualshock4 || !pulse_device_matches(dev, name))
+            continue;
+        len = sizeof(BT_DUALSHOCK4_PATH_PREFIX) + strlen(dev->bt_hidraw);
+        if ((path = malloc(len)))
+            snprintf(path, len, "%s%s", BT_DUALSHOCK4_PATH_PREFIX, dev->bt_hidraw);
+        break;
+    }
+    g_phys_unlock();
+    return path;
+}
