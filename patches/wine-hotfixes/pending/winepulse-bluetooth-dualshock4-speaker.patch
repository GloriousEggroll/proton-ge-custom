+/* The DualShock 4 speaker takes SBC over Bluetooth: 32 kHz dual channel,
+ * 16 blocks, 8 subbands, loudness allocation, bitpool 25, which gives 112 byte
+ * frames of 128 samples, four per output report #0x17 (16 ms), as DS4Dongle
+ * sends them. libsbc is loaded at runtime; without it no speaker audio is
+ * sent. */
+#define BT_DUALSHOCK4_RATE 32000
+#define BT_DUALSHOCK4_AUDIO_REPORT_ID 0x17
+#define BT_DUALSHOCK4_AUDIO_REPORT_SIZE 462
+#define BT_DUALSHOCK4_SBC_FRAME_SAMPLES 128
+#define BT_DUALSHOCK4_SBC_FRAME_SIZE 112
+#define BT_DUALSHOCK4_SBC_FRAMES_PER_REPORT 4
+#define BT_DUALSHOCK4_AUDIO_TARGET_SPEAKER 0x02
+#define BT_DUALSHOCK4_AUDIO_TARGET_HEADSET 0x24
+#define BT_DUALSHOCK4_OUTPUT_REPORT_ID 0x11
+#define BT_DUALSHOCK4_OUTPUT_REPORT_SIZE 78
+#define BT_DUALSHOCK4_VOLUME 0x50
+
+/* struct sbc_struct from sbc/sbc.h. */
+struct bt_sbc
+{
+    unsigned long flags;
+    uint8_t frequency;
+    uint8_t blocks;
+    uint8_t subbands;
+    uint8_t mode;
+    uint8_t allocation;
+    uint8_t bitpool;
+    uint8_t endian;
+    void *priv;
+    void *priv_alloc_base;
+};
+
+static int (*p_sbc_init)(struct bt_sbc *, unsigned long);
+static ssize_t (*p_sbc_encode)(struct bt_sbc *, const void *, size_t, void *, size_t, ssize_t *);
+static void (*p_sbc_finish)(struct bt_sbc *);
+static pthread_once_t bt_dualshock4_sbc_once = PTHREAD_ONCE_INIT;
+
+static void bt_dualshock4_load_sbc(void)
+{
+    void *handle;
+
+    if (!(handle = dlopen("libsbc.so.1", RTLD_NOW)))
+    {
+        WARN("libsbc not found, Bluetooth DualShock 4 speaker audio is disabled.\n");
+        return;
+    }
+    p_sbc_init = dlsym(handle, "sbc_init");
+    p_sbc_encode = dlsym(handle, "sbc_encode");
+    p_sbc_finish = dlsym(handle, "sbc_finish");
+    if (!p_sbc_init || !p_sbc_encode || !p_sbc_finish)
+    {
+        WARN("libsbc is missing symbols, Bluetooth DualShock 4 speaker audio is disabled.\n");
+        p_sbc_init = NULL;
+        dlclose(handle);
+    }
+}
+
+static struct bt_sbc *bt_dualshock4_create_sbc(void)
+{
+    struct bt_sbc *sbc;
+
+    pthread_once(&bt_dualshock4_sbc_once, bt_dualshock4_load_sbc);
+    if (!p_sbc_init || !(sbc = calloc(1, sizeof(*sbc))))
+        return NULL;
+    if (p_sbc_init(sbc, 0) < 0)
+    {
+        WARN("sbc_init failed.\n");
+        free(sbc);
+        return NULL;
+    }
+    sbc->frequency = 0x01;  /* SBC_FREQ_32000 */
+    sbc->blocks = 0x03;     /* SBC_BLK_16 */
+    sbc->subbands = 0x01;   /* SBC_SB_8 */
+    sbc->mode = 0x01;       /* SBC_MODE_DUAL_CHANNEL */
+    sbc->allocation = 0x00; /* SBC_AM_LOUDNESS */
+    sbc->bitpool = 25;
+    sbc->endian = 0x00;     /* SBC_LE */
+    return sbc;
+}
+
+static void bt_dualshock4_destroy_sbc(struct bt_sbc *sbc)
+{
+    if (!sbc) return;
+    p_sbc_finish(sbc);
+    free(sbc);
+}
