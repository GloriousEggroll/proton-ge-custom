+static void bt_dualshock4_update_jack(struct bt_dualsense_mixer *mixer)
+{
+    BYTE buf[128];
+    ssize_t len;
+
+    /* Bluetooth report 0x11 holds the USB input report from byte 3, the
+     * headset jack state is USB byte 30, bit 5. */
+    while ((len = read(mixer->fd, buf, sizeof(buf))) > 0)
+    {
+        if (buf[0] == 0x11 && len >= 33 && mixer->headphones != !!(buf[32] & 0x20))
+        {
+            mixer->headphones = !!(buf[32] & 0x20);
+            TRACE("Bluetooth DualShock 4 %s: headset %s (status %#x).\n", mixer->path,
+                    mixer->headphones ? "plugged" : "unplugged", buf[32]);
+        }
+    }
+}
+
+/* Speaker and headset volume: output report #0x11 with only the volume
+ * fields marked valid, so lightbar and rumble state are left alone. Resent
+ * every second while audio plays, games may change it through their own
+ * output reports. */
+static void bt_dualshock4_send_volume(struct bt_dualsense_mixer *mixer)
+{
+    BYTE report[BT_DUALSHOCK4_OUTPUT_REPORT_SIZE] = {0};
+
+    if (mixer->volume_time && pa_rtclock_now() - mixer->volume_time < 1000000)
+        return;
+    report[0] = BT_DUALSHOCK4_OUTPUT_REPORT_ID;
+    report[1] = 0xc0; /* HID, CRC */
+    report[2] = 0x20;
+    report[3] = 0x10 | 0x20 | 0x80; /* headset left, headset right, speaker volume */
+    report[21] = report[22] = report[24] = BT_DUALSHOCK4_VOLUME;
+    bt_dualsense_set_crc(report, sizeof(report));
+    if (write(mixer->fd, report, sizeof(report)) < 0 && errno != EAGAIN)
+        WARN("Bluetooth DualShock 4 volume write failed: %s\n", strerror(errno));
+    mixer->volume_time = pa_rtclock_now();
+}
+
+static void bt_dualshock4_send_chunk(struct bt_dualsense_mixer *mixer, const int16_t (*pcm)[4])
+{
+    BYTE report[BT_DUALSHOCK4_AUDIO_REPORT_SIZE] = {0};
+    int16_t block[BT_DUALSHOCK4_SBC_FRAME_SAMPLES * 2];
+    BOOL signal = FALSE;
+    ssize_t consumed, written;
+    UINT32 i, f;
+
+    for (i = 0; i < BT_DUALSENSE_SPEAKER_WINDOW_FRAMES; ++i)
+        signal |= pcm[i][0] || pcm[i][1];
+    mixer->stat_signal += signal;
+
+    /* Keep going a little past the last sound so the decoder flushes its
+     * tail, then stop until the game plays audio again. */
+    if (signal)
+        mixer->spk_idle_chunks = 0;
+    else if (mixer->spk_idle_chunks < 16)
+        ++mixer->spk_idle_chunks;
+    if (!mixer->sbc || mixer->spk_idle_chunks >= 16)
+    {
+        mixer->stat_skipped++;
+        return;
+    }
+
+    bt_dualshock4_update_jack(mixer);
+    bt_dualshock4_send_volume(mixer);
+
+    report[0] = BT_DUALSHOCK4_AUDIO_REPORT_ID;
+    report[1] = 0x40;
+    report[2] = 0xa0;
+    report[3] = mixer->sbc_frames;
+    report[4] = mixer->sbc_frames >> 8;
+    report[5] = mixer->headphones ? BT_DUALSHOCK4_AUDIO_TARGET_HEADSET : BT_DUALSHOCK4_AUDIO_TARGET_SPEAKER;
+    for (f = 0; f < BT_DUALSHOCK4_SBC_FRAMES_PER_REPORT; ++f)
+    {
+        for (i = 0; i < BT_DUALSHOCK4_SBC_FRAME_SAMPLES; ++i)
+        {
+            block[i * 2] = pcm[f * BT_DUALSHOCK4_SBC_FRAME_SAMPLES + i][0];
+            block[i * 2 + 1] = pcm[f * BT_DUALSHOCK4_SBC_FRAME_SAMPLES + i][1];
+        }
+        written = 0;
+        consumed = p_sbc_encode(mixer->sbc, block, sizeof(block),
+                report + 6 + f * BT_DUALSHOCK4_SBC_FRAME_SIZE, BT_DUALSHOCK4_SBC_FRAME_SIZE, &written);
+        if (consumed != sizeof(block) || written != BT_DUALSHOCK4_SBC_FRAME_SIZE)
+        {
+            WARN("sbc_encode failed: %d, %d bytes.\n", (int)consumed, (int)written);
+            return;
+        }
+    }
+    mixer->sbc_frames += BT_DUALSHOCK4_SBC_FRAMES_PER_REPORT;
+    bt_dualsense_set_crc(report, sizeof(report));
+
+    mixer->stat_speaker++;
+    if (write(mixer->fd, report, sizeof(report)) < 0)
+    {
+        if (errno == EAGAIN) mixer->stat_eagain++;
+        else WARN("Bluetooth DualShock 4 audio write failed: %s\n", strerror(errno));
+    }
+}
