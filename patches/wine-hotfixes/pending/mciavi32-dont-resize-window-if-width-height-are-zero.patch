From 80a1173ba5dce3c31e87ba82da9dfe5a8aae741a Mon Sep 17 00:00:00 2001
From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Tue, 24 Nov 2026 12:02:19 +1100
Subject: [PATCH] mciavi32: Dont resize window if width/height are zero

Wine-Bug: https://bugs.winehq.org/show_bug.cgi?id=60864
Wine-Bug: https://bugs.winehq.org/show_bug.cgi?id=60863
---
 dlls/mciavi32/wnd.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/dlls/mciavi32/wnd.c b/dlls/mciavi32/wnd.c
index bf3b23e393a..cadc4f01049 100644
--- a/dlls/mciavi32/wnd.c
+++ b/dlls/mciavi32/wnd.c
@@ -205,8 +205,13 @@ DWORD	MCIAVI_mciPut(UINT wDevID, DWORD dwFlags, LPMCI_DGV_PUT_PARMS lpParms)
         return MCIERR_UNRECOGNIZED_COMMAND;
     }
     if (dwFlags & MCI_DGV_PUT_WINDOW) {
+        UINT pos_flags = SWP_NOZORDER;
+
         TRACE("PUT_WINDOW %s\n", wine_dbgstr_rect(&rc));
-        SetWindowPos(wma->hWndPaint, NULL, rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top, SWP_NOZORDER);
+
+        if (lpParms->rc.right == 0 && lpParms->rc.bottom == 0)
+            pos_flags |= SWP_NOSIZE;
+        SetWindowPos(wma->hWndPaint, NULL, rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top, pos_flags);
     }
     LeaveCriticalSection(&wma->cs);
     return 0;
-- 
2.53.0

