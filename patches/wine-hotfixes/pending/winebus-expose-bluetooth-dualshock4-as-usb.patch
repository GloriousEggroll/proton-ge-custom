From: GloriousEggroll <gloriouseggroll@gmail.com>
Subject: [PATCH] winebus: expose Bluetooth DualShock 4 controllers as USB ones.

Like the Bluetooth DualSense, present a Bluetooth DualShock 4 (05c4 / 09cc)
with its USB report descriptor, USB bus and HID interface 3 when Steam Input
is disabled. Games written for a wired DS4 get the 64 byte USB input report,
and their USB output and feature reports are translated: output #5 goes out
as Bluetooth #0x11 with its CRC, calibration #2 comes from Bluetooth #5,
the MAC reports #0x12 / #0x81 come from the Bluetooth address, the firmware
report #0xa3 is padded to its USB size, and the USB initialization report
#0x14 is consumed. This reuses the existing DualShock 4 v2 as v1 Bluetooth
translation, which already did this for a different generation.

PROTON_DUALSHOCK4_BT_AS_USB=0 keeps the Bluetooth layout.

Report layouts as in the Linux hid-playstation driver and DS4Dongle
(https://github.com/snipem/DS4Dongle, MIT license).
---
--- a/dlls/winebus.sys/unixlib.h
+++ b/dlls/winebus.sys/unixlib.h
@@ -45,6 +45,7 @@
     BOOL spoof_dualshock4_v1;
     BOOL spoof_dualsense;
     BOOL spoof_dualsense_usb;
+    BOOL spoof_dualshock4_usb;
     BOOL use_xbox_identity;
 
     WCHAR manufacturer[MAX_PATH];
--- a/dlls/winebus.sys/bus_udev.c
+++ b/dlls/winebus.sys/bus_udev.c
@@ -1568,6 +1568,16 @@
     return sony_steam_input_disabled();
 }
 
+/* Enabled by default when Steam Input is disabled; PROTON_DUALSHOCK4_BT_AS_USB=0
+ * keeps the Bluetooth report layout. */
+static BOOL spoof_bluetooth_dualshock4_as_usb(void)
+{
+    const char *env = getenv("PROTON_DUALSHOCK4_BT_AS_USB");
+
+    if (env && !strcmp(env, "0")) return FALSE;
+    return sony_steam_input_disabled();
+}
+
 /* Bluetooth controllers have no USB topology to derive a container ID from.
  * Use one based on the controller address instead; winepulse computes the
  * same value for the synthetic haptics endpoint of the controller. */
@@ -1655,6 +1665,20 @@
                 desc.pid == 0x0df2 && !desc.spoof_dualsense ? " Edge" : "");
     }
 
+    if (!desc.is_gamepad && !desc.spoof_dualshock4 && desc.bus_type == BUS_TYPE_BLUETOOTH &&
+            desc.vid == 0x054c && (desc.pid == 0x05c4 || desc.pid == 0x09cc) &&
+            spoof_bluetooth_dualshock4_as_usb())
+    {
+        /* Present the Bluetooth controller with its USB report layout, the way
+         * games expect a wired DualShock 4. Interface 3 matches the USB HID
+         * interface in the instance path. */
+        desc.spoof_dualshock4_usb = TRUE;
+        desc.input = 3;
+        set_bluetooth_dualsense_container_id(&desc);
+        TRACE("exposing Bluetooth DualShock 4 %04x:%04x as a USB DualShock 4%s.\n",
+                desc.vid, desc.pid, desc.spoof_dualshock4_v1 ? " v1" : "");
+    }
+
     if (!desc.product[0] && ioctl(fd, HIDIOCGRAWNAME(sizeof(buffer) - 1), buffer) >= 0)
         ntdll_umbstowcs(buffer, strlen(buffer) + 1, desc.product, ARRAY_SIZE(desc.product));
 
