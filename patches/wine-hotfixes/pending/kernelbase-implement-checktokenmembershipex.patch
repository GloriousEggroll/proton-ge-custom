From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Mon, 23 Nov 2026 19:00:00 -0500
Subject: [PATCH] kernelbase: Implement CheckTokenMembershipEx.

The Microsoft GameInput redistributable imports it through
api-ms-win-security-base-l1-2-0 and aborts on the unimplemented stub as soon
as it runs its regular (non-Wine) backend.

CTMF_INCLUDE_APPCONTAINER is the only defined flag and has no effect without
app containers, so forward to CheckTokenMembership.

---
--- a/dlls/kernelbase/kernelbase.spec
+++ b/dlls/kernelbase/kernelbase.spec
@@ -131,7 +131,7 @@
 @ stdcall CheckRemoteDebuggerPresent(long ptr)
 # @ stub CheckTokenCapability
 @ stdcall CheckTokenMembership(long ptr ptr)
-# @ stub CheckTokenMembershipEx
+@ stdcall CheckTokenMembershipEx(long ptr long ptr)
 @ stdcall ChrCmpIA(long long)
 @ stdcall ChrCmpIW(long long)
 @ stdcall ClearCommBreak(long)
--- a/dlls/kernelbase/security.c
+++ b/dlls/kernelbase/security.c
@@ -618,6 +618,22 @@
     return ret;
 }
 
+/******************************************************************************
+ * CheckTokenMembershipEx    (kernelbase.@)
+ */
+BOOL WINAPI CheckTokenMembershipEx( HANDLE token, PSID sid_to_check, DWORD flags, PBOOL is_member )
+{
+    TRACE( "(%p %s %#lx %p)\n", token, debugstr_sid(sid_to_check), flags, is_member );
+
+    /* CTMF_INCLUDE_APPCONTAINER makes no difference without app containers. */
+    if (flags & ~0x1)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return CheckTokenMembership( token, sid_to_check, is_member );
+}
+
 /*************************************************************************
  * CreateRestrictedToken    (kernelbase.@)
  */
