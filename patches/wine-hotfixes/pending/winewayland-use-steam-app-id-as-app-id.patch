From: GloriousEggroll <gloriouseggroll@gmail.com>
Subject: [PATCH] winewayland: use steam_app_<SteamAppId> as the xdg app ID, like winex11.

winex11 sets WM_CLASS to steam_app_<SteamAppId>, while winewayland used the
lowercased exe name, so compositors and Steam identified the same game
differently on Wayland and XWayland. Use steam_app_<SteamAppId> when SteamAppId
is set and fall back to the exe name otherwise.

Refs: https://github.com/GloriousEggroll/proton-ge-custom/issues/937
---
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -74,6 +74,7 @@
 
 extern char *process_activate_token;
 extern char *process_name;
+extern char *process_app_id;
 extern struct wayland process_wayland;
 
 /**********************************************************************
--- a/dlls/winewayland.drv/waylanddrv_main.c
+++ b/dlls/winewayland.drv/waylanddrv_main.c
@@ -24,7 +24,9 @@
 
 #include "config.h"
 
+#include <stdio.h>
 #include <stdlib.h>
+#include <string.h>
 #include <errno.h>
 
 #include "ntstatus.h"
@@ -35,6 +37,7 @@
 WINE_DEFAULT_DEBUG_CHANNEL(waylanddrv);
 
 char *process_name = NULL;
+char *process_app_id = NULL;
 char *process_activate_token = NULL;
 
 static UINT WAYLAND_GetForeignGdiSurfaceCaps(void)
@@ -104,6 +107,26 @@
     }
 }
 
+static void wayland_init_app_id(void)
+{
+    const char *steam_app_id = getenv("SteamAppId");
+    size_t size;
+
+    /* Match the WM_CLASS winex11 sets, so games are identified the same way
+     * on Wayland and XWayland. */
+    if (steam_app_id && *steam_app_id)
+    {
+        size = sizeof("steam_app_") + strlen(steam_app_id);
+        if ((process_app_id = malloc(size)))
+        {
+            snprintf(process_app_id, size, "steam_app_%s", steam_app_id);
+            return;
+        }
+    }
+
+    process_app_id = process_name;
+}
+
 static void wayland_init_activation_token(void)
 {
     char *env;
@@ -144,6 +167,7 @@
     __wine_set_user_driver(&waylanddrv_funcs, WINE_GDI_DRIVER_VERSION);
 
     wayland_init_process_name();
+    wayland_init_app_id();
     wayland_init_activation_token();
 
     if (!wayland_process_init()) goto err;
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -1685,8 +1685,8 @@
     if (!surface->xdg_toplevel) goto err;
     xdg_toplevel_add_listener(surface->xdg_toplevel, &xdg_toplevel_listener, surface->hwnd);
 
-    if (process_name)
-        xdg_toplevel_set_app_id(surface->xdg_toplevel, process_name);
+    if (process_app_id)
+        xdg_toplevel_set_app_id(surface->xdg_toplevel, process_app_id);
 
     if (process_wayland.xdg_toplevel_tag_manager_v1)
     {
@@ -5653,7 +5653,7 @@
     }
 
     xdg_activation_token_v1_set_surface(token, surface->wl_surface);
-    if (process_name && activate) xdg_activation_token_v1_set_app_id(token, process_name);
+    if (process_app_id && activate) xdg_activation_token_v1_set_app_id(token, process_app_id);
 
     pthread_mutex_lock(&seat->mutex);
     if (activate && seat->wl_seat) xdg_activation_token_v1_set_serial(token, serial, seat->wl_seat);
