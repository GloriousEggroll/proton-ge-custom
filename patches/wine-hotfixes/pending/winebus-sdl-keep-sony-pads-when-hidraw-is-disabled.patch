From: GloriousEggroll <gloriouseggroll@gmail.com>
Subject: [PATCH] winebus: keep Sony pads on SDL when hidraw is disabled for them.

The SDL backend always skips DualShock 4 and DualSense pads so that hidraw
handles their native reports, and the bus refuses any non-hidraw DualSense
or DualSense Edge. When hidraw is disabled for them, either with
PROTON_DISABLE_HIDRAW (set by PROTON_PREFER_SDL / sdlinput, and for Sony pads
on the Steam Deck) or the DisableHidraw bus option, neither backend creates
the device and the pad disappears. Only leave them to hidraw when hidraw
will take them.
---
--- a/dlls/winebus.sys/bus_sdl.c
+++ b/dlls/winebus.sys/bus_sdl.c
@@ -945,6 +945,19 @@
     return FALSE;
 }
 
+/* Sony pads are left to hidraw, unless hidraw won't take them. */
+static BOOL is_sony_hidraw_disabled(WORD vid, WORD pid)
+{
+    const char *env = getenv("PROTON_DISABLE_HIDRAW");
+    char needle[16];
+
+    if (options->disable_hidraw) return TRUE;
+    if (!env) return FALSE;
+    if (!strcmp(env, "1")) return TRUE;
+    sprintf(needle, "0x%04x/0x%04x", vid, pid);
+    return strcasestr(env, needle) != NULL;
+}
+
 static BOOL is_emulating_steaminput(void)
 {
     const char *env = getenv("PROTON_EMULATE_STEAMINPUT");
@@ -1042,8 +1055,9 @@
         pSDL_JoystickClose(joystick);
         return;
     }
-    if (is_dualsense_gamepad(desc.vid, desc.pid) ||
-            is_dualshock4_gamepad(desc.vid, desc.pid))
+    if ((is_dualsense_gamepad(desc.vid, desc.pid) ||
+            is_dualshock4_gamepad(desc.vid, desc.pid)) &&
+            !is_sony_hidraw_disabled(desc.vid, desc.pid))
     {
         TRACE("ignoring SDL Sony controller %s; hidraw handles native reports.\n",
                 debugstr_device_desc(&desc));
--- a/dlls/winebus.sys/main.c
+++ b/dlls/winebus.sys/main.c
@@ -2022,7 +2022,8 @@
             else /* desc.is_hidraw == FALSE */
             {
                 RtlEnterCriticalSection(&device_list_cs);
-                if (is_dualsense_gamepad(desc.vid, desc.pid)) device = NULL;
+                /* hidraw takes DualSense pads, unless it is disabled for them */
+                if (hidraw_enabled && is_dualsense_gamepad(desc.vid, desc.pid)) device = NULL;
                 else if (hidraw_enabled && bus_find_device_from_vid_pid(TRUE, &event->device_created.desc, &usages)) device = NULL;
                 else device = bus_create_hid_device(&event->device_created.desc, event->device);
                 RtlLeaveCriticalSection(&device_list_cs);
