+/* Enabled by default when Steam Input is disabled; PROTON_DUALSENSE_BT_AS_USB=0
+ * keeps the Bluetooth report layout. */
+static BOOL spoof_bluetooth_dualsense_as_usb(void)
+{
+    const char *env = getenv("PROTON_DUALSENSE_BT_AS_USB");
+
+    if (env && !strcmp(env, "0")) return FALSE;
+    return sony_steam_input_disabled();
+}
+
+/* Bluetooth controllers have no USB topology to derive a container ID from.
+ * Use one based on the controller address instead; winepulse computes the
+ * same value for the synthetic haptics endpoint of the controller. */
+static void set_bluetooth_dualsense_container_id(struct device_desc *desc)
+{
+    unsigned int mac[6];
+    char uniq[64];
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(uniq) - 1 && desc->serialnumber[i]; ++i)
+        uniq[i] = desc->serialnumber[i] < 0x80 ? desc->serialnumber[i] : '?';
+    uniq[i] = 0;
+    if (sscanf(uniq, "%x:%x:%x:%x:%x:%x", &mac[0], &mac[1], &mac[2], &mac[3], &mac[4], &mac[5]) != 6)
+    {
+        WARN("could not parse Bluetooth DualSense address %s.\n", debugstr_a(uniq));
+        return;
+    }
+
+    desc->bus_container_id.Data1 = MAKELONG(desc->vid, desc->pid);
+    desc->bus_container_id.Data2 = 0x4254;
+    desc->bus_container_id.Data3 = (mac[0] << 8) | mac[1];
+    for (i = 0; i < 4; ++i) desc->bus_container_id.Data4[i] = mac[i + 2];
+    memset(desc->bus_container_id.Data4 + 4, 0, 4);
+    TRACE("Created Bluetooth DualSense container ID %s.\n", debugstr_guid(&desc->bus_container_id));
+}
