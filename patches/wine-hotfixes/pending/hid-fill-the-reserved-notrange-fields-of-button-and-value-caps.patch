From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Mon, 23 Nov 2026 19:00:00 -0500
Subject: [PATCH] hid: Fill the reserved NotRange fields of button and value caps.

For caps that are not ranges, Windows repeats the usage, string,
designator and data index in NotRange.Reserved1 to Reserved4, which overlay
Range.UsageMax, StringMax, DesignatorMax and DataIndexMax. The expected caps
in dinput/tests/hid.c already list them that way.

Microsoft's GameInput walks Range.UsageMin..UsageMax for every cap. With the
reserved fields left at 0 it skipped every non-range axis and hat switch, so
HID gamepads such as the DualSense had no axes and their sticks read as fully
deflected.

---
--- a/dlls/hid/hidp.c
+++ b/dlls/hid/hidp.c
@@ -707,8 +707,8 @@
     dst->IsRange = (caps->flags & HID_VALUE_CAPS_IS_RANGE) ? 1 : 0;
     if (!dst->IsRange)
     {
-        dst->NotRange.Usage = caps->usage_min;
-        dst->NotRange.DataIndex = caps->data_index_min;
+        dst->NotRange.Usage = dst->NotRange.Reserved1 = caps->usage_min;
+        dst->NotRange.DataIndex = dst->NotRange.Reserved4 = caps->data_index_min;
     }
     else
     {
@@ -719,7 +719,7 @@
     }
     dst->IsStringRange = (caps->flags & HID_VALUE_CAPS_IS_STRING_RANGE) ? 1 : 0;
     if (!dst->IsStringRange)
-        dst->NotRange.StringIndex = caps->string_min;
+        dst->NotRange.StringIndex = dst->NotRange.Reserved2 = caps->string_min;
     else
     {
         dst->Range.StringMin = caps->string_min;
@@ -727,7 +727,7 @@
     }
     dst->IsDesignatorRange = (caps->flags & HID_VALUE_CAPS_IS_DESIGNATOR_RANGE) ? 1 : 0;
     if (!dst->IsDesignatorRange)
-        dst->NotRange.DesignatorIndex = caps->designator_min;
+        dst->NotRange.DesignatorIndex = dst->NotRange.Reserved3 = caps->designator_min;
     else
     {
         dst->Range.DesignatorMin = caps->designator_min;
@@ -773,8 +773,8 @@
     if (!dst->IsRange)
     {
         dst->ReportCount = caps->report_count;
-        dst->NotRange.Usage = caps->usage_min;
-        dst->NotRange.DataIndex = caps->data_index_min;
+        dst->NotRange.Usage = dst->NotRange.Reserved1 = caps->usage_min;
+        dst->NotRange.DataIndex = dst->NotRange.Reserved4 = caps->data_index_min;
     }
     else
     {
@@ -786,7 +786,7 @@
     }
     dst->IsStringRange = (caps->flags & HID_VALUE_CAPS_IS_STRING_RANGE) ? 1 : 0;
     if (!dst->IsStringRange)
-        dst->NotRange.StringIndex = caps->string_min;
+        dst->NotRange.StringIndex = dst->NotRange.Reserved2 = caps->string_min;
     else
     {
         dst->Range.StringMin = caps->string_min;
@@ -794,7 +794,7 @@
     }
     dst->IsDesignatorRange = (caps->flags & HID_VALUE_CAPS_IS_DESIGNATOR_RANGE) ? 1 : 0;
     if (!dst->IsDesignatorRange)
-        dst->NotRange.DesignatorIndex = caps->designator_min;
+        dst->NotRange.DesignatorIndex = dst->NotRange.Reserved3 = caps->designator_min;
     else
     {
         dst->Range.DesignatorMin = caps->designator_min;
