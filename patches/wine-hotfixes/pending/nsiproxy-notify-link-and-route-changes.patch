@@ -375,6 +375,12 @@ DWORD WINAPI NsiRequestChangeNotificationEx( struct nsi_request_change_notificat
     if (!(ovr = params->ovr))
     {
         overlapped.hEvent = CreateEventW( NULL, FALSE, FALSE, NULL );
+        if (!overlapped.hEvent)
