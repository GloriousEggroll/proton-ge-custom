-            if(irp->Cancel)
-            {
-                /* Cancel routine should care of freeing data and completing IRP. */
-                TRACE( "irp %p canceled.\n", irp );
-                continue;
-            }
-            if (!NmrIsEqualNpiModuleId( &data->module, &params.module ) || data->table != params.table)
-                continue;
