-    ULONG in_size = sizeof(struct nsiproxy_get_parameter), received;
-    OVERLAPPED overlapped, *ovr;
+    ULONG in_size = sizeof(*in), received;
+    OVERLAPPED overlapped = {0}, *ovr;
     DWORD err = ERROR_SUCCESS;
