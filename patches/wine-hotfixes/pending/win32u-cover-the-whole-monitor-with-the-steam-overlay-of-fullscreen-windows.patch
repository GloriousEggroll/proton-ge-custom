From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Wed, 25 Nov 2026 17:50:28 -0500
Subject: [PATCH] win32u: Cover the whole monitor with the Steam overlay of
 fullscreen windows.

On Wine-Wayland the overlay bridge draws the Steam overlay of OpenGL games
over the rect win32u gives it, which was the scaled client area. A
fullscreen window in an emulated display mode keeps its aspect ratio, so the
overlay only covered the pillarboxed contents instead of the whole screen,
unlike the overlay of other games.

Use the raw monitor rect when the toplevel window covers its monitor.

diff --git a/dlls/win32u/opengl.c b/dlls/win32u/opengl.c
index 7b1094d..3c375ba 100644
--- a/dlls/win32u/opengl.c
+++ b/dlls/win32u/opengl.c
@@ -1514,8 +1514,10 @@ static BOOL load_steam_overlay_opengl_bridge(void)
 
 static void steam_overlay_opengl_dispatch( struct opengl_drawable *drawable )
 {
-    RECT rect, virtual_rect, monitor_rect;
-    HWND hwnd;
+    RECT rect, virtual_rect, monitor_rect, window_rect;
+    MONITORINFO monitor_info = {.cbSize = sizeof(monitor_info)};
+    HMONITOR monitor;
+    HWND hwnd, toplevel;
     UINT width, height;
     UINT dpi;
     int x, y;
@@ -1527,6 +1529,19 @@ static void steam_overlay_opengl_dispatch( struct opengl_drawable *drawable )
     dpi = get_thread_dpi();
     if (!get_client_rect_rel( hwnd, COORDS_SCREEN, &rect, dpi )) return;
     rect = map_rect_virt_to_raw( rect, dpi );
+
+    /* A fullscreen window in an emulated display mode keeps its aspect ratio
+     * with a pillarbox or letterbox; cover the whole monitor, as the overlay
+     * does on X11, rather than only the scaled client area. */
+    toplevel = NtUserGetAncestor( hwnd, GA_ROOT );
+    if (toplevel && get_window_rect( toplevel, &window_rect, dpi ) &&
+        (monitor = monitor_from_window( toplevel, MONITOR_DEFAULTTONEAREST, dpi )) &&
+        NtUserGetMonitorInfo( monitor, &monitor_info ) &&
+        window_rect.left <= monitor_info.rcMonitor.left && window_rect.top <= monitor_info.rcMonitor.top &&
+        window_rect.right >= monitor_info.rcMonitor.right && window_rect.bottom >= monitor_info.rcMonitor.bottom &&
+        get_raw_monitor_rect( &rect, &monitor_rect ))
+        rect = monitor_rect;
+
     width = max( rect.right - rect.left, 1 );
     height = max( rect.bottom - rect.top, 1 );
     x = rect.left;
