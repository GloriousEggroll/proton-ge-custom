From: Alexandre Derumier <aderumier@gmail.com>
Subject: [PATCH] kernel32: Look up an empty section name in an explicit "[]" section.

The parser keeps the keys found before any section header in a first,
nameless section, and PROFILE_Find() stopped there for an empty section
name, so keys of an explicit "[]" section could never be read. Windows
reads them (see the test that was todo_wine).

HORGIHUGH (Clickteam Fusion) reads disk=... from the "[]" section of
data\hugh.ini and ends right after its logo when the value is missing.
---
diff --git a/dlls/kernel32/profile.c b/dlls/kernel32/profile.c
--- a/dlls/kernel32/profile.c
+++ b/dlls/kernel32/profile.c
@@ -582,6 +582,17 @@
         keylen = p - key_name + 1;
     }
 
+    /* The first section holds the keys found before any section header.
+     * Like Windows, look an empty section name up in an explicit "[]"
+     * section when the file has one. */
+    if (!seclen && *section && !(*section)->name[0])
+    {
+        PROFILESECTION **next = &(*section)->next;
+
+        while (*next && (*next)->name[0]) next = &(*next)->next;
+        if (*next) section = next;
+    }
+
     while (*section)
     {
         if (!wcsnicmp((*section)->name, section_name, seclen) &&
diff --git a/dlls/kernel32/tests/profile.c b/dlls/kernel32/tests/profile.c
--- a/dlls/kernel32/tests/profile.c
+++ b/dlls/kernel32/tests/profile.c
@@ -159,9 +159,7 @@
 
     /* works only in unicode, ansi crashes */
     ret=GetPrivateProfileStringW(emptyW, keyW, emptyW, bufW, ARRAY_SIZE(bufW), TESTFILE2W);
-    todo_wine
     ok(ret == 13, "expected 13, got %u\n", ret);
-    todo_wine
     ok(!lstrcmpW(valsectionW,bufW), "expected %s, got %s\n",
         wine_dbgstr_w(valsectionW), wine_dbgstr_w(bufW) );
 
