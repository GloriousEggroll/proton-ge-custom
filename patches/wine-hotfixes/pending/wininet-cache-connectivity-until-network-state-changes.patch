index 57db3794e369..6f544234e186 100644
--- a/dlls/wininet/Makefile.in
+++ b/dlls/wininet/Makefile.in
@@ -1,11 +1,12 @@
 EXTRADEFS = -D_WININET_INTERNAL_
 MODULE    = wininet.dll
 IMPORTLIB = wininet
-IMPORTS   = $(ZLIB_PE_LIBS) mpr shlwapi shell32 user32 ws2_32 advapi32
+IMPORTS   = $(ZLIB_PE_LIBS) mpr shlwapi shell32 user32 ws2_32 advapi32 uuid
 EXTRAINCL = $(ZLIB_PE_CFLAGS)
-DELAYIMPORTS = secur32 crypt32 cryptui dhcpcsvc iphlpapi
+DELAYIMPORTS = secur32 crypt32 cryptui dhcpcsvc iphlpapi nsi
 
 SOURCES = \
+	connectivity.c \
 	cookie.c \
 	dialogs.c \
 	ftp.c \
diff --git a/dlls/wininet/connectivity.c b/dlls/wininet/connectivity.c
new file mode 100644
index 000000000000..0e71223431a4
--- /dev/null
+++ b/dlls/wininet/connectivity.c
@@ -0,0 +1,203 @@
