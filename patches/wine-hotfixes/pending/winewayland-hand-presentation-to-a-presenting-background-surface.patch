From: GloriousEggroll <gloriouseggroll@gmail.com>
Subject: [PATCH] win32u, winewayland: Hand presentation to a background presenter that keeps presenting.

The background presenter coordination gives presentation of a window to
its newest active Vulkan presenter and backs older presenters with local
images whose frames are discarded. That assumes the newest presenter is
the one the application renders with.

EarthX 2 (Unity, D3D11 through DXVK) breaks that assumption. When it
loses focus it minimizes its fullscreen window and a second Vulkan
surface is created on the same window. On restore the new surface gets
a swapchain and becomes the owner, then the game's swapchain is
recreated on its original surface, which becomes a background presenter.
The game keeps presenting only to the original surface, so its frames
are discarded and the window shows the new surface's last frame forever.

Record when each client surface last presented through Vulkan. When a
locally retired background swapchain presents and the owner has not
presented, or been the owner, for a second, make the presenting surface
the newest presenter and the owner. That invalidates both swapchains, so
the application recreates its swapchain on host WSI.

Only owners that have presented through Vulkan can be replaced, since
OpenGL presents do not record a present time. An owner that is
presenting, or has just been selected and is still creating its
swapchain, keeps ownership, so replacement flip-model presenters and the
inactive graphics-probe case handled by the swapchain candidate fix are
unaffected.

Bug: https://github.com/GloriousEggroll/proton-ge-custom/issues/960
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
diff --git a/include/wine/gdi_driver.h b/include/wine/gdi_driver.h
--- a/include/wine/gdi_driver.h
+++ b/include/wine/gdi_driver.h
@@ -262,6 +262,8 @@
     void (*deactivate)( struct client_surface *surface );
     /* present the client surface if necessary, hdc != NULL when offscreen, called from render thread */
     void (*present)( struct client_surface *surface, HDC hdc );
+    /* a background presenter is presenting, take over from an idle owner, called from render thread */
+    void (*claim_presentation)( struct client_surface *surface );
 };
 
 struct client_surface
@@ -278,6 +280,7 @@
     LONG                               updated;        /* has been moved / resized / reparented */
     LONG                               offscreen;      /* client window is offscreen */
     LONG                               presentation_generation; /* invalidates stale presentation waits */
+    LONG                               last_present_tick; /* tick count of the last Vulkan present, 0 if none */
 };
 
 W32KAPI void *client_surface_create( UINT size, const struct client_surface_funcs *funcs, HWND hwnd );
@@ -289,6 +292,7 @@
                                       struct client_surface **owner );
 W32KAPI void client_surface_deactivate( struct client_surface *surface, BOOL native );
 W32KAPI void client_surface_present( struct client_surface *surface );
+W32KAPI void client_surface_claim_presentation( struct client_surface *surface );
 W32KAPI void client_surface_update( struct client_surface *surface );
 W32KAPI void update_client_surfaces( HWND hwnd );
 W32KAPI void detach_client_surfaces( HWND hwnd );
diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -370,6 +370,8 @@
     HDC hdc = 0;
     HWND hwnd;
 
+    InterlockedExchange( &surface->last_present_tick, max( NtGetTickCount(), 1 ) );
+
     pthread_mutex_lock( &surfaces_lock );
     if ((hwnd = surface->hwnd))
     {
@@ -391,6 +393,14 @@
     }
 }
 
+void client_surface_claim_presentation( struct client_surface *surface )
+{
+    pthread_mutex_lock( &surfaces_lock );
+    if (surface->hwnd && surface->funcs->claim_presentation)
+        surface->funcs->claim_presentation( surface );
+    pthread_mutex_unlock( &surfaces_lock );
+}
+
 void client_surface_update( struct client_surface *surface )
 {
     pthread_mutex_lock( &surfaces_lock );
diff --git a/dlls/win32u/vulkan.c b/dlls/win32u/vulkan.c
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -4972,6 +4972,10 @@
         pthread_mutex_unlock( &managed->lock );
         pthread_mutex_unlock( &producer_device_lock );
 
+        /* This frame is discarded. If the presentation owner stopped presenting,
+         * this presenter is the one the window shows, so take over. */
+        client_surface_claim_presentation( surface->client );
+
         if (!IsRectEmpty( &client_rect ) &&
             !extents_equals( &managed->extents, &client_rect ))
             return VK_SUBOPTIMAL_KHR;
diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -714,6 +714,8 @@
     struct wayland_surface *wayland_surface;
     /* wayland client surface (if any) for this window */
     struct wayland_client_surface *client_surface;
+    /* tick count when client_surface became the presentation owner */
+    DWORD client_surface_owner_tick;
     /* all graphics clients targeting this HWND, oldest to newest */
     struct list client_surfaces;
     /* track a stale client surface to ensure DMABUF modifiers stay valid */
diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -4755,6 +4755,7 @@
             client_surface_invalidate_presentation(&previous->client);
     }
     data->client_surface = surface;
+    data->client_surface_owner_tick = NtGetTickCount();
     if (surface)
     {
         InterlockedExchange(&surface->client.presentation_owner, TRUE);
@@ -5090,6 +5091,46 @@
     wayland_win_data_release(data);
 }
 
+/* How long the presentation owner must have stopped presenting before a
+ * background presenter that is still presenting takes over. */
+#define WAYLAND_PRESENTATION_IDLE_MS 1000
+
+/* Ownership follows activation order, but an older presenter can keep rendering
+ * after a newer one goes idle: EarthX 2 gets a second Vulkan surface when it
+ * minimizes on focus loss, the new surface becomes the owner and stops
+ * presenting, and the game keeps presenting to its original surface, whose
+ * frames are discarded. Hand ownership to the presenter that is presenting
+ * once the owner has been idle for a while. Only owners that presented through
+ * Vulkan are considered, as OpenGL presents don't update last_present_tick. */
+static void wayland_client_surface_claim_presentation(struct client_surface *client)
+{
+    struct wayland_client_surface *surface = impl_from_client_surface(client);
+    struct wayland_client_surface *owner;
+    struct wayland_win_data *data;
+    DWORD now, last_present;
+
+    if (!(data = wayland_win_data_get(client->hwnd))) return;
+
+    owner = data->client_surface;
+    if (owner && owner != surface && !list_empty(&surface->hwnd_entry) &&
+        ReadAcquire(&client->active_ref) &&
+        (last_present = ReadAcquire(&owner->client.last_present_tick)))
+    {
+        now = NtGetTickCount();
+        if (now - last_present > WAYLAND_PRESENTATION_IDLE_MS &&
+            now - data->client_surface_owner_tick > WAYLAND_PRESENTATION_IDLE_MS)
+        {
+            TRACE("hwnd=%p owner %s idle for %u ms, %s takes over\n", data->hwnd,
+                  debugstr_client_surface(&owner->client), (UINT)(now - last_present),
+                  debugstr_client_surface(client));
+            wayland_client_surface_register_latest(data, surface);
+            wayland_client_surface_set_owner(data, surface);
+        }
+    }
+
+    wayland_win_data_release(data);
+}
+
 static const struct client_surface_funcs wayland_client_surface_funcs =
 {
     .destroy = wayland_client_surface_destroy,
@@ -5099,6 +5140,7 @@
     .activate = wayland_client_surface_activate,
     .deactivate = wayland_client_surface_deactivate,
     .present = wayland_client_surface_present,
+    .claim_presentation = wayland_client_surface_claim_presentation,
 };
 
 static void client_dmabuf_feedback_handle_done(void *data, struct zwp_linux_dmabuf_feedback_v1 *feedback)
