From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Thu, 26 Nov 2026 02:29:24 -0500
Subject: [PATCH] dinput: Report input lost for devices unacquired by a foreground change.

Ducati World Championship reads its keyboard with GetDeviceState after the
window is restored and treats DIERR_NOTACQUIRED as fatal. Devices of a window
that loses the foreground were left in the same state as after Unacquire, so
GetDeviceState, GetDeviceData and Poll returned DIERR_NOTACQUIRED. Report
DIERR_INPUTLOST for them until they are acquired again, which games answer by
calling Acquire (as the DirectX SDK samples do). An explicit Unacquire still
gives DIERR_NOTACQUIRED.
---
diff -ruN a/dlls/dinput/device.c b/dlls/dinput/device.c
--- a/dlls/dinput/device.c	2026-11-26 02:29:24.913452790 -0500
+++ b/dlls/dinput/device.c	2026-11-26 02:29:24.913864340 -0500
@@ -1458,7 +1458,7 @@
     IDirectInputDevice2_Poll( iface );
 
     EnterCriticalSection( &impl->crit );
-    if (impl->status == STATUS_UNPLUGGED)
+    if (impl->status == STATUS_UNPLUGGED || impl->status == STATUS_LOST)
         hr = DIERR_INPUTLOST;
     else if (impl->status != STATUS_ACQUIRED)
         hr = DIERR_NOTACQUIRED;
@@ -1512,7 +1512,7 @@
     if (This->dinput->dwVersion == 0x0800 || size == sizeof(DIDEVICEOBJECTDATA_DX3))
     {
         if (!This->queue_len) return DIERR_NOTBUFFERED;
-        if (This->status == STATUS_UNPLUGGED) return DIERR_INPUTLOST;
+        if (This->status == STATUS_UNPLUGGED || This->status == STATUS_LOST) return DIERR_INPUTLOST;
         if (This->status != STATUS_ACQUIRED) return DIERR_NOTACQUIRED;
     }
 
@@ -1765,7 +1765,7 @@
     HRESULT hr = DI_NOEFFECT;
 
     EnterCriticalSection( &impl->crit );
-    if (impl->status == STATUS_UNPLUGGED) hr = DIERR_INPUTLOST;
+    if (impl->status == STATUS_UNPLUGGED || impl->status == STATUS_LOST) hr = DIERR_INPUTLOST;
     else if (impl->status != STATUS_ACQUIRED) hr = DIERR_NOTACQUIRED;
     LeaveCriticalSection( &impl->crit );
     if (FAILED(hr)) return hr;
diff -ruN a/dlls/dinput/device_private.h b/dlls/dinput/device_private.h
--- a/dlls/dinput/device_private.h	2026-11-26 02:29:24.915055446 -0500
+++ b/dlls/dinput/device_private.h	2026-11-26 02:29:24.915414135 -0500
@@ -77,6 +77,7 @@
     STATUS_UNACQUIRED,
     STATUS_ACQUIRED,
     STATUS_UNPLUGGED,
+    STATUS_LOST, /* unacquired by a foreground window change */
 };
 
 struct dinput_device
diff -ruN a/dlls/dinput/dinput_main.c b/dlls/dinput/dinput_main.c
--- a/dlls/dinput/dinput_main.c	2026-11-26 02:29:24.914322878 -0500
+++ b/dlls/dinput/dinput_main.c	2026-11-26 02:29:24.914699983 -0500
@@ -151,7 +151,7 @@
     {
         if (!(impl->dwCoopLevel & DISCL_FOREGROUND) || window != impl->win) continue;
         TRACE( "%p window is not foreground - unacquiring %p\n", impl->win, impl );
-        dinput_device_internal_unacquire( &impl->IDirectInputDevice8W_iface, STATUS_UNACQUIRED );
+        dinput_device_internal_unacquire( &impl->IDirectInputDevice8W_iface, STATUS_LOST );
     }
 
     LeaveCriticalSection( &dinput_hook_crit );
