     if (alpha_bits == -1)
     {
         if (alpha_mask || color_info->bmiHeader.biBitCount != 32) alpha_bits = 0;
@@ -1981,7 +1992,8 @@ static BOOL enable_direct_drawing( struct x11drv_win_data *data, BOOL layered )
 
         if (style & WS_VISIBLE && !(style & WS_MINIMIZE)) return FALSE;
     }
-    if (data->client_window) return TRUE; /* draw directly to the window */
+    /* an exclusive fullscreen GL window draws its children scaled into its surface */
+    if (data->client_window && !present_window_has_visible_children( data->hwnd )) return TRUE; /* draw directly to the window */
     if (!client_side_graphics) return TRUE; /* draw directly to the window */
     return FALSE;
 }
@@ -2034,8 +2046,16 @@ void set_surface_window_rects( struct window_surface *window_surface, const stru
         XRectangle *xrects;
 
         window_surface_lock( window_surface );
-        surface->x_offset = max( rects->window.left - rects->visible.left, 0 );
-        surface->y_offset = max( rects->window.top - rects->visible.top, 0 );
+        /* a surface with a border around scaled contents (win32u for scaled
+         * fullscreen windows) covers the visible rect rather than the window */
+        if (window_surface->rect.right - window_surface->rect.left >= rects->visible.right - rects->visible.left &&
+            window_surface->rect.bottom - window_surface->rect.top >= rects->visible.bottom - rects->visible.top)
