diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index d2a9abb..7d1a9c2 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -2094,6 +2094,27 @@ static NTSTATUS get_window_region( HWND hwnd, enum window_region_type type, HRGN
     return status;
 }
 
+/* the client surface covering the window is punched out of the surface
+ * region, add back the visible children drawn into the surface */
+static void add_surface_children_region( HWND hwnd, HRGN region )
+{
+    HWND child;
+    HRGN child_rgn;
+    RECT rect;
+
+    for (child = NtUserGetWindowRelative( hwnd, GW_CHILD ); child;
+         child = NtUserGetWindowRelative( child, GW_HWNDNEXT ))
+    {
+        if (!(get_window_long( child, GWL_STYLE ) & WS_VISIBLE)) continue;
+        if (!get_window_rect( child, &rect, get_thread_dpi() )) continue;
+        if ((child_rgn = NtGdiCreateRectRgn( rect.left, rect.top, rect.right, rect.bottom )))
+        {
+            NtGdiCombineRgn( region, region, child_rgn, RGN_OR );
+            NtGdiDeleteObjectApp( child_rgn );
+        }
+    }
+}
+
 /***********************************************************************
  *           update_surface_region
  */
@@ -2128,6 +2149,7 @@ static void update_surface_region( HWND hwnd )
     if (!region) window_surface_set_clip( surface, shape );
     else
     {
+        if (window_keeps_surface_for_children( hwnd )) add_surface_children_region( hwnd, region );
         NtGdiOffsetRgn( region, -visible.left, -visible.top );
         if (shape) NtGdiCombineRgn( region, region, shape, RGN_AND );
         window_surface_set_clip( surface, region );
@@ -2293,6 +2315,23 @@ static BOOL get_default_window_surface( HWND hwnd, const RECT *surface_rect, str
     return TRUE;
 }
 
+/* An exclusive fullscreen window keeps its contents scaled in a window
+ * surface; with a client surface covering it, child windows such as an edit
+ * control (Star Wars Galactic Battlegrounds' name prompt) would otherwise be
+ * drawn directly and unscaled. Keep the surface while children are shown, the
+ * driver shows them through the client surface. */
+BOOL window_keeps_surface_for_children( HWND hwnd )
+{
+    RECT present_rect;
+    HWND child;
+
+    if (!get_present_rect( hwnd, &present_rect, get_thread_dpi() )) return FALSE;
+    for (child = NtUserGetWindowRelative( hwnd, GW_CHILD ); child;
+         child = NtUserGetWindowRelative( child, GW_HWNDNEXT ))
+        if (get_window_long( child, GWL_STYLE ) & WS_VISIBLE) return TRUE;
+    return FALSE;
+}
+
 static BOOL window_clip_client_surfaces( HWND hwnd )
 {
     WND *win = get_win_ptr( hwnd );
@@ -2304,7 +2343,7 @@ static BOOL window_clip_client_surfaces( HWND hwnd )
     win_rect = win->rects.window;
     release_win_ptr( win );
 
-    if (ret) return !force_present_to_surface( &win_rect );
+    if (ret) return !force_present_to_surface( &win_rect ) && !window_keeps_surface_for_children( hwnd );
 
     return ret;
 }
@@ -4385,6 +4424,18 @@ BOOL set_window_pos( WINDOWPOS *winpos, int parent_x, int parent_y )
     }
     if (surface) window_surface_release( surface );
 
+    /* the toplevel may need its window surface back, see window_keeps_surface_for_children */
+    if ((winpos->flags & (SWP_SHOWWINDOW | SWP_HIDEWINDOW)) &&
+        (get_window_long( winpos->hwnd, GWL_STYLE ) & WS_CHILD))
+    {
+        HWND parent = NtUserGetAncestor( winpos->hwnd, GA_PARENT );
+        RECT present_rect;
+
+        if (parent && parent == NtUserGetAncestor( winpos->hwnd, GA_ROOT ) &&
+            get_present_rect( parent, &present_rect, get_thread_dpi() ))
+            update_window_state( parent );
+    }
+
     if (winpos->flags & SWP_HIDEWINDOW)
     {
         NtUserNotifyWinEvent( EVENT_OBJECT_HIDE, winpos->hwnd, 0, 0 );
diff --git a/dlls/winex11.drv/bitblt.c b/dlls/winex11.drv/bitblt.c
index ad3a863..8684a97 100644
--- a/dlls/winex11.drv/bitblt.c
+++ b/dlls/winex11.drv/bitblt.c
@@ -1593,6 +1593,7 @@ struct x11drv_window_surface
     int                   y_offset;
     RECT                 *clip_rects;
     unsigned int          clip_rect_count;
+    BOOL                  clip_by_children;
 };
 
 static struct x11drv_window_surface *get_x11_surface( struct window_surface *surface )
@@ -1809,9 +1810,19 @@ static BOOL x11drv_surface_flush( struct window_surface *window_surface, const R
     const unsigned char *src = color_bits;
     unsigned char *dst = (unsigned char *)ximage->data;
     RECT rect = *surface_rect;
+    BOOL clip_by_children;
 
     OffsetRect( &rect, surface->x_offset, surface->y_offset );
 
+    /* The GL drawable of an exclusive fullscreen window has holes over the
