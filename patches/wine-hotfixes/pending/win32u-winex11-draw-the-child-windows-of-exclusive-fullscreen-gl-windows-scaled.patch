         if (surface->clip_rects && (xrects = xrectangles_from_rects( surface->clip_rects, surface->clip_rect_count,
diff --git a/dlls/winex11.drv/init.c b/dlls/winex11.drv/init.c
index e009bf5..c8fc822 100644
--- a/dlls/winex11.drv/init.c
+++ b/dlls/winex11.drv/init.c
@@ -425,6 +425,10 @@ struct x11drv_client_surface
     BOOL shm_broken;  /* the fast read failed; use XGetImage until resized */
 #endif
     DWORD shape_last_sample;
+
+    /* holes cut for the children of an exclusive fullscreen window */
+    XRectangle child_holes[16];
+    unsigned int child_hole_count;
 };
 
 static struct x11drv_client_surface *impl_from_client_surface( struct client_surface *client )
@@ -960,6 +964,85 @@ static BOOL update_layered_overlay_shape( struct x11drv_client_surface *surface,
 #endif
 }
 
+/* whether an exclusive fullscreen window shows child windows over its
+ * client surface, win32u then draws them scaled into its window surface */
+BOOL present_window_has_visible_children( HWND hwnd )
+{
+    RECT rect;
+    HWND child;
+
+    if (!NtUserGetPresentRect( hwnd, &rect, 0 )) return FALSE;
+    for (child = NtUserGetWindowRelative( hwnd, GW_CHILD ); child;
+         child = NtUserGetWindowRelative( child, GW_HWNDNEXT ))
+        if (NtUserGetWindowLongW( child, GWL_STYLE ) & WS_VISIBLE) return TRUE;
+    return FALSE;
+}
+
+/* The GL drawable of an exclusive fullscreen window covers the child windows
+ * drawn into its window surface: cut holes in the client window over them,
+ * except while the Steam overlay is open, which covers them. */
+static void update_client_window_child_holes( HWND hwnd, struct x11drv_client_surface *surface )
+{
+#ifdef HAVE_LIBXSHAPE
+    XRectangle holes[ARRAY_SIZE(surface->child_holes)];
+    unsigned int count = 0;
+    RECT client, src, child_rect;
+    float scale_x, scale_y;
+    HWND child;
+    UINT dpi;
+
+    if (!surface->window || !surface->opengl) return;
+    dpi = NtUserGetDpiForWindow( hwnd );
+    if (NtUserGetAncestor( hwnd, GA_PARENT ) == NtUserGetDesktopWindow() &&
+        NtUserGetPresentRect( hwnd, &src, 0 ) && !steam_overlay_is_open() &&
+        NtUserGetClientRect( hwnd, &client, dpi ) && !IsRectEmpty( &client ))
+    {
+        src = IsRectEmpty( &surface->client.content_rect ) ? surface->rect : surface->client.content_rect;
+        scale_x = (float)(src.right - src.left) / client.right;
+        scale_y = (float)(src.bottom - src.top) / client.bottom;
+        for (child = NtUserGetWindowRelative( hwnd, GW_CHILD ); child && count < ARRAY_SIZE(holes);
+             child = NtUserGetWindowRelative( child, GW_HWNDNEXT ))
+        {
+            int left, top, right, bottom;
+
+            if (!(NtUserGetWindowLongW( child, GWL_STYLE ) & WS_VISIBLE)) continue;
+            if (!NtUserGetWindowRect( child, &child_rect, dpi )) continue;
+            NtUserMapWindowPoints( 0, hwnd, (POINT *)&child_rect, 2, dpi );
+            if (!intersect_rect( &child_rect, &child_rect, &client )) continue;
+            /* win32u scales the surface with HALFTONE, which blends the last
+             * pixels of the child with the surface contents right and below
+             * it, keep those out of the hole */
+            left = src.left + (int)(child_rect.left * scale_x);
+            top = src.top + (int)(child_rect.top * scale_y);
+            right = src.left + (int)((child_rect.right - 1) * scale_x);
+            bottom = src.top + (int)((child_rect.bottom - 1) * scale_y);
+            if (right <= left || bottom <= top) continue;
+            holes[count].x = left;
+            holes[count].y = top;
+            holes[count].width = right - left;
+            holes[count].height = bottom - top;
+            count++;
+        }
+    }
+
+    if (count == surface->child_hole_count &&
+        !memcmp( holes, surface->child_holes, count * sizeof(*holes) )) return;
+
+    TRACE( "client window %p/%lx, %u holes\n", hwnd, surface->window, count );
+    if (!count) XShapeCombineMask( gdi_display, surface->window, ShapeBounding, 0, 0, None, ShapeSet );
+    else
+    {
+        XRectangle all = {0, 0, surface->changes.width, surface->changes.height};
+
+        XShapeCombineRectangles( gdi_display, surface->window, ShapeBounding, 0, 0, &all, 1, ShapeSet, Unsorted );
+        XShapeCombineRectangles( gdi_display, surface->window, ShapeBounding, 0, 0, holes, count, ShapeSubtract, Unsorted );
+    }
+    memcpy( surface->child_holes, holes, count * sizeof(*holes) );
+    surface->child_hole_count = count;
+    XFlush( gdi_display );
+#endif
+}
+
 static void X11DRV_client_surface_present( struct client_surface *client, HDC hdc )
 {
     struct x11drv_client_surface *surface = impl_from_client_surface( client );
@@ -975,6 +1058,7 @@ static void X11DRV_client_surface_present( struct client_surface *client, HDC hd
 
     if (!hdc)
     {
+        update_client_window_child_holes( hwnd, surface );
         /* direct present: nothing to copy, but the input shape still follows the pixels */
         if (layered_overlay_alpha_enabled() && layered_overlay_direct_enabled() &&
             (NtUserGetWindowLongW( toplevel, GWL_EXSTYLE ) & WS_EX_LAYERED))
