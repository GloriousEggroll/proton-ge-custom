From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erhan Bilgili <erhan.bilgili@gmail.com>
Date: Tue, 14 Jul 2026 02:13:05 +0200
Subject: [PATCH 35/49] winewayland.drv: Avoid redundant viewport destination
 updates.

Cache the destination last applied to each wp_viewport and skip unchanged
requests. Key the cache on the viewport object so recreated viewports
still get their initial destination.
---
 dlls/winewayland.drv/wayland_surface.c | 21 ++++++++++++++++++---
 dlls/winewayland.drv/waylanddrv.h      |  2 ++
 2 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
index 0b22c67d2f7..aff1a48b48a 100644
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -1085,6 +1085,7 @@ void wayland_surface_destroy(struct wayland_surface *surface)
     {
         wp_viewport_destroy(surface->wp_viewport);
         surface->wp_viewport = NULL;
+        surface->configured_wp_viewport = NULL;
     }
 
     if (surface->wl_surface)
@@ -2043,12 +2044,26 @@ static void wayland_surface_reconfigure_geometry(struct wayland_surface *surface
 static void wayland_surface_reconfigure_size(struct wayland_surface *surface,
                                              int width, int height)
 {
-    TRACE("hwnd=%p size=%dx%d\n", surface->hwnd, width, height);
+    int dest_width = width, dest_height = height;
 
-    if (width != 0 && height != 0)
-        wp_viewport_set_destination(surface->wp_viewport, width, height);
+    if (width <= 0 || height <= 0)
+        dest_width = dest_height = -1;
+
+    if (surface->configured_wp_viewport == surface->wp_viewport &&
+        surface->viewport_dest_width == dest_width &&
+        surface->viewport_dest_height == dest_height)
+        return;
+
+    TRACE("hwnd=%p size=%dx%d\n", surface->hwnd, dest_width, dest_height);
+
+    if (dest_width > 0 && dest_height > 0)
+        wp_viewport_set_destination(surface->wp_viewport, dest_width, dest_height);
     else
         wp_viewport_set_destination(surface->wp_viewport, -1, -1);
+
+    surface->configured_wp_viewport = surface->wp_viewport;
+    surface->viewport_dest_width = dest_width;
+    surface->viewport_dest_height = dest_height;
 }
 
 /**********************************************************************
diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
index 38fa70ffc6e..6149677c7f0 100644
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -484,6 +484,8 @@ struct wayland_surface
 
     struct wl_surface *wl_surface;
     struct wp_viewport *wp_viewport;
+    struct wp_viewport *configured_wp_viewport;
+    int viewport_dest_width, viewport_dest_height;
     struct wp_fractional_scale_v1 *wp_fractional_scale_v1;
     struct zwp_keyboard_shortcuts_inhibitor_v1* zwp_keyboard_shortcuts_inhibitor_v1;
     struct wayland_shm_buffer *small_icon_buffer;
