From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erhan Bilgili <erhan.bilgili@gmail.com>
Date: Mon, 29 Jun 2026 13:39:04 +0200
Subject: [PATCH 21/49] winewayland: Ack fullscreen configures from requested
 state

Allow the existing requested-configure fast path to handle fullscreen and
maximized transitions, not only the initial configure. This lets dmabuf-only
toplevels finalize those state changes without waiting for the Win32 resize
round-trip. Clear any older processing configure when acknowledging a newer
requested serial so the internal state stays monotonic with the xdg
configure stream.
---
 dlls/winewayland.drv/wayland_surface.c | 16 +++++++++-------
 1 file changed, 9 insertions(+), 7 deletions(-)

diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
index f33b81c7fa1..47520f6cd1f 100644
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -3292,19 +3292,21 @@ static BOOL wayland_surface_reconfigure_xdg(struct wayland_surface *surface, REC
         memset(&surface->processing, 0, sizeof(surface->processing));
         xdg_surface_ack_configure(surface->xdg_surface, surface->current.serial);
     }
-    /* If this is the initial configure, and we have a compatible requested
-     * config, use that, in order to draw windows that don't go through the
-     * message loop (e.g., some splash screens).
-     * Note: Decoration changes must go through the message loop */
-    else if (!surface->current.serial && surface->requested.serial &&
+    /* Initial configure, or a fullscreen/maximized transition: ack from the
+     * requested state so a dmabuf-only toplevel finalizes without the win32
+     * resize round-trip. Decoration changes must go through the message loop. */
+    else if (surface->requested.serial &&
+             (!surface->current.serial ||
+              (surface->requested.state &
+               (WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN |
+                WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED))) &&
              surface->current.decor == surface->requested.decor &&
              wayland_surface_config_is_compatible(&surface->requested, rect,
                                                   window->state))
     {
         surface->current = surface->requested;
-        memset(&surface->requested, 0, sizeof(surface->requested));
-        /* clear stale processing config since the requested one is always newer */
         memset(&surface->processing, 0, sizeof(surface->processing));
+        memset(&surface->requested, 0, sizeof(surface->requested));
         xdg_surface_ack_configure(surface->xdg_surface, surface->current.serial);
     }
     else if (!surface->current.serial ||
