@@ -320,6 +328,7 @@ static void wayland_hwnd_dmabuf_buffer_unref(struct wayland_hwnd_dmabuf_buffer *
     wayland_hwnd_dmabuf_buffer_send_release(buffer, buffer->release_flags ?
