-    {
-        if (overlay->wl_surface) wl_surface_destroy(overlay->wl_surface);
-        free(overlay);
-        return NULL;
-    }
-    wl_subsurface_set_desync(overlay->wl_subsurface);
-    overlay->wp_viewport = wp_viewporter_get_viewport(process_wayland.wp_viewporter,
-                                                      overlay->wl_surface);
