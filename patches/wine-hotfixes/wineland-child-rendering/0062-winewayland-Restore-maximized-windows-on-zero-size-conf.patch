From d2ba92e09faac1a2615e8ea4ee00ea66ffdffb3e Mon Sep 17 00:00:00 2001
From: Erhan Bilgili <erhan.bilgili@gmail.com>
Date: Sun, 2 Aug 2026 16:40:40 +0200
Subject: [PATCH] winewayland: Restore maximized windows on zero-size
 configures.

Queue SC_RESTORE when the compositor removes the maximized state, even
if it leaves the restored size to the client. This lets Win32 restore
the saved normal placement instead of retaining maximized geometry.

Ignore compositor state commands while the window is minimized, leaving
keyboard focus as the signal for compositor-initiated restoration.

(cherry picked from commit d2ba92e09faac1a2615e8ea4ee00ea66ffdffb3e)

Source: https://github.com/nanomatters/wine-salkim/commit/d2ba92e09faac1a2615e8ea4ee00ea66ffdffb3e
---
 dlls/winewayland.drv/window.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index a05943bf5ecf1291058f46f74fee91b1a90f127f..4f6ddf6286b2555bca31ec1a087a10cda606ee81 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -1024,13 +1024,14 @@ static void wayland_configure_window(HWND hwnd)
     OffsetRect(&rect, data->rects.window.left, data->rects.window.top);
     if (!IsRectEmpty(&rect)) rect = window_rect_from_visible(&data->rects, rect);
     style = NtUserGetWindowLongW(hwnd, GWL_STYLE);
-    if (!(state & WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN))
+    if (!(style & WS_MINIMIZE) &&
+        !(state & WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN))
     {
         if ((state & WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED) && !(style & WS_MAXIMIZE))
             state_cmd = SC_MAXIMIZE;
         else if (!(state & (WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED |
                             WAYLAND_SURFACE_CONFIG_STATE_TILED)) &&
-                 (style & WS_MAXIMIZE) && window_width && window_height)
+                 (style & WS_MAXIMIZE))
             state_cmd = SC_RESTORE;
     }
     if (state_cmd) wayland_win_data_queue_state_update(data, state_cmd, &rect);
