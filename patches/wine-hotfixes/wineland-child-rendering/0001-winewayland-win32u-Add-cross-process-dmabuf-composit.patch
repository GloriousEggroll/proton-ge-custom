+            TRACE("DWMWA_CLOAKED: hwnd %p reported cloaked (mode %d).\n", hwnd, cloak_mode());
+            *(DWORD*)(pv_attribute) = DWM_CLOAKED_SHELL;
+        }
+        else
+            *(DWORD*)(pv_attribute) = 0;
         hr = S_OK;
         break;
 
