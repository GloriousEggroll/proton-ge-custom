From b8496ab030111c1d26955b6f1324a4cc99f8b03e Mon Sep 17 00:00:00 2001
From: Erhan Bilgili <erhan.bilgili@gmail.com>
Date: Fri, 7 Aug 2026 20:16:41 +0200
Subject: [PATCH] winewayland: Derive toplevel resizeability from window state.

WINE_SWP_RESIZABLE is cleared whenever the outer window rectangle
covers a monitor, even when a thick-frame normal window merely happens
to be screen-sized. Caching it makes winewayland publish identical
minimum and maximum size hints and prevents compositor resizing.

Derive xdg resizeability from WS_THICKFRAME and the style-aware
fullscreen classification instead. This preserves resizing for decorated
screen-sized and maximized windows while keeping explicit Vulkan and
framed borderless fullscreen windows non-resizeable.

(cherry picked from commit b8496ab030111c1d26955b6f1324a4cc99f8b03e)

GE-Proton adaptation: this base caches neither the window style nor a
present rect in struct wayland_win_data, so the classification result is
computed in wayland_win_data_get_config() from the style already read
there, and only the win_data resizeable field is removed.

Source: https://github.com/nanomatters/wine-salkim/commit/b8496ab030111c1d26955b6f1324a4cc99f8b03e
---
 dlls/winewayland.drv/waylanddrv.h | 1 -
 dlls/winewayland.drv/window.c     | 7 ++++---
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
index 02dc617001a..a02a8f6fcdc 100644
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -671,7 +671,6 @@ struct wayland_win_data
     /* window rects, relative to parent client area */
     struct window_rects rects;
     BOOL is_fullscreen;
-    BOOL resizeable;
     BOOL managed;
     BOOL layered_attribs_set;
     int ime_ref;
diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index c8495482eed..b6f0d8de411 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -199,12 +199,14 @@ static void wayland_win_data_get_config(struct wayland_win_data *data,
     enum wayland_surface_config_state window_state = 0;
     enum wayland_surface_config_state pending_state;
     DWORD style, exstyle;
+    BOOL fullscreen;
 
     conf->rect = data->rects.visible;
     conf->window_rect = data->rects.window;
     conf->client_rect = data->rects.client;
     style = NtUserGetWindowLongW(data->hwnd, GWL_STYLE);
     exstyle = NtUserGetWindowLongW(data->hwnd, GWL_EXSTYLE);
+    fullscreen = wayland_win_data_is_fullscreen(data, style);
 
     TRACE("window=%s style=%#x exstyle=%#x\n", wine_dbgstr_rect(&conf->rect), style, exstyle);
 
@@ -219,7 +221,7 @@ static void wayland_win_data_get_config(struct wayland_win_data *data,
         window_state |= pending_state;
     }
     /* The fullscreen state is implied by the window position and style. */
-    else if (wayland_win_data_is_fullscreen(data, style))
+    else if (fullscreen)
     {
         if ((style & WS_MAXIMIZE) && (style & WS_CAPTION) == WS_CAPTION)
             window_state |= WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED;
@@ -231,7 +233,7 @@ static void wayland_win_data_get_config(struct wayland_win_data *data,
         window_state |= WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED;
     }
 
-    conf->resizeable = data->resizeable;
+    conf->resizeable = (style & WS_THICKFRAME) && !fullscreen;
     conf->state = window_state;
     conf->managed = data->managed;
 }
@@ -884,7 +886,6 @@ void WAYLAND_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UIN
 
     data->rects = *new_rects;
     data->is_fullscreen = fullscreen;
-    data->resizeable = swp_flags & WINE_SWP_RESIZABLE;
     data->managed = managed;
 
     if (!surface)
-- 
