 dlls/win32u/driver.c                   | 12 ++---
 dlls/win32u/vulkan.c                   | 16 +++++-
 dlls/winewayland.drv/vulkan.c          |  3 ++
 dlls/winewayland.drv/waylanddrv_main.c |  6 +--
 dlls/winewayland.drv/window_surface.c  | 66 ++++++++++++++++++++++--
 include/wine/gdi_driver.h              |  5 +-
 include/wine/hwnd_dmabuf.h             |  3 +-
 8 files changed, 156 insertions(+), 26 deletions(-)

