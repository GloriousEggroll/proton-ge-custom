+sub print_wine_unix_call_thunks($$)
+{
+    my ($out, $is_wow64) = @_;
+    my $prefix = $is_wow64 ? "wow64_" : "";
+
+    print $out "static NTSTATUS ${prefix}ext_wglWineCloseDmaBufWINE( void *args )\n";
+    print $out "{\n";
+    print $out "    struct\n" if $is_wow64;
+    print $out "    {\n" if $is_wow64;
+    print $out "        int fd;\n" if $is_wow64;
+    print $out "    } *params = args;\n" if $is_wow64;
+    print $out "    struct wglWineCloseDmaBufWINE_params *params = args;\n" unless $is_wow64;
+    print $out "\n";
+    print $out "    if (params->fd >= 0) close( params->fd );\n";
+    print $out "    return STATUS_SUCCESS;\n";
+    print $out "}\n\n";
+
+    print $out "static NTSTATUS ${prefix}ext_wglWineDmaBufExportSupportedWINE( void *args )\n";
+    print $out "{\n";
+    if ($is_wow64)
+    {
+        print $out "    struct\n";
+        print $out "    {\n";
+        print $out "        PTR32 teb;\n";
+        print $out "        BOOL ret;\n";
+        print $out "    } *params = args;\n";
+        print $out "    TEB *teb = get_teb64( params->teb );\n";
+    }
+    else
+    {
+        print $out "    struct wglWineDmaBufExportSupportedWINE_params *params = args;\n";
+        print $out "    TEB *teb = params->teb;\n";
+    }
+    print $out "    const struct opengl_funcs *funcs = teb->glTable;\n\n";
+    print $out "    params->ret = funcs && funcs->p_wglWineDmaBufExportSupportedWINE &&\n";
+    print $out "            funcs->p_wglWineDmaBufExportSupportedWINE();\n";
+    print $out "    return STATUS_SUCCESS;\n";
+    print $out "}\n\n";
+
+    print $out "static NTSTATUS ${prefix}ext_wglWineExportDmaBufWINE( void *args )\n";
+    print $out "{\n";
+    if ($is_wow64)
+    {
+        print $out "    struct\n";
+        print $out "    {\n";
+        print $out "        PTR32 teb;\n";
+        print $out "        GLuint texture;\n";
+        print $out "        GLenum target;\n";
+        print $out "        PTR32 desc;\n";
+        print $out "        PTR32 fd;\n";
+        print $out "        BOOL ret;\n";
+        print $out "    } *params = args;\n";
+        print $out "    TEB *teb = get_teb64( params->teb );\n";
+    }
+    else
+    {
+        print $out "    struct wglWineExportDmaBufWINE_params *params = args;\n";
+        print $out "    TEB *teb = params->teb;\n";
+    }
+    print $out "    const struct opengl_funcs *funcs = teb->glTable;\n\n";
+    print $out "    if (!funcs || !funcs->p_wglWineExportDmaBufWINE) return STATUS_NOT_IMPLEMENTED;\n";
+    if ($is_wow64)
+    {
+        print $out "    params->ret = funcs->p_wglWineExportDmaBufWINE( params->texture, params->target,\n";
+        print $out "            ULongToPtr(params->desc), ULongToPtr(params->fd) );\n";
+    }
+    else
+    {
+        print $out "    params->ret = funcs->p_wglWineExportDmaBufWINE( params->texture, params->target,\n";
+        print $out "            params->desc, params->fd );\n";
+    }
+    print $out "    return STATUS_SUCCESS;\n";
+    print $out "}\n\n";
+
