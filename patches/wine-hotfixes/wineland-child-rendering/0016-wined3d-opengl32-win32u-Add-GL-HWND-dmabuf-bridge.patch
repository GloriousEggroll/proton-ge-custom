+static void hwnd_dmabuf_commit_producer_open( struct window *win, int exclusive )
+{
+    win->dmabuf_producer_count++;
+    if (exclusive)
+        win->dmabuf_exclusive_count++;
+    if (win->dmabuf_pending_count)
+        win->dmabuf_pending_count--;
+}
