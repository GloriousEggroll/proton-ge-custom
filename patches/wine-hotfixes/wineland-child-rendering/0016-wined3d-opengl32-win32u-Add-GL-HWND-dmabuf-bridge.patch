+    struct wglWineExportDmaBufWINE_params args =
+    {
+        .teb = NtCurrentTeb(),
+        .texture = texture,
+        .target = target,
+        .desc = desc,
+        .fd = fd,
+    };
+    NTSTATUS status;
+
+    TRACE( "texture %u, target %#x, desc %p, fd %p.\n", texture, target, desc, fd );
+
+    if ((status = UNIX_CALL( wglWineExportDmaBufWINE, &args )))
+    {
+        if (status != STATUS_NOT_IMPLEMENTED)
