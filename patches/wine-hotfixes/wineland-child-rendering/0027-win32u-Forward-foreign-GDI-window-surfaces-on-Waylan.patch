diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
index 7c0281ecbdf..09e5489f16f 100644
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -25,6 +25,7 @@
 #include "config.h"
 
 #include <assert.h>
+#include <limits.h>
 #include <stdlib.h>
 #include <string.h>
 #include <time.h>
@@ -2244,15 +2245,59 @@ static int wayland_hwnd_dmabuf_channel_recv_one(int channel_fd, hwnd_dmabuf_fram
     return 1;
 }
 
-/* Build a wl_buffer wrapping the dmabuf fd plus its tracking buffer, cached on the
- * surface. Does not close fd (caller owns it). Returns NULL on failure. */
-static struct wayland_hwnd_dmabuf_buffer *wayland_hwnd_dmabuf_create_buffer(
