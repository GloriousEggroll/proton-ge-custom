 dlls/winewayland.drv/waylanddrv_main.c |   1 +
 dlls/winewayland.drv/window.c          |  14 ++
 include/wine/gdi_driver.h              |   3 +-
 7 files changed, 240 insertions(+), 13 deletions(-)

