From 848dd9933fac545ff26a90a39ca75f22ea0c84d9 Mon Sep 17 00:00:00 2001
From: Erhan Bilgili <erhan.bilgili@gmail.com>
Date: Mon, 17 Aug 2026 22:14:21 +0200
Subject: [PATCH] win32u: Refresh display topology after monitor changes.

Logical display slots are registry links to persistent output source
keys. Reopening an existing slot followed its previous target because
the internal recursive key helper did not apply OBJ_OPENLINK. This left
a surviving output associated with a disconnected monitor after source
indices changed.

Open the final registry link itself when requested so that it can be
retargeted. Keep application-selected virtual mode properties while
refreshing current and persisted source positions from the host layout.

This prevents windows and cursor clipping from retaining disconnected
monitor coordinates when outputs are added or removed.

(cherry picked from commit 848dd9933fac545ff26a90a39ca75f22ea0c84d9)

Source: https://github.com/nanomatters/wine-salkim/commit/848dd9933fac545ff26a90a39ca75f22ea0c84d9
---
 dlls/win32u/font.c      |  3 ++-
 dlls/win32u/sysparams.c | 20 ++++++++++++++++++--
 2 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/dlls/win32u/font.c b/dlls/win32u/font.c
index 836bcbe23ea..76c40e93fe3 100644
--- a/dlls/win32u/font.c
+++ b/dlls/win32u/font.c
@@ -541,7 +541,7 @@ HKEY reg_create_key( HKEY root, const WCHAR *name, ULONG name_len,
     attr.Length = sizeof(attr);
     attr.RootDirectory = root;
     attr.ObjectName = &nameW;
-    attr.Attributes = 0;
+    attr.Attributes = (options & REG_OPTION_OPEN_LINK) ? OBJ_OPENLINK : 0;
     attr.SecurityDescriptor = NULL;
     attr.SecurityQualityOfService = NULL;
 
@@ -562,6 +562,7 @@ HKEY reg_create_key( HKEY root, const WCHAR *name, ULONG name_len,
         {
             unsigned int subkey_options = options;
             if (i < len) subkey_options &= ~(REG_OPTION_CREATE_LINK | REG_OPTION_OPEN_LINK);
+            attr.Attributes = (subkey_options & REG_OPTION_OPEN_LINK) ? OBJ_OPENLINK : 0;
             nameW.Buffer = (WCHAR *)name + pos;
             nameW.Length = (i - pos) * sizeof(WCHAR);
             status = NtCreateKey( &ret, MAXIMUM_ALLOWED, &attr, 0, NULL, subkey_options, disposition );
diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index 52fee82da82..845633213b9 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -564,6 +564,17 @@ static BOOL read_source_mode( HKEY hkey, UINT index, DEVMODEW *mode )
     return TRUE;
 }
 
+static BOOL sync_mode_position( DEVMODEW *mode, const DEVMODEW *layout )
+{
+    if (!(layout->dmFields & DM_POSITION)) return FALSE;
+    if ((mode->dmFields & DM_POSITION) && mode->dmPosition.x == layout->dmPosition.x &&
+        mode->dmPosition.y == layout->dmPosition.y) return FALSE;
+
+    mode->dmFields |= DM_POSITION;
+    mode->dmPosition = layout->dmPosition;
+    return TRUE;
+}
+
 static BOOL source_get_registry_settings( const struct source *source, DEVMODEW *mode )
 {
     BOOL ret = FALSE;
@@ -2512,7 +2523,7 @@ static DEVMODEW *get_virtual_modes( const DEVMODEW *initial, const DEVMODEW *max
 static void add_modes( const DEVMODEW *current, UINT host_modes_count, const DEVMODEW *host_modes, void *param )
 {
     struct device_manager_ctx *ctx = param;
-    DEVMODEW dummy, physical, detached = *current, virtual, *virtual_modes = NULL;
+    DEVMODEW registry_mode, physical, detached = *current, virtual, *virtual_modes = NULL;
     UINT virtual_count, modes_count = host_modes_count;
     const DEVMODEW *modes = host_modes;
     struct source *source;
@@ -2540,6 +2551,7 @@ static void add_modes( const DEVMODEW *current, UINT host_modes_count, const DEV
         /* HACK: Gamescope doesn't really changes the display mode, pretend it changed to what was requested */
         if (user_driver->pHasWindowManager( "steamcompmgr" ) && read_source_mode( source->key, ENUM_CURRENT_SETTINGS, &virtual ))
         {
+            sync_mode_position( &virtual, &physical );
             WARN( "Faking current mode to %s\n", debugstr_devmodew(&virtual) );
             current = &virtual;
             detached = *current;
@@ -2562,6 +2574,8 @@ static void add_modes( const DEVMODEW *current, UINT host_modes_count, const DEV
     {
         if (!read_source_mode( source->key, ENUM_CURRENT_SETTINGS, &virtual ) || is_detached_mode( &virtual ))
             virtual = physical;
+        else
+            sync_mode_position( &virtual, &physical );
 
         if ((virtual_modes = get_virtual_modes( current, &physical, host_modes, host_modes_count, &virtual_count )))
         {
@@ -2573,8 +2587,10 @@ static void add_modes( const DEVMODEW *current, UINT host_modes_count, const DEV
         }
     }
 
-    if (current == &detached || !read_source_mode( source->key, ENUM_REGISTRY_SETTINGS, &dummy ))
+    if (current == &detached || !read_source_mode( source->key, ENUM_REGISTRY_SETTINGS, &registry_mode ))
         write_source_mode( source->key, ENUM_REGISTRY_SETTINGS, current );
+    else if (sync_mode_position( &registry_mode, &physical ))
+        write_source_mode( source->key, ENUM_REGISTRY_SETTINGS, &registry_mode );
     write_source_mode( source->key, ENUM_CURRENT_SETTINGS, current );
 
     assert( !modes_count || modes->dmDriverExtra == 0 );
-- 
