From 7e2f430b58ae8ad43482a96d1accaff91abbef2f Mon Sep 17 00:00:00 2001
From: Mike Lothian <mike@fireburn.co.uk>
Date: Wed, 14 Oct 2026 14:45:14 +0100
Subject: [PATCH 2/2] loader: Do not warn when the interpreter has no _r_debug.

A dynamic loader which keeps its debug state in the C library does not export
_r_debug from the interpreter, so there is nothing to link. The link is only
for debuggers, so the message printed by every process is dropped.
---
 loader/preloader.c | 1 -
 1 file changed, 1 deletion(-)

diff --git a/loader/preloader.c b/loader/preloader.c
index 1158213..1e48a9b 100644
--- a/loader/preloader.c
+++ b/loader/preloader.c
@@ -1515,7 +1515,6 @@ void* wld_start( void **stack )
     /* expose ld.so _r_debug as a separate namespace in r_next */
     ld_so_r_debug = find_symbol( &ld_so_map, "_r_debug", STT_OBJECT );
     if (ld_so_r_debug) _r_debug.r_next = (struct wld_r_debug_extended *)ld_so_r_debug;
-    else wld_printf( "_r_debug not found in ld.so\n" );
 
     _r_debug_state(); /* notify GDB that _r_debug is ready */
 
