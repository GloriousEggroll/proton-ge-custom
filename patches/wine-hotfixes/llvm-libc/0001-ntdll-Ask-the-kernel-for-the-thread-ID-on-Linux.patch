From 22194b4d69615dd93fd527c98d12ea446181dd6c Mon Sep 17 00:00:00 2001
From: Mike Lothian <mike@fireburn.co.uk>
Date: Wed, 14 Oct 2026 14:45:14 +0100
Subject: [PATCH 1/2] ntdll: Ask the kernel for the thread ID on Linux.

The server signals threads with tgkill, so it needs the kernel ID.
pthread_getthreadid_np returns that on FreeBSD, but a C library may provide
the function on Linux with a different meaning. llvm-libc does, and returns
the ID its C++ runtime uses for std::thread.
---
 dlls/ntdll/unix/server.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index 112157b..a3de682 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1538,10 +1538,10 @@ static void send_server_task_port(void)
 static int get_unix_tid(void)
 {
     int ret = -1;
-#ifdef HAVE_PTHREAD_GETTHREADID_NP
-    ret = pthread_getthreadid_np();
-#elif defined(linux)
+#if defined(linux)
     ret = syscall( __NR_gettid );
+#elif defined(HAVE_PTHREAD_GETTHREADID_NP)
+    ret = pthread_getthreadid_np();
 #elif defined(__sun)
     ret = pthread_self();
 #elif defined(__APPLE__)
