+    if (FAILED((hr = data_section_create( type, data, size, &section )))) return hr;
+    hr = IVector_IInspectable_Append( impl->sections, (IInspectable *)section );
+    IBluetoothLEAdvertisementDataSection_Release( section );
+    return hr;
+}
