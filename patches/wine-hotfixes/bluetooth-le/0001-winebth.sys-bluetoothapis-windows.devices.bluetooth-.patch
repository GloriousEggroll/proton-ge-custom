+    else if (!ctx->bluez_dbus_unique_name && ((ctx->bluez_dbus_unique_name = strdup( name ))))
+        bluez_on_service_available( ctx );
+    p_dbus_error_free( &error );
+    p_dbus_message_unref( reply );
+}
