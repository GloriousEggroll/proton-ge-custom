+struct named_flag
+{
+    const char *name;
+    BOOLEAN *flag;
+};
+
+static int named_flag_cmp( const void *flag1, const void *flag2 )
+{
+    const struct named_flag *f1 = flag1, *f2 = flag2;
+    return strcmp( f1->name, f2->name );
+}
