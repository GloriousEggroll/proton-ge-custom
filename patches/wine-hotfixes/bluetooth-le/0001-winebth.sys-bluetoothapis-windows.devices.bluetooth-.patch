+    hr = gatt_service_get_characteristics_vector( impl, filter, &vector );
+    hr = characteristics_result_create( SUCCEEDED(hr) ? GattCommunicationStatus_Success : GattCommunicationStatus_Unreachable,
+                                        vector, &chars_result );
