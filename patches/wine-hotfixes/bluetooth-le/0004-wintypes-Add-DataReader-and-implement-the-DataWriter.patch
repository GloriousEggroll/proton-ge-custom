+
+    if (!value) return E_POINTER;
+    return data_reader_read(impl, value, sizeof(*value));
+}
+
+static HRESULT WINAPI data_reader_ReadBytes(IDataReader *iface, UINT32 value_size, BYTE *value)
+{
