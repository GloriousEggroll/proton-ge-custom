From 0746a70221a12f8bda57731c50f88fbe93fcfd10 Mon Sep 17 00:00:00 2001
From: David Szendrei <618011+pocker@users.noreply.github.com>
Date: Tue, 29 Sep 2026 11:42:35 +0200
Subject: [PATCH 6/8] windows.devices.bluetooth: Wait for GATT service device
 nodes to appear.

winebth creates the per-service device nodes asynchronously after BlueZ
has resolved the services, and an app that requests characteristics
straight after connecting can get ahead of them. Retry for up to 5
seconds before failing.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/windows.devices.bluetooth/gatt.c | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/dlls/windows.devices.bluetooth/gatt.c b/dlls/windows.devices.bluetooth/gatt.c
index 3e312c2f..bd0b82f3 100644
--- a/dlls/windows.devices.bluetooth/gatt.c
+++ b/dlls/windows.devices.bluetooth/gatt.c
@@ -1368,7 +1368,7 @@ static inline struct gatt_service *impl_from_IGattDeviceService( IGattDeviceServ
 }
 
 /* Find the driver's device node for this service. Caller must hold impl->cs. */
-static HANDLE gatt_service_open( struct gatt_service *impl )
+static HANDLE gatt_service_find( struct gatt_service *impl )
 {
     char buffer[sizeof( SP_DEVICE_INTERFACE_DETAIL_DATA_W ) + MAX_PATH * sizeof( WCHAR )];
     SP_DEVICE_INTERFACE_DETAIL_DATA_W *detail = (SP_DEVICE_INTERFACE_DETAIL_DATA_W *)buffer;
@@ -1410,10 +1410,27 @@ static HANDLE gatt_service_open( struct gatt_service *impl )
         break;
     }
     SetupDiDestroyDeviceInfoList( devinfo );
-    if (impl->service_handle == INVALID_HANDLE_VALUE) WARN( "No device node for service %s\n", debugstr_guid( &uuid ) );
     return impl->service_handle;
 }
 
+/* winebth creates the service device nodes asynchronously once BlueZ has resolved the services, so an app
+ * that asks for characteristics right after connecting can get ahead of them. Wait a little for them to
+ * appear. Caller must hold impl->cs. */
+static HANDLE gatt_service_open( struct gatt_service *impl )
+{
+    GUID uuid;
+    int i;
+
+    for (i = 0; i < 50; i++)
+    {
+        if (gatt_service_find( impl ) != INVALID_HANDLE_VALUE) return impl->service_handle;
+        Sleep( 100 );
+    }
+    le_uuid_to_guid( &impl->service.ServiceUuid, &uuid );
+    WARN( "No device node for service %s\n", debugstr_guid( &uuid ) );
+    return INVALID_HANDLE_VALUE;
+}
+
 static HANDLE gatt_service_get_handle( struct gatt_service *impl )
 {
     HANDLE handle;
