Do not assume MSVC when _WIN32 is defined.

_MSC_VER is undefined under clang, which makes the comparison true and pulls in
MSVC-only code.

--- a/src/vrcore/strtools_public.h
+++ b/src/vrcore/strtools_public.h
@@ -108,7 +108,7 @@
 
 #endif
 
-#if defined( _WIN32 ) && _MSC_VER < 1800
+#if defined( _WIN32 ) && defined( _MSC_VER ) && _MSC_VER < 1800
 inline uint64_t strtoull(const char *str, char **endptr, int base) { return _strtoui64( str, endptr, base ); }
 #endif
 
